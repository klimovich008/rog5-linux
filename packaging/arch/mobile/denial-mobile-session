#!/usr/bin/env bash
# Separate mobile composition; never install over the accepted headless entry.
# These prerequisites exclude known impossible sessions. They do not qualify
# PAM authentication, lock-screen isolation, logind device access or hardware.
set -euo pipefail

mobile_die() { printf 'denial-mobile-session: %s\n' "$*" >&2; exit 1; }

# Read-only boundary functions are separate so offline fixtures can supply facts
# while executing the production decisions below. No environment path overrides.
mobile_identity() {
  printf '%s %s %s %s %s\n' "$(/usr/bin/id -u)" "$(/usr/bin/id -ru)" "$(/usr/bin/id -g)" "$(/usr/bin/id -rg)" "$(/usr/bin/id -un)"
  /usr/bin/id -G
}
mobile_status() { /usr/bin/cat "/proc/$$/status"; }
mobile_login() {
  /usr/bin/timeout --signal=TERM --kill-after=1s 5s \
    /usr/bin/loginctl show-session self --all --no-pager \
    --property=Active --property=Remote --property=User --property=Class \
    --property=Type --property=Seat
}
mobile_metadata() {
  [[ ! -L "$1" ]] || return 1
  LC_ALL=C /usr/bin/stat -c '%u %g %a %F' -- "$1"
}
mobile_load_config() {
  # This is the upstream launcher's same root-controlled shell configuration.
  # shellcheck source=/dev/null
  source /etc/denial/session.conf
}
mobile_character_device() { [[ "$1" == /* && -c "$1" ]]; }
mobile_output_access() {
  [[ "$1" == /* && ! -L "$1" && -f "$1" && -r "$1" && -w "$1" \
    && -w "${1%/*}" && -x "${1%/*}" ]]
}
mobile_delegate() { exec /usr/bin/denial-session "$@"; }

mobile_root_controlled() {
  local metadata owner group mode kind
  metadata=$(mobile_metadata "$1") || mobile_die "unavailable or symlinked configuration path: $1"
  read -r owner group mode kind <<< "$metadata"
  [[ "$owner" == 0 && "$group" == 0 && "$mode" =~ ^[0-7]{3,4}$ \
    && "$kind" == "$2" ]] || mobile_die "configuration path is not root-controlled: $1"
  (( (8#$mode & 0022) == 0 )) || mobile_die "configuration path is writable by other users: $1"
}

mobile_main() {
  local identity groups group status line key value metadata
  local -A session=()
  local no_new_privs=missing
  [[ $# == 0 || ( $# == 1 && "$1" == --check ) ]] \
    || mobile_die 'only --check is supported; machine configuration owns device selection'
  [[ -z "${WAYLAND_DISPLAY:-}" ]] || mobile_die 'an inherited Wayland session is already active'
  identity=$(mobile_identity) || mobile_die 'cannot establish user identity'
  [[ "${identity%%$'\n'*}" == '1000 1000 1000 1000 mobile' ]] \
    || mobile_die 'requires real/effective mobile UID and GID 1000'
  groups=''
  if [[ "$identity" == *$'\n'* ]]; then groups=${identity#*$'\n'}; fi
  for group in $groups; do
    [[ "$group" == 1000 ]] || mobile_die 'supplementary groups are not allowed'
  done
  status=$(mobile_status) || mobile_die 'cannot read process privilege state'
  while IFS= read -r line; do
    if [[ "$line" == NoNewPrivs:* ]]; then
      read -r key value <<< "$line"
      [[ "$no_new_privs" == missing ]] || mobile_die 'duplicate NoNewPrivs field'
      no_new_privs=$value
    fi
  done <<< "$status"
  [[ "$no_new_privs" == 0 ]] || mobile_die 'PAM unix_chkpwd requires NoNewPrivs=0 in this package profile'
  metadata=$(mobile_metadata /usr/bin/unix_chkpwd) || mobile_die 'PAM unix_chkpwd is unavailable'
  [[ "$metadata" == '0 0 6755 regular file' ]] \
    || mobile_die 'requires the authenticated PAM package unix_chkpwd root:root mode 06755'
  # Mode/ownership alone do not prove that the mount permits set-ID execution,
  # that the bytes match the package, or that PAM/lock-screen policy is secure.
  [[ "${XDG_RUNTIME_DIR:-}" == /run/user/1000 ]] || mobile_die 'XDG_RUNTIME_DIR must be /run/user/1000'
  metadata=$(mobile_metadata /run/user/1000) || mobile_die 'runtime directory is unavailable'
  [[ "$metadata" == '1000 1000 700 directory' ]] || mobile_die 'runtime directory must be mobile-owned mode 0700'
  status=$(mobile_login) || mobile_die 'cannot verify this process local logind session'
  while IFS='=' read -r key value; do
    case "$key" in
      Active|Remote|User|Class|Type|Seat)
        [[ ! -v "session[$key]" ]] || mobile_die "duplicate logind property: $key"
        session[$key]=$value ;;
      *) mobile_die 'unexpected logind response' ;;
    esac
  done <<< "$status"
  [[ "${session[Active]:-}" == yes && "${session[Remote]:-}" == no \
    && "${session[User]:-}" == 1000 && "${session[Class]:-}" == user \
    && ( "${session[Type]:-}" == tty || "${session[Type]:-}" == wayland ) \
    && -n "${session[Seat]:-}" ]] || mobile_die 'requires an active local mobile logind seat'

  mobile_root_controlled /etc directory
  mobile_root_controlled /etc/denial directory
  mobile_root_controlled /etc/denial/session.conf 'regular file'
  unset DENIAL_DRM_DEVICE DENIAL_RENDER_DEVICE DENIAL_OUTPUT_CONFIG
  export LIBSEAT_BACKEND=logind DENIA_SHELL_PROFILE=mobile DENIAL_PAM_SERVICE=login
  mobile_load_config || mobile_die 'cannot load machine session configuration'
  [[ "${LIBSEAT_BACKEND:-}" == logind && "${DENIA_SHELL_PROFILE:-}" == mobile \
    && "${DENIAL_PAM_SERVICE:-}" == login ]] \
    || mobile_die 'machine configuration must preserve logind, mobile shell and login PAM service'
  mobile_character_device "${DENIAL_DRM_DEVICE:-}" \
    || mobile_die 'machine configuration must select an explicit DRM character device'
  mobile_character_device "${DENIAL_RENDER_DEVICE:-}" \
    || mobile_die 'machine configuration must select an explicit render character device'
  mobile_output_access "${DENIAL_OUTPUT_CONFIG:-}" \
    || mobile_die 'machine configuration must select an existing writable user output configuration'
  metadata=$(mobile_metadata "$DENIAL_OUTPUT_CONFIG") || mobile_die 'output configuration metadata is unavailable'
  [[ "$metadata" == '1000 1000 600 regular file' ]] \
    || mobile_die 'output configuration must be mobile-owned mode 0600'
  export DENIAL_DRM_DEVICE DENIAL_RENDER_DEVICE DENIAL_OUTPUT_CONFIG
  # Never use inherited XDG_SESSION_ID to borrow another session's seat.
  unset XDG_SESSION_ID
  mobile_delegate "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  mobile_main "$@"
fi
