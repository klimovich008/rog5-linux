[Unit]
Description=ROG5 loopback-only web terminal
After=network.target

[Service]
Type=simple
User=rog5
Group=rog5
Environment=HOME=/home/rog5
WorkingDirectory=/home/rog5
ExecStart=/usr/bin/ttyd -i 127.0.0.1 -p 7681 -W /usr/bin/tmux new-session -A -s main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
