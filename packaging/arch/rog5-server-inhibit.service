[Unit]
Description=Keep the ROG5 server awake while allowing the display to blank
After=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=sleep:handle-power-key --who=rog5-server --why=keep-server-workloads-running --mode=block /usr/bin/sleep infinity
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
