#!/usr/bin/python3
"""Route MultiMedia1 to both speakers once the ROG5 sound card is up.

Run by rog5-audio.service after the audio modules load. The card has no UCM
profile, so nothing else sets it up: without this, playback reaches no amplifier.
  MultiMedia1 (card 0, device 0) -> SENARY MI2S -> CS35L45 x2
  left (ASP_RX1) -> the top amplifier (RCV), right (ASP_RX2) -> the bottom (SPK),
  as on stock: in landscape with the side port down the top edge is on the left
Both amplifiers run in speaker mode at 0 dB digital (409; 0.25 dB steps) and
19 dBV analog (3, the highest step, as stock). The speaker-protection DSP firmware is not loaded:
-12 dB and then -6 dB were too quiet for the user (2026-09-30), who asked for
full power; long full-volume playback can overheat the speakers until the
protection firmware runs. DAPM powers the amplifiers only while a stream runs.
With the mic DTB feature, the built-in microphones record on PCM 3
(MultiMedia3 <- VA_CODEC_DMA_TX_0): DMIC0 (stock "dmic1", handset) left,
DMIC2 (stock "dmic2", speaker side) right, +18 dB decimator gain as on stock.
Those controls are optional: without the VA macro they are skipped.
Uses libasound through ctypes, as amixer cset would.
"""
import ctypes
import sys
import time

CARD_NAME = 'ASUS-ROG-Phone-5'
ROUTE = (
    ('SEN_MI2S_RX Audio Mixer MultiMedia1', '1'),
    ('SPK Amplifier Mode', 'SPK'),
    ('RCV Amplifier Mode', 'SPK'),
    ('SPK DACPCM Source', 'ASP_RX2'),
    ('RCV DACPCM Source', 'ASP_RX1'),
    ('SPK Analog PCM Volume', '3'),
    ('RCV Analog PCM Volume', '3'),
    ('SPK Digital PCM Volume', '409'),
    ('RCV Digital PCM Volume', '409'),
    ('SPK AMP Enable Switch', '1'),
    ('RCV AMP Enable Switch', '1'),
)
CAPTURE = (
    ('MultiMedia3 Mixer VA_CODEC_DMA_TX_0', '1'),
    ('VA DEC0 MUX', 'VA_DMIC'),
    ('VA DMIC MUX0', 'DMIC0'),
    ('VA DEC1 MUX', 'VA_DMIC'),
    ('VA DMIC MUX1', 'DMIC2'),
    ('VA_AIF1_CAP Mixer DEC0', '1'),
    ('VA_AIF1_CAP Mixer DEC1', '1'),
    ('VA_DEC0 Volume', '102'),
    ('VA_DEC1 Volume', '102'),
)
WAIT_SECONDS = 60


def log(message):
    try:
        with open('/dev/kmsg', 'w') as kmsg:
            kmsg.write(f'rog5-audio-route: {message}\n')
    except OSError:
        print(message, file=sys.stderr)


def find_card(asound):
    for index in range(8):
        name = ctypes.c_char_p()
        if asound.snd_card_get_longname(index, ctypes.byref(name)) == 0 and name.value.decode() == CARD_NAME:
            return index
    return None


def set_control(asound, handle, name, value):
    ptr = ctypes.c_void_p
    eid, info, val = ptr(), ptr(), ptr()
    asound.snd_ctl_elem_id_malloc(ctypes.byref(eid))
    asound.snd_ctl_elem_info_malloc(ctypes.byref(info))
    asound.snd_ctl_elem_value_malloc(ctypes.byref(val))
    try:
        rc = asound.snd_ctl_ascii_elem_id_parse(eid, f"name='{name}'".encode())
        if rc < 0:
            return rc
        asound.snd_ctl_elem_info_set_id(info, eid)
        rc = asound.snd_ctl_elem_info(handle, info)
        if rc < 0:
            return rc
        asound.snd_ctl_elem_info_get_id(info, eid)
        asound.snd_ctl_elem_value_set_id(val, eid)
        rc = asound.snd_ctl_ascii_value_parse(handle, val, info, value.encode())
        if rc < 0:
            return rc
        return asound.snd_ctl_elem_write(handle, val)
    finally:
        asound.snd_ctl_elem_value_free(val)
        asound.snd_ctl_elem_info_free(info)
        asound.snd_ctl_elem_id_free(eid)


def main():
    asound = ctypes.CDLL('libasound.so.2')
    # These return void: without a restype, ctypes reads a stale register.
    for void in ('snd_ctl_elem_info_set_id', 'snd_ctl_elem_info_get_id', 'snd_ctl_elem_value_set_id',
                 'snd_ctl_elem_id_free', 'snd_ctl_elem_info_free', 'snd_ctl_elem_value_free'):
        getattr(asound, void).restype = None
    card = None
    deadline = time.monotonic() + WAIT_SECONDS
    while card is None and time.monotonic() < deadline:
        card = find_card(asound)
        if card is None:
            time.sleep(1)
    if card is None:
        log(f'FAIL no {CARD_NAME} card after {WAIT_SECONDS}s')
        return 1
    handle = ctypes.c_void_p()
    rc = asound.snd_ctl_open(ctypes.byref(handle), f'hw:{card}'.encode(), 0)
    if rc < 0:
        log(f'FAIL open hw:{card}: {rc}')
        return 1
    failed = [name for name, value in ROUTE if set_control(asound, handle, name, value) < 0]
    capture = [set_control(asound, handle, name, value) for name, value in CAPTURE]
    asound.snd_ctl_close(handle)
    if all(rc == 0 for rc in capture):
        log(f'hw:{card} microphones routed to MultiMedia3 (PCM 3)')
    elif any(rc == 0 for rc in capture):
        log('FAIL microphone route incomplete')
    if failed:
        log('FAIL could not set ' + ', '.join(failed))
        return 1
    log(f'hw:{card} MultiMedia1 routed to both speakers')
    return 0


if __name__ == '__main__':
    sys.exit(main())
