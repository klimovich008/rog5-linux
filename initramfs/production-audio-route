CONFIRM_RETRY_SECONDS = 0.05
KMSG = '/dev/kmsg'


def log(message):
    try:
        with open('/dev/kmsg', 'w') as kmsg:
            kmsg.write(f'rog5-audio-route: {message}\n')
    except OSError:
        print(message, file=sys.stderr)


def brace_delta(line):
    delta, quote = 0, None
    for ch in line:
        if quote:
            if ch == quote:
                quote = None
        elif ch in '\'"':
            quote = ch
        elif ch == '{':
            delta += 1
        elif ch == '}':
            delta -= 1
    return delta


def safe_value(name):
    for pattern, value in STATE_SAFE:
        if pattern.match(name):
            return value
    return None


def force_value(block, value):
    """(block with every value line set to value, ok). ok is False unless the
    block has value lines and all of them are in the form alsactl writes
    (value N / value.N N, optionally a trailing comment)."""
    out, depth, values, ok = [], 0, 0, True
    for line in block:
        if depth == 1 and re.match(r'\s*value\b', line):
            match = STATE_VALUE.match(line)
            if match:
                values += 1
                line = f'{match.group(1)}{value}\n'
            else:
                ok = False
        out.append(line)
        depth += brace_delta(line)
    return out, ok and values > 0


# The lines alsactl store writes in a control block (depth 2), one key each;
# the comment block (depth 3) holds only "key value" lines.
BLOCK_LINES = (re.compile(r'\s*iface\s+\w+\s*$'),
               re.compile(r'\s*name\s+(\'[^\'\\]*\'|"[^"\\]*")\s*$'),
               re.compile(r'\s*(index|device|subdevice)\s+\d+\s*$'),
               STATE_VALUE,
               re.compile(r'\s*comment\s*\{\s*$'))


def block_syntax(block):
    """None when a control block of this card is in the alsactl store layout
    (so that the name and value lines read here are the ones libasound
    reads), else what is not."""
    if len(block) < 2 or block[-1].strip() != '}':
        return 'control block not closed on its own line'
    comment = False
    for line in block[1:-1]:
        text = line.strip()
        if not text or text.startswith('#'):
            continue
        if '\\' in text:
            return f'escape in {text!r}'
        if comment:
            if text == '}':
                comment = False
            elif '{' in text or '}' in text or not re.match(r'[\w.]+\s+\S', text):
                return f'unexpected comment line {text!r}'
        elif any(pattern.match(line) for pattern in BLOCK_LINES):
            comment = text.startswith('comment')
        else:
            return f'unexpected line {text!r}'
    return 'comment block not closed' if comment else None


def quarantine_alsa_state(path, why):
    """Move a state file that could not be made safe out of alsactl's way."""
    try:
        os.replace(path, path + '.rog5-unsafe')
        log(f'sanitize: {path} {why}; moved to {path}.rog5-unsafe, nothing restored')
    except FileNotFoundError:
        pass
    except OSError as e:
        log(f'sanitize: FAIL {path} {why}, and it could not be moved aside: {e}')


def sanitize_alsa_state(path=STATE_FILE):
    """Drop this card's DSP/DSP_RX/DACPCM entries from the saved ALSA state and
    put its digital volumes at -12 dB and its amplifier enables off. Only the
    layout alsactl store writes is understood (state.CARD { control.N { name
    ...; value ... } }); anything else that mentions this card is moved
    aside rather than restored unchecked."""
    try:
        with open(path) as f:
            text = f.read()
    except FileNotFoundError:
        return 0
    lines = text.splitlines(keepends=True)
    out, block, dropped, forced, headers = [], None, [], [], 0
    depth, card, name, unsafe = 0, None, None, None
    for line in lines:
        if block is not None:
            block.append(line)
            match = re.match(r'\s*name\s+([\'"])(.*)\1\s*$', line)
            if depth == 2 and match:
                name = match.group(2)
            depth += brace_delta(line)
            if depth == 1:
                safe = safe_value(name) if name else None
                syntax = block_syntax(block)
                if syntax:
                    unsafe = unsafe or syntax
                if not name:
                    unsafe = unsafe or 'a control without a name line'
                elif STATE_DROP.match(name):
                    dropped.append(name)
                elif safe is not None:
                    fixed, ok = force_value(block, safe)
                    if not ok:
                        unsafe = unsafe or f'{name}: value not in the alsactl layout'
                    if fixed != block:
                        forced.append(name)
                    out.extend(fixed)
                else:
                    out.extend(block)
                block = None
            elif depth < 1:
                unsafe = unsafe or 'unbalanced control block'
            continue
        if depth == 0:
            match = re.match(r'\s*state\.([\'"]?)([^\'"\s{\\]+)\1\s*\{\s*$', line)
            card = match.group(2) if match else None
            headers += card == CARD_ID
            if not match and line.strip() and not line.lstrip().startswith('#'):
                # e.g. "state {" or an escaped card id: not what alsactl writes
                unsafe = unsafe or f'unexpected top-level line {line.strip()!r}'
        elif depth == 1 and card == CARD_ID:
            if re.match(r'\s*control\.\d+\s*\{\s*$', line):
                block, name = [line], None
                depth += brace_delta(line)
                continue
            if line.strip() not in ('', '}') and not line.lstrip().startswith('#'):
                unsafe = unsafe or f'unexpected line {line.strip()!r}'
        out.append(line)
        depth += brace_delta(line)
    if depth != 0 or block is not None:
        unsafe = 'did not parse'
    elif text.count(CARD_ID) != headers:
        unsafe = unsafe or f'{CARD_ID} outside a state.{CARD_ID} block'
    if unsafe:
        quarantine_alsa_state(path, unsafe)
        return 0
    if not dropped and not forced:
        return 0
    tmp = path + '.rog5-tmp'
    try:
        with open(tmp, 'w') as f:
            f.writelines(out)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, os.stat(path).st_mode & 0o7777)
        os.replace(tmp, path)
    except OSError as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        quarantine_alsa_state(path, f'could not be rewritten ({e})')
        return 0
    log(f'sanitize: removed {len(dropped)} speaker DSP/route entries, set {len(forced)} '
        f'volume/amplifier entries to -12 dB/off in {path}')
    return 0


class Mixer:
    """The few libasound control calls this script needs."""

    def __init__(self, asound, handle):
        self.asound, self.handle = asound, handle

    def _elem(self, name):
        a, ptr = self.asound, ctypes.c_void_p
        eid, info, val = ptr(), ptr(), ptr()
        a.snd_ctl_elem_id_malloc(ctypes.byref(eid))
        a.snd_ctl_elem_info_malloc(ctypes.byref(info))
        a.snd_ctl_elem_value_malloc(ctypes.byref(val))
        rc = a.snd_ctl_ascii_elem_id_parse(eid, f"name='{name}'".encode())
        if rc >= 0:
            a.snd_ctl_elem_info_set_id(info, eid)
            rc = a.snd_ctl_elem_info(self.handle, info)
        if rc >= 0:
            a.snd_ctl_elem_info_get_id(info, eid)
            a.snd_ctl_elem_value_set_id(val, eid)
        return rc, eid, info, val

    def _free(self, eid, info, val):
        self.asound.snd_ctl_elem_value_free(val)
        self.asound.snd_ctl_elem_info_free(info)
        self.asound.snd_ctl_elem_id_free(eid)

    def set(self, name, value):
        rc, eid, info, val = self._elem(name)
        try:
            if rc >= 0:
                rc = self.asound.snd_ctl_ascii_value_parse(self.handle, val, info, value.encode())
            if rc >= 0:
                rc = self.asound.snd_ctl_elem_write(self.handle, val)
            return rc
        finally:
            self._free(eid, info, val)

    def get_int(self, name):
        """Integer, boolean or enumerated item index; None on error."""
        rc, eid, info, val = self._elem(name)
        try:
            if rc >= 0:
                rc = self.asound.snd_ctl_elem_read(self.handle, val)
            if rc < 0:
                return None
            kind = self.asound.snd_ctl_elem_info_get_type(info)
            if kind == 3:  # SND_CTL_ELEM_TYPE_ENUMERATED
                return self.asound.snd_ctl_elem_value_get_enumerated(val, 0)
            return self.asound.snd_ctl_elem_value_get_integer(val, 0)
        finally:
            self._free(eid, info, val)

    def get_bytes(self, name):
        """(rc, bytes) of a BYTES control."""
        rc, eid, info, val = self._elem(name)
        try:
            if rc >= 0:
                rc = self.asound.snd_ctl_elem_read(self.handle, val)
            if rc < 0:
                return rc, None
            count = self.asound.snd_ctl_elem_info_get_count(info)
            return 0, bytes(self.asound.snd_ctl_elem_value_get_byte(val, i) for i in range(count))
        finally:
            self._free(eid, info, val)

    def set_bytes(self, name, data):
        rc, eid, info, val = self._elem(name)
        try:
            if rc >= 0 and self.asound.snd_ctl_elem_info_get_count(info) != len(data):
                rc = -22
            if rc >= 0:
                for i, byte in enumerate(data):
                    self.asound.snd_ctl_elem_value_set_byte(val, i, byte)
                rc = self.asound.snd_ctl_elem_write(self.handle, val)
            return rc
        finally:
            self._free(eid, info, val)

    def get_be32(self, name):
        rc, data = self.get_bytes(name)
        if rc < 0 or len(data) != 4:
            return None
        return int.from_bytes(data, 'big')


def read_key_values(path):
    values = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.split('#', 1)[0].strip()
                if '=' in line:
                    key, value = line.split('=', 1)
                    values[key.strip()] = value.strip()
    except OSError:
        pass
    return values


def amp_device(prefix):
    for node in glob.glob('/sys/bus/i2c/devices/*/of_node'):
        try:
            with open(os.path.join(node, 'compatible'), 'rb') as f:
                if b'cirrus,cs35l45' not in f.read():
                    continue
            with open(os.path.join(node, 'sound-name-prefix'), 'rb') as f:
                if f.read().rstrip(b'\0').decode() == prefix:
                    return os.path.dirname(node)
        except OSError:
            continue
    return None


def dt_string(device, prop):
    try:
        with open(os.path.join(device, 'of_node', prop), 'rb') as f:
            return f.read().rstrip(b'\0').decode()
    except OSError:
        return None


def runtime_control(device, value=None):
    """Read or set the amplifier's runtime PM control ('auto' or 'on').

    'on' keeps it out of runtime suspend. The driver hibernates a preloaded
    DSP 3 s after its last use; volatile coefficients (CSPL_STATE, ...)
    cannot be read or written then, and the vendor never hibernated this
    firmware (its HAL only pauses it between streams), so by default the
    DSP stays awake and paused (hibernate=0 in speaker-dsp.conf)."""
    if device is None:
        return None
    path = os.path.join(device, 'power', 'control')
    try:
        if value is None:
            with open(path) as f:
                return f.read().strip()
        with open(path, 'w') as f:
            f.write(value)
        return value
    except OSError:
        return None


def runtime_status(device):
    try:
        with open(os.path.join(device, 'power', 'runtime_status')) as f:
            return f.read().strip()
    except (OSError, TypeError):
        return None


def unavailable(prefix, part, config, calibration):
    """Why this amplifier stays on the direct path, or None."""
    if part not in config.get('amps', '').replace(',', ' ').split():
        return f'not enabled in {CONFIG_FILE}'
    for suffix in ('wmfw', 'bin'):
        if not os.path.isfile(f'{FIRMWARE_DIR}/cs35l45-{part}-dsp1-spk-prot.{suffix}'):
            return 'firmware not installed'
    if calibration.get(f'{part}_cal_source') != 'persist' and config.get('allow_default_calibration') != '1':
        return 'no factory calibration (allow_default_calibration=1 accepts the vendor default)'
    try:
        cal_r = int(calibration.get(f'{part}_cal_r', ''))
    except ValueError:
        return f'no calibration in {SPEAKER_DIR}/calibration'
    if not CAL_MIN <= cal_r <= CAL_MAX:
        return f'calibration {cal_r} out of range'
    device = amp_device(prefix)
    if device is None:
        return 'amplifier not found'
    if dt_string(device, 'cirrus,dsp-part-name') != f'cs35l45-{part}':
        return 'DT has no cirrus,dsp-part-name (old DTB)'
    return None


def kernel_messages(path=KMSG):
    """The kernel log records still in the ring buffer, oldest first (text
    of each record's first line); None when the log cannot be read in full."""
    messages = []
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        while True:
            try:
                record = os.read(fd, 8192)
            except BlockingIOError:
                break
            except BrokenPipeError:
                return None  # records overwritten while reading: incomplete
            except OSError:
                return None
            if not record:
                break
            text = record.decode(errors='replace').partition(';')[2]
            messages.append(text.split('\n', 1)[0])
    finally:
        os.close(fd)
    return messages


def dsp_failures(device, prefix):
    """Kernel log lines of a pause or resume this amplifier's protection
    firmware did not acknowledge."""
    return (f'cs35l45 {device}: Failed to set mailbox cmd 1 ',
            f'cs35l45 {device}: Failed to set mailbox cmd 2 ',
            f'cs35l45 {device}: Protection firmware did not pause',
            f'cs35l45 {device}: Failed to write MBOX',
            f'ASoC: PRE_PMD: {prefix} DSP1 event failed',
            f'ASoC: POST_PMU: {prefix} DSP1 event failed')


def wedge_reason(messages, device, prefix):
    """The kernel log line showing that this amplifier's protection firmware
    missed a pause/resume after its last start, or None. A history that does
    not show the start (log unreadable, or the start overwritten in the ring
    buffer) cannot rule a wedge out and counts as one."""
    if messages is None:
        return 'kernel log unreadable'
    started = False
    start = f'cs35l45 {device}: Protection firmware calibration CAL_R'
    failures = dsp_failures(device, prefix)
    reason = None
    for text in messages:
        if text.startswith('rog5-audio-route:'):
            continue  # this script's own reports quote the kernel lines
        if start in text:
            started, reason = True, None
        elif any(failure in text for failure in failures):
            reason = text
    if reason is None and not started:
        return 'its last start is no longer in the kernel log'
    return reason


def playback_idle(card):
    """MultiMedia1 (PCM 0 playback) is closed."""
    for path in glob.glob(f'/proc/asound/card{card}/pcm0p/sub*/status'):
        try:
            with open(path) as f:
                if f.read().strip() != 'closed':
                    return False
        except OSError:
            continue
    return True


def wait_playback_idle(card, seconds):
    deadline = time.monotonic() + seconds
    while not playback_idle(card):
        if time.monotonic() > deadline:
            return False
        time.sleep(0.2)
    return True


def core_running(mixer, prefix):
    """The DSP core runs when its volatile CSPL_STATE can be read (any
    DAPM path may keep it running, Preload or not)."""
    return mixer.get_be32(f'{prefix} {CSPL}CSPL_STATE') is not None


def dsp_running(mixer, prefix):
    """Preloaded and running: stays up between streams."""
    return mixer.get_int(f'{prefix} DSP1 Preload Switch') == 1 and core_running(mixer, prefix)


def apply_music_delta(mixer, prefix, part):
    """Stock "Fast Use Case" music tuning: the first 68 words of
    CSPL_UPDATE_PARAMS_CONFIG, then CSPL_COMMAND = UPDATE_PARAM."""
    try:
        with open(f'{SPEAKER_DIR}/cs35l45-{part}-music.be32', 'rb') as f:
            delta = f.read()
    except OSError as e:
        return f'music delta: {e.strerror}'
    rc, current = mixer.get_bytes(f'{prefix} {CSPL}{UPDATE_PARAMS}')
    if rc < 0 or len(delta) > len(current) or len(delta) % 4 or \
            int.from_bytes(delta[:4], 'big') * 4 != len(delta):
        return f'music delta: bad sizes ({rc})'
    rc = mixer.set_bytes(f'{prefix} {CSPL}{UPDATE_PARAMS}', delta + current[len(delta):])
    if rc >= 0:
        rc = mixer.set_bytes(f'{prefix} {CSPL}CSPL_COMMAND', CSPL_CMD_UPDATE_PARAM.to_bytes(4, 'big'))
    if rc < 0:
        return f'music delta: write failed ({rc})'
    state = None
    for _ in range(40):
        state = mixer.get_be32(f'{prefix} {CSPL}CSPL_STATE')
        if state == 0 or state == CSPL_ST_ERROR:
            break
        time.sleep(0.005)
    error = mixer.get_be32(f'{prefix} {CSPL}CSPL_ERRORNO')
    if state != 0 or error != 0:
        return f'music delta: CSPL_STATE {state} CSPL_ERRORNO {error}'
    return None


def start_protection(mixer, prefix, part, direct, cal_r, config, card=None):
    """Set up and verify the protection DSP; return None or a failure."""
    for name, value in (('DSP_RX1 Source', direct), ('DSP_RX2 Source', direct)) + DSP_INPUTS:
        if mixer.set(f'{prefix} {name}', value) < 0:
            return f'could not set {name}'
    started = False
    running = dsp_running(mixer, prefix)
    if running:
        device = amp_device(prefix)
        wedge = wedge_reason(kernel_messages(), os.path.basename(device or ''), prefix)
        if wedge:
            if not wait_playback_idle(card, PCM_IDLE_SECONDS):
                return f'protection DSP wedged ({wedge}) and playback did not stop'
            log(f'{prefix} protection DSP wedged after its last start ({wedge}); restarting it')
            running = False
    if not running:
        # A preloaded DSP that does not run (or is wedged): stop it before
        # loading again.
        if mixer.get_int(f'{prefix} DSP1 Preload Switch') == 1:
            mixer.set(f'{prefix} DSP1 Preload Switch', '0')
            deadline = time.monotonic() + DSP_STOP_SECONDS
            while core_running(mixer, prefix):
                if time.monotonic() > deadline:
                    return 'DSP did not stop'
                time.sleep(0.1)
        if mixer.set(f'{prefix} DSP1 Firmware', 'Protection') < 0:
            return 'could not select the Protection firmware'
        # Loads the wmfw and the .bin (tuning + this unit's calibration) and
        # starts the core; returns when the core runs or failed to.
        if mixer.set(f'{prefix} DSP1 Preload Switch', '1') < 0:
            return 'preload failed'
        started = True
        deadline = time.monotonic() + DSP_BOOT_SECONDS
        # The coefficient controls are added from a work item.
        while not dsp_running(mixer, prefix):
            if time.monotonic() > deadline:
                return 'DSP did not start (see dmesg: firmware)'
            time.sleep(0.1)
    cal = [mixer.get_be32(f'{prefix} {CSPL}{name}') for name in ('CAL_R', 'CAL_STATUS', 'CAL_CHECKSUM')]
    if cal != [cal_r, 1, cal_r + 1]:
        return f'calibration read back {cal}, expected {[cal_r, 1, cal_r + 1]}'
    # RUNNING, or MUTED while paused; wait out a re-initialisation.
    for _ in range(20):
        state = mixer.get_be32(f'{prefix} {CSPL}CSPL_STATE')
        if state in CSPL_ST_OK or state == CSPL_ST_ERROR or state is None:
            break
        time.sleep(0.05)
    error = mixer.get_be32(f'{prefix} {CSPL}CSPL_ERRORNO')
    if state not in CSPL_ST_OK or error != 0:
        return f'CSPL_STATE {state} CSPL_ERRORNO {error}'
    if started and config.get('music_delta', '0') == '1':
        failure = apply_music_delta(mixer, prefix, part)
        if failure:
            return failure
    log(f'{prefix} speaker protection running (CAL_R {cal_r}, CSPL_STATE {state}'
        f'{", started" if started else ""})')
    return None


def set_confirmed(mixer, name, value):
    """Write an integer or boolean control and read it back. Only for
    controls without a register (AMP Enable Switch): a read-back shows the
    driver's register cache, see attenuate()."""
    mixer.set(name, value)
    return mixer.get_int(name) == int(value)


def attenuate(mixer, prefix, attempts=3):
    """Digital PCM Volume at -12 dB, confirmed: True only when two writes that
    each change the value (NUDGE_VOLUME, then DIRECT_VOLUME) both succeeded
    and the control reads DIRECT_VOLUME. The read-back alone proves nothing:
    regmap updates its cache before the I2C write, so a failed write still
    reads back, and a retry of the same value would not reach the amplifier
    (the cache already matches). A changed value always does. Retried
    briefly: one I2C error should not mute a speaker until the next boot."""
    name = f'{prefix} Digital PCM Volume'
    for attempt in range(attempts):
        if attempt:
            time.sleep(CONFIRM_RETRY_SECONDS)
        if mixer.set(name, NUDGE_VOLUME) >= 0 and mixer.set(name, DIRECT_VOLUME) >= 0 and \
                mixer.get_int(name) == int(DIRECT_VOLUME):
            return True
    return False


def set_mux(mixer, prefix, control, value, via=None):
    """Set a DAPM mux and confirm it reached the amplifier: the put reports
    success even when the register write fails, which only shows in the
    kernel log ("ASoC: RCV DACPCM Source DAPM update failed"), and a failed
    write leaves the new value in the register cache, so setting it again
    writes nothing. Hence first via (another item), then value: the second
    write always changes the cached register and goes to the amplifier.
    Without via a no-op write can confirm a stale value. None, or why it is
    not confirmed."""
    items = (via, value) if via else (value,)
    marker = f'{prefix} {control} -> {" -> ".join(items)} ({time.monotonic_ns()})'
    log(marker)
    for item in items:
        if mixer.set(f'{prefix} {control}', item) < 0:
            return f'could not set {control}'
    messages = kernel_messages()
    if messages is None:
        return f'{control} not confirmed (kernel log unreadable)'
    marker = f'rog5-audio-route: {marker}'
    if marker not in messages:
        return f'{control} not confirmed (marker not in the kernel log)'
    # The mux change may pause and resume a running DSP (a stream through
    # DSP_TX1): a resume it missed leaves it paused (silent) or wedged.
    failures = (f'ASoC: {prefix} {control} DAPM',) + \
        dsp_failures(os.path.basename(amp_device(prefix) or prefix), prefix)
    for text in messages[len(messages) - messages[::-1].index(marker):]:
        if text.startswith('rog5-audio-route:'):
            continue
        if any(failure in text for failure in failures):
            return f'{control} {value} not confirmed ({text})'
    return None


class NotIsolated(str):
    """A failure after which the amplifier could not be muted either."""


def mute_amp(mixer, prefix, why):
    """Fail closed when -12 dB cannot be confirmed: amplifier off and its DAC
    fed zeros, so neither the direct path nor a stopped DSP can reach the
    speaker at a protected level. The DSP is left as it is. Returns the
    failure; a NotIsolated one when either step is not confirmed."""
    off = set_confirmed(mixer, f'{prefix} AMP Enable Switch', '0')
    # With the amplifier off, through DSP_TX1 (the protected path; nothing
    # from a stopped DSP) so that Zero is really written. Never through the
    # unprotected ASP_RX source at an unconfirmed level. Without "off" the
    # result is NotIsolated anyway.
    zero = set_mux(mixer, prefix, 'DACPCM Source', 'Zero', via='DSP_TX1' if off else None)
    log(f'FAIL {prefix} {why}: AMP Enable Switch {"off" if off else "NOT confirmed off"}, '
        f'DACPCM Source {zero or "Zero"}')
    if off and zero is None:
        return f'{prefix} {why} (amplifier muted)'
    return NotIsolated(f'{prefix} {why} (amplifier NOT isolated)')


def route_amp(mixer, prefix, part, direct, config, calibration, card=None):
    """Direct path or protection DSP for one amplifier, then its AMP Enable
    Switch; None, or what failed."""
    volume = f'{prefix} Digital PCM Volume'
    # -12 dB first, confirmed (an earlier run may have left 0 dB behind a
    # DSP, or alsactl restored it): nothing below may change the source, stop
    # a DSP or enable the amplifier otherwise.
    if not attenuate(mixer, prefix):
        return mute_amp(mixer, prefix, f'Digital PCM Volume not confirmed at {DIRECT_VOLUME}')
    reason = unavailable(prefix, part, config, calibration)
    device = amp_device(prefix)
    if reason is None:
        cal_r = int(calibration[f'{part}_cal_r'])
        if runtime_control(device, 'on') != 'on' or runtime_status(device) != 'active':
            reason = 'amplifier did not stay runtime-active'
        else:
            reason = start_protection(mixer, prefix, part, direct, cal_r, config, card)
        if reason is None:
            # Through Zero (a moment of silence at -12 dB) so that DSP_TX1 is written.
            reason = set_mux(mixer, prefix, 'DACPCM Source', 'DSP_TX1', via='Zero')
        if reason is None:
            if config.get('hibernate', '0') == '1':
                runtime_control(device, 'auto')
            # Full level only now that the DSP protects this speaker.
            if mixer.set(volume, PROTECTED_VOLUME) < 0:
                log(f'{prefix} protected, but Digital PCM Volume may stay at {DIRECT_VOLUME}')
            return enable_amp(mixer, prefix)
        log(f'FAIL {prefix} speaker protection: {reason}; direct path')
        reason = None
    # The direct path: -12 dB again, confirmed right before the switch (a
    # protection attempt never raises it), then stop a DSP left from an
    # earlier run or failure (awake: a hibernating DSP is woken by the stop
    # anyway).
    if not attenuate(mixer, prefix):
        return mute_amp(mixer, prefix, f'Digital PCM Volume not confirmed at {DIRECT_VOLUME}')
    failure = None
    if mixer.set(f'{prefix} DACPCM Source', direct) < 0:
        failure = f'{prefix} DACPCM Source'
    if mixer.get_int(f'{prefix} DSP1 Preload Switch') == 1:
        runtime_control(device, 'on')
        mixer.set(f'{prefix} DSP1 Preload Switch', '0')
    # No Preload control at all: a kernel without DSP support, nothing runs.
    if mixer.get_int(f'{prefix} DSP1 Preload Switch') not in (0, None) or \
            core_running(mixer, prefix):
        failure = failure or f'{prefix} DSP stop (still running, DACPCM {direct})'
    if runtime_control(device) == 'on':
        runtime_control(device, 'auto')
    if reason and reason != f'not enabled in {CONFIG_FILE}' and reason != 'firmware not installed':
        log(f'{prefix} speaker protection off: {reason}')
    # At -12 dB (confirmed above) the amplifier may play whatever the source.
    return enable_amp(mixer, prefix) or failure


def enable_amp(mixer, prefix):
    if mixer.set(f'{prefix} AMP Enable Switch', '1') < 0:
        return f'{prefix} AMP Enable Switch'
    return None


def cut_playback(mixer, failed):
    """An amplifier at an unconfirmed level that could not be muted: take
    MultiMedia1 off SENARY MI2S (an ADSP control, not on the amplifiers' I2C
    bus) and change nothing else."""
    if set_confirmed(mixer, PLAYBACK_MIXER, '0'):
        log('FAIL speaker route stopped: MultiMedia1 disconnected from both amplifiers')
        return failed
    log('FAIL speaker route stopped, and MultiMedia1 could NOT be disconnected')
    return failed + [PLAYBACK_MIXER]


def route_card(mixer, config, calibration, card=None):
    """Every amplifier at -12 dB (confirmed) before the shared route, then each
    amplifier's path, then the playback mixer; the controls that failed."""
    unsafe = [prefix for prefix, part, direct in AMPS if not attenuate(mixer, prefix)]
    failed = [mute_amp(mixer, prefix, f'Digital PCM Volume not confirmed at {DIRECT_VOLUME}')
              for prefix in unsafe]
    if any(isinstance(failure, NotIsolated) for failure in failed):
        return cut_playback(mixer, failed)
    failed += [name for name, value in ROUTE if mixer.set(name, value) < 0]
    for prefix, part, direct in AMPS:
        if prefix in unsafe:
            continue
        failure = route_amp(mixer, prefix, part, direct, config, calibration, card)
        if isinstance(failure, NotIsolated):
            return cut_playback(mixer, failed + [failure])
        if failure:
            failed.append(failure)
    if mixer.set(PLAYBACK_MIXER, '1') < 0:
        failed.append(PLAYBACK_MIXER)
    return failed


def find_card(asound):
    for index in range(8):
        name = ctypes.c_char_p()
        if asound.snd_card_get_longname(index, ctypes.byref(name)) == 0 and name.value.decode() == CARD_NAME:
            return index
    return None


def load_asound():
    asound = ctypes.CDLL('libasound.so.2')
    # These return void: without a restype, ctypes reads a stale register.
    for void in ('snd_ctl_elem_info_set_id', 'snd_ctl_elem_info_get_id', 'snd_ctl_elem_value_set_id',
                 'snd_ctl_elem_id_free', 'snd_ctl_elem_info_free', 'snd_ctl_elem_value_free',
                 'snd_ctl_elem_value_set_byte'):
        getattr(asound, void).restype = None
    asound.snd_ctl_elem_value_get_byte.restype = ctypes.c_ubyte
    asound.snd_ctl_elem_value_get_integer.restype = ctypes.c_long
    asound.snd_ctl_elem_value_get_enumerated.restype = ctypes.c_uint
    asound.snd_ctl_elem_info_get_count.restype = ctypes.c_uint
    asound.snd_ctl_elem_value_set_byte.argtypes = (ctypes.c_void_p, ctypes.c_uint, ctypes.c_ubyte)
    asound.snd_ctl_elem_value_get_byte.argtypes = (ctypes.c_void_p, ctypes.c_uint)
    asound.snd_ctl_elem_value_get_integer.argtypes = (ctypes.c_void_p, ctypes.c_uint)
    asound.snd_ctl_elem_value_get_enumerated.argtypes = (ctypes.c_void_p, ctypes.c_uint)
    return asound


def main():
    if sys.argv[1:] == ['--sanitize-alsa-state']:
        # Never fails the udev event, but never leaves an unchecked file for
        # alsactl either (unreadable, not text, ...).
        try:
            return sanitize_alsa_state(STATE_FILE)
        except Exception as e:  # noqa: BLE001
            quarantine_alsa_state(STATE_FILE, f'could not be checked ({e!r})')
            return 0
    # Not needed (nor loaded) for the sanitizer, which runs inside udevd.
    global ctypes
    import ctypes
    # rog5-audio.service and rog5-audio-route.service may both run this.
    lock = open(LOCK_FILE, 'w')
    fcntl.flock(lock, fcntl.LOCK_EX)
    asound = load_asound()
    card = None
    deadline = time.monotonic() + WAIT_SECONDS
    while card is None and time.monotonic() < deadline:
        card = find_card(asound)
        if card is None:
            time.sleep(1)
    if card is None:
        log(f'FAIL no {CARD_NAME} card after {WAIT_SECONDS}s')
        return 1
    handle = ctypes.c_void_p()
    rc = asound.snd_ctl_open(ctypes.byref(handle), f'hw:{card}'.encode(), 0)
    if rc < 0:
        log(f'FAIL open hw:{card}: {rc}')
        return 1
    mixer = Mixer(asound, handle)
    config = read_key_values(CONFIG_FILE)
    calibration = read_key_values(f'{SPEAKER_DIR}/calibration')
    failed = route_card(mixer, config, calibration, card)
    capture = [mixer.set(name, value) for name, value in CAPTURE]
    asound.snd_ctl_close(handle)
    if all(rc == 0 for rc in capture):
        log(f'hw:{card} microphones routed to MultiMedia3 (PCM 3)')
    elif any(rc == 0 for rc in capture):
        log('FAIL microphone route incomplete')
    if failed:
        log('FAIL could not set ' + ', '.join(failed))
        return 1
    log(f'hw:{card} MultiMedia1 routed to both speakers')
    return 0


if __name__ == '__main__':
    sys.exit(main())
