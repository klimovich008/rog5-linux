#!/bin/sh
set -u

bb=/bin/busybox

log() {
	printf 'rog5-standalone-exitrd: %s\n' "$*" >/dev/kmsg 2>/dev/null ||
		printf 'rog5-standalone-exitrd: %s\n' "$*" >/dev/console 2>/dev/null ||
		true
}

move_mount() {
	source=$1 target=$2
	[ -d "$source" ] || return 0
	"$bb" mountpoint -q "$source" || return 0
	"$bb" mkdir -p "$target" || return 1
	"$bb" mount --move "$source" "$target" || return 1
}

unmount_mount() {
	"$bb" mountpoint -q "$1" || return 0
	"$bb" umount "$1" || return 1
}

lazy_unmount() {
	"$bb" mountpoint -q "$1" || return 0
	"$bb" umount -l "$1" 2>/dev/null || true
}

detach_persistent_state() {
	record=/oldsys/run/rog5-persistent-state.runtime
	[ -f "$record" ] && [ ! -L "$record" ] || return 0
	loop_device=$($bb sed -n 's/^loop=//p' "$record") || return 1
	case $loop_device in /dev/loop[0-9]*) ;; *) return 1 ;; esac
	loop_device=/oldsys/dev/${loop_device#/dev/}
	unmount_mount /oldroot/persist || return 1
	[ -b "$loop_device" ] || return 1
	"$bb" losetup -d "$loop_device" || return 1
	unmount_mount /oldroot/.rog5/userdata-rw || return 1
	for sys_block in /oldsys/sys/class/block/sd*; do
		[ -e "$sys_block/dev" ] || continue
		device=/oldsys/dev/$("$bb" basename "$sys_block")
		[ -b "$device" ] || return 1
		"$bb" blockdev --setro "$device" || return 1
	done
}

try_native_kexec() {
	# Only a RAM trial stages this syscall-only helper and its verified digest.
	# An ordinary reboot, incomplete teardown or missing tool must reboot V11.
	[ "${1:-}" = kexec ] && [ "$clean" = 1 ] || return 0
	[ -f /rog5-kexec-exec ] && [ ! -L /rog5-kexec-exec ] &&
		[ -x /rog5-kexec-exec ] || return 0
	[ -f /rog5-kexec-exec.sha256 ] && [ ! -L /rog5-kexec-exec.sha256 ] || return 0
	(cd / && "$bb" sha256sum -c rog5-kexec-exec.sha256) || return 0
	/rog5-kexec-exec
	# Any return is failure, including status zero. Never retry the target.
}

log 'discarding volatile root before standalone restart'
"$bb" mount -o remount,rw / 2>/dev/null || true
"$bb" mkdir -p /oldsys

clean=1
move_mount /oldroot/.rog5/root-ro /oldsys/root-ro || clean=0
move_mount /oldroot/.rog5/userdata-ro /oldsys/userdata-ro || clean=0
move_mount /oldroot/.rog5/state /oldsys/state || clean=0
for api in sys proc run dev; do
	move_mount "/oldroot/$api" "/oldsys/$api" || clean=0
done
detach_persistent_state || clean=0
unmount_mount /oldroot || clean=0
unmount_mount /oldsys/state || clean=0
unmount_mount /oldsys/root-ro || clean=0
unmount_mount /oldsys/userdata-ro || clean=0

if [ "$clean" -ne 1 ]; then
	log 'clean teardown incomplete; detaching residual mounts'
	lazy_unmount /oldroot/persist
	lazy_unmount /oldroot/.rog5/userdata-rw
	lazy_unmount /oldroot
	lazy_unmount /oldsys/state
	lazy_unmount /oldsys/root-ro
	lazy_unmount /oldsys/userdata-ro
fi
for api in run dev sys proc; do
	lazy_unmount "/oldsys/$api"
done

try_native_kexec "${1:-}" || true
log 'requesting storage-quiescent normal restart'
"$bb" reboot -f 2>/dev/null || true
log 'normal restart returned; triggering emergency reset'
printf b >/proc/sysrq-trigger 2>/dev/null || true
while :; do "$bb" sleep 3600; done
