#!/bin/sh
set -eu

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

fail() {
	echo "rog5-p2-attest: FAIL $*" >/dev/kmsg
	exit 1
}

expected_physical_count=116
expected_seal_sha256=e201955dead61a04ca0e70d67fcea18750940330421334c91cfe2c760e7fb3ff
expected_tree_sha256=b71eccbe5275f8d125a6d3251fff166b57f196c23984b845e31666ecaaea9a8c
lower=/.rog5/userdata-ro/rog5/roots/arch-a
userdata_record=/run/rog5-p2-userdata-device

[ -f "$userdata_record" ] && [ ! -L "$userdata_record" ] &&
	[ "$(stat -c %a "$userdata_record")" = 444 ] ||
	fail 'resolved userdata identity record is absent'
IFS= read -r userdata <"$userdata_record" ||
	fail 'resolved userdata identity record is unreadable'
case $userdata in /dev/sd[a-z]23) ;; *) fail 'resolved userdata node is unsafe' ;; esac
userdata_name=${userdata##*/}
[ -b "$userdata" ] && [ -e "/sys/class/block/$userdata_name/partition" ] ||
	fail 'resolved userdata device disappeared'

[ -e /run/rog5-p2-root-mounted ] ||
	fail 'initramfs handoff marker is absent'
grep -Fxq \
	"PASS persistent root matches anchored seal entries=181242 tree_sha256=$expected_tree_sha256" \
	/run/rog5-p2-root-verification.txt ||
	fail 'initramfs root verification record changed'
[ "$(sha256sum "$lower/.rog5-persistent-seal" | cut -d ' ' -f 1)" = \
	"$expected_seal_sha256" ] ||
	fail 'mounted lower seal changed after handoff'
[ ! -e /.rog5/userdata-ro/rog5/state/good ] ||
	fail 'unbooted root was promoted'
[ ! -e /.rog5/userdata-ro/rog5/state/next ] ||
	fail 'unbooted root was selected'

awk '$1 == "overlay" && $2 == "/" && $3 == "overlay" &&
	$4 ~ /(^|,)rw(,|$)/ { found++ }
	END { exit found != 1 }' /proc/mounts ||
	fail 'active root is not a writable volatile overlay'
awk -v userdata="$userdata" '$1 == userdata && $2 == "/.rog5/userdata-ro" &&
	$3 == "ext4" && $4 ~ /(^|,)ro(,|$)/ { found++ }
	END { exit found != 1 }' /proc/mounts ||
	fail 'userdata backing mount is not the exact read-only ext4 partition'
awk '$1 == "tmpfs" && $2 == "/.rog5/state" && $3 == "tmpfs" &&
	$4 ~ /(^|,)rw(,|$)/ { found++ }
	END { exit found != 1 }' /proc/mounts ||
	fail 'overlay state is not writable tmpfs'

block_mounts=0
expected_device=$(cat "/sys/class/block/$userdata_name/dev")
while read -r _ _ device _ mountpoint _ rest; do
	[ -e "/sys/dev/block/$device" ] || continue
	block_mounts=$((block_mounts + 1))
	[ "$device" = "$expected_device" ] &&
		[ "$mountpoint" = /.rog5/userdata-ro ] ||
		fail "unexpected block-backed mount: $mountpoint"
done </proc/self/mountinfo
[ "$block_mounts" -eq 1 ] ||
	fail 'physical block-backed mount count changed'

physical_count=0
for sys_disk in /sys/class/block/*; do
	[ -e "$sys_disk/device" ] || continue
	[ ! -e "$sys_disk/partition" ] || continue
	disk=$(basename "$sys_disk")
	for sys_block in "$sys_disk" "$sys_disk"/"$disk"*; do
		[ -e "$sys_block/dev" ] || continue
		[ "$sys_block" = "$sys_disk" ] ||
			[ -e "$sys_block/partition" ] || continue
		device=/dev/$(basename "$sys_block")
		[ -b "$device" ] || fail "missing block node: $device"
		[ "$(cat "$sys_block/ro")" = 1 ] ||
			fail "writable sysfs block state: $device"
		[ "$(blockdev --getro "$device")" = 1 ] ||
			fail "writable block ioctl state: $device"
		physical_count=$((physical_count + 1))
	done
done
[ "$physical_count" -eq "$expected_physical_count" ] ||
	fail 'physical topology count changed'

blocked_query_count=$(dmesg |
	grep -F -c 'ROG5 UFS discovery: blocked device query' || true)
blocked_scsi_count=$(dmesg |
	grep -F -c 'ROG5 UFS discovery: blocked SCSI opcode' || true)
journal_recovery_count=$(dmesg |
	grep -E -i -c 'EXT4-fs.*(journal recovery|recovery complete|recovering journal)' ||
	true)
ufs_error_count=$(dmesg |
	grep -E -i -c '(ufshcd|ufshcd-qcom|scsi|sd [0-9]).*(fatal|abort|reset|I/O error|timed out)' ||
	true)
[ "$blocked_query_count" -eq 0 ] ||
	fail 'blocked device query appeared'
[ "$blocked_scsi_count" -eq 0 ] ||
	fail 'blocked SCSI opcode appeared'
[ "$journal_recovery_count" -eq 0 ] ||
	fail 'ext4 journal recovery appeared'
[ "$ufs_error_count" -eq 0 ] ||
	fail 'UFS or SCSI error appeared'

ip -o -4 address show dev usb0 |
	grep -Fq '169.254.77.2/30' ||
	fail 'USB management address is absent'
systemctl is-active --quiet sshd.service ||
	fail 'strict SSH service is not active'
sshd -T | grep -Fqx 'passwordauthentication no' ||
	fail 'SSH password authentication is enabled'
sshd -T | grep -Eq '^permitrootlogin (without-password|prohibit-password)$' ||
	fail 'SSH root policy changed'
sshd -T | grep -Fqx 'pubkeyauthentication yes' ||
	fail 'SSH public-key authentication is disabled'
[ -s /etc/ssh/ssh_host_ed25519_key ] &&
	[ "$(stat -c %a /etc/ssh/ssh_host_ed25519_key)" = 600 ] ||
	fail 'volatile SSH host identity is absent'

backlight_count=0
for brightness in /sys/class/backlight/*/brightness; do
	[ -e "$brightness" ] || continue
	backlight_count=$((backlight_count + 1))
	[ "$(cat "$brightness")" = 0 ] ||
		fail 'a physical backlight is on'
done

temporary=/run/.rog5-p2-ready.$$
trap 'rm -f -- "$temporary"' EXIT HUP INT TERM
{
	printf '%s\n' 'status=PASS'
	printf '%s\n' "kernel=$(uname -r)"
	printf '%s\n' "physical_blocks=$physical_count"
	printf '%s\n' 'block_backed_mounts=1'
	printf '%s\n' 'userdata_mount=ro-noload'
	printf '%s\n' 'root=overlay-tmpfs'
	printf '%s\n' "blocked_device_queries=$blocked_query_count"
	printf '%s\n' "blocked_scsi_commands=$blocked_scsi_count"
	printf '%s\n' "journal_recovery_events=$journal_recovery_count"
	printf '%s\n' "ufs_error_events=$ufs_error_count"
	printf '%s\n' "backlights=$backlight_count"
	printf '%s\n' 'ssh=strict-key-only'
} >"$temporary"
chmod 0444 "$temporary"
mv -T -- "$temporary" /run/rog5-p2-ready
trap - EXIT HUP INT TERM

echo 'rog5-p2-attest: PASS read-only persistent Arch root ready' >/dev/kmsg
