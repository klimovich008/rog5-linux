#!/bin/sh
set -u

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mkdir -p /dev/pts /run /sys/kernel/config /var/log
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
echo /sbin/mdev >/proc/sys/kernel/hotplug
hostname rog5-network-root
mdev -s

log() {
	echo "rog5-network-root: $*" >/dev/kmsg
}

force_rollback() {
	(
		sleep 5
		while :; do
			log 'forced reboot still active; using emergency reset'
			echo b >/proc/sysrq-trigger 2>/dev/null || true
			sleep 5
		done
	) &
	reboot -f &
	while :; do sleep 3600; done
}

physical_topology_count() {
	count=0
	for sys_disk in /sys/class/block/*; do
		[ -e "$sys_disk/device" ] || continue
		[ ! -e "$sys_disk/partition" ] || continue
		count=$((count + 1))
	done
	printf '%s\n' "$count"
}

has_block_backed_mount() {
	while read -r _ _ device _ mountpoint _ rest; do
		[ -e "/sys/dev/block/$device" ] || continue
		log "block-backed mount detected at $mountpoint"
		return 0
	done </proc/self/mountinfo
	return 1
}

verify_no_phone_storage() {
	has_block_backed_mount && return 1
	mdev -s || return 1
	physical_count=$(physical_topology_count)
	[ "$physical_count" -eq 0 ] || {
		log "physical block device appeared with UFS-disabled DTB; count=$physical_count"
		return 1
	}
	return 0
}

arm_watchdog() {
	(
		exec 8>/dev/kmsg
		exec 9>/proc/sysrq-trigger
		sleep "$recovery_timeout"
		echo 'rog5-network-root: watchdog expired; using emergency reset' >&8
		echo b >&9
	) &
	echo $! >/run/rog5-network-root-watchdog.pid
	log "network-root watchdog armed for $recovery_timeout seconds"
}

configure_usb() {
	usb_mode=/sys/bus/platform/devices/a600000.ssusb/mode
	[ ! -e "$usb_mode" ] || echo peripheral >"$usb_mode" || return 1
	mount -t configfs configfs /sys/kernel/config || return 1

	gadget=/sys/kernel/config/usb_gadget/rog5-network-root
	mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409"
	echo 0x1d6b >"$gadget/idVendor"
	echo 0x0104 >"$gadget/idProduct"
	echo 0xef >"$gadget/bDeviceClass"
	echo 0x02 >"$gadget/bDeviceSubClass"
	echo 0x01 >"$gadget/bDeviceProtocol"
	echo Linux >"$gadget/strings/0x409/manufacturer"
	echo 'ROG5 network root' >"$gadget/strings/0x409/product"
	echo 'NFS root over NCM' \
		>"$gadget/configs/c.1/strings/0x409/configuration"
	mkdir -p "$gadget/functions/ncm.usb0"
	ln -s "$gadget/functions/ncm.usb0" "$gadget/configs/c.1/ncm.usb0"
	mdev -s || return 1

	udc=
	attempt=0
	while [ "$attempt" -lt 200 ] && [ -z "$udc" ]; do
		for candidate in /sys/class/udc/*; do
			[ -e "$candidate" ] || continue
			case $(basename "$candidate") in
				*a600000*) udc=$(basename "$candidate"); break ;;
			esac
			[ -n "$udc" ] || udc=$(basename "$candidate")
		done
		[ -n "$udc" ] || sleep 0.1
		attempt=$((attempt + 1))
	done
	[ -n "$udc" ] || return 1
	echo "$udc" >"$gadget/UDC" || return 1

	attempt=0
	while [ "$attempt" -lt 100 ] && [ ! -e /sys/class/net/usb0 ]; do
		sleep 0.1
		attempt=$((attempt + 1))
	done
	[ -e /sys/class/net/usb0 ] || return 1
	ip link set usb0 up || return 1
	ip address add 169.254.77.2/30 dev usb0 || return 1

	attempt=0
	while [ "$attempt" -lt 100 ]; do
		[ "$(cat /sys/class/net/usb0/carrier 2>/dev/null || echo 0)" = 1 ] &&
			return 0
		sleep 0.1
		attempt=$((attempt + 1))
	done
	return 1
}

mount_network_root() {
	mkdir -p /mnt/root-ro /mnt/state /newroot
	attempt=0
	while [ "$attempt" -lt 30 ]; do
		if mount -t nfs4 \
			-o vers=4.2,proto=tcp,port=2049,ro,nolock,soft,timeo=10,retrans=1 \
			169.254.77.1:/ /mnt/root-ro; then
			break
		fi
		attempt=$((attempt + 1))
		sleep 1
	done
	mountpoint -q /mnt/root-ro || return 1
	awk '$2 == "/mnt/root-ro" && $4 ~ /(^|,)ro(,|$)/ { found=1 }
		END { exit !found }' /proc/mounts || return 1

	mount -t tmpfs -o nodev,nosuid,mode=0755,size=2048m \
		tmpfs /mnt/state || return 1
	mkdir -p /mnt/state/upper /mnt/state/work
	mount -t overlay overlay \
		-o lowerdir=/mnt/root-ro,upperdir=/mnt/state/upper,workdir=/mnt/state/work \
		/newroot || return 1
	[ -x /newroot/sbin/init ] || return 1
	return 0
}

prepare_shutdown_root() {
	exitrd=/run/initramfs

	mkdir -p "$exitrd/bin" "$exitrd/lib" "$exitrd/dev" "$exitrd/proc" \
		"$exitrd/sys" "$exitrd/run" "$exitrd/oldroot" "$exitrd/oldsys" ||
		return 1
	cp -p /bin/busybox "$exitrd/bin/busybox" || return 1
	cp -p /lib/ld-musl-aarch64.so.1 \
		"$exitrd/lib/ld-musl-aarch64.so.1" || return 1
	ln -s ld-musl-aarch64.so.1 \
		"$exitrd/lib/libc.musl-aarch64.so.1" || return 1
	ln -s busybox "$exitrd/bin/sh" || return 1
	cp -p /shutdown "$exitrd/shutdown" || return 1
	chroot "$exitrd" /bin/sh -n /shutdown || return 1
	touch /run/rog5-network-root-exitrd-ready
	return 0
}

recovery_timeout=600
netroot_count=0
netroot_invalid=0
for argument in $(cat /proc/cmdline); do
	case $argument in
		rog5.netroot=1) netroot_count=$((netroot_count + 1)) ;;
		rog5.netroot=*) netroot_invalid=1 ;;
		rog5.recovery_timeout=*) recovery_timeout=${argument#*=} ;;
	esac
done
case $recovery_timeout in *[!0-9]*|'') recovery_timeout=600 ;; esac
if [ "$recovery_timeout" -lt 60 ] || [ "$recovery_timeout" -gt 900 ]; then
	recovery_timeout=600
fi
if [ "$netroot_count" -ne 1 ] || [ "$netroot_invalid" -ne 0 ]; then
	log 'invalid network-root command line; rebooting'
	force_rollback
fi

if ! verify_no_phone_storage; then
	log 'phone-storage exclusion failed before USB; rebooting'
	force_rollback
fi
physical_count=$(physical_topology_count)
[ "$physical_count" -eq 0 ] || {
	log 'physical block device appeared with UFS-disabled DTB'
	force_rollback
}

arm_watchdog

configure_usb
usb_status=$?
if [ "$usb_status" -ne 0 ]; then
	log 'USB network-root transport failed; rebooting'
	force_rollback
fi

mount_network_root
root_status=$?
if [ "$root_status" -ne 0 ]; then
	log 'read-only NFS root or tmpfs overlay failed; rebooting'
	force_rollback
fi

if ! verify_no_phone_storage; then
	log 'phone-storage exclusion failed before switch_root; rebooting'
	force_rollback
fi

if ! prepare_shutdown_root; then
	log 'shutdown initramfs preparation failed; rebooting'
	force_rollback
fi

mkdir -p /newroot/.rog5/root-ro /newroot/.rog5/state \
	/newroot/dev /newroot/proc /newroot/sys /newroot/run
printf '%s\n' 0 >/run/rog5-physical-block-count
printf '%s\n' '169.254.77.1:/' >/run/rog5-network-root-source
touch /run/rog5-network-root-mounted

mount --move /mnt/root-ro /newroot/.rog5/root-ro
mount --move /mnt/state /newroot/.rog5/state
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /run /newroot/run

exec switch_root /newroot /sbin/init
