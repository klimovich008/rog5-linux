[Unit]
Description=Publish one bounded post-switch ROG5 display observation
DefaultDependencies=no
Before=basic.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/run/rog5-native-wifi/display-post-switch-report send
TimeoutStartSec=90s

[Install]
WantedBy=sysinit.target
