#!/bin/sh
set -eu
set -f

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
expected_release=@EXPECTED_KERNEL_RELEASE@
expected_bundle=@EXPECTED_BUNDLE@
expected_udc=a600000.usb
reboot_helper=/usr/libexec/rog5-reboot-bootloader

return_bootloader() {
	sync || true
	"$reboot_helper" || true
	while :; do sleep 3600; done
}

delayed_return() {
	sleep "$1"
	return_bootloader
}

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
echo /sbin/mdev >/proc/sys/kernel/hotplug 2>/dev/null || :
mdev -s || :

(
	sleep 120
	return_bootloader
) &

attempt=0
while [ "$attempt" -lt 200 ] && [ ! -e "/sys/class/udc/$expected_udc" ]; do
	attempt=$((attempt + 1))
	sleep 0.1
done
[ -e "/sys/class/udc/$expected_udc" ] || delayed_return 5

extra_count=0
extra_name=
for candidate in /sys/class/udc/*; do
	[ -e "$candidate" ] || continue
	name=$(basename "$candidate")
	[ "$name" = "$expected_udc" ] && continue
	extra_count=$((extra_count + 1))
	extra_name=$name
done
[ "$extra_count" -ne 0 ] || delayed_return 10
[ "$extra_count" -eq 1 ] || delayed_return 70
case $extra_name in
	a800000.usb) delayed_return 15 ;;
	a600000.dwc3) delayed_return 20 ;;
	a800000.dwc3) delayed_return 25 ;;
	ci_hdrc.*) delayed_return 30 ;;
	musb*|*.musb) delayed_return 35 ;;
	dwc2*|*.dwc2) delayed_return 40 ;;
	dummy_udc.*) delayed_return 45 ;;
	*.usb) delayed_return 50 ;;
	*.dwc3) delayed_return 55 ;;
	*) delayed_return 60 ;;
esac
