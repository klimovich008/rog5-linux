#!/bin/sh
set -u

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mkdir -p /dev/pts /var/log /sys/kernel/config
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
echo /sbin/mdev > /proc/sys/kernel/hotplug
hostname rog5-recovery

log() {
	echo "rog5-recovery: $*" >/dev/kmsg
}

force_rollback() {
	(
		sleep 5
		while :; do
			log 'orderly forced reboot still active; using emergency reset'
			echo b >/proc/sysrq-trigger 2>/dev/null || true
			sleep 5
		done
	) &
	reboot -f &
	while :; do sleep 3600; done
}

isolate_storage() {
	while read -r _ _ device _ mountpoint _ rest; do
		[ -e "/sys/dev/block/$device" ] || continue
		log "block-backed mount detected at $mountpoint"
		return 1
	done </proc/self/mountinfo

	count=0
	for sys_disk in /sys/class/block/*; do
		[ -e "$sys_disk/device" ] || continue
		[ ! -e "$sys_disk/partition" ] || continue
		disk=$(basename "$sys_disk")
		for sys_block in "$sys_disk" "$sys_disk"/"$disk"*; do
			[ -e "$sys_block/dev" ] || continue
			[ "$sys_block" = "$sys_disk" ] ||
				[ -e "$sys_block/partition" ] || continue
			device=/dev/$(basename "$sys_block")
			[ -b "$device" ] || {
				log "missing physical block node: $device"
				return 1
			}
			blockdev --setro "$device" || {
				log "failed to lock physical block device: $device"
				return 1
			}
			[ "$(blockdev --getro "$device")" = 1 ] || {
				log "physical block device remains writable: $device"
				return 1
			}
			count=$((count + 1))
		done
	done
	printf '%s\n' "$count" >/run/rog5-physical-block-count
	log "storage isolation ready; read-only physical block devices=$count"
}

physical_topology_count() {
	count=0
	for sys_disk in /sys/class/block/*; do
		[ -e "$sys_disk/device" ] || continue
		[ ! -e "$sys_disk/partition" ] || continue
		disk=$(basename "$sys_disk")
		for sys_block in "$sys_disk" "$sys_disk"/"$disk"*; do
			[ -e "$sys_block/dev" ] || continue
			[ "$sys_block" = "$sys_disk" ] ||
				[ -e "$sys_block/partition" ] || continue
			count=$((count + 1))
		done
	done
	printf '%s\n' "$count"
}

wait_for_ufs_discovery() {
	attempt=0
	stable=0
	previous=-1
	while [ "$attempt" -lt 450 ]; do
		mdev -s || return 1
		count=$(physical_topology_count)
		if [ "$count" -gt 0 ] && [ "$count" = "$previous" ]; then
			stable=$((stable + 1))
		else
			stable=0
		fi
		[ "$stable" -ge 20 ] && return 0
		previous=$count
		attempt=$((attempt + 1))
		sleep 0.1
	done
	log 'UFS discovery did not enumerate a physical disk'
	return 1
}

verify_ufs_power_containment() {
	auto_marker='ROG5 UFS discovery: auto-hibern8 disabled; link remains active'
	host_marker='ROG5 UFS discovery: host runtime PM forbidden; active reference retained'
	wlun_marker='ROG5 UFS discovery: WLUN runtime PM forbidden'
	attempt=0
	auto_count=0
	host_count=0
	wlun_count=0
	while [ "$attempt" -lt 100 ]; do
		auto_count=$(dmesg | grep -F -c "$auto_marker" || true)
		host_count=$(dmesg | grep -F -c "$host_marker" || true)
		wlun_count=$(dmesg | grep -F -c "$wlun_marker" || true)
		if [ "$auto_count" -gt 0 ] &&
			[ "$host_count" -gt 0 ] &&
			[ "$wlun_count" -gt 0 ]; then
			break
		fi
		attempt=$((attempt + 1))
		sleep 0.1
	done
	if [ "$auto_count" -eq 0 ] ||
		[ "$host_count" -eq 0 ] ||
		[ "$wlun_count" -eq 0 ]; then
		log "UFS power-containment marker missing; auto=$auto_count host=$host_count wlun=$wlun_count"
		return 1
	fi

	blocked_query_count=$(dmesg |
		grep -F -c 'ROG5 UFS discovery: blocked device query' || true)
	blocked_scsi_count=$(dmesg |
		grep -F -c 'ROG5 UFS discovery: blocked SCSI opcode' || true)
	printf '%s\n' "$blocked_query_count" >/run/rog5-ufs-blocked-query-count
	printf '%s\n' "$blocked_scsi_count" >/run/rog5-ufs-blocked-scsi-count
	if [ "$blocked_query_count" -ne 0 ] || [ "$blocked_scsi_count" -ne 0 ]; then
		log "UFS discovery blocked an unexpected command; queries=$blocked_query_count SCSI=$blocked_scsi_count"
		return 1
	fi
	log 'UFS power containment ready; blocked queries=0 blocked SCSI=0'
}

write_ufs_inventory() {
	inventory=/run/rog5-ufs-inventory.tsv
	printf 'name\tkind\tpartition_number\tpartition_name\tmajor_minor\tread_only\tstart_sectors\tsize_sectors\tlogical_block_bytes\tsysfs_path\n' \
			>"$inventory"
	for sys_disk in /sys/class/block/*; do
		[ -e "$sys_disk/device" ] || continue
		[ ! -e "$sys_disk/partition" ] || continue
		disk=$(basename "$sys_disk")
		logical_block_bytes=$(cat "$sys_disk/queue/logical_block_size")
		for sys_block in "$sys_disk" "$sys_disk"/"$disk"*; do
			[ -e "$sys_block/dev" ] || continue
			if [ "$sys_block" = "$sys_disk" ]; then
				kind=disk
				partition_number=0
				partition_name=-
				start=0
			else
				[ -e "$sys_block/partition" ] || continue
				kind=partition
				partition_number=$(cat "$sys_block/partition")
				partition_name=$(sed -n 's/^PARTNAME=//p' "$sys_block/uevent" |
					sed -n '1p')
				[ -n "$partition_name" ] || partition_name=-
				start=$(cat "$sys_block/start")
			fi
			name=$(basename "$sys_block")
			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
				"$name" "$kind" "$partition_number" "$partition_name" \
				"$(cat "$sys_block/dev")" \
				"$(cat "$sys_block/ro")" "$start" \
				"$(cat "$sys_block/size")" "$logical_block_bytes" \
				"$(readlink -f "$sys_block")" \
				>>"$inventory"
		done
	done
	[ "$(wc -l <"$inventory")" -gt 1 ]
}

serve_acm() {
	while :; do
		while [ ! -c /dev/ttyGS0 ]; do sleep 0.1; done
		log 'starting ACM shell'
		setsid sh -c 'exec sh -i <>/dev/ttyGS0 >&0 2>&0' || true
		log 'ACM shell exited; restarting'
		sleep 1
	done
}

release=$(uname -r)
log "userspace started on $release"
case $release in
	5.4.*)
		if [ -d /lib/modules/5.4-gki ]; then
			[ -e "/lib/modules/$release" ] || ln -s 5.4-gki "/lib/modules/$release"
			while read -r module; do
				modprobe "${module%.ko}" || insmod "/lib/modules/5.4-gki/$module" ||
					log "optional module failed: ${module%.ko}"
			done </lib/modules/5.4-gki/modules.load
			mdev -s
		fi
		;;
esac

timeout=180
device_cidr=
gateway=
ufs_discovery=0
ufs_discovery_count=0
ufs_discovery_invalid=0
for argument in $(cat /proc/cmdline); do
	case $argument in
		rog5.recovery_timeout=*) timeout=${argument#*=} ;;
		rog5.recovery_cidr=*) device_cidr=${argument#*=} ;;
		rog5.recovery_gateway=*) gateway=${argument#*=} ;;
		rog5.ufs_discovery=*)
			ufs_discovery_count=$((ufs_discovery_count + 1))
			if [ "$argument" = rog5.ufs_discovery=1 ]; then
				ufs_discovery=1
			else
				ufs_discovery_invalid=1
			fi
			;;
	esac
done
case $timeout in *[!0-9]*|'') timeout=180 ;; esac
if [ "$timeout" -lt 30 ] || [ "$timeout" -gt 900 ]; then
	timeout=180
fi
touch /run/rog5-recovery-armed
(
	sleep "$timeout"
	[ -e /run/rog5-recovery-armed ] || exit 0
	log 'rollback timer expired; rebooting'
	force_rollback
) &
echo $! >/run/rog5-recovery-watchdog.pid
log 'rollback timer armed'

if [ "$ufs_discovery_count" -gt 1 ] || [ "$ufs_discovery_invalid" = 1 ]; then
	log 'invalid UFS discovery command line; rebooting'
	force_rollback
fi
if [ "$ufs_discovery" = 1 ]; then
	if [ ! -r /proc/config.gz ] ||
		! gzip -dc /proc/config.gz |
			grep -qx 'CONFIG_SCSI_UFS_DISCOVERY_READ_ONLY=y'; then
		log 'dedicated UFS discovery kernel attestation failed; rebooting'
		force_rollback
	fi
	log 'waiting for stable UFS discovery'
	if ! wait_for_ufs_discovery; then
		log 'UFS discovery failed; rebooting'
		force_rollback
	fi
	if ! verify_ufs_power_containment; then
		log 'UFS power containment failed; rebooting'
		force_rollback
	fi
fi

if ! isolate_storage; then
	log 'storage isolation failed; rebooting'
	force_rollback
fi
if [ "$ufs_discovery" = 1 ]; then
	[ "$(cat /run/rog5-physical-block-count)" -gt 0 ] || {
		log 'UFS discovery did not enumerate a physical disk'
		force_rollback
	}
	if ! write_ufs_inventory; then
		log 'UFS sysfs inventory failed; rebooting'
		force_rollback
	fi
	log 'UFS sysfs-only inventory ready'
fi

usb_mode=/sys/bus/platform/devices/a600000.ssusb/mode
[ -e "$usb_mode" ] && echo peripheral >"$usb_mode"

if ! mount -t configfs configfs /sys/kernel/config; then
	log 'configfs unavailable; rollback timer remains armed'
	while :; do sleep 3600; done
fi
log 'configfs ready'
gadget=/sys/kernel/config/usb_gadget/rog5-recovery
mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409"
echo 0x1d6b >"$gadget/idVendor"
echo 0x0104 >"$gadget/idProduct"
echo 0xef >"$gadget/bDeviceClass"
echo 0x02 >"$gadget/bDeviceSubClass"
echo 0x01 >"$gadget/bDeviceProtocol"
echo Linux >"$gadget/strings/0x409/manufacturer"
echo 'ROG5 recovery' >"$gadget/strings/0x409/product"
echo 'NCM and ACM recovery' >"$gadget/configs/c.1/strings/0x409/configuration"
mkdir -p "$gadget/functions/ncm.usb0" "$gadget/functions/acm.usb0"
ln -s "$gadget/functions/ncm.usb0" "$gadget/configs/c.1/ncm.usb0"
ln -s "$gadget/functions/acm.usb0" "$gadget/configs/c.1/acm.usb0"
if ! mdev -s; then
	log 'device-node rescan failed; rollback timer remains armed'
	force_rollback
fi
[ -c /dev/ttyGS0 ] || {
	log 'ACM device node missing after rescan; rollback timer remains armed'
	force_rollback
}
if ! isolate_storage; then
	log 'storage isolation failed after device-node rescan; rebooting'
	force_rollback
fi
if [ "$ufs_discovery" = 1 ] &&
	! verify_ufs_power_containment; then
	log 'UFS power containment failed after device-node rescan; rebooting'
	force_rollback
fi
serve_acm &
echo $! >/run/rog5-recovery-acm.pid
log 'gadget functions configured'

udc=
attempt=0
log 'waiting for USB device controller'
while [ "$attempt" -lt 200 ] && [ -z "$udc" ]; do
	for candidate in /sys/class/udc/*; do
		[ -e "$candidate" ] || continue
		case $(basename "$candidate") in
			*a600000*) udc=$(basename "$candidate"); break ;;
		esac
		[ -n "$udc" ] || udc=$(basename "$candidate")
	done
	[ -n "$udc" ] || sleep 0.1
	attempt=$((attempt + 1))
done

if [ -n "$udc" ]; then
	echo "$udc" >"$gadget/UDC"
	soft_connect="/sys/class/udc/$udc/soft_connect"
	if [ -w "$soft_connect" ]; then
		if echo disconnect >"$soft_connect" &&
			sleep 1 &&
			echo connect >"$soft_connect"; then
			log 'forced a clean USB reconnect'
		else
			log 'failed to force a clean USB reconnect'
		fi
	fi
	attempt=0
	while [ "$attempt" -lt 100 ] && [ ! -e /sys/class/net/usb0 ]; do
		sleep 0.1
		attempt=$((attempt + 1))
	done
	if [ -e /sys/class/net/usb0 ]; then
		ip link set usb0 up
		case $device_cidr in
			''|*[!0-9a-fA-F:./]*) udhcpc -n -q -t 5 -i usb0 >/var/log/udhcpc.log 2>&1 || true ;;
			*) ip address add "$device_cidr" dev usb0 ;;
		esac
		case $gateway in
			''|*[!0-9a-fA-F:.]*) ;;
			*) ip route replace default via "$gateway" dev usb0 ;;
		esac
		attempt=0
		while [ "$attempt" -lt 100 ]; do
			udc_state=$(cat "/sys/class/udc/$udc/state" 2>/dev/null || echo unknown)
			carrier=$(cat /sys/class/net/usb0/carrier 2>/dev/null || echo unknown)
			if [ "$udc_state" = configured ] || [ "$carrier" = 1 ]; then
				break
			fi
			sleep 0.1
			attempt=$((attempt + 1))
		done
		log "USB recovery network interface is ready; state=$udc_state carrier=$carrier"
	fi
else
	log 'no USB device controller found'
fi

if [ -s /root/.ssh/authorized_keys ]; then
	mkdir -p /run/sshd
	rm -f /etc/ssh/ssh_host_*
	if ssh-keygen -A &&
		/usr/sbin/sshd -t &&
		/usr/sbin/sshd -E /var/log/sshd.log; then
		log 'SSH recovery enabled'
	else
		log 'SSH setup failed; ACM remains available'
	fi
else
	log 'ACM-only recovery; SSH disabled'
fi
log 'recovery ready; remove /run/rog5-recovery-armed only after validation'

while :; do sleep 3600; done
