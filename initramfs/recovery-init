#!/bin/sh
set -u

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mkdir -p /dev/pts /var/log /sys/kernel/config
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
echo /sbin/mdev > /proc/sys/kernel/hotplug
hostname rog5-recovery

log() {
	echo "rog5-recovery: $*" >/dev/kmsg
}

force_rollback() {
	while :; do
		reboot -f
		sleep 5
		echo b >/proc/sysrq-trigger 2>/dev/null || true
	done
}

storage_failure_delay=50

isolate_storage() {
	while read -r _ _ device _ mountpoint _ rest; do
		[ -e "/sys/dev/block/$device" ] || continue
		storage_failure_delay=30
		log "block-backed mount detected at $mountpoint"
		return 1
	done </proc/self/mountinfo

	count=0
	for sys_disk in /sys/class/block/*; do
		[ -e "$sys_disk/device" ] || continue
		disk=$(basename "$sys_disk")
		for sys_block in "$sys_disk" "$sys_disk"/"$disk"*; do
			[ -e "$sys_block/dev" ] || continue
			[ "$sys_block" = "$sys_disk" ] ||
				[ -e "$sys_block/partition" ] || continue
			device=/dev/$(basename "$sys_block")
			[ -b "$device" ] || {
				log "missing physical block node: $device"
				return 1
			}
			blockdev --setro "$device" || {
				log "failed to lock physical block device: $device"
				return 1
			}
			[ "$(blockdev --getro "$device")" = 1 ] || {
				log "physical block device remains writable: $device"
				return 1
			}
			count=$((count + 1))
		done
	done
	log "storage isolation ready; read-only physical block devices=$count"
}

serve_acm() {
	while :; do
		while [ ! -c /dev/ttyGS0 ]; do sleep 0.1; done
		log 'starting ACM shell'
		setsid sh -c 'exec sh -i <>/dev/ttyGS0 >&0 2>&0' || true
		log 'ACM shell exited; restarting'
		sleep 1
	done
}

release=$(uname -r)
log "userspace started on $release"
case $release in
	5.4.*)
		if [ -d /lib/modules/5.4-gki ]; then
			[ -e "/lib/modules/$release" ] || ln -s 5.4-gki "/lib/modules/$release"
			while read -r module; do
				modprobe "${module%.ko}" || insmod "/lib/modules/5.4-gki/$module" ||
					log "optional module failed: ${module%.ko}"
			done </lib/modules/5.4-gki/modules.load
			mdev -s
		fi
		;;
esac

timeout=180
device_cidr=
gateway=
for argument in $(cat /proc/cmdline); do
	case $argument in
		rog5.recovery_timeout=*) timeout=${argument#*=} ;;
		rog5.recovery_cidr=*) device_cidr=${argument#*=} ;;
		rog5.recovery_gateway=*) gateway=${argument#*=} ;;
	esac
done
case $timeout in *[!0-9]*|'') timeout=180 ;; esac
if [ "$timeout" -lt 30 ] || [ "$timeout" -gt 900 ]; then
	timeout=180
fi
rollback_lock_timeout_ns=$(( (timeout + 30) * 1000000000 ))
if ! printf 'rog5-recovery-rollback %s\n' \
	"$rollback_lock_timeout_ns" >/sys/power/wake_lock; then
	log 'rollback suspend inhibitor unavailable; diagnostic delay=10'
	sleep 10
	force_rollback
fi
touch /run/rog5-recovery-armed
(
	sleep "$timeout"
	[ -e /run/rog5-recovery-armed ] || exit 0
	log 'rollback timer expired; rebooting'
	force_rollback
) &
echo $! >/run/rog5-recovery-watchdog.pid
log 'rollback timer armed'

if ! isolate_storage; then
	log "storage isolation failed; diagnostic delay=$storage_failure_delay"
	sleep "$storage_failure_delay"
	force_rollback
fi

usb_mode=/sys/bus/platform/devices/a600000.ssusb/mode
[ -e "$usb_mode" ] && echo peripheral >"$usb_mode"

if ! mount -t configfs configfs /sys/kernel/config; then
	log 'configfs unavailable; rollback timer remains armed'
	while :; do sleep 3600; done
fi
log 'configfs ready'
gadget=/sys/kernel/config/usb_gadget/rog5-recovery
mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409"
echo 0x1d6b >"$gadget/idVendor"
echo 0x0104 >"$gadget/idProduct"
echo 0xef >"$gadget/bDeviceClass"
echo 0x02 >"$gadget/bDeviceSubClass"
echo 0x01 >"$gadget/bDeviceProtocol"
echo Linux >"$gadget/strings/0x409/manufacturer"
echo 'ROG5 recovery' >"$gadget/strings/0x409/product"
echo 'NCM and ACM recovery' >"$gadget/configs/c.1/strings/0x409/configuration"
mkdir -p "$gadget/functions/ncm.usb0" "$gadget/functions/acm.usb0"
ln -s "$gadget/functions/ncm.usb0" "$gadget/configs/c.1/ncm.usb0"
ln -s "$gadget/functions/acm.usb0" "$gadget/configs/c.1/acm.usb0"
serve_acm &
echo $! >/run/rog5-recovery-acm.pid
log 'gadget functions configured'

udc=
attempt=0
log 'waiting for USB device controller'
while [ "$attempt" -lt 200 ] && [ -z "$udc" ]; do
	for candidate in /sys/class/udc/*; do
		[ -e "$candidate" ] || continue
		case $(basename "$candidate") in
			*a600000*) udc=$(basename "$candidate"); break ;;
		esac
		[ -n "$udc" ] || udc=$(basename "$candidate")
	done
	[ -n "$udc" ] || sleep 0.1
	attempt=$((attempt + 1))
done

if [ -n "$udc" ]; then
	echo "$udc" >"$gadget/UDC"
	soft_connect="/sys/class/udc/$udc/soft_connect"
	if [ -w "$soft_connect" ]; then
		if echo disconnect >"$soft_connect" &&
			sleep 1 &&
			echo connect >"$soft_connect"; then
			log 'forced a clean USB reconnect'
		else
			log 'failed to force a clean USB reconnect'
		fi
	fi
	attempt=0
	while [ "$attempt" -lt 100 ] && [ ! -e /sys/class/net/usb0 ]; do
		sleep 0.1
		attempt=$((attempt + 1))
	done
	if [ -e /sys/class/net/usb0 ]; then
		ip link set usb0 up
		case $device_cidr in
			''|*[!0-9a-fA-F:./]*) udhcpc -n -q -t 5 -i usb0 >/var/log/udhcpc.log 2>&1 || true ;;
			*) ip address add "$device_cidr" dev usb0 ;;
		esac
		case $gateway in
			''|*[!0-9a-fA-F:.]*) ;;
			*) ip route replace default via "$gateway" dev usb0 ;;
		esac
		attempt=0
		while [ "$attempt" -lt 100 ]; do
			udc_state=$(cat "/sys/class/udc/$udc/state" 2>/dev/null || echo unknown)
			carrier=$(cat /sys/class/net/usb0/carrier 2>/dev/null || echo unknown)
			if [ "$udc_state" = configured ] || [ "$carrier" = 1 ]; then
				break
			fi
			sleep 0.1
			attempt=$((attempt + 1))
		done
		log "USB recovery network interface is ready; state=$udc_state carrier=$carrier"
	fi
else
	log 'no USB device controller found'
fi

if [ -s /root/.ssh/authorized_keys ]; then
	mkdir -p /run/sshd
	rm -f /etc/ssh/ssh_host_*
	if ssh-keygen -A &&
		/usr/sbin/sshd -t &&
		/usr/sbin/sshd -E /var/log/sshd.log; then
		log 'SSH recovery enabled'
	else
		log 'SSH setup failed; ACM remains available'
	fi
else
	log 'ACM-only recovery; SSH disabled'
fi
log 'recovery ready; remove /run/rog5-recovery-armed only after validation'

while :; do sleep 3600; done
