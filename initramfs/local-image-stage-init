#!/bin/sh
set -eu

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
expected_release=@EXPECTED_KERNEL_RELEASE@
expected_bundle=@EXPECTED_BUNDLE@
expected_udc=a600000.usb
expected_topology_count=117
reboot_helper=/usr/libexec/rog5-reboot-bootloader
status=/run/rog5-local-image-stage.status
stage_record=/run/rog5-local-image-stage.stage
stage_sequence=0
stage_reporting=0
current_stage=
target_boot_id=

log() {
	echo "rog5-local-image-stage: $*" >/dev/kmsg 2>/dev/null || true
}

return_bootloader() {
	sync || true
	"$reboot_helper" || true
	while :; do sleep 3600; done
}

fail() {
	log "FAIL $*"
	printf 'state=FAIL\nreason=%s\n' "$1" >"$status" 2>/dev/null || true
	if [ "$stage_reporting" -eq 1 ] && [ -n "$current_stage" ]; then
		publish_stage "$current_stage" FAIL "$1" || true
		sleep 10
	fi
	return_bootloader
}

topology_count() {
	count=0
	for sys_disk in /sys/class/block/*; do
		[ -e "$sys_disk/device" ] || continue
		[ ! -e "$sys_disk/partition" ] || continue
		disk=$(basename "$sys_disk")
		for sys_block in "$sys_disk" "$sys_disk"/"$disk"*; do
			[ -e "$sys_block/dev" ] || continue
			[ "$sys_block" = "$sys_disk" ] ||
				[ -e "$sys_block/partition" ] || continue
			count=$((count + 1))
		done
	done
	printf '%s\n' "$count"
}

publish_stage() {
	stage_name=$1
	stage_state=$2
	stage_detail=$3
	case $stage_name in
		power-usb|ufs-ready|userdata-resolved|storage-locked|runtime) ;;
		*) return 1 ;;
	esac
	case $stage_state in ENTER|PASS|FAIL) ;; *) return 1 ;; esac
	case $stage_detail in ''|-*|*-|*[!a-z0-9-]*) return 1 ;; esac
	[ "${#stage_detail}" -le 128 ] || return 1
	stage_sequence=$((stage_sequence + 1))
	[ -n "$target_boot_id" ] || return 1
	stage_next=$stage_record.next
	printf '%s\n' \
		'format=rog5-persistent-root-stage-v2' \
		"target_release=$expected_release" \
		"boot_id=$target_boot_id" \
		"sequence=$stage_sequence" \
		"stage=$stage_name" \
		"state=$stage_state" \
		"detail=$stage_detail" >"$stage_next" || return 1
	chmod 0444 "$stage_next" || return 1
	mv -f "$stage_next" "$stage_record" || return 1
}

send_stage_record() {
	nc -n -w 1 -s 169.254.77.2 169.254.77.1 8079 \
		<"$stage_record" >/dev/null 2>&1
}

start_stage_reporter() {
	(
		while :; do
			[ ! -s "$stage_record" ] || send_stage_record || true
			sleep 1
		done
	) &
}

classify_zero_ufs() {
	ufs_dt=/sys/firmware/devicetree/base/soc@0/ufshc@1d84000
	[ -d "$ufs_dt" ] || fail ufs-dt-missing
	[ -f "$ufs_dt/status" ] || fail ufs-dt-status-missing
	ufs_dt_status=$(dd if="$ufs_dt/status" bs=1 count=4 2>/dev/null) ||
		fail ufs-dt-status-invalid
	case $ufs_dt_status in
		okay) ;;
		disa) fail ufs-dt-disabled ;;
		*) fail ufs-dt-status-invalid ;;
	esac
	platform_count=0
	ufs_platform=
	for candidate in /sys/bus/platform/devices/*; do
		[ -L "$candidate/of_node" ] || continue
		[ "$(readlink -f "$candidate/of_node")" = "$ufs_dt" ] || continue
		platform_count=$((platform_count + 1))
		ufs_platform=$candidate
	done
	[ "$platform_count" -eq 1 ] || fail "ufs-dt-okay-platform-$platform_count"
	[ -L "$ufs_platform/driver" ] || fail ufs-platform-unbound
	host_count=0
	for host in /sys/class/scsi_host/host*; do
		[ -e "$host" ] || continue
		host_count=$((host_count + 1))
	done
	[ "$host_count" -gt 0 ] || fail "ufs-bound-host-$host_count"
	fail "ufs-host-$host_count-block-0"
}

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mkdir -p /dev/pts /run /var/log /run/sshd /sys/kernel/config
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
echo /sbin/mdev >/proc/sys/kernel/hotplug || :
mdev -s
hostname rog5-local-image-stage

(
	sleep 900
	log 'watchdog deadline reached'
	return_bootloader
) &
watchdog=$!
printf '%s\n' "$watchdog" >/run/rog5-local-image-stage-watchdog.pid

[ "$(uname -r)" = "$expected_release" ] || fail kernel-release
bundle_count=0
persistent_count=0
discovery_count=0
for token in $(cat /proc/cmdline); do
	[ "$token" = "rog5.bundle=$expected_bundle" ] && bundle_count=$((bundle_count + 1))
	[ "$token" = rog5.persistent_ro=1 ] && persistent_count=$((persistent_count + 1))
	[ "$token" = rog5.ufs_discovery=1 ] && discovery_count=$((discovery_count + 1))
done
[ "$bundle_count:$persistent_count:$discovery_count" = 1:1:1 ] || fail command-line

usb_mode=/sys/bus/platform/devices/a600000.ssusb/mode
[ ! -e "$usb_mode" ] || echo peripheral >"$usb_mode" || fail usb-mode
mount -t configfs configfs /sys/kernel/config
gadget=/sys/kernel/config/usb_gadget/rog5-local-image-stage
mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409"
echo 0x1d6b >"$gadget/idVendor"
echo 0x0104 >"$gadget/idProduct"
echo 0xef >"$gadget/bDeviceClass"
echo 0x02 >"$gadget/bDeviceSubClass"
echo 0x01 >"$gadget/bDeviceProtocol"
echo Linux >"$gadget/strings/0x409/manufacturer"
echo 'ROG5 local image stage' >"$gadget/strings/0x409/product"
echo 'NCM SSH staging' >"$gadget/configs/c.1/strings/0x409/configuration"
mkdir -p "$gadget/functions/ncm.usb0"
ln -s "$gadget/functions/ncm.usb0" "$gadget/configs/c.1/ncm.usb0"

attempt=0
bound_udc=0
while [ "$attempt" -lt 2500 ]; do
	if [ -e "/sys/class/udc/$expected_udc" ]; then
		if echo "$expected_udc" >"$gadget/UDC"; then
			bound_udc=1
			break
		fi
		[ ! -e "/sys/class/udc/$expected_udc" ] ||
			[ -z "$(cat "$gadget/UDC")" ] || fail udc-identity
	fi
	attempt=$((attempt + 1))
	sleep 0.01
done
[ "$bound_udc" -eq 1 ] || fail udc-identity
[ "$(cat "$gadget/UDC")" = "$expected_udc" ] || fail udc-identity
attempt=0
while [ "$attempt" -lt 100 ] && [ ! -e /sys/class/net/usb0 ]; do
	attempt=$((attempt + 1)); sleep 0.1
done
[ -e /sys/class/net/usb0 ] || fail ncm-absent
ip link set usb0 up
ip address add 169.254.77.2/30 dev usb0

attempt=0
while [ "$attempt" -lt 150 ]; do
	[ "$(cat /sys/class/net/usb0/carrier 2>/dev/null || echo 0)" = 1 ] && break
	attempt=$((attempt + 1)); sleep 0.1
done
[ "$attempt" -lt 150 ] || fail ncm-carrier

target_boot_id=$(cat /proc/sys/kernel/random/boot_id) || fail boot-id
current_stage=power-usb
publish_stage power-usb ENTER none || fail stage-publish
stage_reporting=1
start_stage_reporter || fail stage-reporter
if ! /sbin/rog5-load-persistent-power-usb \
	>/run/rog5-power-usb-loader.result; then
	power_result=$(sed -n '1p' /run/rog5-power-usb-loader.result 2>/dev/null || true)
	case $power_result in
		power-usb-*) power_detail=${power_result#power-usb-} ;;
		*) power_detail=loader-error ;;
	esac
	case $power_detail in
		''|-*|*-|*[!a-z0-9-]*) power_detail=loader-error ;;
	esac
	publish_stage power-usb FAIL "$power_detail" || true
	sleep 10
	return_bootloader
fi
publish_stage power-usb PASS ready || fail stage-publish
current_stage=ufs-ready
publish_stage ufs-ready ENTER none || fail stage-publish

for module in phy-qcom-qmp-ufs.ko ufshcd-core.ko ufshcd-pltfrm.ko ufs-qcom.ko; do
	insmod "/rog5-ufs-modules/$module" || fail ufs-module
done
for module in phy_qcom_qmp_ufs ufshcd_core ufshcd_pltfrm ufs_qcom; do
	grep -q "^$module " /proc/modules || fail ufs-module-state
done
mdev -s

attempt=0
while [ "$attempt" -lt 200 ]; do
	count=$(topology_count)
	[ "$count" -eq "$expected_topology_count" ] && break
	attempt=$((attempt + 1)); sleep 0.1
done
[ "$count" -ne 0 ] || classify_zero_ufs
[ "$count" -eq "$expected_topology_count" ] || fail "ufs-count-$count"
publish_stage ufs-ready PASS ready || fail stage-publish

current_stage=userdata-resolved
publish_stage userdata-resolved ENTER none || fail stage-publish
userdata=
matches=0
for sys_disk in /sys/class/block/*; do
	[ -e "$sys_disk/device" ] || continue
	[ ! -e "$sys_disk/partition" ] || continue
	disk=$(basename "$sys_disk")
	case $disk in sd[a-z]) ;; *) continue ;; esac
	for sys_block in "$sys_disk"/"$disk"*; do
		[ -e "$sys_block/partition" ] || continue
		[ "$(sed -n 's/^PARTNAME=//p' "$sys_block/uevent" | sed -n '1p')" = userdata ] || continue
		[ "$(cat "$sys_disk/size")" = 494927872 ] || continue
		[ "$(cat "$sys_disk/queue/logical_block_size")" = 4096 ] || continue
		[ "$(cat "$sys_block/partition")" = 23 ] || continue
		[ "$(cat "$sys_block/start")" = 18821440 ] || continue
		[ "$(cat "$sys_block/size")" = 408997568 ] || continue
		matches=$((matches + 1)); userdata=/dev/$(basename "$sys_block")
	done
done
[ "$matches" -eq 1 ] && [ -b "$userdata" ] || fail userdata-identity
printf '%s\n' "$userdata" >/run/rog5-userdata-device
chmod 0444 /run/rog5-userdata-device
publish_stage userdata-resolved PASS ready || fail stage-publish

current_stage=storage-locked
publish_stage storage-locked ENTER none || fail stage-publish
for sys_block in /sys/class/block/*; do
	[ -e "$sys_block/dev" ] || continue
	[ -e "$sys_block/device" ] || [ -e "$sys_block/partition" ] || continue
	device=/dev/$(basename "$sys_block")
	[ -b "$device" ] || continue
	blockdev --setro "$device" || fail storage-lock
done
[ -z "$(awk '$1 ~ "^/dev/sd" { print }' /proc/mounts)" ] || fail storage-mounted
publish_stage storage-locked PASS ready || fail stage-publish

current_stage=runtime
publish_stage runtime ENTER none || fail stage-publish
if [ -e /etc/nologin ] || [ -L /etc/nologin ]; then
	[ -f /etc/nologin ] && [ ! -L /etc/nologin ] && [ ! -s /etc/nologin ] ||
		fail nologin-identity
	rm /etc/nologin || fail nologin-remove
fi
[ ! -e /etc/nologin ] && [ ! -L /etc/nologin ] || fail nologin-present
ssh-keygen -q -t ed25519 -N '' -f /run/ssh_host_ed25519_key
/usr/sbin/sshd -h /run/ssh_host_ed25519_key -E /var/log/sshd.log
printf 'state=READY\nuserdata=%s\nstorage=read-only\nssh=key-only\n' "$userdata" >"$status"
chmod 0444 "$status"
publish_stage runtime PASS ready || fail stage-publish
current_stage=

log 'ready for one exact compressed-image staging command over key-only SSH'
while :; do sleep 3600; done
