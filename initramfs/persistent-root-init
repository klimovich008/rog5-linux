mount_overlay_root() {
	mount -t tmpfs -o nodev,nosuid,mode=0755,size=2048m \
		tmpfs /mnt/state || return 1
	mkdir -p /mnt/state/upper /mnt/state/work
	mount -t overlay overlay \
		-o lowerdir=/mnt/root-ro,upperdir=/mnt/state/upper,workdir=/mnt/state/work \
		/newroot || return 1
	awk '$1 == "overlay" && $2 == "/newroot" && $3 == "overlay" &&
		$4 ~ /(^|,)rw(,|$)/ { found++ }
		END { exit found != 1 }' /proc/mounts || return 1
	[ -x /newroot/sbin/init ] || return 1
	return 0
}

prepare_volatile_systemd_state() {
	root=$1
	lower=$2
	upper=$3
	runtime=$4
	expected_cache_size=20207
	expected_cache_sha256=ae57b0740e33f19b3f748bdf8e159a65ecfb828f1339f093d91ec9ef4b8e89ed
	empty_sha256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

	for directory in \
		"$root/etc" "$root/var" "$root/usr" \
		"$lower/etc" "$lower/var" "$upper" \
		"$runtime/systemd/system"; do
		[ -d "$directory" ] && [ ! -L "$directory" ] || return 1
	done
	verify_exact_regular "$root/etc/ld.so.cache" 0 0 644 \
		"$expected_cache_size" "$expected_cache_sha256" || return 1

	for subtree in etc var; do
		lower_marker=$lower/$subtree/.updated
		merged_marker=$root/$subtree/.updated
		upper_marker=$upper/$subtree/.updated
		[ ! -e "$lower_marker" ] && [ ! -L "$lower_marker" ] || return 1
		[ ! -e "$merged_marker" ] && [ ! -L "$merged_marker" ] || return 1
		[ ! -e "$upper_marker" ] && [ ! -L "$upper_marker" ] || return 1
		touch -r "$root/usr" "$merged_marker" || return 1
		chown 0:0 "$merged_marker" || return 1
		chmod 0644 "$merged_marker" || return 1
		verify_exact_regular "$merged_marker" 0 0 644 0 \
			"$empty_sha256" || return 1
		verify_exact_regular "$upper_marker" 0 0 644 0 \
			"$empty_sha256" || return 1
		marker_time=$(stat -c '%Y:%y' "$merged_marker") || return 1
		[ "$marker_time" = "$(stat -c '%Y:%y' "$root/usr")" ] ||
			return 1
		[ "$marker_time" = "$(stat -c '%Y:%y' "$upper_marker")" ] ||
			return 1
		[ ! -e "$lower_marker" ] && [ ! -L "$lower_marker" ] || return 1
	done

	vconsole_mask=$runtime/systemd/system/systemd-vconsole-setup.service
	[ ! -e "$vconsole_mask" ] && [ ! -L "$vconsole_mask" ] || return 1
	ln -s /dev/null "$vconsole_mask" || return 1
	[ -L "$vconsole_mask" ] &&
		[ "$(readlink "$vconsole_mask")" = /dev/null ] || return 1

	sshdgenkeys_mask=$runtime/systemd/system/sshdgenkeys.service
	stock_sshd_mask=$runtime/systemd/system/sshd.service
	ed25519_unit=$runtime/systemd/system/rog5-sshd-ed25519-key.service
	early_sshd_unit=$runtime/systemd/system/rog5-early-sshd.service
	early_sshd_wants=$runtime/systemd/system/sysinit.target.wants/rog5-early-sshd.service
	for path in "$sshdgenkeys_mask" "$stock_sshd_mask" "$ed25519_unit" \
		"$early_sshd_unit" "$early_sshd_wants"; do
		[ ! -e "$path" ] && [ ! -L "$path" ] || return 1
	done
	ln -s /dev/null "$sshdgenkeys_mask" || return 1
	[ -L "$sshdgenkeys_mask" ] &&
		[ "$(readlink "$sshdgenkeys_mask")" = /dev/null ] || return 1
	ln -s /dev/null "$stock_sshd_mask" || return 1
	[ -L "$stock_sshd_mask" ] &&
		[ "$(readlink "$stock_sshd_mask")" = /dev/null ] || return 1
	cat >"$ed25519_unit" <<'EOF'
[Unit]
Description=Generate one volatile Ed25519 SSH host key
DefaultDependencies=no
Before=rog5-early-sshd.service
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -q -t ed25519 -N "" -f /etc/ssh/ssh_host_ed25519_key
EOF
	cat >"$early_sshd_unit" <<'EOF'
[Unit]
Description=Start strict SSH before the general Arch boot transaction
DefaultDependencies=no
Requires=rog5-sshd-ed25519-key.service
After=rog5-sshd-ed25519-key.service
Before=basic.target

[Service]
ExecStart=/usr/bin/sshd -D
KillMode=process
Restart=on-failure
RestartSec=2s
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755

[Install]
WantedBy=sysinit.target
EOF
	ln -s ../rog5-early-sshd.service "$early_sshd_wants" || return 1
	[ -L "$early_sshd_wants" ] &&
		[ "$(readlink "$early_sshd_wants")" = \
		../rog5-early-sshd.service ] || return 1
	chown 0:0 "$ed25519_unit" "$early_sshd_unit" || return 1
	chmod 0644 "$ed25519_unit" "$early_sshd_unit" || return 1
	verify_exact_regular "$ed25519_unit" 0 0 644 274 \
		99390fa5afe975b46a4f62f7f532c3062acfa69e85970d5a7aeb28a7ccfadd09 ||
		return 1
	verify_exact_regular "$early_sshd_unit" 0 0 644 366 \
		a9b6c3b487755dcb9e0726773b5f6376cadfa192244d8f7c24d9fd3837661359 ||
		return 1
	return 0
}

prepare_runtime() {
	exitrd=/run/initramfs
	mkdir -p "$exitrd/bin" "$exitrd/lib" "$exitrd/dev" "$exitrd/proc" \
		"$exitrd/sys" "$exitrd/run" "$exitrd/oldroot" \
		"$exitrd/oldsys" || return 1
	cp -p /bin/busybox "$exitrd/bin/busybox" || return 1
	cp -p /lib/ld-musl-aarch64.so.1 \
		"$exitrd/lib/ld-musl-aarch64.so.1" || return 1
	ln -s ld-musl-aarch64.so.1 \
		"$exitrd/lib/libc.musl-aarch64.so.1" || return 1
	ln -s busybox "$exitrd/bin/sh" || return 1
	cp -p /shutdown "$exitrd/shutdown" || return 1
	chroot "$exitrd" /bin/sh -n /shutdown || return 1

	cp -p /usr/local/sbin/rog5-p2-attest /run/rog5-p2-attest ||
		return 1
	mkdir -p /run/NetworkManager/conf.d /run/udev/rules.d \
		/run/systemd/system/sysinit.target.wants
	cat >/run/NetworkManager/conf.d/10-rog5-p2.conf <<'EOF'
[keyfile]
unmanaged-devices=interface-name:usb0
EOF
	cat >/run/udev/rules.d/10-rog5-p2-storage.rules <<'EOF'
SUBSYSTEM=="block", KERNEL=="sd*", ENV{UDISKS_IGNORE}="1"
EOF
	cat >/run/systemd/system/rog5-p2-ready.service <<'EOF'
[Unit]
Description=Verify the read-only persistent-root P2 gate
DefaultDependencies=no
Requires=rog5-early-sshd.service
After=rog5-early-sshd.service
Before=basic.target

[Service]
Type=oneshot
ExecStart=/run/rog5-p2-attest
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
EOF
	ln -s ../rog5-p2-ready.service \
		/run/systemd/system/sysinit.target.wants/rog5-p2-ready.service
	ln -s /dev/null /run/systemd/system/udisks2.service
	prepare_volatile_systemd_state \
		/newroot /mnt/root-ro /mnt/state/upper /run || return 1
	return 0
}

move_handoff_mount() {
	mount --move "$1" "$2"
}

rollback_handoff_mounts() {
	rollback_status=0

	[ "$handoff_moved_run" -eq 0 ] ||
		move_handoff_mount "$handoff_newroot/run" "$handoff_run" ||
		rollback_status=1
	[ "$handoff_moved_proc" -eq 0 ] ||
		move_handoff_mount "$handoff_newroot/proc" "$handoff_proc" ||
		rollback_status=1
	[ "$handoff_moved_sys" -eq 0 ] ||
		move_handoff_mount "$handoff_newroot/sys" "$handoff_sys" ||
		rollback_status=1
	[ "$handoff_moved_dev" -eq 0 ] ||
		move_handoff_mount "$handoff_newroot/dev" "$handoff_dev" ||
		rollback_status=1
	[ "$handoff_moved_state" -eq 0 ] ||
		move_handoff_mount "$handoff_newroot/.rog5/state" \
			"$handoff_state" || rollback_status=1
	[ "$handoff_moved_root" -eq 0 ] ||
		move_handoff_mount "$handoff_newroot/.rog5/root-ro" \
			"$handoff_root" || rollback_status=1
	[ "$handoff_moved_userdata" -eq 0 ] ||
		move_handoff_mount "$handoff_newroot/.rog5/userdata-ro" \
			"$handoff_userdata" || rollback_status=1
	return "$rollback_status"
}

handoff_persistent_root() {
	handoff_moved_userdata=0
	handoff_moved_root=0
	handoff_moved_state=0
	handoff_moved_dev=0
	handoff_moved_sys=0
	handoff_moved_proc=0
	handoff_moved_run=0

	mkdir -p "$handoff_newroot/.rog5/userdata-ro" \
		"$handoff_newroot/.rog5/root-ro" \
		"$handoff_newroot/.rog5/state" "$handoff_newroot/dev" \
		"$handoff_newroot/proc" "$handoff_newroot/sys" \
		"$handoff_newroot/run" || return 1
	touch "$handoff_run/rog5-p2-root-mounted" || return 1

	if ! move_handoff_mount "$handoff_userdata" \
		"$handoff_newroot/.rog5/userdata-ro"; then
		return 1
	fi
	handoff_moved_userdata=1
	if ! move_handoff_mount "$handoff_root" \
		"$handoff_newroot/.rog5/root-ro"; then
		rollback_handoff_mounts || true
		return 1
	fi
	handoff_moved_root=1
	if ! move_handoff_mount "$handoff_state" \
		"$handoff_newroot/.rog5/state"; then
		rollback_handoff_mounts || true
		return 1
	fi
	handoff_moved_state=1
	if ! move_handoff_mount "$handoff_dev" "$handoff_newroot/dev"; then
		rollback_handoff_mounts || true
		return 1
	fi
	handoff_moved_dev=1
	if ! move_handoff_mount "$handoff_sys" "$handoff_newroot/sys"; then
		rollback_handoff_mounts || true
		return 1
	fi
	handoff_moved_sys=1
	if ! move_handoff_mount "$handoff_proc" "$handoff_newroot/proc"; then
		rollback_handoff_mounts || true
		return 1
	fi
	handoff_moved_proc=1
	if ! move_handoff_mount "$handoff_run" "$handoff_newroot/run"; then
		rollback_handoff_mounts || true
		return 1
	fi
	handoff_moved_run=1
	return 0
}

switch_root_failure() {
	trap - EXIT
	rollback_handoff_mounts || true
	stage_record=/run/rog5-persistent-root-stage.record
	publish_stage switch-root FAIL || true
	log 'switch_root returned after a complete persistent-root handoff'
	sleep 2
	force_rollback
}

recovery_timeout=600
persistent_count=0
persistent_invalid=0
discovery_count=0
discovery_invalid=0
for argument in $(cat /proc/cmdline); do
	case $argument in
		rog5.persistent_ro=1) persistent_count=$((persistent_count + 1)) ;;
		rog5.persistent_ro=*) persistent_invalid=1 ;;
		rog5.ufs_discovery=1) discovery_count=$((discovery_count + 1)) ;;
		rog5.ufs_discovery=*) discovery_invalid=1 ;;
		rog5.recovery_timeout=*) recovery_timeout=${argument#*=} ;;
	esac
done
case $recovery_timeout in *[!0-9]*|'') recovery_timeout=600 ;; esac
if [ "$recovery_timeout" -lt 300 ] || [ "$recovery_timeout" -gt 900 ]; then
	recovery_timeout=600
fi

arm_watchdog
if ! configure_usb; then
	fail_stage 'USB recovery transport failed' usb 15
fi
if ! load_reboot_mode_modules; then
	fail_stage 'Qualcomm reboot-mode modules failed' reboot-mode 15
fi
if ! wait_for_reboot_mode; then
	fail_stage 'Qualcomm reboot-mode path is unavailable' reboot-mode 15
fi

if [ "$persistent_count" -ne 1 ] || [ "$persistent_invalid" -ne 0 ] ||
	[ "$discovery_count" -ne 1 ] || [ "$discovery_invalid" -ne 0 ]; then
	fail_stage 'invalid persistent-root command line' cmdline 5
fi
running_kernel_release=
if ! IFS= read -r running_kernel_release <"$release_file"; then
	fail_stage 'running kernel release is unavailable' \
		kernel-release-file 20
fi
if [ "$running_kernel_release" != "$expected_kernel_release" ]; then
	fail_stage 'running kernel release changed' kernel-release-identity 25
fi
target_boot_id=$(cat /proc/sys/kernel/random/boot_id) ||
	fail_stage 'target boot identity is unavailable' kernel-release-file 20
case "$expected_ufs_storage_mode:$expected_probe_boot_id" in
	local-write:current) ;;
	read-only:any-prior) ;;
	read-only:staged-seal) ;;
	read-only:*)
		printf '%s\n' "$expected_probe_boot_id" |
			grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' ||
			fail_stage 'target write-probe producer identity is invalid' \
				kernel-release-file 20
		[ "$expected_probe_boot_id" != "$target_boot_id" ] ||
			fail_stage 'target write-probe producer is not from an earlier boot' \
				kernel-release-file 20
		;;
	*) fail_stage 'target UFS storage mode is invalid' kernel-release-file 20 ;;
esac
printf '%s\n' "$target_boot_id" |
	grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' ||
	fail_stage 'target boot identity is invalid' kernel-release-file 20
publish_or_rollback kernel-verified PASS
start_stage_reporter
publish_or_rollback ufs-ready ENTER
if [ -x /sbin/rog5-load-persistent-power-usb ]; then
	power_usb_failure=
	if ! power_usb_failure=$(/sbin/rog5-load-persistent-power-usb); then
		if ! valid_power_usb_failure "$power_usb_failure"; then
			power_usb_failure=power-usb-invalid-failure-record
		fi
		publish_stage ufs-ready FAIL "$power_usb_failure" || true
		log 'side-port power/USB initialization failed'
		sleep 2
		force_rollback
	fi
fi
if deferred_ufs_modules_present; then
	log 'waiting for deferred UFS probe rendezvous'
	if ! wait_for_deferred_ufs_rendezvous; then
		fail_stage 'deferred UFS probe rendezvous failed' ufs-rendezvous 15
	fi
	load_deferred_ufs_modules
	module_status=$?
	case $module_status in
		0) ;;
		*)
			publish_stage ufs-ready FAIL \
				"ufs-module-status-$module_status" || true
			fail_stage 'deferred UFS module load returned an error' ufs-module 20
			;;
	esac
fi
log 'waiting for stable UFS discovery'
if ! wait_for_ufs_discovery; then
	count=$(physical_topology_count)
	auto_count=$(dmesg | grep -F -c \
		'ROG5 UFS discovery: auto-hibern8 disabled; link remains active' || true)
	host_count=$(dmesg | grep -F -c \
		'ROG5 UFS discovery: host runtime PM forbidden; active reference retained' || true)
	wlun_count=$(dmesg | grep -F -c \
		'ROG5 UFS discovery: WLUN runtime PM forbidden' || true)
	error_count=$(dmesg | grep -Ei -c \
		'ufshcd.*(error|failed|failure|timeout|timed out)|ufs.*(link startup failed|probe failed|reset and restore failed|fatal)' || true)
	ufs_discovery_detail=ufs-discovery-p${count}-a${auto_count}-h${host_count}-w${wlun_count}-e${error_count}
	publish_stage ufs-ready FAIL "$ufs_discovery_detail" || true
	fail_stage 'UFS discovery failed' ufs-discovery 35
fi
if ! verify_ufs_power_containment; then
	publish_stage ufs-ready FAIL ufs-power-containment || true
	fail_stage 'UFS power containment failed before storage lock' \
		ufs-power 50
fi
publish_or_rollback ufs-ready PASS
publish_or_rollback storage-locked ENTER
if ! lock_physical_storage; then
	publish_stage storage-locked FAIL || true
	fail_stage 'physical storage lock failed' storage-lock 65
fi
publish_or_rollback storage-locked PASS
publish_or_rollback userdata-resolved ENTER
userdata=$(find_exact_userdata /sys/class/block /dev) ||
	{
		publish_stage userdata-resolved FAIL || true
		fail_stage 'exact userdata identity failed' userdata 80
	}
[ -b "$userdata" ] || {
	publish_stage userdata-resolved FAIL || true
	fail_stage 'exact userdata node is absent' userdata 80
}
printf '%s\n' "$userdata" >/run/rog5-p2-userdata-device ||
	{
		publish_stage userdata-resolved FAIL || true
		fail_stage 'userdata identity publication failed' userdata 80
	}
chmod 0444 /run/rog5-p2-userdata-device ||
	{
		publish_stage userdata-resolved FAIL || true
		fail_stage 'userdata identity mode failed' userdata 80
	}
if ! write_ufs_inventory; then
	publish_stage userdata-resolved FAIL || true
	fail_stage 'UFS inventory failed' inventory 95
fi
if ! verify_physical_storage_read_only ||
	! verify_ufs_power_containment; then
	fail_local_stage userdata-resolved \
		'storage containment failed after USB rescan'
fi
publish_or_rollback userdata-resolved PASS
publish_or_rollback userdata-mount ENTER
if ! mount_persistent_root; then
	if [ "$mount_persistent_root_failure" = rog5-directory ]; then
		publish_sparse_block_probe || true
	fi
	fail_local_stage userdata-mount 'read-only noload userdata mount failed' \
		"userdata-$mount_persistent_root_failure"
fi
publish_or_rollback userdata-mount PASS
publish_or_rollback image-resolved ENTER
if ! resolve_local_root_image; then
	fail_local_stage image-resolved 'exact local root image identity failed'
fi
publish_or_rollback image-resolved PASS
if [ "$expected_ufs_storage_mode" = local-write ]; then
	publish_or_rollback image-write ENTER
	if ! run_local_image_write_probe; then
		case $image_write_failure_stage in
			image-write-window|userdata-unmount|write-window-precheck|\
			userdata-partition-rw|userdata-disk-rw|\
			write-window-selected-disk-blockdev|write-window-selected-disk-sysfs|\
			write-window-selected-part-blockdev|write-window-selected-part-sysfs|\
			write-window-other-disk-blockdev|write-window-other-disk-sysfs|\
			write-window-other-part-blockdev|write-window-other-part-sysfs|\
			write-window-count|userdata-rw|image-loop-rw|\
			image-fs-rw|image-probe|storage-relock) ;;
			*) image_write_failure_stage=image-write ;;
		esac
		fail_local_stage "$image_write_failure_stage" \
			'bounded local-image write probe failed'
	fi
	publish_or_rollback image-write PASS
fi
publish_or_rollback image-mount ENTER
if ! mount_local_root_image; then
	fail_local_stage image-mount 'read-only noload local root image mount failed'
fi
publish_or_rollback image-mount PASS
publish_or_rollback root-verify ENTER
if ! verify_persistent_root; then
	fail_local_stage root-verify 'anchored persistent-root verification failed'
fi
publish_or_rollback root-verify PASS
publish_or_rollback ufs-health ENTER
if ! verify_ufs_health; then
	fail_local_stage ufs-health 'UFS or ext4 read-only health gate failed'
fi
publish_or_rollback ufs-health PASS
publish_or_rollback overlay ENTER
if ! mount_overlay_root; then
	fail_local_stage overlay 'tmpfs OverlayFS root failed'
fi
publish_or_rollback overlay PASS
publish_or_rollback runtime ENTER
if ! prepare_runtime; then
	fail_local_stage runtime 'volatile runtime preparation failed'
fi
publish_or_rollback runtime PASS
publish_or_rollback final-storage ENTER
if ! verify_physical_storage_read_only ||
	! verify_userdata_and_image_mounts ||
	! verify_ufs_health; then
	fail_local_stage final-storage 'final read-only storage gate failed'
fi
publish_or_rollback final-storage PASS

handoff_newroot=/newroot
handoff_userdata=/mnt/userdata
handoff_root=/mnt/root-ro
handoff_state=/mnt/state
handoff_dev=/dev
handoff_proc=/proc
handoff_sys=/sys
handoff_run=/run
publish_or_rollback switch-root ENTER
# The reporter and its record live on /run.  Give the final volatile record
# one bounded heartbeat interval before moving /run into the new root.
sleep 2
if ! handoff_persistent_root; then
	fail_local_stage switch-root 'persistent-root mount handoff failed'
fi
stage_record=$handoff_newroot/run/rog5-persistent-root-stage.record
if ! publish_stage switch-root PASS; then
	rollback_handoff_mounts || true
	stage_record=/run/rog5-persistent-root-stage.record
	fail_local_stage switch-root 'post-handoff stage publication failed'
fi
report_current_stage_once || true

trap switch_root_failure EXIT
exec switch_root /newroot /sbin/init
