	grep -Fxq 'seal_format=rog5-persistent-root-v1' "$seal" || return 1
	grep -Fxq 'generation=arch-a' "$seal" || return 1
	grep -Fxq 'promotion_state=UNBOOTED' "$seal" || return 1
	grep -Fxq 'source_archive_size=536746495' "$seal" || return 1
	grep -Fxq 'source_archive_sha256=4d120a4b3a10be098cea47ba8536969bbaa931b47b31cc37fc3474fea045b324' \
		"$seal" || return 1
	grep -Fxq 'tree_entries=37736' "$seal" || return 1
	grep -Fxq "tree_sha256=$expected_tree_sha256" "$seal" || return 1
	verify_exact_regular "$root/.rog5-source-seal" 0 0 444 430 \
		"$expected_source_seal_sha256" || return 1
	verify_exact_local_image_probe "$root" || return 1

	[ -L "$root/sbin/init" ] &&
		[ "$(readlink "$root/sbin/init")" = ../lib/systemd/systemd ] ||
