#!/bin/sh
set -u

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mkdir -p /dev/pts /run /sys/kernel/config /var/log
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
echo /sbin/mdev >/proc/sys/kernel/hotplug
hostname rog5-persistent-root
mdev -s

expected_physical_count=116
expected_kernel_release=@EXPECTED_KERNEL_RELEASE@
expected_ufs_storage_mode=@EXPECTED_UFS_STORAGE_MODE@
expected_probe_boot_id=@EXPECTED_PROBE_BOOT_ID@
expected_seal_sha256=02231e86746fbc656090f52c96d7e0c968c7ca86ba7449c306f611ea20c6a876
expected_tree_sha256=4701c23b93624bf894bb76331c165b650c9a2aecb99273a4e6d37c20ac3ef167
expected_source_seal_sha256=42ef8388bb771fbd0dd8141939b042a89037ea1cf1bec9288f7a3ae51455210a
expected_image_bytes=17179869184
expected_image_uuid=598a876b-a8db-4859-a01a-1b864b0a87f4
expected_image_label=ROG5_ARCH_A
expected_probe_bytes=132
userdata=
userdata_disk=
root_image=
root_loop=
image_write_failure_stage=image-write
release_file=/proc/sys/kernel/osrelease
expected_udc=a600000.usb
udc_class_dir=/sys/class/udc
udc_poll_attempts=200
stage_sequence=0
stage_record=/run/rog5-persistent-root-stage.record
stage_reporter_pid=
target_boot_id=
reboot_helper=/usr/libexec/rog5-reboot-bootloader
reboot_mode_driver=/sys/bus/platform/drivers/nvmem-reboot-mode
reboot_mode_modules=/rog5-reboot-mode-modules

log() {
	for kmsg in /dev/kmsg /newroot/dev/kmsg; do
		[ -c "$kmsg" ] || continue
		echo "rog5-persistent-root: $*" >"$kmsg" 2>/dev/null || true
		break
	done
	return 0
}

publish_stage() {
	stage_name=$1
	stage_state=$2
	stage_detail=${3:-none}
	case $stage_name in
		kernel-verified|ufs-ready|storage-locked|userdata-resolved|\
userdata-mount|image-resolved|image-mount|root-verify|ufs-health|\
image-write|image-write-window|userdata-unmount|write-window-precheck|\
userdata-partition-rw|userdata-disk-rw|\
write-window-selected-disk-blockdev|write-window-selected-disk-sysfs|\
write-window-selected-part-blockdev|write-window-selected-part-sysfs|\
write-window-other-disk-blockdev|write-window-other-disk-sysfs|\
write-window-other-part-blockdev|write-window-other-part-sysfs|\
write-window-count|userdata-rw|image-loop-rw|\
image-fs-rw|image-probe|storage-relock|\
overlay|runtime|final-storage|switch-root) ;;
		*) return 1 ;;
	esac
	case $stage_state in ENTER|PASS|FAIL) ;; *) return 1 ;; esac
	case $stage_detail in
		''|-*|*-|*[!a-z0-9-]*) return 1 ;;
	esac
	[ "${#stage_detail}" -le 128 ] || return 1
	stage_sequence=$((stage_sequence + 1))
	[ -n "$target_boot_id" ] || return 1
	stage_next=$stage_record.next
	printf '%s\n' \
		'format=rog5-persistent-root-stage-v2' \
		"target_release=$running_kernel_release" \
		"boot_id=$target_boot_id" \
		"sequence=$stage_sequence" \
		"stage=$stage_name" \
		"state=$stage_state" \
		"detail=$stage_detail" >"$stage_next" || return 1
	chmod 0444 "$stage_next" || return 1
	mv -f "$stage_next" "$stage_record" || return 1
	log "stage sequence=$stage_sequence stage=$stage_name state=$stage_state detail=$stage_detail"
}

send_stage_record() {
	nc -n -w 1 -s 169.254.77.2 \
		169.254.77.1 8079 >/dev/null 2>&1
}

report_current_stage_once() {
	[ -s "$stage_record" ] || return 1
	send_stage_record <"$stage_record"
}

start_stage_reporter() {
	(
		while :; do
			if [ -s "$stage_record" ]; then
				send_stage_record <"$stage_record" || true
			fi
			sleep 1
		done
	) &
	stage_reporter_pid=$!
	printf '%s\n' "$stage_reporter_pid" >/run/rog5-stage-reporter.pid
}

valid_power_usb_failure() {
	candidate=$1
	[ "${#candidate}" -le 128 ] || return 1
	[ "$(printf '%s\n' "$candidate" | wc -l)" -eq 1 ] || return 1
	printf '%s\n' "$candidate" |
		grep -Eq '^power-usb-[a-z0-9]([a-z0-9-]*[a-z0-9])?$'
}

publish_or_rollback() {
	publish_stage "$1" "$2" || {
		log 'volatile stage publication failed'
		force_rollback
	}
}

fail_local_stage() {
	stage_detail=${3:-none}
	publish_stage "$1" FAIL "$stage_detail" || true
	log "$2"
	# Give the receive-only heartbeat one bounded chance to export the
	# terminal stage before the storage-quiescent reset.
	sleep 2
	force_rollback
}

force_rollback() {
	log 'requesting storage-quiescent bootloader restart'
	if [ -x "$reboot_helper" ]; then
		"$reboot_helper" || true
	fi
	log 'bootloader restart returned; forcing emergency reset'
	while :; do
		printf b >/proc/sysrq-trigger 2>/dev/null || true
		sleep 5
	done
}

wait_for_reboot_mode() {
	attempt=0
	while [ "$attempt" -lt 100 ]; do
		if [ -L "$reboot_mode_driver/reboot-mode" ] &&
			[ "$(basename "$(readlink -f \
				"$reboot_mode_driver/reboot-mode")")" = reboot-mode ] &&
			[ "$(tr '\000' '\n' \
				</sys/devices/platform/reboot-mode/of_node/compatible)" = \
				nvmem-reboot-mode ]; then
			return 0
		fi
		attempt=$((attempt + 1))
		sleep 0.1
	done
	return 1
}

load_reboot_mode_modules() {
	[ -d "$reboot_mode_modules" ] || return 0
	[ "$(find "$reboot_mode_modules" -mindepth 1 -maxdepth 1 -type f | wc -l)" -eq 2 ] ||
		return 1
	for module in nvmem_qcom-spmi-sdam.ko nvmem-reboot-mode.ko; do
		path=$reboot_mode_modules/$module
		[ -f "$path" ] && [ ! -L "$path" ] || return 1
		insmod "$path" || return 1
	done
}

fail_stage() {
	reason=$1
	stage=$2
	delay=$3
	case "$stage:$delay" in
		cmdline:5|kernel-release-file:20|kernel-release-identity:25|\
ufs-discovery:35|ufs-power:50|storage-lock:65|userdata:80|inventory:95|\
usb:15|reboot-mode:15|ufs-rendezvous:15|ufs-module:20) ;;
		*)
			log 'invalid failure timing marker'
			force_rollback
			;;
	esac
	log "$reason"
	log "failure timing marker stage=$stage delay=${delay}s"
	sleep "$delay"
	force_rollback
}

arm_watchdog() {
	(
		exec 8>/dev/kmsg
		exec 9>/proc/sysrq-trigger
		sleep "$recovery_timeout"
		echo 'rog5-persistent-root: watchdog expired; requesting bootloader restart' >&8
		if [ -x "$reboot_helper" ]; then
			"$reboot_helper" || true
		fi
		echo 'rog5-persistent-root: bootloader restart returned; using emergency reset' >&8
		printf b >&9
		while :; do sleep 3600; done
	) &
	echo $! >/run/rog5-p2-watchdog.pid
	log "emergency-reset watchdog armed for $recovery_timeout seconds"
}

physical_topology_count() {
	count=0
	for sys_disk in /sys/class/block/*; do
		[ -e "$sys_disk/device" ] || continue
		[ ! -e "$sys_disk/partition" ] || continue
		disk=$(basename "$sys_disk")
		for sys_block in "$sys_disk" "$sys_disk"/"$disk"*; do
			[ -e "$sys_block/dev" ] || continue
			[ "$sys_block" = "$sys_disk" ] ||
				[ -e "$sys_block/partition" ] || continue
			count=$((count + 1))
		done
	done
	printf '%s\n' "$count"
}

wait_for_ufs_discovery() {
	attempt=0
	stable=0
	previous=-1
	while [ "$attempt" -lt 450 ]; do
		mdev -s || return 1
		count=$(physical_topology_count)
		if [ "$count" = "$expected_physical_count" ] &&
			[ "$count" = "$previous" ]; then
			stable=$((stable + 1))
		else
			stable=0
		fi
		[ "$stable" -ge 20 ] && return 0
		previous=$count
		attempt=$((attempt + 1))
		sleep 0.1
	done
	log "UFS topology did not stabilize at $expected_physical_count nodes"
	return 1
}

verify_ufs_power_containment() {
	auto_marker='ROG5 UFS discovery: auto-hibern8 disabled; link remains active'
	host_marker='ROG5 UFS discovery: host runtime PM forbidden; active reference retained'
	wlun_marker='ROG5 UFS discovery: WLUN runtime PM forbidden'
	if [ "$expected_ufs_storage_mode" = local-write ]; then
		attempt=0
		auto_count=0
		host_count=0
		wlun_count=0
		optional_count=0
		while [ "$attempt" -lt 100 ]; do
			auto_count=$(dmesg | grep -F -c "$auto_marker" || true)
			host_count=$(dmesg | grep -F -c "$host_marker" || true)
			wlun_count=$(dmesg | grep -F -c "$wlun_marker" || true)
			optional_count=$(dmesg | grep -F -c \
				'ROG5 UFS discovery: optional device writes and high-speed gear switch disabled' || true)
			if [ "$auto_count" -gt 0 ] && [ "$host_count" -gt 0 ] &&
				[ "$wlun_count" -gt 0 ] && [ "$optional_count" -gt 0 ]; then
				break
			fi
			attempt=$((attempt + 1))
			sleep 0.1
		done
		[ "$auto_count" -gt 0 ] && [ "$host_count" -gt 0 ] &&
			[ "$wlun_count" -gt 0 ] && [ "$optional_count" -gt 0 ] ||
			return 1
		[ "$(dmesg | grep -F -c \
			'ROG5 UFS discovery: forced read-only before registration' || true)" \
			-eq 0 ] || return 1
		blocked_query_count=$(dmesg |
			grep -F -c 'ROG5 UFS discovery: blocked device query' || true)
		blocked_scsi_count=$(dmesg |
			grep -F -c 'ROG5 UFS discovery: blocked SCSI opcode' || true)
		[ "$blocked_query_count" -eq 0 ] &&
			[ "$blocked_scsi_count" -eq 0 ]
		return
	fi
	attempt=0
	auto_count=0
	host_count=0
	wlun_count=0
	while [ "$attempt" -lt 100 ]; do
		auto_count=$(dmesg | grep -F -c "$auto_marker" || true)
		host_count=$(dmesg | grep -F -c "$host_marker" || true)
		wlun_count=$(dmesg | grep -F -c "$wlun_marker" || true)
		if [ "$auto_count" -gt 0 ] &&
			[ "$host_count" -gt 0 ] &&
			[ "$wlun_count" -gt 0 ]; then
			break
		fi
		attempt=$((attempt + 1))
		sleep 0.1
	done
	[ "$auto_count" -gt 0 ] &&
		[ "$host_count" -gt 0 ] &&
		[ "$wlun_count" -gt 0 ] || return 1

	blocked_query_count=$(dmesg |
		grep -F -c 'ROG5 UFS discovery: blocked device query' || true)
	blocked_scsi_count=$(dmesg |
		grep -F -c 'ROG5 UFS discovery: blocked SCSI opcode' || true)
	[ "$blocked_query_count" -eq 0 ] &&
		[ "$blocked_scsi_count" -eq 0 ] || return 1
	return 0
}

has_block_backed_mount() {
	while read -r _ _ device _ mountpoint _ rest; do
		[ -e "/sys/dev/block/$device" ] || continue
		log "unexpected block-backed mount at $mountpoint"
		return 0
	done </proc/self/mountinfo
	return 1
}

lock_physical_storage() {
	has_block_backed_mount && return 1
	count=0
	for sys_disk in /sys/class/block/*; do
		[ -e "$sys_disk/device" ] || continue
		[ ! -e "$sys_disk/partition" ] || continue
		disk=$(basename "$sys_disk")
		for sys_block in "$sys_disk" "$sys_disk"/"$disk"*; do
			[ -e "$sys_block/dev" ] || continue
			[ "$sys_block" = "$sys_disk" ] ||
				[ -e "$sys_block/partition" ] || continue
			device=/dev/$(basename "$sys_block")
			[ -b "$device" ] || return 1
			blockdev --setro "$device" || return 1
			[ "$(blockdev --getro "$device")" = 1 ] || return 1
			[ "$(cat "$sys_block/ro")" = 1 ] || return 1
			count=$((count + 1))
		done
	done
	[ "$count" -eq "$expected_physical_count" ] || return 1
	printf '%s\n' "$count" >/run/rog5-physical-block-count
	return 0
}

verify_physical_storage_read_only() {
	count=0
	for sys_disk in /sys/class/block/*; do
		[ -e "$sys_disk/device" ] || continue
		[ ! -e "$sys_disk/partition" ] || continue
		disk=$(basename "$sys_disk")
		for sys_block in "$sys_disk" "$sys_disk"/"$disk"*; do
			[ -e "$sys_block/dev" ] || continue
			[ "$sys_block" = "$sys_disk" ] ||
				[ -e "$sys_block/partition" ] || continue
			device=/dev/$(basename "$sys_block")
			[ -b "$device" ] || return 1
			[ "$(blockdev --getro "$device")" = 1 ] || return 1
			[ "$(cat "$sys_block/ro")" = 1 ] || return 1
			count=$((count + 1))
		done
	done
	[ "$count" -eq "$expected_physical_count" ]
}

find_exact_userdata() {
	[ "$#" -eq 2 ] || return 1
	sys_block_root=$1
	dev_root=$2
	userdata_count=0
	exact_count=0
	found=
	for sys_disk in "$sys_block_root"/*; do
		[ -e "$sys_disk/device" ] || continue
		[ ! -e "$sys_disk/partition" ] || continue
		disk=$(basename "$sys_disk") || return 1
		case $disk in sd[a-z]) ;; *) continue ;; esac
		for sys_block in "$sys_disk"/"$disk"*; do
			[ -e "$sys_block/partition" ] || continue
			partition_name=$(sed -n 's/^PARTNAME=//p' \
				"$sys_block/uevent" | sed -n '1p')
			[ "$partition_name" = userdata ] || continue
			userdata_count=$((userdata_count + 1))
			name=$(basename "$sys_block") || return 1
			[ "$name" = "${disk}23" ] || continue
			[ "$(cat "$sys_disk/size")" = 494927872 ] || continue
			[ "$(cat "$sys_disk/queue/logical_block_size")" = 4096 ] ||
				continue
			[ "$(cat "$sys_block/partition")" = 23 ] || continue
			[ "$(cat "$sys_block/start")" = 18821440 ] || continue
			[ "$(cat "$sys_block/size")" = 476106392 ] || continue
			[ "$(sed -n 's/^DEVNAME=//p' "$sys_block/uevent")" = \
				"$name" ] || continue
			[ "$(cat "$sys_block/ro")" = 1 ] || continue
			exact_count=$((exact_count + 1))
			found=$name
		done
	done
	[ "$userdata_count" -eq 1 ] && [ "$exact_count" -eq 1 ] || return 1
	printf '%s/%s\n' "$dev_root" "$found"
}

write_ufs_inventory() {
	inventory=/run/rog5-p2-ufs-inventory.tsv
	printf 'name\tkind\tpartition_number\tpartition_name\tmajor_minor\tread_only\tstart_sectors\tsize_sectors\tlogical_block_bytes\n' \
		>"$inventory"
	for sys_disk in /sys/class/block/*; do
		[ -e "$sys_disk/device" ] || continue
		[ ! -e "$sys_disk/partition" ] || continue
		disk=$(basename "$sys_disk")
		logical_block_bytes=$(cat "$sys_disk/queue/logical_block_size")
		for sys_block in "$sys_disk" "$sys_disk"/"$disk"*; do
			[ -e "$sys_block/dev" ] || continue
			if [ "$sys_block" = "$sys_disk" ]; then
				kind=disk
				partition_number=0
				partition_name=-
				start=0
			else
				[ -e "$sys_block/partition" ] || continue
				kind=partition
				partition_number=$(cat "$sys_block/partition")
				partition_name=$(sed -n 's/^PARTNAME=//p' \
					"$sys_block/uevent" | sed -n '1p')
				[ -n "$partition_name" ] || partition_name=-
				start=$(cat "$sys_block/start")
			fi
			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
				"$(basename "$sys_block")" "$kind" \
				"$partition_number" "$partition_name" \
				"$(cat "$sys_block/dev")" \
				"$(cat "$sys_block/ro")" "$start" \
				"$(cat "$sys_block/size")" \
				"$logical_block_bytes" >>"$inventory"
		done
	done
	[ "$(wc -l <"$inventory")" -eq $((expected_physical_count + 1)) ]
}

udc_candidate_count() {
	count=0
	for candidate in "$udc_class_dir"/*; do
		[ -e "$candidate" ] || continue
		count=$((count + 1))
	done
	printf '%s\n' "$count"
}

validate_expected_udc_once() {
	count=0
	selected=
	for candidate in "$udc_class_dir"/*; do
		[ -e "$candidate" ] || continue
		count=$((count + 1))
		selected=$(basename "$candidate") || return 1
	done
	[ "$count" -eq 1 ] && [ "$selected" = "$expected_udc" ] || return 1
	printf '%s\n' "$selected"
}

validate_expected_udc() {
	validate_expected_udc_once
}

expected_udc_is_bound() {
	bound_udc=$(cat "$gadget/UDC" 2>/dev/null) || return 1
	[ "$bound_udc" = "$expected_udc" ] &&
		[ "$(validate_expected_udc)" = "$expected_udc" ]
}

select_expected_udc() {
	attempt=0
	while [ "$attempt" -lt "$udc_poll_attempts" ]; do
		candidate_count=$(udc_candidate_count) || return 1
		case $candidate_count in
			0)
				sleep 0.1
				attempt=$((attempt + 1))
				continue
				;;
			1) ;;
			*) return 1 ;;
		esac
		first=$(validate_expected_udc) || return 1
		sleep 0.1
		second=$(validate_expected_udc) || return 1
		[ "$first" = "$second" ] || return 1
		printf '%s\n' "$first"
		return 0
	done
	return 1
}

configure_usb() {
	usb_mode=/sys/bus/platform/devices/a600000.ssusb/mode
	[ ! -e "$usb_mode" ] || echo peripheral >"$usb_mode" || return 1
	mount -t configfs configfs /sys/kernel/config || return 1

	gadget=/sys/kernel/config/usb_gadget/rog5-persistent-root
	mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409"
	echo 0x1d6b >"$gadget/idVendor"
	echo 0x0104 >"$gadget/idProduct"
	echo 0xef >"$gadget/bDeviceClass"
	echo 0x02 >"$gadget/bDeviceSubClass"
	echo 0x01 >"$gadget/bDeviceProtocol"
	echo Linux >"$gadget/strings/0x409/manufacturer"
	echo 'ROG5 persistent root' >"$gadget/strings/0x409/product"
	echo 'Read-only Arch root over NCM' \
		>"$gadget/configs/c.1/strings/0x409/configuration"
	mkdir -p "$gadget/functions/ncm.usb0"
	ln -s "$gadget/functions/ncm.usb0" "$gadget/configs/c.1/ncm.usb0"
	mdev -s || return 1

	udc=$(select_expected_udc) || return 1
	[ "$(validate_expected_udc)" = "$udc" ] || return 1
	echo "$udc" >"$gadget/UDC" || return 1
	expected_udc_is_bound || return 1

	attempt=0
	while [ "$attempt" -lt 100 ] && [ ! -e /sys/class/net/usb0 ]; do
		sleep 0.1
		attempt=$((attempt + 1))
	done
	[ -e /sys/class/net/usb0 ] || return 1
	ip link set usb0 up || return 1
	ip address add 169.254.77.2/30 dev usb0 || return 1
	expected_udc_is_bound || return 1
	return 0
}

deferred_ufs_modules_present() {
	[ -d /rog5-ufs-modules ] && [ ! -L /rog5-ufs-modules ]
}

wait_for_deferred_ufs_rendezvous() {
	attempt=0
	stable=0
	while [ "$attempt" -lt 150 ]; do
		if [ "$(cat /sys/class/net/usb0/carrier 2>/dev/null)" = 1 ]; then
			stable=$((stable + 1))
		else
			stable=0
		fi
		if [ "$stable" -ge 10 ]; then
			# Leave the host enough time to record the stable target identity
			# before the deliberately observed Qualcomm probe begins.
			sleep 3
			return 0
		fi
		attempt=$((attempt + 1))
		sleep 0.1
	done
	return 1
}

load_deferred_ufs_modules() {
	module_dir=/rog5-ufs-modules
	phy=$module_dir/phy-qcom-qmp-ufs.ko
	core=$module_dir/ufshcd-core.ko
	platform=$module_dir/ufshcd-pltfrm.ko
	qcom=$module_dir/ufs-qcom.ko
	[ -f "$phy" ] && [ ! -L "$phy" ] &&
		[ -f "$core" ] && [ ! -L "$core" ] &&
		[ -f "$platform" ] && [ ! -L "$platform" ] &&
		[ -f "$qcom" ] && [ ! -L "$qcom" ] || return 1
	[ "$(find "$module_dir" -mindepth 1 -maxdepth 1 -print |
		wc -l)" -eq 4 ] || return 1
	if grep -Eq '^(phy_qcom_qmp_ufs|ufshcd_core|ufshcd_pltfrm|ufs_qcom) ' \
		/proc/modules; then
		return 1
	fi
	log 'deferred Qualcomm UFS PHY probe begin'
	insmod /rog5-ufs-modules/phy-qcom-qmp-ufs.ko || return 1
	log 'deferred Qualcomm UFS PHY probe returned'
	grep -q '^phy_qcom_qmp_ufs ' /proc/modules || return 1
	grep -Eq '^(ufshcd_core|ufshcd_pltfrm|ufs_qcom) ' /proc/modules &&
		return 1

	insmod /rog5-ufs-modules/ufshcd-core.ko || return 1
	grep -q '^phy_qcom_qmp_ufs ' /proc/modules || return 1
	grep -q '^ufshcd_core ' /proc/modules || return 1
	grep -Eq '^(ufshcd_pltfrm|ufs_qcom) ' /proc/modules && return 1

	insmod /rog5-ufs-modules/ufshcd-pltfrm.ko || return 1
	grep -q '^phy_qcom_qmp_ufs ' /proc/modules || return 1
	grep -q '^ufshcd_core ' /proc/modules || return 1
	grep -q '^ufshcd_pltfrm ' /proc/modules || return 1
	grep -q '^ufs_qcom ' /proc/modules && return 1

	log 'deferred Qualcomm UFS host probe begin'
	insmod /rog5-ufs-modules/ufs-qcom.ko || return 1
	for loaded in phy_qcom_qmp_ufs ufshcd_core ufshcd_pltfrm ufs_qcom; do
		grep -q "^$loaded " /proc/modules || return 1
	done
	[ "$(grep -Ec '^(phy_qcom_qmp_ufs|ufshcd_core|ufshcd_pltfrm|ufs_qcom) ' \
		/proc/modules)" -eq 4 ] || return 1
	log 'deferred Qualcomm UFS host probe returned'
	return 0
}

verify_only_userdata_mount() {
	count=0
	userdata_name=${userdata##*/}
	expected_device=$(cat "/sys/class/block/$userdata_name/dev") || return 1
	while read -r _ _ device _ mountpoint _ rest; do
		[ -e "/sys/dev/block/$device" ] || continue
		count=$((count + 1))
		[ "$device" = "$expected_device" ] &&
			[ "$mountpoint" = /mnt/userdata ] || return 1
	done </proc/self/mountinfo
	[ "$count" -eq 1 ]
}

verify_userdata_and_image_mounts() {
	count=0
	userdata_name=${userdata##*/}
	loop_name=${root_loop##*/}
	expected_userdata=$(cat "/sys/class/block/$userdata_name/dev") || return 1
	expected_loop=$(cat "/sys/class/block/$loop_name/dev") || return 1
	while read -r _ _ device _ mountpoint _ rest; do
		[ -e "/sys/dev/block/$device" ] || continue
		count=$((count + 1))
		if [ "$device" = "$expected_userdata" ] &&
			[ "$mountpoint" = /mnt/userdata ]; then
			continue
		fi
		if [ "$device" = "$expected_loop" ] &&
			[ "$mountpoint" = /mnt/root-ro ]; then
			continue
		fi
		return 1
	done </proc/self/mountinfo
	[ "$count" -eq 2 ]
}

ext4_feature_flag() {
	features=$1
	feature=$2
	for current_feature in $features; do
		[ "$current_feature" = "$feature" ] && return 0
	done
	return 1
}

blkid_filesystem_type() {
	for blkid_field in $1; do
		case $blkid_field in
			'TYPE="ext4"') printf 'ext4\n'; return 0 ;;
			'TYPE="f2fs"') printf 'f2fs\n'; return 0 ;;
		esac
	done
	printf 'unknown\n'
}

filesystem_magic_type() {
	magic=$1
	[ "${#magic}" -eq 128 ] &&
		printf '%s\n' "$magic" | grep -Eq '^[0-9a-f]{128}$' || {
		printf 'unknown\n'
		return 0
	}
	[ "$(printf '%s\n' "$magic" | cut -c 1-8)" = 1020f5f2 ] && {
		printf 'f2fs\n'
		return 0
	}
	[ "$(printf '%s\n' "$magic" | cut -c 113-116)" = 53ef ] && {
		printf 'ext4\n'
		return 0
	}
	printf 'unknown\n'
}

classify_userdata_filesystem() {
	userdata_filesystem_detail=tunknown-bunknown-cx-ex-vx-qx-px-rx-ox
	blkid_record=$(blkid "$userdata" 2>&1) || {
		blkid_record=
	}
	blkid_type=$(blkid_filesystem_type "$blkid_record")
	magic_record=$(dd if="$userdata" bs=1 skip=1024 count=64 2>/dev/null |
		od -An -v -tx1 | tr -d ' \n') || {
		userdata_filesystem_detail=tmagic-b${blkid_type}-cx-ex-vx-qx-px-rx-ox
		return 0
	}
	magic_type=$(filesystem_magic_type "$magic_record")
	case $magic_type in
		f2fs)
			userdata_filesystem_detail=tf2fs-b${blkid_type}-cx-ex-vx-qx-px-rx-ox
			return 0
			;;
		ext4) ;;
		*)
			userdata_filesystem_detail=tunknown-b${blkid_type}-cx-ex-vx-qx-px-rx-ox
			return 0
			;;
	esac
	dumpe2fs_record=$(dumpe2fs -h "$userdata" 2>&1) || {
		userdata_filesystem_detail=te-b${blkid_type}-dump-cx-ex-vx-qx-px-rx-ox
		return 0
	}
	[ "${#dumpe2fs_record}" -le 32768 ] || {
		userdata_filesystem_detail=te-b${blkid_type}-large-cx-ex-vx-qx-px-rx-ox
		return 0
	}
	features=$(printf '%s\n' "$dumpe2fs_record" |
		sed -n 's/^Filesystem features:[[:space:]]*//p' | sed -n '1p')
	[ -n "$features" ] || {
		userdata_filesystem_detail=te-b${blkid_type}-features-cx-ex-vx-qx-px-rx-ox
		return 0
	}
	casefold=0; encrypt=0; verity=0; quota=0
	project=0; recovery=0; orphan=0
	ext4_feature_flag "$features" casefold && casefold=1
	ext4_feature_flag "$features" encrypt && encrypt=1
	ext4_feature_flag "$features" verity && verity=1
	ext4_feature_flag "$features" quota && quota=1
	ext4_feature_flag "$features" project && project=1
	ext4_feature_flag "$features" needs_recovery && recovery=1
	ext4_feature_flag "$features" orphan_file && orphan=1
	userdata_filesystem_detail=te-b${blkid_type}-c${casefold}-e${encrypt}-v${verity}-q${quota}-p${project}-r${recovery}-o${orphan}
	return 0
}

mount_persistent_root() {
	mount_persistent_root_failure=mkdir
	mkdir -p /mnt/userdata /mnt/root-ro /mnt/probe-root /mnt/state /newroot ||
		return 1
	mount_persistent_root_failure=filesystem-probe
	classify_userdata_filesystem || return 1
	mount_persistent_root_failure=mount-call
	mount_status=0
	mount_output=$(mount -t ext4 -o ro,noload "$userdata" /mnt/userdata 2>&1) ||
		mount_status=$?
	if [ "$mount_status" -ne 0 ]; then
		case $(dmesg | tail -n 80) in
			*'casefold feature cannot be mounted without CONFIG_UNICODE'*)
				mount_kernel_detail=casefold ;;
			*'unsupported optional features'*) mount_kernel_detail=incompat ;;
			*"Can't find ext4 filesystem"*) mount_kernel_detail=not-ext4 ;;
			*'required journal recovery suppressed'*) mount_kernel_detail=recovery ;;
			*'EXT4-fs '*'mount failed'*) mount_kernel_detail=ext4-failed ;;
			*)
				case $mount_output in
					*'Invalid argument'*) mount_kernel_detail=einval ;;
					*'wrong fs type'*) mount_kernel_detail=wrong-fs ;;
					*) mount_kernel_detail=other ;;
				esac
				;;
		esac
		mount_persistent_root_failure=mount-call-s${mount_status}-${userdata_filesystem_detail}-${mount_kernel_detail}
		return 1
	fi
	mount_persistent_root_failure=mountpoint
	mountpoint -q /mnt/userdata || return 1
	mount_persistent_root_failure=mount-table
	awk -v userdata="$userdata" '$1 == userdata && $2 == "/mnt/userdata" &&
		$3 == "ext4" && $4 ~ /(^|,)ro(,|$)/ { found++ }
		END { exit found != 1 }' /proc/mounts || return 1
	mount_persistent_root_failure=mount-inventory
	verify_only_userdata_mount || return 1
	mount_persistent_root_failure=storage-read-only
	verify_physical_storage_read_only || return 1

	mount_persistent_root_failure=rog5-directory
	for path in /mnt/userdata/rog5 /mnt/userdata/rog5/images; do
		[ -d "$path" ] && [ ! -L "$path" ] || return 1
	done
	mount_persistent_root_failure=selector-absence
	[ ! -e /mnt/userdata/rog5/state/good ] || return 1
	[ ! -e /mnt/userdata/rog5/state/next ] || return 1
	mount_persistent_root_failure=none
	return 0
}

publish_sparse_block_probe() {
	for probe_block in 1 32 1086 8224 8225 9278 14680096 14688288 14688289; do
		probe_hash=$(dd if="$userdata" bs=4096 skip="$probe_block" count=1 \
			2>/dev/null | sha256sum | cut -d ' ' -f 1) || return 1
		printf '%s\n' "$probe_hash" | grep -Eq '^[0-9a-f]{64}$' || return 1
		publish_stage userdata-mount ENTER \
			"raw-b${probe_block}-${probe_hash}" || return 1
		report_current_stage_once || true
		sleep 1
	done
}

resolve_local_root_image() {
	root_image=/mnt/userdata/rog5/images/arch-local-a.ext4
	[ -f "$root_image" ] && [ ! -L "$root_image" ] || return 1
	[ "$(stat -c '%u:%g:%a:%s:%h' "$root_image")" = \
		"0:0:600:$expected_image_bytes:1" ] || return 1
	return 0
}

verify_exact_userdata_write_window() {
	count=0
	writable=0
	for sys_disk in /sys/class/block/*; do
		[ -e "$sys_disk/device" ] || continue
		[ ! -e "$sys_disk/partition" ] || continue
		disk=$(basename "$sys_disk")
		for sys_block in "$sys_disk" "$sys_disk"/"$disk"*; do
			[ -e "$sys_block/dev" ] || continue
			[ "$sys_block" = "$sys_disk" ] ||
				[ -e "$sys_block/partition" ] || continue
			device=/dev/$(basename "$sys_block")
			[ -b "$device" ] || return 1
			expected_ro=1
			case $device in
				"$userdata_disk")
					expected_ro=0
					writable=$((writable + 1))
					blockdev_stage=write-window-selected-disk-blockdev
					sysfs_stage=write-window-selected-disk-sysfs
					;;
				"$userdata")
					expected_ro=0
					writable=$((writable + 1))
					blockdev_stage=write-window-selected-part-blockdev
					sysfs_stage=write-window-selected-part-sysfs
					;;
				/dev/sd[a-z])
					blockdev_stage=write-window-other-disk-blockdev
					sysfs_stage=write-window-other-disk-sysfs
					;;
				/dev/sd[a-z][0-9]*)
					blockdev_stage=write-window-other-part-blockdev
					sysfs_stage=write-window-other-part-sysfs
					;;
				*) return 1 ;;
			esac
			image_write_failure_stage=$blockdev_stage
			[ "$(blockdev --getro "$device")" = "$expected_ro" ] ||
				return 1
			image_write_failure_stage=$sysfs_stage
			[ "$(cat "$sys_block/ro")" = "$expected_ro" ] || return 1
			count=$((count + 1))
		done
	done
	image_write_failure_stage=write-window-count
	[ "$count" -eq "$expected_physical_count" ] && [ "$writable" -eq 2 ]
}

open_exact_userdata_write_window() {
	image_write_failure_stage=write-window-precheck
	case $userdata in /dev/sd[a-z]23) ;; *) return 1 ;; esac
	userdata_disk=${userdata%23}
	disk_name=${userdata_disk##*/}
	userdata_name=${userdata##*/}
	[ -b "$userdata_disk" ] && [ -b "$userdata" ] || return 1
	[ -e "/sys/class/block/$disk_name/device" ] &&
		[ ! -e "/sys/class/block/$disk_name/partition" ] &&
		[ -e "/sys/class/block/$userdata_name/partition" ] || return 1
	[ "$(cat "/sys/class/block/$userdata_name/partition")" = 23 ] ||
		return 1
	[ "$(sed -n 's/^PARTNAME=//p' \
		"/sys/class/block/$userdata_name/uevent" | sed -n '1p')" = userdata ] ||
		return 1
	verify_physical_storage_read_only || return 1
	# Keep the parent disk read-only until the exact partition flag is ready.
	image_write_failure_stage=userdata-partition-rw
	blockdev --setrw "$userdata" || return 1
	image_write_failure_stage=userdata-disk-rw
	blockdev --setrw "$userdata_disk" || {
		blockdev --setro "$userdata" || true
		return 1
	}
	verify_exact_userdata_write_window
}

close_exact_userdata_write_window() {
	close_status=0
	case $userdata_disk in /dev/sd[a-z]) ;; *) return 1 ;; esac
	case $userdata in "$userdata_disk"23) ;; *) return 1 ;; esac
	# Closing the parent first immediately blocks raw-disk and partition writes.
	blockdev --setro "$userdata_disk" || close_status=1
	blockdev --setro "$userdata" || close_status=1
	verify_physical_storage_read_only || close_status=1
	[ "$close_status" -eq 0 ]
}

verify_exact_local_image_probe() {
	probe_root=$1
	case $probe_root in
		/mnt/probe-root|/mnt/root-ro|/.rog5/root-ro) ;;
		*) return 1 ;;
	esac
	case $expected_ufs_storage_mode in
		local-write)
			[ "$expected_probe_boot_id" = current ] || return 1
			probe_boot_id=$target_boot_id
			;;
	read-only)
		if [ "$expected_probe_boot_id" = any-prior ]; then
			probe_boot_id=any-prior
		else
			printf '%s\n' "$expected_probe_boot_id" |
				grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' ||
					return 1
			[ "$expected_probe_boot_id" != "$target_boot_id" ] || return 1
			probe_boot_id=$expected_probe_boot_id
		fi
			;;
		*) return 1 ;;
	esac
	probe_dir=$probe_root/var/lib/rog5
	probe_path=$probe_dir/local-image-write-probe-v1
	if [ "$expected_probe_boot_id" = staged-seal ]; then
		[ ! -e "$probe_path" ] && [ ! -L "$probe_path" ]
		return
	fi
	for path in "$probe_root/var" "$probe_root/var/lib" "$probe_dir"; do
		[ -d "$path" ] && [ ! -L "$path" ] || return 1
	done
	[ -f "$probe_path" ] && [ ! -L "$probe_path" ] || return 1
	[ "$(stat -c '%u:%g:%a:%s:%h' "$probe_path")" = \
		"0:0:444:$expected_probe_bytes:1" ] || return 1
	[ "$(wc -l <"$probe_path")" -eq 3 ] || return 1
	if [ "$probe_boot_id" = any-prior ]; then
		probe_boot_id=$(sed -n 's/^boot_id=//p' "$probe_path") || return 1
		[ "$(grep -c '^boot_id=' "$probe_path")" -eq 1 ] || return 1
		printf '%s\n' "$probe_boot_id" |
			grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' ||
			return 1
		[ "$probe_boot_id" != "$target_boot_id" ] || return 1
	fi
	grep -Fxq 'format=rog5-local-image-write-probe-v1' "$probe_path" ||
		return 1
	grep -Fxq "image_uuid=$expected_image_uuid" "$probe_path" || return 1
	grep -Fxq "boot_id=$probe_boot_id" "$probe_path" || return 1
}

write_exact_local_image_probe() {
	probe_root=/mnt/probe-root
	probe_dir=$probe_root/var/lib/rog5
	probe_path=$probe_dir/local-image-write-probe-v1
	probe_next=$probe_path.next
	for path in "$probe_root/var" "$probe_root/var/lib"; do
		[ -d "$path" ] && [ ! -L "$path" ] || return 1
	done
	[ ! -e "$probe_dir" ] && [ ! -L "$probe_dir" ] || return 1
	mkdir -m 0700 "$probe_dir" || return 1
	if ! (umask 077 && printf '%s\n' \
		'format=rog5-local-image-write-probe-v1' \
		"image_uuid=$expected_image_uuid" \
		"boot_id=$target_boot_id" >"$probe_next" &&
		chmod 0444 "$probe_next" &&
		mv "$probe_next" "$probe_path"); then
		rm -f "$probe_next" "$probe_path" || true
		rmdir "$probe_dir" || true
		return 1
	fi
	verify_exact_local_image_probe "$probe_root"
}

run_local_image_write_probe() {
	probe_status=0
	probe_loop=
	probe_loop_attached=0
	probe_mounted=0
	userdata_mounted=0
	image_write_failure_stage=userdata-unmount
	[ -d /mnt/probe-root ] && [ ! -L /mnt/probe-root ] || {
		image_write_failure_stage=image-fs-rw
		return 1
	}

	umount /mnt/userdata || return 1
	open_exact_userdata_write_window || {
		close_exact_userdata_write_window || true
		return 1
	}
	image_write_failure_stage=userdata-rw
	if mount -t ext4 -o rw,nodev,nosuid,noexec,noatime \
		"$userdata" /mnt/userdata; then
		userdata_mounted=1
	else
		probe_status=1
	fi
	if [ "$probe_status" -eq 0 ]; then
		mountpoint -q /mnt/userdata || probe_status=1
		verify_only_userdata_mount || probe_status=1
		verify_exact_userdata_write_window || probe_status=1
		resolve_local_root_image || probe_status=1
	fi
	if [ "$probe_status" -eq 0 ]; then
		image_write_failure_stage=image-loop-rw
	fi
	if [ "$probe_status" -eq 0 ]; then
		probe_loop=$(losetup -f) || probe_status=1
		case $probe_loop in /dev/loop[0-9]*) ;; *) probe_status=1 ;; esac
	fi
	if [ "$probe_status" -eq 0 ]; then
		probe_loop_name=${probe_loop##*/}
		[ -b "$probe_loop" ] &&
			[ -d "/sys/class/block/$probe_loop_name" ] || probe_status=1
	fi
	if [ "$probe_status" -eq 0 ]; then
		if losetup "$probe_loop" "$root_image"; then
			probe_loop_attached=1
		else
			probe_status=1
		fi
	fi
	if [ "$probe_status" -eq 0 ]; then
		[ "$(blockdev --getro "$probe_loop")" = 0 ] || probe_status=1
		[ "$(blockdev --getsize64 "$probe_loop")" = \
			"$expected_image_bytes" ] || probe_status=1
		probe_backing=$(cat \
			"/sys/class/block/$probe_loop_name/loop/backing_file") ||
			probe_status=1
		case $probe_backing in
			/mnt/userdata/rog5/images/arch-local-a.ext4|\
			mnt/userdata/rog5/images/arch-local-a.ext4) ;;
			*) probe_status=1 ;;
		esac
		probe_blkid=$(blkid "$probe_loop") || probe_status=1
		printf '%s\n' "$probe_blkid" |
			grep -Fq " UUID=\"$expected_image_uuid\"" || probe_status=1
		printf '%s\n' "$probe_blkid" |
			grep -Fq " LABEL=\"$expected_image_label\"" || probe_status=1
		printf '%s\n' "$probe_blkid" |
			grep -Fq ' TYPE="ext4"' || probe_status=1
	fi
	if [ "$probe_status" -eq 0 ]; then
		image_write_failure_stage=image-fs-rw
	fi
	if [ "$probe_status" -eq 0 ] &&
		mount -t ext4 -o rw,nodev,nosuid,noexec,noatime \
		"$probe_loop" /mnt/probe-root; then
		probe_mounted=1
	else
		probe_status=1
	fi
	if [ "$probe_status" -eq 0 ]; then
		image_write_failure_stage=image-probe
		write_exact_local_image_probe || probe_status=1
	fi
	if [ "$probe_status" -eq 0 ]; then
		image_write_failure_stage=storage-relock
	fi
	sync || probe_status=1

	if [ "$probe_mounted" -eq 1 ]; then
		umount /mnt/probe-root || probe_status=1
	fi
	if [ "$probe_loop_attached" -eq 1 ]; then
		losetup -d "$probe_loop" || probe_status=1
	fi
	if [ "$userdata_mounted" -eq 1 ]; then
		umount /mnt/userdata || probe_status=1
	fi
	close_exact_userdata_write_window || probe_status=1
	[ "$probe_status" -eq 0 ] || return 1

	# Resume the established immutable runtime only after every UFS node is RO.
	mount_persistent_root || return 1
	resolve_local_root_image || return 1
	image_write_failure_stage=image-write
	return 0
}

mount_local_root_image() {
	root_loop=$(losetup -f) || return 1
	case $root_loop in /dev/loop[0-9]*) ;; *) return 1 ;; esac
	loop_name=${root_loop##*/}
	[ -b "$root_loop" ] && [ -d "/sys/class/block/$loop_name" ] || return 1
	losetup -r "$root_loop" "$root_image" || return 1
	[ "$(blockdev --getro "$root_loop")" = 1 ] || return 1
	[ "$(blockdev --getsize64 "$root_loop")" = "$expected_image_bytes" ] ||
		return 1
	[ "$(cat "/sys/class/block/$loop_name/ro")" = 1 ] || return 1
	backing_file=$(cat "/sys/class/block/$loop_name/loop/backing_file") ||
		return 1
	case $backing_file in
		/mnt/userdata/rog5/images/arch-local-a.ext4|\
		mnt/userdata/rog5/images/arch-local-a.ext4) ;;
		*) return 1 ;;
	esac
	blkid_record=$(blkid "$root_loop") || return 1
	printf '%s\n' "$blkid_record" |
		grep -Fq " UUID=\"$expected_image_uuid\"" || return 1
	printf '%s\n' "$blkid_record" |
		grep -Fq " LABEL=\"$expected_image_label\"" || return 1
	printf '%s\n' "$blkid_record" |
		grep -Fq ' TYPE="ext4"' || return 1
	mount -t ext4 -o ro,noload,nodev,nosuid,noatime \
		"$root_loop" /mnt/root-ro || return 1
	awk -v loop="$root_loop" '$1 == loop && $2 == "/mnt/root-ro" &&
		$3 == "ext4" && $4 ~ /(^|,)ro(,|$)/ &&
		$4 ~ /(^|,)nodev(,|$)/ && $4 ~ /(^|,)nosuid(,|$)/ {
			found++
		}
		END { exit found != 1 }' /proc/mounts || return 1
	verify_userdata_and_image_mounts || return 1
	printf '%s\n' "$root_loop" >/run/rog5-p2-root-loop-device || return 1
	chmod 0444 /run/rog5-p2-root-loop-device || return 1
	return 0
}

verify_ufs_health() {
	blocked_query_count=$(dmesg |
		grep -F -c 'ROG5 UFS discovery: blocked device query' || true)
	blocked_scsi_count=$(dmesg |
		grep -F -c 'ROG5 UFS discovery: blocked SCSI opcode' || true)
	journal_recovery_count=$(dmesg |
		grep -E -i -c 'EXT4-fs.*(journal recovery|recovery complete|recovering journal)' ||
		true)
	ufs_error_count=$(dmesg |
		grep -E -i -c '(ufshcd|ufshcd-qcom|scsi|sd [0-9]).*(fatal|abort|reset|I/O error|timed out)' ||
		true)
	printf '%s\n' "$blocked_query_count" >/run/rog5-p2-blocked-query-count
	printf '%s\n' "$blocked_scsi_count" >/run/rog5-p2-blocked-scsi-count
	printf '%s\n' "$journal_recovery_count" \
		>/run/rog5-p2-journal-recovery-count
	printf '%s\n' "$ufs_error_count" >/run/rog5-p2-ufs-error-count
	[ "$blocked_query_count" -eq 0 ] &&
		[ "$blocked_scsi_count" -eq 0 ] &&
		[ "$journal_recovery_count" -eq 0 ] &&
		[ "$ufs_error_count" -eq 0 ]
}

verify_exact_regular() {
	path=$1
	owner=$2
	group=$3
	mode=$4
	size=$5
	hash=$6
	[ -f "$path" ] && [ ! -L "$path" ] || return 1
	[ "$(stat -c '%u:%g:%a:%s:%h' "$path")" = \
		"$owner:$group:$mode:$size:1" ] || return 1
	[ "$(sha256sum "$path" | cut -d ' ' -f 1)" = "$hash" ]
}

verify_persistent_root() {
	root=/mnt/root-ro
	seal=$root/.rog5-persistent-seal
	verify_exact_regular "$seal" 0 0 444 430 "$expected_seal_sha256" ||
