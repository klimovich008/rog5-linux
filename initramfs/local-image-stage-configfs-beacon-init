#!/bin/sh
set -eu
set -f

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
reboot_helper=/usr/libexec/rog5-reboot-bootloader
expected_udc=a600000.usb

return_bootloader() {
	sync || true
	"$reboot_helper" || true
	while :; do sleep 3600; done
}

delayed_return() {
	sleep "$1"
	return_bootloader
}

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mkdir -p /sys/kernel/config
echo /sbin/mdev >/proc/sys/kernel/hotplug 2>/dev/null || :
mdev -s || :

(
	sleep 120
	return_bootloader
) &

mount -t configfs configfs /sys/kernel/config || delayed_return 5
gadget=/sys/kernel/config/usb_gadget/rog5-configfs-beacon
mkdir -p "$gadget/strings/0x409" \
	"$gadget/configs/c.1/strings/0x409" || delayed_return 10
{
	echo 0x1d6b >"$gadget/idVendor"
	echo 0x0104 >"$gadget/idProduct"
	echo 0xef >"$gadget/bDeviceClass"
	echo 0x02 >"$gadget/bDeviceSubClass"
	echo 0x01 >"$gadget/bDeviceProtocol"
	echo Linux >"$gadget/strings/0x409/manufacturer"
	echo 'ROG5 local image stage' >"$gadget/strings/0x409/product"
	echo 'ConfigFS beacon' >"$gadget/configs/c.1/strings/0x409/configuration"
} || delayed_return 15
mkdir -p "$gadget/functions/ncm.usb0" \
	"$gadget/functions/acm.usb0" || delayed_return 20
{
	ln -s "$gadget/functions/ncm.usb0" "$gadget/configs/c.1/ncm.usb0"
	ln -s "$gadget/functions/acm.usb0" "$gadget/configs/c.1/acm.usb0"
} || delayed_return 25

attempt=0
while [ "$attempt" -lt 200 ] && [ ! -e "/sys/class/udc/$expected_udc" ]; do
	attempt=$((attempt + 1))
	sleep 0.1
done
[ -e "/sys/class/udc/$expected_udc" ] || delayed_return 15
set -- /sys/class/udc/*
[ "$#" -eq 1 ] && [ "$(basename "$1")" = "$expected_udc" ] ||
	delayed_return 45
echo "$expected_udc" >"$gadget/UDC" || delayed_return 55

sleep 30
return_bootloader
