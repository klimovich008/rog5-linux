#!/bin/sh
set -u

bb=/bin/busybox
action=${1:-reboot}

log() {
	printf 'rog5-network-root-exitrd: %s\n' "$*" >/dev/kmsg 2>/dev/null ||
		printf 'rog5-network-root-exitrd: %s\n' "$*" >/dev/console 2>/dev/null ||
		true
}

move_mount() {
	source=$1
	target=$2

	[ -d "$source" ] || return 0
	"$bb" mountpoint -q "$source" || return 0
	"$bb" mkdir -p "$target" || return 1
	if "$bb" mount --move "$source" "$target"; then
		log "moved $source to $target"
		return 0
	fi
	log "failed to move $source to $target"
	return 1
}

unmount_mount() {
	target=$1

	"$bb" mountpoint -q "$target" || return 0
	if "$bb" umount "$target"; then
		log "unmounted $target"
		return 0
	fi
	log "normal unmount failed for $target"
	return 1
}

lazy_unmount() {
	target=$1

	"$bb" mountpoint -q "$target" || return 0
	"$bb" umount -l "$target" 2>/dev/null || true
}

log "starting action=$action"
"$bb" mount -o remount,rw / 2>/dev/null || true
"$bb" mkdir -p /oldsys

clean=1
move_mount /oldroot/.rog5/root-ro /oldsys/root-ro || clean=0
move_mount /oldroot/.rog5/state /oldsys/state || clean=0
for api in sys proc run dev; do
	move_mount "/oldroot/$api" "/oldsys/$api" || clean=0
done

"$bb" sync
unmount_mount /oldroot || clean=0
unmount_mount /oldsys/state || clean=0
unmount_mount /oldsys/root-ro || clean=0

if [ "$clean" -eq 1 ]; then
	log 'overlay root and backing filesystems unmounted cleanly'
else
	log 'clean teardown incomplete; detaching volatile mounts before reset'
	lazy_unmount /oldroot
	lazy_unmount /oldsys/state
	lazy_unmount /oldsys/root-ro
fi
for api in run dev sys proc; do
	lazy_unmount "/oldsys/$api"
done
"$bb" sync

case $action in
	reboot) "$bb" reboot -f -n ;;
	poweroff) "$bb" poweroff -f -n ;;
	halt) "$bb" halt -f -n ;;
	kexec)
		log 'kexec is unavailable in the minimal exitrd; rebooting'
		"$bb" reboot -f -n
		;;
	*)
		log "unknown action=$action; rebooting"
		"$bb" reboot -f -n
		;;
esac

log 'orderly action returned; using emergency reset'
printf b >/proc/sysrq-trigger 2>/dev/null || true
while :; do "$bb" sleep 3600; done
