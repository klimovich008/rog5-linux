#!/bin/sh
# Read-only, RAM-only source observer. The caller bounds this whole process.
# Absence/failure of its receipt denies later RAM admission; never delays fallback.
set -eu
bb=/bin/busybox
diagnostics=0
case $# in
	2) ;;
	3) [ "$3" = --diagnostics ] || exit 1; diagnostics=1 ;;
	*) exit 1 ;;
esac
[ "$2" = reboot ] || exit 1
case $1 in 1) ;; 0) [ "$diagnostics" = 1 ] || exit 1 ;; *) exit 1 ;; esac
clean=$1
cd /
for path in shutdown rog5-source-teardown rog5-source-teardown.intent rog5-source-teardown.sha256; do
	[ -f "$path" ] && [ ! -L "$path" ] || exit 1
	case $path in
		shutdown) expected=0:0:755:1 ;;
		*) expected=0:0:444:1 ;;
	esac
	[ "$("$bb" stat -c '%u:%g:%a:%h' "$path")" = "$expected" ] || exit 1
	[ "$("$bb" stat -c '%s' "$path")" -le 16384 ] || exit 1
done
[ "$("$bb" wc -l <rog5-source-teardown.sha256)" -eq 3 ] || exit 1
"$bb" awk '
 NR==1 { if (NF!=2 || $2!="shutdown") exit 1 }
 NR==2 { if (NF!=2 || $2!="rog5-source-teardown") exit 1 }
 NR==3 { if (NF!=2 || $2!="rog5-source-teardown.intent") exit 1 }
 { if (length($1)!=64 || $1 ~ /[^0-9a-f]/) exit 1 }
 END { if (NR!=3) exit 1 }
' rog5-source-teardown.sha256 || exit 1
"$bb" sha256sum -c rog5-source-teardown.sha256 >/dev/null || exit 1
"$bb" awk -F= '
 BEGIN { split("boot_id release nonce shutdown_sha256 observer_sha256 physical_nodes", keys, " ") }
 NF!=2 || NR>6 || $1!=keys[NR] { exit 1 }
 NR==1 { if (length($2)!=36 || $2 ~ /[^0-9a-f-]/) exit 1 }
 NR==2 { if (length($2)<1 || length($2)>80 || $2 ~ /[^A-Za-z0-9._+-]/) exit 1 }
 NR>=3 && NR<=5 { if (length($2)!=64 || $2 ~ /[^0-9a-f]/) exit 1 }
 NR==6 { if ($2!="117") exit 1 }
 END { if (NR!=6) exit 1 }
' rog5-source-teardown.intent || exit 1
field() { "$bb" sed -n "s/^$1=//p" /rog5-source-teardown.intent; }
boot_id=$(field boot_id)
release=$(field release)
nonce=$(field nonce)
shutdown_sha256=$(field shutdown_sha256)
observer_sha256=$(field observer_sha256)
[ "$("$bb" cat /oldsys/proc/sys/kernel/random/boot_id)" = "$boot_id" ] || exit 1
[ "$("$bb" uname -r)" = "$release" ] || exit 1
[ "$("$bb" sha256sum /shutdown | "$bb" cut -d ' ' -f 1)" = "$shutdown_sha256" ] || exit 1
[ "$("$bb" sha256sum /rog5-source-teardown | "$bb" cut -d ' ' -f 1)" = "$observer_sha256" ] || exit 1
# Diagnostics start only after validating the staged bytes and source identity.
# Each phase is sent once. A failed diagnostic send disables later diagnostics,
# while the enclosing five-second timeout still bounds this entire observer.
diagnostic() {
	[ "$diagnostics" = 1 ] || return 0
	diagnostic_reason=none
	[ "$1" != fail ] || diagnostic_reason=$reason
	printf '%s\n' 'format=rog5-source-teardown-diagnostic-v2' "boot_id=$boot_id" \
		"nonce=$nonce" "shutdown_sha256=$shutdown_sha256" "observer_sha256=$observer_sha256" \
		"phase=$phase" "clean=$clean" "state=$1" "reason=$diagnostic_reason" |
		"$bb" nc -n -w 1 -s 169.254.77.2 169.254.77.1 8079 >/dev/null 2>&1 || diagnostics=0
	return 0
}
phase=teardown
reason=unclean
diagnostic begin
if [ "$diagnostics" = 1 ]; then
	trap 'status=$?; if [ "$status" -ne 0 ]; then diagnostic fail; fi' EXIT
fi
[ "$clean" = 1 ] || exit 1
phase=mounts
reason=mount-read
diagnostic begin
# After exact teardown only RAM/API mounts may remain. Unknown filesystems refuse.
[ -f /oldsys/proc/self/mountinfo ] && [ -r /oldsys/proc/self/mountinfo ] || exit 1
reason=mount-command
if mount_reason=$("$bb" awk '
 function refuse(why) { failure=why; exit 1 }
 function device(value) {
   split(value,parts,":")
   return value ~ /^[0-9]+:[0-9]+$/ && length(parts[1])<=10 && length(parts[2])<=10 ? value : "invalid" }
 BEGIN { allowed["rootfs"]; allowed["tmpfs"]; allowed["ramfs"]; allowed["devtmpfs"];
 allowed["proc"]; allowed["sysfs"]; allowed["devpts"]; allowed["configfs"];
 allowed["securityfs"]; allowed["cgroup2"]; allowed["pstore"]; allowed["debugfs"];
 allowed["tracefs"]; allowed["bpf"]; allowed["mqueue"]; allowed["fusectl"]; allowed["binfmt_misc"];
 allowed["hugetlbfs"] }
 { separator=0; for (i=7;i<=NF;i++) if ($i=="-") { separator=i; break }
   if (!separator || separator+3!=NF) refuse("mount-row:" NR)
   if (!($(separator+1) in allowed)) {
     fs=$(separator+1)
     if (fs !~ /^[A-Za-z0-9_.-]+$/ || length(fs)>32) fs="unknown"
     refuse("mount-filesystem:" fs ":" device($3)) }
   if ($3 !~ /^0:[0-9]+$/) refuse("mount-device:" device($3))
   if ($5=="/oldsys/proc" && $(separator+1)=="proc") seen_proc=1
   if ($5=="/oldsys/sys" && $(separator+1)=="sysfs") seen_sys=1
   if ($5=="/oldsys/dev" && $(separator+1)=="devtmpfs") seen_dev=1
   if ($5=="/" && $(separator+1) ~ /^(rootfs|tmpfs|ramfs)$/) seen_root=1 }
 END {
   if (!failure) {
     if (!seen_root) failure="mount-missing:root"
     else if (!seen_proc) failure="mount-missing:proc"
     else if (!seen_sys) failure="mount-missing:sys"
     else if (!seen_dev) failure="mount-missing:dev" }
   if (failure) { print failure; exit 1 } }
' /oldsys/proc/self/mountinfo 2>&1); then
	[ -z "$mount_reason" ] || exit 1
else
	mount_status=$?
	# Only one bounded classifier value is forwarded. Applet/open stderr is
	# retained in this comparison so END output cannot hide a command error.
	reason=mount-command:$mount_status
	if [ "$mount_status" = 1 ] && [ "${#mount_reason}" -le 96 ]; then
		case $mount_reason in
			''|*[!A-Za-z0-9_.:-]*) ;;
			mount-row:*|mount-filesystem:*|mount-device:*|mount-missing:*) reason=$mount_reason ;;
		esac
	fi
	exit 1
fi
reason=check-failed
phase=loops
diagnostic begin
for path in /oldsys/sys/class/block/loop*/loop; do
	[ ! -e "$path" ] && [ ! -L "$path" ] || exit 1
done
phase=physical
diagnostic begin
count=0
for path in /oldsys/sys/class/block/sd*; do
	[ -e "$path/dev" ] || continue
	name=${path##*/}
	case $name in sd[a-z]|sd[a-z][0-9]*) ;; *) exit 1 ;; esac
	[ ! -L "/oldsys/dev/$name" ] || exit 1
	IFS= read -r dev <"$path/dev" || exit 1
	major=${dev%:*} minor=${dev#*:}
	case $major in ''|*[!0-9]*) exit 1 ;; esac
	case $minor in ''|*[!0-9]*) exit 1 ;; esac
	[ "$dev" = "$major:$minor" ] || exit 1
	device=$(printf 'block special file:%x:%x' "$major" "$minor") || exit 1
	[ "$("$bb" stat -c '%F:%t:%T' "/oldsys/dev/$name")" = "$device" ] || exit 1
	IFS= read -r ro <"$path/ro" || exit 1
	[ "$ro" = 1 ] || exit 1
	[ "$("$bb" blockdev --getro "/oldsys/dev/$name")" = 1 ] || exit 1
	count=$((count + 1))
done
[ "$count" -eq 117 ] || exit 1
phase=receipt
diagnostic begin
# One transmission only. A zero netcat exit is not evidence of host receipt.
printf '%s\n' 'format=rog5-source-teardown-v1' "boot_id=$boot_id" "nonce=$nonce" \
	"shutdown_sha256=$shutdown_sha256" "observer_sha256=$observer_sha256" \
	'physical_nodes=117' 'mounts=clear' 'loops=clear' 'physical_ro=all' 'result=PASS' |
	"$bb" nc -n -w 1 -s 169.254.77.2 169.254.77.1 8079 >/dev/null 2>&1
