#!/bin/sh
# Commit this boot of the default production bundle as healthy.
#
# The slot-B loader boots the selector's primary bundle only while its
# try-once record (userdata /rog5/boot/wifi-trial-state) is absent or healthy,
# and re-arms it to pending on every primary boot. Without this commit, the
# next boot takes the fallback bundle (V11). A boot that is not the selected
# trial (a RAM trial, or the fallback) finds a different record and changes
# nothing. Any failure leaves the record pending.
#
# Health is: current-boot P2 and SSH identity, sshd listening, only the
# userdata write window writable, battery below 45 C, the production module
# tree published by the init (/run/rog5-production-modules.record) and
# rog5-platform-modules.service succeeded, and the local shell came up
# locked once during this boot (see local_shell_ready). A boot that reaches
# SSH but not the phone's display/lock screen therefore stays pending and the
# next boot takes the fallback, which still gives SSH.
set -u
root=${ROG5_TRIAL_KIT:-/run/rog5-production-trial}
run=${ROG5_TRIAL_RUN:-/run}
sys=${ROG5_TRIAL_SYS:-/sys}
proc=${ROG5_TRIAL_PROC:-/proc}
kmsg=${ROG5_TRIAL_KMSG:-/dev/kmsg}
descriptor=$root/trial-descriptor
helper=$root/trial-state
limit=${ROG5_TRIAL_WAIT:-180}
systemctl=${ROG5_TRIAL_SYSTEMCTL:-systemctl}
loginctl=${ROG5_TRIAL_LOGINCTL:-loginctl}
rootfs=${ROG5_TRIAL_ROOT:-}

log() {
	printf 'rog5-production-trial: %s\n' "$*" >"$kmsg" 2>/dev/null ||
		printf 'rog5-production-trial: %s\n' "$*" >&2
}

fail() {
	log "FAIL $*"
	exit 1
}

[ -f "$descriptor" ] && [ ! -L "$descriptor" ] || fail 'trial descriptor missing'
[ "$(wc -l <"$descriptor")" -eq 4 ] &&
	[ "$(sed -n 1p "$descriptor")" = format=rog5-persistent-wifi-health-v1 ] &&
	[ "$(sed -n 4p "$descriptor")" = mode=try-once ] || fail 'trial descriptor format'
trial_id=$(sed -n 's/^trial_id=//p' "$descriptor")
primary=$(sed -n 's/^primary_bundle=//p' "$descriptor")
[ "$(sed -n 2p "$descriptor")" = "trial_id=$trial_id" ] &&
	[ "$(sed -n 3p "$descriptor")" = "primary_bundle=$primary" ] ||
	fail 'trial descriptor fields'
case $trial_id in ''|*[!0-9a-f]*) fail 'trial id' ;; esac
[ "${#trial_id}" -eq 64 ] || fail 'trial id length'
case $primary in ''|*[!a-z0-9._-]*|*..*|[._-]*) fail 'primary bundle name' ;; esac
[ -x "$helper" ] && [ ! -L "$helper" ] || fail 'trial helper missing'
boot_id=$(cat "$proc/sys/kernel/random/boot_id") || fail 'boot id'
release=$(cat "$proc/sys/kernel/osrelease") || fail 'kernel release'

if ! state=$("$helper" state "$trial_id" "$primary" 2>/dev/null); then
	log "SKIP this boot is not the selected try-once trial of $primary"
	exit 0
fi
case $state in
	pending|healthy) ;;
	failed) log "SKIP the $primary trial is already failed"; exit 0 ;;
	*) fail "unexpected trial state $state" ;;
esac

# The phone's local shell must have reached its lock screen once during this
# boot: the logind session led by rog5-phosh.service's main process with
# LockedHint=yes (Phosh publishes its startup lock with packages/phosh 0002).
# That needs msm, the panel, phoc and Phosh. The unit starts before Phosh can
# (it is not ordered after the SSH services; ready() waits for them), so the
# first poll precedes the startup lock and a PIN cannot be entered between
# two polls. Once seen it is latched in $shell_latch for this boot, so an
# unlock, a desktop-mode switch, a Phosh restart or a restart of this unit
# does not hold the commit back. A GNOME Mobile boot
# (/run/rog5-shell/effective) needs GDM active and the boot-bound readiness
# record of its rog5-shell watchdog (answering shell, touchscreen, lit
# panel; the GDM greeter is the lock there). A boot without Phosh (not
# installed, or rog5-phosh.service disabled or masked: a headless server)
# commits without a local shell.
shell_latch=$run/rog5-production-trial-shell
locked_session=
latch_shell() {
	locked_session=$1
	printf 'boot_id=%s\nshell=%s\n' "$boot_id" "$locked_session" \
		>"$shell_latch.next" && chmod 0444 "$shell_latch.next" &&
		mv -f "$shell_latch.next" "$shell_latch" ||
		log "WARN could not record the local shell latch"
}

if [ -f "$shell_latch" ] && [ ! -L "$shell_latch" ] &&
	[ "$(stat -c '%u:%a' "$shell_latch")" = 0:444 ] &&
	[ "$(sed -n 1p "$shell_latch")" = "boot_id=$boot_id" ]; then
	locked_session=$(sed -n 's/^shell=\([A-Za-z0-9_-]\{1,64\}\)$/\1/p' "$shell_latch")
fi

local_shell_ready() {
	[ -z "$locked_session" ] || return 0
	effective=$(cat "$run/rog5-shell/effective" 2>/dev/null) || effective=phosh
	if [ "$effective" = gnome-mobile ]; then
		mobile=$run/rog5-shell/mobile-ready
		[ -f "$mobile" ] && [ ! -L "$mobile" ] &&
			[ "$(stat -c %u "$mobile")" = 0 ] &&
			[ "$(cat "$mobile")" = "boot_id=$boot_id" ] || return 1
		"$systemctl" is-active --quiet gdm.service || return 1
		latch_shell gdm
		return 0
	fi
	[ -x "$rootfs/usr/bin/phosh-session" ] || { locked_session=none; return 0; }
	case $("$systemctl" is-enabled rog5-phosh.service 2>/dev/null) in
		disabled|masked|masked-runtime) locked_session=none; return 0 ;;
	esac
	leader=$("$systemctl" show -p MainPID --value rog5-phosh.service 2>/dev/null) ||
		return 1
	case $leader in ''|0|*[!0-9]*) return 1 ;; esac
	for session in $("$loginctl" list-sessions --no-legend 2>/dev/null |
		awk '$1 ~ /^[A-Za-z0-9_-]+$/ { print $1 }'); do
		properties=$("$loginctl" show-session "$session" \
			-p Leader -p State -p LockedHint 2>/dev/null) || continue
		printf '%s\n' "$properties" | grep -Fxq "Leader=$leader" || continue
		printf '%s\n' "$properties" | grep -Fxq 'State=closing' && continue
		printf '%s\n' "$properties" | grep -Fxq 'LockedHint=yes' || continue
		latch_shell "$session"
		return 0
	done
	return 1
}

modules_ready() {
	record=$run/rog5-production-modules.record
	[ -f "$record" ] && [ ! -L "$record" ] &&
		[ "$(stat -c '%u:%g:%a' "$record")" = 0:0:444 ] &&
		[ "$(cat "$record")" = "release=$release" ] || return 1
	"$systemctl" is-active --quiet rog5-platform-modules.service
}

waiting=
ready() {
	# Polled every pass so the lock screen is seen even before SSH is up.
	local_shell_ready || waiting='local shell locked'
	modules_ready || { waiting='production modules'; return 1; }
	[ -n "$locked_session" ] || return 1
	waiting='p2, ssh, storage or battery'
	p2=$run/rog5-p2-ready
	identity=$run/rog5-persistent-ssh-identity.record
	[ -f "$p2" ] && [ ! -L "$p2" ] && [ "$(stat -c '%u:%g:%a' "$p2")" = 0:0:444 ] &&
		grep -Fxq status=PASS "$p2" &&
		grep -Fxq "attested_boot_id=$boot_id" "$p2" || return 1
	[ -f "$identity" ] && [ ! -L "$identity" ] &&
		[ "$(stat -c '%u:%g:%a' "$identity")" = 0:0:444 ] &&
		grep -Fxq "identity_boot_id=$boot_id" "$identity" || return 1
	# sshd listening on 0.0.0.0:22.
	grep -q ': 00000000:0016 00000000:0000 0A ' "$proc/net/tcp" || return 1
	for node in "$sys"/class/block/sd*; do
		[ -e "$node/ro" ] || continue
		# A USB disk (resolved sysfs path under a usbN bus: a flash drive, a
		# hub's card reader) is not the UFS and may stay writable.
		case $(readlink -f "$node") in */usb[0-9]*/*) continue ;; esac
		[ "$(cat "$node/ro")" = 1 ] && continue
		case ${node##*/} in sda|sda23) ;; *) return 1 ;; esac
	done
	temp=$(cat "$sys/class/power_supply/qcom-battmgr-bat/temp" 2>/dev/null) || temp=
	case $temp in ''|*[!0-9-]*) ;; *) [ "$temp" -lt 450 ] || return 1 ;; esac
	return 0
}

waited=0
until ready; do
	if "$systemctl" is-failed --quiet rog5-platform-modules.service; then
		fail "rog5-platform-modules.service failed; record stays $state, so the next boot takes the fallback"
	fi
	waited=$((waited + 1))
	[ "$waited" -lt "$limit" ] ||
		fail "health not reached in $limit s (waiting for $waiting); record stays $state, so the next boot takes the fallback"
	sleep 1
done
result=$("$helper" healthy "$trial_id" "$primary") || fail 'trial commit'
case $result in healthy|already-healthy) ;; *) fail "trial commit result $result" ;; esac
log "PASS $primary committed $result for boot $boot_id after $waited s (local shell: $locked_session)"
