#!/bin/sh
set -eu
set -f

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
expected_release=@EXPECTED_KERNEL_RELEASE@
expected_bundle=@EXPECTED_BUNDLE@
reboot_helper=/usr/libexec/rog5-reboot-bootloader

log() {
	echo "rog5-preusb-diagnostic: $*" >/dev/kmsg 2>/dev/null || true
}

return_bootloader() {
	sync || true
	"$reboot_helper" || true
	while :; do sleep 3600; done
}

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mkdir -p /run
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run 2>/dev/null || true
echo /sbin/mdev >/proc/sys/kernel/hotplug 2>/dev/null || :
mdev -s || :
hostname rog5-preusb-diagnostic || :

(
	sleep 60
	log watchdog
	return_bootloader
) &

if [ "$(uname -r)" != "$expected_release" ]; then
	log kernel-release
	sleep 5
	return_bootloader
fi

bundle_count=0
persistent_count=0
discovery_count=0
for token in $(cat /proc/cmdline); do
	[ "$token" = "rog5.bundle=$expected_bundle" ] &&
		bundle_count=$((bundle_count + 1))
	[ "$token" = rog5.persistent_ro=1 ] &&
		persistent_count=$((persistent_count + 1))
	[ "$token" = rog5.ufs_discovery=1 ] &&
		discovery_count=$((discovery_count + 1))
done
if [ "$bundle_count:$persistent_count:$discovery_count" != 1:1:1 ]; then
	log command-line
	sleep 15
	return_bootloader
fi

log preusb-checks-pass
sleep 25
return_bootloader
