@@ -15003,6 +15024,8 @@ update_resource_scale (ClutterActor *self,
   if (old_resource_scale == -1.f)
     return;
 
+  g_signal_emit (self, actor_signals[REAL_RESOURCE_SCALE_CHANGED], 0);
