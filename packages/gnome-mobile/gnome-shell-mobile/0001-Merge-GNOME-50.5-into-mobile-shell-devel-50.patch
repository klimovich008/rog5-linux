+
+#: data/50-gnome-shell-system.xml:9
+msgid "Show the notification list"
+msgstr "ᱤᱛᱞᱟᱹᱭ ᱛᱟᱞᱠᱟ ᱩᱫᱩᱜᱽ ᱢᱮ"
+
