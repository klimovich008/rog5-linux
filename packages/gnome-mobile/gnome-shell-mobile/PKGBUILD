prepare() {
  # Inject gvc
  ln -sfn libgnome-volume-control gvc

  cd gnome-shell-mobile
  local p
  for p in "${source[@]}"; do
    [[ $p = *.patch ]] || continue
    echo "Applying $p"
    git apply --whitespace=nowarn "$srcdir/$p"
  done
}

build() {
  local meson_options=(
    -D gtk_doc=false
    -D tests=false
  )

  CFLAGS="${CFLAGS/-O2/-O3} -fno-semantic-interposition"
  LDFLAGS+=" -Wl,-Bsymbolic-functions"

  # Inject subprojects
  export MESON_PACKAGE_CACHE_DIR="$srcdir"

  arch-meson gnome-shell-mobile build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  rm -rf "$pkgdir"/usr/share/doc
}

