#!/bin/bash
# /usr/local/bin/eden (ROG5): start Eden with its four emulated-CPU threads
# (CPUCore_0..3) pinned one each to the fast cores 4..7 (Cortex-A78 x3, X1).
# Unpinned, these threads often run on the A55 cores and BotW drops to ~26 fps;
# pinned it holds its 30 fps cap (2026-10-03 benchmark, packages/eden/README.md).
# Shader compilers, audio and other threads stay free to use every core.
# Turnip: force sysmem rendering (pixel-identical; +3.4 fps unpinned in BotW, gmem is far worse)
TU_DEBUG=${TU_DEBUG:-sysmem} /usr/bin/eden "$@" &
pid=$!
# Games create CPUCore_0..3 when they start (again after a stop/restart): re-pin every 3 s.
while kill -0 $pid 2>/dev/null; do
    for t in /proc/$pid/task/*; do
        case "$(cat "$t/comm" 2>/dev/null)" in
        CPUCore_[0-3]) c=$(cat "$t/comm"); taskset -p -c $((4 + ${c#CPUCore_})) "${t##*/}" >/dev/null 2>&1 ;;
        esac
    done
    sleep 3
done
wait $pid
