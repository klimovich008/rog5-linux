+    ROG5_TLS_ACCESSOR std::size_t CurrentPhysicalCoreIndex() const;
 
     /// Gets the sole instance of the Scheduler at the current running core.
     Kernel::KScheduler* CurrentScheduler();
 
     /// Gets the an instance of the current physical CPU core.
-    Kernel::PhysicalCore& CurrentPhysicalCore();
+    ROG5_TLS_ACCESSOR Kernel::PhysicalCore& CurrentPhysicalCore();
 
     /// Gets the an instance of the current physical CPU core.
-    const Kernel::PhysicalCore& CurrentPhysicalCore() const;
+    ROG5_TLS_ACCESSOR const Kernel::PhysicalCore& CurrentPhysicalCore() const;
 
     /// Gets the an instance of the hardware timer.
     Kernel::KHardwareTimer& HardwareTimer();
