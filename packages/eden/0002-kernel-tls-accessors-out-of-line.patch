@@ -39,6 +39,18 @@
 class ServiceManager;
 }
 
+// ROG5: these read Impl's thread_local state. Guest fibers resume on other host
+// threads, and once inlined (LTO/-O3) the compiler keeps the thread-local address
+// of the previous host thread across Fiber::YieldTo, so a host thread acts as the
+// wrong emulated core (scheduler GetDisableDispatchCount asserts, dynarmic
+// !is_executing, NCE SIGUSR2 to a stale thread). Keep them out of line so every
+// call computes the address on the thread that is running.
+#if defined(__GNUC__)
+#define ROG5_TLS_ACCESSOR [[gnu::noinline]]
+#else
+#define ROG5_TLS_ACCESSOR
+#endif
+
 namespace Kernel {
 
 class KClientPort;
