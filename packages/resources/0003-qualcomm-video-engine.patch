+        assert_eq!(data.active, Some(true));
+        assert_eq!(data.counters.unwrap().active, 123);
+        std::fs::write(iris.join("power/runtime_status"), "suspended\n").unwrap();
+        assert_eq!(VideoEngineData::new(data.inner).active, Some(false));
+        let data = VideoEngineData::new(engines.next().unwrap());
+        assert_eq!(data.inner.sysfs_path, venus);
