+        std::fs::create_dir_all(proc.join("43")).unwrap(); // no readable fd directory
+        std::fs::create_dir_all(proc.join("self/fd")).unwrap(); // not a PID
+        std::fs::write(proc.join("42/comm"), "mpv\n").unwrap();
+        for (fd, target) in [
+            ("0", "/dev/video0"),
+            ("1", "/dev/video1"),
+            ("2", "/dev/video2"),
+            ("3", "/dev/null"),
