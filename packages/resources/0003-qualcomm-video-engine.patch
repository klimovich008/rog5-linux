new file mode 100644
index 0000000..082fc9f
--- /dev/null
+++ b/src/utils/video.rs
@@ -0,0 +1,315 @@
+use std::{
+    collections::{BTreeMap, HashSet},
+    path::{Path, PathBuf},
+};
+
+use super::read_parsed;
+
+const PATH_VIDEO4LINUX: &str = "/sys/class/video4linux";
+const DRIVER_NAMES: &[&str] = &["qcom-iris", "qcom-venus"];
+
+#[derive(Debug, Clone)]
+pub struct VideoEngine {
+    pub sysfs_path: PathBuf,
+    pub driver: String,
+    /// Device node and V4L2 name (e.g. qcom-iris-decoder).
+    pub nodes: Vec<(PathBuf, String)>,
+}
+
+#[derive(Debug, Clone, Copy)]
+pub struct RuntimeCounters {
+    active: u64,
+    suspended: u64,
+}
+
+impl RuntimeCounters {
+    /// Runtime-PM residency, not codec throughput or separate encode/decode utilization.
+    pub fn busy_since(self, previous: Self) -> Option<f64> {
+        let active = self.active.checked_sub(previous.active)?;
+        let suspended = self.suspended.checked_sub(previous.suspended)?;
+        let total = u128::from(active) + u128::from(suspended);
+        (total > 0).then(|| active as f64 / total as f64)
+    }
+}
+
+#[derive(Debug)]
+pub struct VideoUser {
+    pub pid: i32,
+    pub name: String,
+}
+
+#[derive(Debug)]
+pub struct VideoEngineData {
+    pub inner: VideoEngine,
+    pub active: Option<bool>,
+    pub counters: Option<RuntimeCounters>,
+    pub users: Vec<VideoUser>,
+}
+
+impl VideoEngine {
+    fn discover(class_path: &Path) -> Vec<Self> {
+        let Ok(entries) = std::fs::read_dir(class_path) else {
+            return Vec::new();
+        };
+        let mut engines: BTreeMap<PathBuf, Self> = BTreeMap::new();
+        for entry in entries.flatten() {
+            let node_name = entry.file_name().to_string_lossy().into_owned();
+            if !node_name.strip_prefix("video").is_some_and(|suffix| {
+                !suffix.is_empty() && suffix.bytes().all(|byte| byte.is_ascii_digit())
+            }) {
+                continue;
+            }
+            let Ok(device) = std::fs::canonicalize(entry.path().join("device")) else {
+                continue;
+            };
+            // Venus can expose nodes on a child of the platform codec device.
+            let Some((path, driver)) = device.ancestors().find_map(|path| {
+                let driver = std::fs::read_link(path.join("driver")).ok()?;
+                let driver = driver.file_name()?.to_str()?;
+                DRIVER_NAMES
+                    .contains(&driver)
+                    .then(|| (path.to_path_buf(), driver.to_string()))
+            }) else {
+                continue;
+            };
+            let name = read_parsed::<String>(entry.path().join("name")).unwrap_or_default();
+            engines
+                .entry(path.clone())
+                .or_insert_with(|| Self {
+                    sysfs_path: path,
+                    driver,
+                    nodes: Vec::new(),
+                })
+                .nodes
+                .push((Path::new("/dev").join(node_name), name));
+        }
+        engines
+            .into_values()
+            .map(|mut engine| {
+                engine.nodes.sort();
+                engine
+            })
+            .collect()
+    }
+}
+
+impl VideoEngineData {
+    pub fn collect() -> Vec<Self> {
+        let mut data: Vec<_> = VideoEngine::discover(Path::new(PATH_VIDEO4LINUX))
+            .into_iter()
+            .map(Self::new)
+            .collect();
+        if !data.is_empty() {
+            read_users(&mut data, Path::new("/proc"));
+        }
+        data
+    }
+
+    fn new(inner: VideoEngine) -> Self {
+        let power = inner.sysfs_path.join("power");
+        let active = read_parsed::<String>(power.join("runtime_status"))
+            .ok()
+            .and_then(|status| match status.as_str() {
+                "active" => Some(true),
+                "suspended" => Some(false),
+                _ => None,
+            });
+        let counters = read_parsed::<u64>(power.join("runtime_active_time"))
+            .ok()
+            .zip(read_parsed::<u64>(power.join("runtime_suspended_time")).ok())
+            .map(|(active, suspended)| RuntimeCounters { active, suspended });
+        Self {
+            inner,
+            active,
+            counters,
+            users: Vec::new(),
+        }
+    }
+}
+
+/// Scan once for all engines. Inaccessible or disappearing processes/fds are normal.
+fn read_users(data: &mut [VideoEngineData], proc_path: &Path) {
+    let Ok(processes) = std::fs::read_dir(proc_path) else {
+        return;
+    };
+    let nodes: BTreeMap<_, _> = data
+        .iter()
+        .enumerate()
+        .flat_map(|(index, engine)| {
+            engine
+                .inner
+                .nodes
+                .iter()
+                .map(move |(node, _)| (node.clone(), index))
+        })
+        .collect();
+    for process in processes.flatten() {
+        let Ok(pid) = process.file_name().to_string_lossy().parse::<i32>() else {
+            continue;
+        };
+        let Ok(fds) = std::fs::read_dir(process.path().join("fd")) else {
+            continue;
+        };
+        let engines: HashSet<_> = fds
+            .flatten()
+            .filter_map(|fd| std::fs::read_link(fd.path()).ok())
+            .filter_map(|target| nodes.get(&target).copied())
+            .collect();
+        if engines.is_empty() {
+            continue;
+        }
+        let name = read_parsed::<String>(process.path().join("comm"))
+            .ok()
+            .filter(|name| !name.is_empty())
+            .or_else(|| {
+                std::fs::read_link(process.path().join("exe"))
+                    .ok()?
+                    .file_name()
+                    .map(|name| name.to_string_lossy().into_owned())
+            })
+            .unwrap_or_else(|| pid.to_string());
+        for index in engines {
+            data[index].users.push(VideoUser {
+                pid,
+                name: name.clone(),
+            });
+        }
+    }
+    for engine in data {
+        engine.users.sort_by_key(|user| user.pid);
+    }
+}
