+    #[test]
+    fn discovery_groups_nodes_and_reads_platform_power() {
+        let fixture = Fixture::new("discovery");
+        let iris = fixture.node(
+            "video0", "aa00000.video-codec", "qcom-iris", "qcom-iris-decoder",
+        );
+        fixture.node(
+            "video1", "aa00000.video-codec", "qcom-iris", "qcom-iris-encoder",
+        );
+        let venus = fixture.node(
+            "video2", "bb00000.video-codec", "qcom-venus", "qcom-venus-decoder",
+        );
+        fixture.node("video3", "camera", "uvcvideo", "USB Camera");
+        // A Venus node with an intermediate child device still belongs to the platform engine.
+        std::fs::remove_file(fixture.0.join("class/video2/device")).unwrap();
+        std::fs::create_dir_all(venus.join("decoder")).unwrap();
+        symlink(venus.join("decoder"), fixture.0.join("class/video2/device")).unwrap();
+        std::fs::write(iris.join("power/runtime_status"), "active\n").unwrap();
+        std::fs::write(iris.join("power/runtime_active_time"), "123\n").unwrap();
+        std::fs::write(iris.join("power/runtime_suspended_time"), "456\n").unwrap();
+        let mut engines = VideoEngine::discover(&fixture.0.join("class")).into_iter();
+        let data = VideoEngineData::new(engines.next().unwrap());
+        assert_eq!(data.inner.sysfs_path, iris);
+        assert_eq!(data.inner.nodes.len(), 2);
+        assert_eq!(
+            data.inner.nodes[0],
+            (PathBuf::from("/dev/video0"), "qcom-iris-decoder".into()),
