+use crate::utils::video::{RuntimeCounters, VideoEngine, VideoEngineData};
+
+pub const TAB_ID_PREFIX: &str = "video";
+
+mod imp {
+    use std::cell::{Cell, RefCell};
+
+    use crate::ui::{pages::VIDEO_PRIMARY_ORD, widgets::graph_box::ResGraphBox};
+
+    use super::*;
+
+    use gtk::{
+        CompositeTemplate,
+        gio::{Icon, ThemedIcon},
+        glib::{ParamSpec, Properties, Value},
+    };
+
+    #[derive(CompositeTemplate, Properties)]
+    #[template(resource = "/net/nokyan/Resources/ui/pages/video.ui")]
+    #[properties(wrapper_type = super::ResVideo)]
+    pub struct ResVideo {
+        #[template_child]
+        pub busy: TemplateChild<ResGraphBox>,
+        #[template_child]
+        pub state: TemplateChild<adw::ActionRow>,
+        #[template_child]
+        pub codecs: TemplateChild<adw::ActionRow>,
+        #[template_child]
+        pub users: TemplateChild<adw::ActionRow>,
+
+        pub previous_counters: Cell<Option<RuntimeCounters>>,
+
+        #[property(get)]
+        uses_progress_bar: Cell<bool>,
+
+        #[property(get)]
+        main_graph_color: glib::Bytes,
+
+        #[property(get)]
+        icon: RefCell<Icon>,
+
+        #[property(get, set)]
+        usage: Cell<f64>,
+
+        #[property(get = Self::tab_name, set = Self::set_tab_name, type = glib::GString)]
+        tab_name: Cell<glib::GString>,
+
+        #[property(get = Self::tab_detail_string, set = Self::set_tab_detail_string, type = glib::GString)]
+        tab_detail_string: Cell<glib::GString>,
+
+        #[property(get = Self::tab_usage_string, set = Self::set_tab_usage_string, type = glib::GString)]
+        tab_usage_string: Cell<glib::GString>,
+
+        #[property(get = Self::tab_id, set = Self::set_tab_id, type = glib::GString)]
+        tab_id: Cell<glib::GString>,
+
+        #[property(get)]
+        graph_locked_max_y: Cell<bool>,
+
+        #[property(get)]
+        primary_ord: Cell<u32>,
+
+        #[property(get, set)]
+        secondary_ord: Cell<u32>,
+    }
+
+    impl ResVideo {
+        gstring_getter_setter!(tab_name, tab_detail_string, tab_usage_string, tab_id);
+    }
+
+    impl Default for ResVideo {
+        fn default() -> Self {
+            Self {
+                busy: Default::default(),
+                state: Default::default(),
+                codecs: Default::default(),
+                users: Default::default(),
+                previous_counters: Default::default(),
+                uses_progress_bar: Cell::new(true),
+                main_graph_color: glib::Bytes::from_static(&super::ResVideo::MAIN_GRAPH_COLOR),
+                icon: RefCell::new(ThemedIcon::new("video-x-generic-symbolic").into()),
+                usage: Default::default(),
+                tab_name: Cell::new(glib::GString::from(i18n("Video engine"))),
+                tab_detail_string: Cell::new(glib::GString::new()),
+                tab_id: Cell::new(glib::GString::new()),
+                tab_usage_string: Cell::new(glib::GString::new()),
+                graph_locked_max_y: Cell::new(true),
+                primary_ord: Cell::new(VIDEO_PRIMARY_ORD),
+                secondary_ord: Default::default(),
+            }
+        }
+    }
+
+    #[glib::object_subclass]
+    impl ObjectSubclass for ResVideo {
+        const NAME: &'static str = "ResVideo";
+        type Type = super::ResVideo;
+        type ParentType = adw::Bin;
+
+        fn class_init(klass: &mut Self::Class) {
+            Self::bind_template(klass);
+        }
+
+        // You must call `Widget`'s `init_template()` within `instance_init()`.
+        fn instance_init(obj: &glib::subclass::InitializingObject<Self>) {
+            obj.init_template();
+        }
+    }
+
+    impl ObjectImpl for ResVideo {
+        fn constructed(&self) {
+            self.parent_constructed();
+            let obj = self.obj();
+
+            // Devel Profile
+            if PROFILE == "Devel" {
+                obj.add_css_class("devel");
+            }
+        }
+
+        fn properties() -> &'static [ParamSpec] {
+            Self::derived_properties()
+        }
+
+        fn set_property(&self, id: usize, value: &Value, pspec: &ParamSpec) {
+            self.derived_set_property(id, value, pspec);
+        }
+
+        fn property(&self, id: usize, pspec: &ParamSpec) -> Value {
+            self.derived_property(id, pspec)
+        }
+    }
+
+    impl WidgetImpl for ResVideo {}
+    impl BinImpl for ResVideo {}
+}
+
+glib::wrapper! {
+    pub struct ResVideo(ObjectSubclass<imp::ResVideo>)
+        @extends gtk::Widget, adw::Bin,
+        @implements gtk::Buildable, gtk::ConstraintTarget, gtk::Accessible;
+}
+
+impl Default for ResVideo {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl ResVideo {
+    const MAIN_GRAPH_COLOR: [u8; 3] = [0x91, 0x41, 0xac];
+
+    pub fn new() -> Self {
+        trace!("Creating ResVideo GObject…");
+        glib::Object::new::<Self>()
+    }
+
+    pub fn init(&self, engine: &VideoEngine, secondary_ord: u32) {
+        let imp = self.imp();
+        self.set_secondary_ord(secondary_ord);
+        imp.set_tab_id(&format!("{}-{}", TAB_ID_PREFIX, engine.sysfs_path.display()));
+        imp.set_tab_detail_string(&engine.driver);
+        imp.busy.set_title_label(&i18n("Busy"));
+        imp.busy.set_tooltip(Some(&i18n(
+            "Time runtime-active, including autosuspend delay",
+        )));
+        imp.busy.graph().set_graph_color(
+            Self::MAIN_GRAPH_COLOR[0],
+            Self::MAIN_GRAPH_COLOR[1],
+            Self::MAIN_GRAPH_COLOR[2],
+        );
+    }
+
+    pub fn refresh_page(&self, data: &VideoEngineData, apps: &AppsContext) {
+        let imp = self.imp();
+        let previous = imp.previous_counters.replace(data.counters);
+        let busy = data
+            .counters
+            .zip(previous)
+            .and_then(|(current, previous)| current.busy_since(previous));
+        let busy_string = busy.map_or_else(
+            || i18n("N/A"),
+            |fraction| format!("{} %", (fraction * 100.0).round()),
+        );
+        imp.busy.set_subtitle(&busy_string);
+        imp.busy.graph().push_data_point(busy.unwrap_or(0.0));
+        imp.busy.graph().set_visible(busy.is_some());
+        self.set_usage(busy.unwrap_or(0.0));
+        let state = match data.active {
+            Some(true) => i18n("Active"),
+            Some(false) => i18n("Idle"),
+            None => i18n("N/A"),
+        };
+        imp.state.set_subtitle(&state);
+        self.set_property("tab_usage_string", format!("{busy_string} · {state}"));
+
+        let codecs = data
+            .inner
+            .nodes
+            .iter()
+            .map(|(node, name)| {
+                let role = if name.contains("decoder") {
+                    i18n("Decoder")
+                } else if name.contains("encoder") {
+                    i18n("Encoder")
+                } else {
+                    name.clone()
+                };
+                format!("{role} ({})", node.display())
+            })
+            .collect::<Vec<_>>()
+            .join("\n");
+        imp.codecs.set_subtitle(&glib::markup_escape_text(&codecs));
+
+        let users = data
+            .users
+            .iter()
+            .map(|user| {
+                let name = apps
+                    .apps_iter()
+                    .find(|app| {
+                        app.id.is_some()
+                            && app
+                                .processes_iter(apps)
+                                .any(|process| process.data.pid == user.pid)
+                    })
+                    .map(|app| app.display_name.as_str())
+                    .or_else(|| {
+                        apps.get_process(user.pid)
+                            .map(|process| process.display_name.as_str())
+                    })
+                    .unwrap_or(&user.name);
+                format!("{name} ({})", user.pid)
+            })
+            .collect::<Vec<_>>()
+            .join("\n");
+        imp.users.set_subtitle(&glib::markup_escape_text(
+            &if users.is_empty() { i18n("None detected") } else { users },
+        ));
+    }
+}
