+    #[test]
+    fn runtime_residency_and_counter_reset() {
+        let previous = RuntimeCounters {
+            active: 100,
+            suspended: 900,
+        };
+        for (active, suspended, expected) in [
+            (350, 1650, Some(0.25)),
+            (100, 1900, Some(0.0)),
+            (1100, 900, Some(1.0)),
+            (100, 900, None), // no elapsed time
+            (0, 0, None), // counters reset
+            (200, 0, None), // suspended counter reset
+        ] {
+            assert_eq!(
+                RuntimeCounters { active, suspended }.busy_since(previous),
+                expected,
+            );
+        }
+    }
