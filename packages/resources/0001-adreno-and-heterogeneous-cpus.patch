+/// Returns whether the DRM device at `sysfs_device_path` exposes a render node (renderD*).
+fn has_render_node(sysfs_device_path: &Path) -> bool {
+    glob(&format!("{}/drm/renderD*", sysfs_device_path.to_string_lossy()))
+        .is_ok_and(|mut paths| paths.any(|path| path.is_ok()))
+}
+
+/// Derives a human-readable GPU name from a devicetree `compatible` file (a list of
+/// NUL-separated strings), e.g. "qcom,adreno-660.1" → "Qualcomm Adreno 660".
+fn of_compatible_name<P: AsRef<Path>>(compatible_path: P) -> Result<String> {
+    let compatible = read_parsed::<String>(compatible_path)?;
+
+    compatible
+        .split('\0')
+        .find_map(|compatible| {
+            RE_ADRENO_COMPATIBLE
+                .captures(compatible)
+                .and_then(|captures| captures.get(1))
+                .map(|model| format!("Qualcomm Adreno {}", model.as_str()))
+        })
+        .context("no known devicetree compatible")
+}
diff --git a/src/utils/gpu/msm.rs b/src/utils/gpu/msm.rs
new file mode 100644
index 0000000..562f3c6
--- /dev/null
+++ b/src/utils/gpu/msm.rs
@@ -0,0 +1,146 @@
+use anyhow::{Context, Result, bail};
+use glob::glob;
+use process_data::gpu_usage::GpuIdentifier;
+
+use std::path::{Path, PathBuf};
+
+use crate::utils::{pci::Device, read_parsed};
+
+use super::GpuImpl;
+
+/// Drivers used by Qualcomm Adreno GPUs: `adreno` is the platform driver bound to the GPU
+/// device, `msm` is the name of the DRM driver.
+pub const DRIVER_NAMES: &[&str] = &["adreno", "msm"];
+
+#[derive(Debug, Clone, Default)]
+
+pub struct MsmGpu {
+    pub device: Option<&'static Device>,
+    pub gpu_identifier: GpuIdentifier,
+    pub driver: String,
+    sysfs_path: PathBuf,
+    first_hwmon_path: Option<PathBuf>,
+}
+
+impl MsmGpu {
+    pub fn new(
+        device: Option<&'static Device>,
+        gpu_identifier: GpuIdentifier,
+        driver: String,
+        sysfs_path: PathBuf,
+        first_hwmon_path: Option<PathBuf>,
+    ) -> Self {
+        Self {
+            device,
+            gpu_identifier,
+            driver,
+            sysfs_path,
+            first_hwmon_path,
+        }
+    }
+
+    /// Current GPU frequency as reported by devfreq, in Hz.
+    fn devfreq_core_frequency(&self) -> Result<f64> {
+        let cur_freq = glob(&format!(
+            "{}/device/devfreq/*/cur_freq",
+            self.sysfs_path.to_string_lossy()
+        ))?
+        .flatten()
+        .next()
+        .context("no devfreq found")?;
+
+        read_parsed::<f64>(cur_freq)
+    }
+
+    /// Highest temperature of the thermal zones covering the GPU (e.g. `gpu-top-thermal` and
+    /// `gpu-bottom-thermal`), in °C.
+    fn thermal_zone_temperature() -> Result<f64> {
+        glob("/sys/class/thermal/thermal_zone*")?
+            .flatten()
+            .filter(|path| {
+                read_parsed::<String>(path.join("type")).is_ok_and(|zone_type| {
+                    zone_type.starts_with("gpu") && zone_type.ends_with("thermal")
+                })
+            })
+            .filter_map(|path| read_parsed::<f64>(path.join("temp")).ok())
+            .map(|millicelsius| millicelsius / 1000.0)
+            .reduce(f64::max)
+            .context("no GPU thermal zone found")
+    }
+}
+
+impl GpuImpl for MsmGpu {
+    fn device(&self) -> Option<&'static Device> {
+        self.device
+    }
+
+    fn gpu_identifier(&self) -> GpuIdentifier {
+        self.gpu_identifier
+    }
+
+    fn driver(&self) -> &str {
+        &self.driver
+    }
+
+    fn sysfs_path(&self) -> &Path {
+        &self.sysfs_path
+    }
+
+    fn first_hwmon(&self) -> Option<&Path> {
+        self.first_hwmon_path.as_deref()
+    }
+
+    fn name(&self) -> Result<String> {
+        self.drm_name()
+    }
+
+    fn usage(&self) -> Result<f64> {
+        self.drm_usage().map(|usage| usage as f64 / 100.0)
+    }
+
+    fn encode_usage(&self) -> Result<f64> {
+        bail!("encode usage not implemented for msm")
+    }
+
+    fn decode_usage(&self) -> Result<f64> {
+        bail!("decode usage not implemented for msm")
