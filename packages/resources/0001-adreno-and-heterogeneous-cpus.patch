 impl CpuInfo {
+    /// Splits `lscpu` output into its per-core-type sections. Heterogeneous CPUs (e.g. ARM
+    /// big.LITTLE) get one section per core type, each beginning with its "Model name:" line.
+    fn lscpu_core_type_sections(lscpu_output: &str) -> Vec<&str> {
+        let starts: Vec<usize> = RE_LSCPU_MODEL_NAME
+            .find_iter(lscpu_output)
+            .map(|m| m.start())
+            .collect();
+
+        if starts.is_empty() {
+            return vec![lscpu_output];
+        }
+
+        starts
+            .iter()
+            .enumerate()
+            .map(|(i, start)| {
+                let end = starts.get(i + 1).copied().unwrap_or(lscpu_output.len());
+                &lscpu_output[*start..end]
+            })
+            .collect()
+    }
+
+    fn capture_parsed<T: std::str::FromStr>(regex: &Regex, haystack: &str) -> Option<T> {
+        regex
+            .captures(haystack)
+            .and_then(|captures| captures.get(1))
+            .and_then(|capture| capture.as_str().trim().parse().ok())
+    }
+
     fn parse_lscpu<S: AsRef<str>>(lscpu_output: S) -> Self {
