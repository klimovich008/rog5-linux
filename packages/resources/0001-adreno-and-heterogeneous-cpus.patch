 const KNOWN_THERMAL_ZONES: &[&str] = &["cpu-thermal", "x86_pkg_temp", "acpitz"];
 
-static RE_LSCPU_MODEL_NAME: Lazy<Regex> = lazy_regex!(r"Model name:\s*(.*)");
+// Per-core or per-cluster thermal zones as found on many ARM SoCs, e.g. "cpu0-thermal",
+// "cpu4-top-thermal" or "cluster0-thermal"
+static RE_CPU_THERMAL_ZONE: Lazy<Regex> = lazy_regex!(r"^(cpu|cluster)[0-9a-z_-]*thermal$");
+
+static RE_LSCPU_MODEL_NAME: Lazy<Regex> = lazy_regex!(r"(?m)^\s*Model name:\s*(.*)$");
 
 static RE_LSCPU_ARCHITECTURE: Lazy<Regex> = lazy_regex!(r"Architecture:\s*(.*)");
 
 static RE_LSCPU_CPUS: Lazy<Regex> = lazy_regex!(r"CPU\(s\):\s*(.*)");
 
-static RE_LSCPU_SOCKETS: Lazy<Regex> = lazy_regex!(r"Socket\(s\):\s*(.*)");
+static RE_LSCPU_SOCKETS: Lazy<Regex> = lazy_regex!(r"(?m)^\s*Socket\(s\):\s*(.*)$");
 
-static RE_LSCPU_CORES: Lazy<Regex> = lazy_regex!(r"Core\(s\) per socket:\s*(.*)");
+static RE_LSCPU_CORES: Lazy<Regex> = lazy_regex!(r"(?m)^\s*Core\(s\) per socket:\s*(.*)$");
 
 static RE_LSCPU_VIRTUALIZATION: Lazy<Regex> = lazy_regex!(r"Virtualization:\s*(.*)");
 
-static RE_LSCPU_MAX_MHZ: Lazy<Regex> = lazy_regex!(r"CPU max MHz:\s*(.*)");
+static RE_LSCPU_MAX_MHZ: Lazy<Regex> = lazy_regex!(r"(?m)^\s*CPU max MHz:\s*(.*)$");
 
 static RE_PROC_STAT: Lazy<Regex> = lazy_regex!(
     r"cpu\d+ *(?P<user>\d*) *(?P<nice>\d*) *(?P<system>\d*) *(?P<idle>\d*) *(?P<iowait>\d*) *(?P<irq>\d*) *(?P<softirq>\d*) *(?P<steal>\d*) *(?P<guest>\d*) *(?P<guest_nice>\d*)"
 );
 
-static CPU_TEMPERATURE_PATH: LazyLock<Option<PathBuf>> = LazyLock::new(|| {
+/// Paths of the CPU temperature sensors, the CPU temperature is the highest of them
+static CPU_TEMPERATURE_PATHS: LazyLock<Vec<PathBuf>> = LazyLock::new(|| {
     search_for_hwmons(KNOWN_HWMONS)
         .or_else(|| search_for_thermal_zones(KNOWN_THERMAL_ZONES))
-        .or_else(|| {
+        .map(|path| vec![path])
+        .or_else(search_for_cpu_thermal_zones)
+        .unwrap_or_else(|| {
             warn!("No CPU temperature sensor found!");
-            None
+            Vec::new()
         })
 });
 
@@ -102,6 +109,28 @@ fn search_for_thermal_zones(types: &[&'static str]) -> Option<PathBuf> {
     None
 }
 
+fn search_for_cpu_thermal_zones() -> Option<Vec<PathBuf>> {
+    trace!("Collecting per-core and per-cluster thermal zones for CPU temperature…");
+
+    let paths: Vec<PathBuf> = glob("/sys/class/thermal/thermal_zone*")
+        .unwrap()
+        .flatten()
+        .filter(|path| {
+            read_parsed::<String>(path.join("type"))
+                .is_ok_and(|read_type| RE_CPU_THERMAL_ZONE.is_match(&read_type))
+        })
+        .map(|path| path.join("temp"))
+        .collect();
+
+    if paths.is_empty() {
+        trace!("No per-core or per-cluster CPU thermal zones found");
+        None
+    } else {
+        debug!("CPU temperature sensors located at {paths:?} (type: thermal zones, using maximum)");
+        Some(paths)
+    }
+}
