@@ -320,11 +415,21 @@ pub fn get_cpu_usage() -> Vec<Result<(u64, u64)>> {
 ///
 /// Will return `Err` if there was no way to read the CPU temperature.
 pub fn get_temperature() -> Result<f32> {
-    if let Some(path) = CPU_TEMPERATURE_PATH.as_ref() {
