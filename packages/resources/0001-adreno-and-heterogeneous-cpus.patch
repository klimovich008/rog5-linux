-                    .map(|capture| Self::trade_mark_symbols(capture.as_str()))
+        let sections = Self::lscpu_core_type_sections(lscpu_output);
+
+        // (model name, number of physical cores) of each core type
+        let mut core_types: Vec<(String, Option<usize>)> = Vec::new();
+        for section in &sections {
+            let Some(name) = RE_LSCPU_MODEL_NAME
+                .captures(section)
+                .and_then(|captures| captures.get(1))
+                .map(|capture| Self::trade_mark_symbols(capture.as_str().trim()))
+            else {
+                continue;
+            };
+
+            let cores = Self::capture_parsed::<usize>(&RE_LSCPU_CORES, section).map(|cores| {
+                cores.saturating_mul(
+                    Self::capture_parsed::<usize>(&RE_LSCPU_SOCKETS, section).unwrap_or(1),
+                )
             });
 
+            if let Some((_, existing_cores)) = core_types
+                .iter_mut()
+                .find(|(existing_name, _)| *existing_name == name)
+            {
+                *existing_cores = existing_cores.zip(cores).map(|(a, b)| a + b);
+            } else {
+                core_types.push((name, cores));
+            }
+        }
+
+        let model_name = match core_types.as_slice() {
