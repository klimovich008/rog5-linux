+    let mut last_error = None;
+    let mut temperature: Option<f32> = None;
+
+    for path in CPU_TEMPERATURE_PATHS.iter() {
+        match read_sysfs_thermal(path) {
+            Ok(t) => temperature = Some(temperature.map_or(t, |max| max.max(t))),
+            Err(e) => last_error = Some(e),
