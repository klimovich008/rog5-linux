@@ -0,0 +1,38 @@
+// ROG5 VM diagnostic only. Does not schedule frames or alter picture lifetime.
+import 'package:flutter/scheduler.dart';
+
+enum Rog5PictureStage {
+  build,
+  paintEnter,
+  opacitySkip,
+  drawBegin,
+  drawEnd,
+  paintEnd,
+}
+
+final Stopwatch _rog5PictureClock = Stopwatch()..start();
+int _rog5PictureRecords = 0;
+
+void rog5PictureStage(
+  Rog5PictureStage stage,
+  Object picture, {
+  required double width,
+  required double height,
+  required double pictureWidth,
+  required double pictureHeight,
+  double x = 0,
+  double y = 0,
+  double opacity = 1,
+  bool filter = false,
+}) {
+  if (_rog5PictureRecords >= 96) return;
+  final int frame =
+      SchedulerBinding.instance.currentFrameTimeStamp.inMicroseconds;
+  print(
+    'ROG5_PICTURE seq=${++_rog5PictureRecords} stage=${stage.name} '
+    'mono_us=${_rog5PictureClock.elapsedMicroseconds} frame_us=$frame '
+    'picture=${identityHashCode(picture)} width=$width height=$height '
+    'picture_width=$pictureWidth picture_height=$pictureHeight '
+    'x=$x y=$y opacity=$opacity filter=$filter',
+  );
+}
