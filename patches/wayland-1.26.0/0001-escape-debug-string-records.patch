+/* Keep document strings within one diagnostic record. This does not change
+ * the protocol payload; consumers must not unescape diagnostics into records. */
+static void
+print_quoted_string(FILE *f, const char *string)
+{
+	const unsigned char *p = (const unsigned char *) string;
+
+	fputc('"', f);
+	for (; *p; p++) {
+		switch (*p) {
+		case '\\': fputs("\\\\", f); break;
+		case '"': fputs("\\\"", f); break;
+		case '\n': fputs("\\n", f); break;
+		case '\r': fputs("\\r", f); break;
+		case '\t': fputs("\\t", f); break;
+		default:
+			if (*p < 0x20 || *p == 0x7f)
+				fprintf(f, "\\x%02x", (unsigned int) *p);
+			else
+				fputc(*p, f);
+		}
+	}
+	fputc('"', f);
+}
