 namespace {
 
+// Bounded, opt-in origin diagnostics. IDs identify raster calls, not native
+// grants or queued submissions. No admission or scheduling decisions use them.
+namespace denial_render_audit {
+constexpr unsigned kLimit = 4096;
+std::atomic<unsigned> events{0};
+std::atomic<unsigned> calls{0};
+struct Context { unsigned id = 0; const char* origin = "unscoped"; };
+thread_local Context current;
+
+bool Enabled() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("DENIA_RENDER_AUDIT");
+    return value && std::strcmp(value, "1") == 0;
+  }();
+  return enabled;
+}
+unsigned Take(std::atomic<unsigned>& counter) {
+  unsigned value = counter.load(std::memory_order_relaxed);
+  while (value < kLimit) {
+    if (counter.compare_exchange_weak(value, value + 1,
+                                     std::memory_order_relaxed)) {
+      return value + 1;
+    }
+  }
+  return 0;
+}
+void Record(const char* stage, int64_t view = -1, int64_t value = 0,
+            uint64_t generation = 0) {
+  if (!Enabled()) return;
+  const auto sequence = Take(events);
+  if (!sequence) return;
+  FML_LOG(IMPORTANT) << "Denial render origin seq=" << sequence
+                << " call=" << current.id << " origin=" << current.origin
+                << " stage=" << stage << " view=" << view
+                << " value=" << value << " generation=" << generation
+                << " cap_last=" << (sequence == kLimit);
+}
+class Scope {
+ public:
+  explicit Scope(const char* origin) : previous_(current), enabled_(Enabled()) {
+    if (enabled_) {
+      current = {Take(calls), origin};
+      Record("enter");
+    }
+  }
+  ~Scope() {
+    if (enabled_) { Record("exit"); current = previous_; }
+  }
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+ private:
+  Context previous_;
+  bool enabled_;
+};
+}  // namespace denial_render_audit
