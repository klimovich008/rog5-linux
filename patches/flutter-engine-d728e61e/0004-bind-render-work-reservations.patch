+
+bool EmbedderEngine::SetRenderWorkCallbacks(
+    DenialRenderWork::Callbacks callbacks) {
+  if (!IsValid() || denial_work_callbacks_ || !callbacks.begin ||
+      !callbacks.end || !callbacks.done ||
+      !task_runners_.GetPlatformTaskRunner()->RunsTasksOnCurrentThread()) {
+    return false;
+  }
+  denial_work_callbacks_ = callbacks;
+  denial_work_mode_ = std::make_shared<std::atomic<bool>>(false);
+  // Register before rendering. First WithWork atomically activates this flag,
+  // so previously queued raster work cannot steal the new request's grant.
+  task_runners_.GetRasterTaskRunner()->PostTask(
+      [rasterizer = shell_->GetRasterizer(), mode = denial_work_mode_]() {
+        if (rasterizer) {
+          rasterizer->SetDenialRenderWorkMode(mode);
+        }
+      });
+  return true;
+}
+
+bool EmbedderEngine::RenderOutputsWithWork(
+    std::vector<int64_t> views, std::vector<int64_t> textures,
+    bool rebuild_scene, uint64_t frame_start_time_nanos,
+    uint64_t frame_target_time_nanos, uint64_t work_id, intptr_t vsync_baton) {
+  if (!IsValid() || !denial_work_callbacks_ || !work_id || views.empty() ||
+      rebuild_scene != (vsync_baton != 0) ||
+      !task_runners_.GetPlatformTaskRunner()->RunsTasksOnCurrentThread()) {
+    return false;
+  }
+  auto work = std::make_shared<DenialRenderWork>(
+      work_id, std::move(views), std::move(textures), *denial_work_callbacks_);
+  denial_work_mode_->store(true);
+  const auto start = fml::TimePoint::FromEpochDelta(
+      fml::TimeDelta::FromNanoseconds(frame_start_time_nanos));
+  const auto target = fml::TimePoint::FromEpochDelta(
+      fml::TimeDelta::FromNanoseconds(frame_target_time_nanos));
+  if (rebuild_scene) {
+    return VsyncWaiterEmbedder::OnEmbedderVsync(
+        task_runners_, vsync_baton, start, target,
+        [engine = shell_->GetEngine(), work]() {
+          if (engine) {
+            engine->SetDenialRenderWork(work);
+          }
+        });
+  }
+  shell_->RenderDenialWork(std::move(work), start, target);
   return true;
 }
 
