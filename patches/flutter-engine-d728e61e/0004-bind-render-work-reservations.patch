+void Rasterizer::StoreDenialPendingTask(std::unique_ptr<LayerTreeTask> task) {
+  if (task->render_output_configuration_generation !=
+      denial_render_output_generation_) {
+    return;
+  }
+  auto view = view_records_.find(task->view_id);
+  if (view != view_records_.end() && view->second.last_successful_task &&
+      view->second.last_successful_task->denial_scene_sequence >
+          task->denial_scene_sequence) {
+    return;
+  }
+  auto& pending = denial_pending_output_tasks_[task->view_id];
+  if (!pending || pending->denial_scene_sequence <= task->denial_scene_sequence) {
+    pending = std::move(task);
+  }
+}
