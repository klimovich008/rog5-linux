+// Immutable identity and callback ownership for exactly one admitted request.
+// The last owner may disappear on UI (empty frame) or raster (draw completion).
+struct DenialRenderWork {
+  struct Callbacks {
+    int32_t (*begin)(void*, int64_t, uint64_t, uint32_t, uint32_t);
+    void (*end)(void*, int64_t, uint64_t);
+    void (*done)(void*, uint64_t);
+    void* user;
+  };
+  DenialRenderWork(uint64_t id,
+                  std::vector<int64_t> views,
+                  std::vector<int64_t> textures,
+                  Callbacks callbacks)
+      : id(id), render_view_ids(std::move(views)),
+        texture_identifiers(std::move(textures)), callbacks(callbacks) {}
+  ~DenialRenderWork() { callbacks.done(callbacks.user, id); }
+  bool Selects(int64_t view) const {
+    return std::find(render_view_ids.begin(), render_view_ids.end(), view) !=
+           render_view_ids.end();
+  }
+  const uint64_t id;
+  const std::vector<int64_t> render_view_ids;
+  const std::vector<int64_t> texture_identifiers;
+  const Callbacks callbacks;
+  FML_DISALLOW_COPY_AND_ASSIGN(DenialRenderWork);
+};
+
+// Only a currently executing raster call installs this scope. Cached scene
+// tasks never retain work ownership; pipeline retries explicitly carry it.
+class DenialRenderWorkScope {
+ public:
+  DenialRenderWorkScope(std::shared_ptr<DenialRenderWork>& slot,
+                       std::shared_ptr<DenialRenderWork> work)
+      : slot_(slot), previous_(std::exchange(slot, std::move(work))) {}
+  ~DenialRenderWorkScope() { slot_ = std::move(previous_); }
+ private:
+  std::shared_ptr<DenialRenderWork>& slot_;
+  std::shared_ptr<DenialRenderWork> previous_;
+  FML_DISALLOW_COPY_AND_ASSIGN(DenialRenderWorkScope);
+};
+
+// begin protects the matching grant until acquire or end; stale work never
+// reaches backing-store allocation. All exits after successful begin call end.
+class DenialRenderAdmission {
+ public:
+  DenialRenderAdmission(std::shared_ptr<DenialRenderWork> work, int64_t view,
+                       uint32_t width, uint32_t height)
+      : work_(std::move(work)), view_(view),
+        result_(work_ && work_->Selects(view)
+                    ? work_->callbacks.begin(work_->callbacks.user, view,
+                                             work_->id, width, height)
+                    : 0) {}
+  ~DenialRenderAdmission() {
+    if (result_ == 1) {
+      work_->callbacks.end(work_->callbacks.user, view_, work_->id);
+    }
+  }
+  int32_t result() const { return result_; }
+ private:
+  std::shared_ptr<DenialRenderWork> work_;
+  const int64_t view_;
+  const int32_t result_;
+  FML_DISALLOW_COPY_AND_ASSIGN(DenialRenderAdmission);
+};
