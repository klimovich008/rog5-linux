+void Shell::RenderDenialWork(std::shared_ptr<DenialRenderWork> work,
+                             fml::TimePoint frame_start,
+                             fml::TimePoint frame_target) {
+  auto recorder = std::make_unique<FrameTimingsRecorder>();
+  recorder->RecordVsync(frame_start, frame_target);
+  const auto now = fml::TimePoint::Now();
+  recorder->RecordBuildStart(now);
+  recorder->RecordBuildEnd(now);
+  OnAnimatorDrawDenialRenderWork(std::move(recorder), std::move(work));
+}
+
+void Shell::OnAnimatorDrawDenialRenderWork(
+    std::unique_ptr<FrameTimingsRecorder> recorder,
+    std::shared_ptr<DenialRenderWork> work) {
+  task_runners_.GetRasterTaskRunner()->PostTask(fml::MakeCopyable(
+      [rasterizer = rasterizer_->GetWeakPtr(), work = std::move(work),
+       recorder = std::move(recorder)]() mutable {
+        if (rasterizer) {
+          rasterizer->DrawDenialRenderOutputs(work->render_view_ids,
+              work->texture_identifiers, std::move(recorder), work);
+        }
+      }));
 }
 
