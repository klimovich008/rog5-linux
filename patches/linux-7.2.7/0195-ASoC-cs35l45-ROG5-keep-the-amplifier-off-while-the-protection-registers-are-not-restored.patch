From: Claude <noreply@anthropic.com>
Subject: [PATCH] ASoC: cs35l45: keep the amplifier off while the protection registers are not restored

0122 switches the amplifier to the vendor boost/LDPM/BBPE operating point
while the speaker-protection firmware runs and restores the defaults when
it stops or fails to start. A failed restore was only logged: prot_regs_set
stayed set (so amplifier-mode changes are refused) but nothing stopped the
amplifier from being enabled again, e.g. for the direct DACPCM path, with a
partly configured boost (2026-10-02 GPT-6.1-Sol audit, F4).

- A failed restore after a failed setup, a failed DSP start or a DSP stop
  switches the amplifier off (GLOBAL_ENABLES = 0) at once.
- GLOBAL_EN power-up with prot_regs_set but no running firmware retries
  the restore first and leaves the amplifier off while it fails (a DAPM
  event error is only logged, so the write is skipped, not just failed).

Nothing changes when the restore succeeds, nor while the firmware runs
(prot_regs_set is legitimately set then).

Hardware (RAM trial with audio): speaker playback through the protection
firmware and through the direct path, stream start/stop and the preloaded
DSP reload (0151) must behave as before, with no "protection registers not
restored" in dmesg. The failure path itself needs I2C fault injection.

diff --git a/sound/soc/codecs/cs35l45.c b/sound/soc/codecs/cs35l45.c
index 431e88aa3..3a2a58784 100644
--- a/sound/soc/codecs/cs35l45.c
+++ b/sound/soc/codecs/cs35l45.c
@@ -107,16 +107,34 @@ static int cs35l45_set_cspl_mbox_cmd(struct cs35l45_private *cs35l45,
 	return -ENOMSG;
 }
 
+static int cs35l45_set_prot_regs(struct cs35l45_private *cs35l45, bool vendor);
+
 static int cs35l45_global_en_ev(struct snd_soc_dapm_widget *w,
 				struct snd_kcontrol *kcontrol, int event)
 {
 	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
 	struct cs35l45_private *cs35l45 = snd_soc_component_get_drvdata(component);
+	int ret;
 
 	dev_dbg(cs35l45->dev, "%s event : %x\n", __func__, event);
 
 	switch (event) {
 	case SND_SOC_DAPM_POST_PMU:
+		/*
+		 * The protection operating point is still set although its
+		 * firmware does not run: an earlier rollback failed. Restore
+		 * the defaults first, and leave the amplifier off (a DAPM
+		 * event error is only logged) while that fails.
+		 */
+		if (cs35l45->prot_regs_set && !cs35l45->dsp.cs_dsp.running) {
+			ret = cs35l45_set_prot_regs(cs35l45, false);
+			if (ret) {
+				dev_err(cs35l45->dev,
+					"protection registers not restored, amplifier stays off\n");
+				return ret;
+			}
+		}
+
 		regmap_write(cs35l45->regmap, CS35L45_GLOBAL_ENABLES,
 			     CS35L45_GLOBAL_EN_MASK);
 
@@ -201,6 +219,18 @@ static int cs35l45_set_prot_regs(struct cs35l45_private *cs35l45, bool vendor)
 	return ret;
 }
 
+/*
+ * The defaults could not be restored after the protection firmware stopped or
+ * failed to start (prot_regs_set stays set): switch the amplifier off now; it
+ * is enabled again only once the restore succeeds (cs35l45_global_en_ev()).
+ */
+static void cs35l45_prot_restore_failed(struct cs35l45_private *cs35l45)
+{
+	dev_err(cs35l45->dev,
+		"protection registers not restored, switching the amplifier off\n");
+	regmap_write(cs35l45->regmap, CS35L45_GLOBAL_ENABLES, 0);
+}
+
 /* A wedged preloaded DSP is booted again this long after its stream stopped */
 #define CS35L45_DSP_RELOAD_DELAY_MS	500
 
@@ -229,14 +259,15 @@ static int cs35l45_dsp_preload_ev(struct snd_soc_dapm_widget *w,
 		    cs35l45->amplifier_mode == AMP_MODE_SPK) {
 			ret = cs35l45_set_prot_regs(cs35l45, true);
 			if (ret) {
-				cs35l45_set_prot_regs(cs35l45, false);
+				if (cs35l45_set_prot_regs(cs35l45, false))
+					cs35l45_prot_restore_failed(cs35l45);
 				return ret;
 			}
 		}
 
 		ret = wm_adsp_event(w, kcontrol, event);
-		if (ret)
-			cs35l45_set_prot_regs(cs35l45, false);
+		if (ret && cs35l45_set_prot_regs(cs35l45, false))
+			cs35l45_prot_restore_failed(cs35l45);
 
 		return ret;
 	case SND_SOC_DAPM_PRE_PMD:
@@ -250,7 +281,8 @@ static int cs35l45_dsp_preload_ev(struct snd_soc_dapm_widget *w,
 				return ret;
 		}
 
-		cs35l45_set_prot_regs(cs35l45, false);
+		if (cs35l45_set_prot_regs(cs35l45, false))
+			cs35l45_prot_restore_failed(cs35l45);
 
 		ret = wm_adsp_early_event(w, kcontrol, event);
 
