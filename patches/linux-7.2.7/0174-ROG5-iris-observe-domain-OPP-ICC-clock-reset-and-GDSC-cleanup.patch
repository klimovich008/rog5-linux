From: GPT-6.1-Sol (Codex CLI) <noreply@openai.com>
Subject: [PATCH] ROG5-iris-observe-domain-OPP-ICC-clock-reset-and-GDSC-cleanup

Retain all normal resource helpers and their order. Mark each domain-list
OPP-token clear, link deletion, detach, runtime disable, default pstate,
genpd removal, work queue and virtual-device unregister. Do not access the
virtual device after unregister. Mark asynchronous power-off work and GDSC
callback entry/exit. Domain/provider-lock markers never delay; worker entry
and exit settle outside those locks. Shared MX/MMCX records can reflect
other consumers and are contextual observations, not proof of codec MMIO.
Managed clock/reset/ICC bulk and OPP-table releases have explicit names;
OPP config action is identified by the devres action markers in 0172.

diff --git a/drivers/base/power/common.c b/drivers/base/power/common.c
--- a/drivers/base/power/common.c
+++ b/drivers/base/power/common.c
@@ -4,6 +4,7 @@
  *
  * Copyright (C) 2011 Rafael J. Wysocki <rjw@sisk.pl>, Renesas Electronics Corp.
  */
+#include <linux/rog5_iris_trace.h>
 #include <linux/kernel.h>
 #include <linux/device.h>
 #include <linux/export.h>
@@ -382,9 +383,14 @@
 		return;
 
 	for (i = 0; i < list->num_pds; i++) {
+		rog5_iris_remove_mark(list->pd_devs[i], "PD[%d] OPP token %u clear begin",
+				      i, list->opp_tokens[i]);
 		dev_pm_opp_clear_config(list->opp_tokens[i]);
+		rog5_iris_remove_mark(list->pd_devs[i], "PD[%d] OPP token clear done; link delete begin", i);
 		if (list->pd_links[i])
 			device_link_del(list->pd_links[i]);
+		rog5_iris_remove_mark(list->pd_devs[i], "PD[%d] link delete done; detach begin", i);
+		/* detach unregisters the virtual device: do not log through it afterwards. */
 		dev_pm_domain_detach(list->pd_devs[i], true);
 	}
 
diff --git a/drivers/pmdomain/core.c b/drivers/pmdomain/core.c
--- a/drivers/pmdomain/core.c
+++ b/drivers/pmdomain/core.c
@@ -6,6 +6,7 @@
  */
 #define pr_fmt(fmt) "PM: " fmt
 
+#include <linux/rog5_iris_trace.h>
 #include <linux/delay.h>
 #include <linux/idr.h>
 #include <linux/kernel.h>
@@ -894,7 +895,9 @@
 
 	timed = timed && genpd->gd && !genpd->states[state_idx].fwnode;
 	if (!timed) {
+		rog5_iris_domain_mark(genpd->name, "provider power-off begin", false);
 		ret = genpd->power_off(genpd);
+		rog5_iris_domain_mark(genpd->name, "provider power-off returned", false);
 		if (ret)
 			goto busy;
 
@@ -902,7 +905,9 @@
 	}
 
 	time_start = ktime_get();
+	rog5_iris_domain_mark(genpd->name, "timed provider power-off begin", false);
 	ret = genpd->power_off(genpd);
+	rog5_iris_domain_mark(genpd->name, "timed provider power-off returned", false);
 	if (ret)
 		goto busy;
 
@@ -1147,9 +1152,15 @@
 
 	genpd = container_of(work, struct generic_pm_domain, power_off_work);
 
+	rog5_iris_domain_mark(genpd->name, "power-off work lock begin", true);
 	genpd_lock(genpd);
+	rog5_iris_domain_mark(genpd->name,
+		genpd->status == GENPD_STATE_OFF ? "work: cached OFF; power-off begin" :
+		"work: cached ON; power-off begin", false);
 	genpd_power_off(genpd, false, 0);
+	rog5_iris_domain_mark(genpd->name, "work: power-off done; unlock begin", false);
 	genpd_unlock(genpd);
+	rog5_iris_domain_mark(genpd->name, "power-off work done", true);
 }
 
 /**
@@ -3257,6 +3268,7 @@
 {
 	struct generic_pm_domain *pd;
 	bool is_virt_dev;
+	const char *name;
 	unsigned int i;
 	int ret = 0;
 
@@ -3264,7 +3276,9 @@
 	if (IS_ERR(pd))
 		return;
 
-	dev_dbg(dev, "removing from PM domain %s\n", pd->name);
+	name = pd->name;
+	rog5_iris_remove_mark(dev, "genpd %s detach: runtime disable begin", name);
+	dev_dbg(dev, "removing from PM domain %s\n", name);
 
 	/* Check if the device was created by genpd at attach. */
 	is_virt_dev = dev->bus == &genpd_bus_type;
@@ -3272,6 +3286,8 @@
 	/* Disable runtime PM if we enabled it at attach. */
 	if (is_virt_dev)
 		pm_runtime_disable(dev);
+
+	rog5_iris_remove_mark(dev, "genpd %s: runtime disable done; default pstate clear begin", name);
 
 	/* Drop the default performance state */
 	if (dev_gpd_data(dev)->default_pstate) {
@@ -3279,6 +3295,8 @@
 		dev_gpd_data(dev)->default_pstate = 0;
 	}
 
+	rog5_iris_remove_mark(dev, "genpd %s: pstate clear done; remove device begin", name);
+
 	for (i = 1; i < GENPD_RETRY_MAX_MS; i <<= 1) {
 		ret = genpd_remove_device(pd, dev);
 		if (ret != -EAGAIN)
@@ -3288,6 +3306,7 @@
 		cond_resched();
 	}
 
+	rog5_iris_remove_mark(dev, "genpd %s: remove device returned %d", name, ret);
 	if (ret < 0) {
 		dev_err(dev, "failed to remove from PM domain %s: %d",
 			pd->name, ret);
@@ -3295,11 +3314,15 @@
 	}
 
 	/* Check if PM domain can be powered off after removing this device. */
+	rog5_iris_remove_mark(dev, "genpd %s: power-off work queue begin", name);
 	genpd_queue_power_off_work(pd);
+	rog5_iris_remove_mark(dev, "genpd %s: work queued; virtual unregister begin", name);
 
 	/* Unregister the device if it was created by genpd. */
 	if (is_virt_dev)
 		device_unregister(dev);
+	/* The domain outlives this virtual device. */
+	rog5_iris_domain_mark(name, "detach: virtual unregister done", true);
 }
 
