-	msm_dp_display_replay_reset_hpd(msm_dp_display);
 	if (rc)
 		goto failed_enable;
 	msm_dp_display->retry_pending = false;
 
 	if (msm_dp_tpg)
 		msm_dp_panel_tpg_config(msm_dp_display->panel, true);
 	drm_info(msm_dp_display->drm_dev,
