-	if (!pending)
-		return;
-	spin_lock_irqsave(&dp->irq_thread_lock, flags);
-	dp->hpd_isr_status |= pending;
-	spin_unlock_irqrestore(&dp->irq_thread_lock, flags);
-	irq_wake_thread(dp->irq, dp);
-}
-
 void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 				 struct drm_atomic_commit *state)
 {
 	struct msm_dp_bridge *msm_dp_bridge = to_dp_bridge(drm_bridge);
 	struct msm_dp *dp = msm_dp_bridge->msm_dp_display;
 	int rc = 0;
 	struct msm_dp_display_private *msm_dp_display;
 	bool force_link_train = false;
 
 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
 	if (!msm_dp_display->msm_dp_mode.drm_mode.clock) {
 		DRM_ERROR("invalid params\n");
 		return;
 	}
 
 	if (dp->is_edp)
 		msm_dp_hpd_plug_handle(msm_dp_display);
 
 	if (pm_runtime_resume_and_get(&dp->pdev->dev)) {
 		DRM_ERROR("failed to pm_runtime_resume\n");
 		return;
 	}
 
 	/*
 	 * ROG5: the link enable reads the sink's link_info (bpp, lanes, rate)
 	 * and trains the link: serialise with capability rereads and sink
 	 * requests (hpd/irq_hpd). After the eDP plug handler, which takes it.
 	 */
 	guard(mutex)(&msm_dp_display->plugged_lock);
 
@@ -1683,68 +1659,66 @@ void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 			drm_info(msm_dp_display->drm_dev, "DP: sink D3 -> D0 before link enable (rc=%d)\n", rc);
 			if (rc)
