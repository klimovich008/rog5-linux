 	rc = msm_dp_display_set_mode(dp, &msm_dp_display->msm_dp_mode);
 	if (rc) {
 		DRM_ERROR("Failed to perform a mode set, rc=%d\n", rc);
 		goto failed_enable;
 	}
 
 	rc = msm_dp_panel_config_pcon(msm_dp_display->panel);
 	if (rc)
 		goto failed_enable;
 
 	rc = msm_dp_ctrl_on_link(msm_dp_display->ctrl);
-	msm_dp_display_replay_reset_hpd(msm_dp_display);
 	if (rc) {
 		DRM_ERROR_RATELIMITED("Failed link training (rc=%d)\n", rc);
 		goto failed_enable;
