From: Claude <noreply@anthropic.com>
Subject: [PATCH] dma: swiotlb: default pool size from Kconfig (ROG5 opt-in)

arm64 sets up the 64 MiB SWIOTLB pool whenever RAM extends above the DMA
zone (on the ROG Phone 5 ZONE_DMA ends at 4 GiB and RAM at 14 GiB). Every
DMA master of this SoC that Linux drives sits behind the APPS SMMU or the
GPU SMMU, so the pool is almost unused: io_tlb_used_hiwater was 4 slabs
(8 KiB) of 32768 after a GNOME + Steam + Proton game session on k111. The
size can only be lowered with "swiotlb=" on the command line, which the
ROG5 boot chain builds inside the signed slot-B loader, so changing it
means a new loader on boot_b.

CONFIG_SWIOTLB_DEFAULT_SIZE_MB sets the default instead (64 keeps the old
behaviour); "swiotlb=" still overrides it and architecture adjustments
(swiotlb_adjust_size) still apply, since they compare against the same
IO_TLB_DEFAULT_SIZE. ROG5: kernel k113 trial (rog5-swiotlb-slim.fragment); see
test-results/2026-10-01-memory-footprint.md for the RAM-trial plan.

--- a/include/linux/swiotlb.h
+++ b/include/linux/swiotlb.h
@@ -32,8 +32,12 @@
 #define IO_TLB_SHIFT 11
 #define IO_TLB_SIZE (1 << IO_TLB_SHIFT)
 
-/* default to 64MB */
+/* default to 64MB unless the configuration sets another size */
+#ifdef CONFIG_SWIOTLB_DEFAULT_SIZE_MB
+#define IO_TLB_DEFAULT_SIZE ((unsigned long)CONFIG_SWIOTLB_DEFAULT_SIZE_MB << 20)
+#else
 #define IO_TLB_DEFAULT_SIZE (64UL<<20)
+#endif
 
 unsigned long swiotlb_size_or_default(void);
 void __init swiotlb_init_remap(bool addressing_limit, unsigned int flags,
--- a/kernel/dma/Kconfig
+++ b/kernel/dma/Kconfig
@@ -86,6 +86,20 @@
 	bool
 	select NEED_DMA_MAP_STATE
 
+config SWIOTLB_DEFAULT_SIZE_MB
+	int "Default size of the SWIOTLB bounce buffer pool (MiB)"
+	depends on SWIOTLB
+	range 2 1024
+	default 64
+	help
+	  Size of the boot-time bounce buffer pool when the command line has
+	  no "swiotlb=" option. Systems whose DMA masters all sit behind an
+	  IOMMU bounce almost nothing but still reserve the full pool once
+	  RAM extends above the DMA zone. The pool is split into one area per
+	  CPU, so it needs at least 256 KiB per possible CPU.
+
+	  If unsure, keep 64.
+
 config SWIOTLB_DYNAMIC
 	bool "Dynamic allocation of DMA bounce buffers"
 	default n
