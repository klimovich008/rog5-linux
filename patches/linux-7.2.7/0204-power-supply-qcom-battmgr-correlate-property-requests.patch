 static void qcom_battmgr_callback(const void *data, size_t len, void *priv)
 {
+	const struct qcom_battmgr_message *resp = data;
 	const struct pmic_glink_hdr *hdr = data;
 	struct qcom_battmgr *battmgr = priv;
-	unsigned int opcode = le32_to_cpu(hdr->opcode);
-
-	if (opcode == BATTMGR_NOTIFICATION)
+	unsigned long flags;
+	u32 opcode;
+	bool property_reply;
+
+	if (len < sizeof(*hdr))
+		return;
+	opcode = le32_to_cpu(hdr->opcode);
+	if (le32_to_cpu(hdr->owner) != PMIC_GLINK_OWNER_BATTMGR)
+		return;
+	if (opcode == BATTMGR_NOTIFICATION) {
 		qcom_battmgr_notification(battmgr, data, len);
-	else if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
-		 battmgr->variant == QCOM_BATTMGR_X1E80100)
+		return;
+	}
+	if (le32_to_cpu(hdr->type) != PMIC_GLINK_REQ_RESP &&
+	    !(opcode == BATTMGR_REQUEST_NOTIFICATION &&
+	      le32_to_cpu(hdr->type) == PMIC_GLINK_NOTIFY))
+		return;
+
+	spin_lock_irqsave(&battmgr->request_lock, flags);
+	if (!battmgr->request_opcode || opcode != battmgr->request_opcode)
+		goto out;
+	property_reply = opcode == BATTMGR_BAT_PROPERTY_GET ||
+			 opcode == BATTMGR_USB_PROPERTY_GET ||
+			 opcode == BATTMGR_WLS_PROPERTY_GET;
+	if (property_reply) {
+		if (len < sizeof(*hdr) + sizeof(__le32)) {
+			battmgr->error = -EPROTO;
+			battmgr->request_poisoned = true;
+			goto complete;
+		}
+		if (le32_to_cpu(resp->intval.property) != battmgr->request_property)
+			goto out;
+	}
+	if (len < sizeof(*hdr) + sizeof(__le32)) {
+		battmgr->error = -EPROTO;
+		goto complete;
+	}
+	if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
+	    battmgr->variant == QCOM_BATTMGR_X1E80100)
 		qcom_battmgr_sc8280xp_callback(battmgr, data, len);
 	else
 		qcom_battmgr_sm8350_callback(battmgr, data, len);
+complete:
+	if (battmgr->error < 0)
+		battmgr->request_poisoned = true;
+	battmgr->request_opcode = 0;
+	complete(&battmgr->ack);
+out:
+	spin_unlock_irqrestore(&battmgr->request_lock, flags);
 }
 
