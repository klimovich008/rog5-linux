From: GPT-6.1-Sol <noreply@openai.com>
Subject: [PATCH] power: supply: qcom_battmgr: correlate property requests

Complete audit 12 notification/property correlation beyond 0190's mutex.
Track pending opcode/property and service generation under an IRQ-safe lock.
Validate headers and match/claim before decoding cache data and completing.
Malformed matched responses fail; unrelated and duplicate replies do not
complete the waiter. Timed-out requests poison this tokenless protocol until
the service restarts, so a late reply cannot satisfy an identical retry.

Local fix; no matching upstream backport found in lore/kernel.org searches.
Hardware: charge policy and notification enable concurrently on PDR UP;
delayed/malformed/property-mismatched replies and timeout/recovery. Confirm
fresh capacity is required and ordinary reads fail after an uncertain timeout.

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -380,6 +380,11 @@
 
 	int error;
 	struct completion ack;
+	spinlock_t request_lock;
+	u32 request_opcode;
+	u32 request_property;
+	u32 service_generation;
+	bool request_poisoned;
 	int oem_error;
 	struct completion oem_ack;
 	/*
@@ -835,22 +840,43 @@
 
 static int qcom_battmgr_request(struct qcom_battmgr *battmgr, void *data, size_t len)
 {
-	unsigned long left;
+	struct pmic_glink_hdr *hdr = data;
+	struct qcom_battmgr_property_request *prop = data;
+	unsigned long left, flags;
+	u32 generation;
 	int ret;
 
+	lockdep_assert_held(&battmgr->lock);
+	spin_lock_irqsave(&battmgr->request_lock, flags);
+	if (!battmgr->service_up || battmgr->request_poisoned) {
+		ret = battmgr->service_up ? -EIO : -ENOTCONN;
+		spin_unlock_irqrestore(&battmgr->request_lock, flags);
+		return ret;
+	}
+	generation = battmgr->service_generation;
 	reinit_completion(&battmgr->ack);
-
 	battmgr->error = 0;
+	battmgr->request_opcode = le32_to_cpu(hdr->opcode);
+	battmgr->request_property = len == sizeof(*prop) ? le32_to_cpu(prop->property) : 0;
+	spin_unlock_irqrestore(&battmgr->request_lock, flags);
 
 	ret = pmic_glink_send(battmgr->client, data, len);
-	if (ret < 0)
-		return ret;
-
-	left = wait_for_completion_timeout(&battmgr->ack, HZ);
-	if (!left)
-		return -ETIMEDOUT;
-
-	return battmgr->error;
+	left = ret < 0 ? 0 : wait_for_completion_timeout(&battmgr->ack, HZ);
+	spin_lock_irqsave(&battmgr->request_lock, flags);
+	battmgr->request_opcode = 0;
+	if (generation != battmgr->service_generation || !battmgr->service_up) {
+		ret = -ENOTCONN;
+	} else if (ret >= 0) {
+		if (!left) {
+			/* Wire protocol has no token: forbid indistinguishable retry. */
+			battmgr->request_poisoned = true;
+			ret = -ETIMEDOUT;
+		} else {
+			ret = battmgr->error;
+		}
+	}
+	spin_unlock_irqrestore(&battmgr->request_lock, flags);
+	return ret;
 }
 
