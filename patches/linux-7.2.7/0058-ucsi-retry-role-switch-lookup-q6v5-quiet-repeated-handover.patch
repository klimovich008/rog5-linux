+/*
+ * Set the data role, and if the switch refuses (e.g. UCSI took a reference
+ * to a role switch that its controller unregistered while re-probing),
+ * look the switch up again and retry once. Seen on the ROG5 side port:
+ * "failed to set usb role" until ucsi_glink was reloaded.
+ */
+static int ucsi_set_usb_role(struct ucsi_connector *con, enum usb_role role)
+{
+	struct usb_role_switch *sw;
+	int ret;
+
+	ret = usb_role_switch_set_role(con->usb_role_sw, role);
+	if (!ret)
+		return 0;
+	sw = fwnode_usb_role_switch_get(ucsi_find_fwnode(con));
+	if (IS_ERR_OR_NULL(sw))
+		return ret;
+	usb_role_switch_put(con->usb_role_sw);
+	con->usb_role_sw = sw;
+	return usb_role_switch_set_role(con->usb_role_sw, role);
+}
+
 static int ucsi_register_port(struct ucsi *ucsi, struct ucsi_connector *con)
 {
 	struct typec_capability *cap = &con->typec_cap;
