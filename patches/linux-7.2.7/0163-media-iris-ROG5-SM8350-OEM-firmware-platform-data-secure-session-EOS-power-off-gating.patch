+/*
+ * ROG5: controller power off as the stock Iris2 driver does it
+ * (hfi_iris2.c:176, HPG 6.1.2): X2RPMh = 3, AON MVP-NOC low-power request
+ * and acknowledge, debug bridge to low power (7, wait for 7) and back (0,
+ * wait for 0), then clocks and the controller power domain. The generic
+ * sequence asks the CPU-NOC at wrapper +0x5c/+0x60 instead, which never
+ * acknowledged on SM8350 ("CPU NOC LPI handshake timed out (0x0)" at every
+ * power off in the k115 trials) and then skipped the debug-bridge steps.
+ * Like stock, a handshake that does not complete is reported and the power
+ * off goes on; the first failure is returned.
+ */
+static int iris_vpu2_sm8350_power_off_controller(struct iris_core *core)
+{
+	u32 val = 0;
+	int ret, err = 0;
+
+	writel(MSK_SIGNAL_FROM_TENSILICA | MSK_CORE_POWER_ON, core->reg_base + CPU_CS_X2RPMH);
+
+	writel(REQ_POWER_DOWN_PREP, core->reg_base + AON_WRAPPER_MVP_NOC_LPI_CONTROL);
+	ret = readl_poll_timeout(core->reg_base + AON_WRAPPER_MVP_NOC_LPI_STATUS,
+				 val, val & BIT(0), 50, 1000);
+	if (ret) {
+		dev_err(core->dev, "AON MVP NOC not in low power (%#x)\n", val);
+		err = err ?: ret;
+	}
+
+	writel(0x7, core->reg_base + WRAPPER_DEBUG_BRIDGE_LPI_CONTROL);
+	ret = readl_poll_timeout(core->reg_base + WRAPPER_DEBUG_BRIDGE_LPI_STATUS,
+				 val, (val & 0x7) == 0x7, 50, 1000);
+	if (ret) {
+		dev_err(core->dev, "debug bridge LPI request not acknowledged (%#x)\n", val);
+		err = err ?: ret;
+	}
+
+	writel(0x0, core->reg_base + WRAPPER_DEBUG_BRIDGE_LPI_CONTROL);
+	ret = readl_poll_timeout(core->reg_base + WRAPPER_DEBUG_BRIDGE_LPI_STATUS,
+				 val, val == 0, 50, 1000);
+	if (ret) {
+		dev_err(core->dev, "debug bridge LPI release not acknowledged (%#x)\n", val);
+		err = err ?: ret;
+	}
+
+	iris_disable_unprepare_clock(core, IRIS_AHB_CLK);
+	iris_disable_unprepare_clock(core, IRIS_CTRL_CLK);
+	iris_disable_unprepare_clock(core, IRIS_AXI_CLK);
+	iris_disable_power_domains(core, core->pmdomain_tbl->pd_devs[IRIS_CTRL_POWER_DOMAIN]);
+
+	return err;
+}
