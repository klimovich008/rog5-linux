+/* ROG5: gen1 HFI_PROPERTY_SYS_UBWC_CONFIG values (stock msm_vidc layout) */
+struct iris_gen1_ubwc_config {
+	u32 override_bits;	/* bit 0 channels, 1 MAL, 2 HBB, 3 swizzle, 4 spreading */
+	u32 max_channels;
+	u32 mal_length;
+	u32 highest_bank_bit;
+	u32 bank_swzl_level;
+	u32 bank_spreading;
+};
+
+/*
+ * ROG5: SM8350 with the ASUS OEM firmware (vpu20_4v.mbn). Kept out of the
+ * SM8250 data so that no other SM8250-compatible device changes behaviour.
