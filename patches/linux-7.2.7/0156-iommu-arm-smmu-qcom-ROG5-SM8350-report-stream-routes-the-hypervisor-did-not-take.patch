From 299c0bbef420d55eae168fa9cce24381da220526 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 22:25:56 +0200
Subject: [PATCH] iommu/arm-smmu-qcom: ROG5 SM8350: report stream routes the
 hypervisor did not take

The SM8350 hypervisor on the ROG Phone 5 silently drops some HLOS S2CR
writes: patch 0049/0051 found that the DSPs' streams routed to the low
context banks stay FAULT, and the DSP's first access to a shared buffer
then wedges the SoC until it resets. Which streams it accepts on which
banks is not documented. The video core (Iris, stream 0x2100, patch
0154 and the d14 DTB) is the next HLOS master to get a route; on the
SM8350 HDK it works on the low banks, but this phone runs the vendor
hypervisor policy, and a dropped route would only show as a hang when
the firmware first touches its queues.

Read back every S2CR that routes one of Linux's own masters to its
domain (type TRANS, in use) after writing it on SM8350 and warn
when its type or context bank differs, naming the SMR and the bank, so
the route is checked when the device attaches (driver probe), before
anything starts the master. Reads of S2CR are fine here:
qcom_sm8350_smmu500_reset() (patch 0064) already reads them to find the
hypervisor's own routes. qcom_smmu_write_s2cr() keeps its behaviour;
the value it writes is now computed by qcom_smmu_s2cr_value().

ROG5: patch 0156, kernel k114. Diagnostic only, no behaviour change.
---
 drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c | 47 ++++++++++++++++++----
 1 file changed, 40 insertions(+), 7 deletions(-)

diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
index 7de1e31..e0400c6 100644
--- a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
@@ -546,13 +546,12 @@ static int qcom_adreno_smmuv2_cfg_probe(struct arm_smmu_device *smmu)
 	return 0;
 }
 
-static void qcom_smmu_write_s2cr(struct arm_smmu_device *smmu, int idx)
+static u32 qcom_smmu_s2cr_value(struct arm_smmu_device *smmu, int idx)
 {
 	struct arm_smmu_s2cr *s2cr = smmu->s2crs + idx;
 	struct qcom_smmu *qsmmu = to_qcom_smmu(smmu);
 	u32 cbndx = s2cr->cbndx;
 	u32 type = s2cr->type;
-	u32 reg;
 
 	if (qsmmu->bypass_quirk) {
 		if (type == S2CR_TYPE_BYPASS) {
@@ -575,10 +574,14 @@ static void qcom_smmu_write_s2cr(struct arm_smmu_device *smmu, int idx)
 		}
 	}
 
-	reg = FIELD_PREP(ARM_SMMU_S2CR_TYPE, type) |
-	      FIELD_PREP(ARM_SMMU_S2CR_CBNDX, cbndx) |
-	      FIELD_PREP(ARM_SMMU_S2CR_PRIVCFG, s2cr->privcfg);
-	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_S2CR(idx), reg);
+	return FIELD_PREP(ARM_SMMU_S2CR_TYPE, type) |
+	       FIELD_PREP(ARM_SMMU_S2CR_CBNDX, cbndx) |
+	       FIELD_PREP(ARM_SMMU_S2CR_PRIVCFG, s2cr->privcfg);
+}
+
+static void qcom_smmu_write_s2cr(struct arm_smmu_device *smmu, int idx)
+{
+	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_S2CR(idx), qcom_smmu_s2cr_value(smmu, idx));
 }
 
 static int qcom_smmu_def_domain_type(struct device *dev)
@@ -711,12 +714,42 @@ static int qcom_sm8350_smmu500_reset(struct arm_smmu_device *smmu)
 	return 0;
 }
 
+/*
+ * The SM8350 hypervisor drops some HLOS S2CR writes without an error (see
+ * qcom_sm8350_smmu500_alloc_context_bank() and qcom_sm8350_smmu500_reset()):
+ * the stream then stays on its old route and the master's first DMA faults
+ * or wedges the SoC. Read every translating route back, so a dropped one is
+ * in the log when the device attaches, before the master is started.
+ */
+static void qcom_sm8350_smmu500_write_s2cr(struct arm_smmu_device *smmu, int idx)
+{
+	struct arm_smmu_s2cr *s2cr = smmu->s2crs + idx;
+	u32 want = qcom_smmu_s2cr_value(smmu, idx);
+	u32 got;
+
+	arm_smmu_gr0_write(smmu, ARM_SMMU_GR0_S2CR(idx), want);
+	/*
+	 * Only routes of Linux's own masters to their domains: the reset also
+	 * writes every unused entry, and the hypervisor keeps its own streams
+	 * on their banks on purpose (qcom_sm8350_smmu500_reset()).
+	 */
+	if (s2cr->type != S2CR_TYPE_TRANS || !s2cr->count)
+		return;
+
+	got = arm_smmu_gr0_read(smmu, ARM_SMMU_GR0_S2CR(idx));
+	if ((got ^ want) & (ARM_SMMU_S2CR_TYPE | ARM_SMMU_S2CR_CBNDX))
+		dev_warn(smmu->dev,
+			 "S2CR%d (SMR id 0x%x mask 0x%x) reads 0x%08x after routing it to context bank %lu (0x%08x): the hypervisor did not take the route\n",
+			 idx, smmu->smrs ? smmu->smrs[idx].id : 0, smmu->smrs ? smmu->smrs[idx].mask : 0,
+			 got, FIELD_GET(ARM_SMMU_S2CR_CBNDX, want), want);
+}
+
 static const struct arm_smmu_impl qcom_sm8350_smmu_500_impl = {
 	.init_context = qcom_smmu_init_context,
 	.cfg_probe = qcom_smmu_cfg_probe,
 	.def_domain_type = qcom_smmu_def_domain_type,
 	.reset = qcom_sm8350_smmu500_reset,
-	.write_s2cr = qcom_smmu_write_s2cr,
+	.write_s2cr = qcom_sm8350_smmu500_write_s2cr,
 	.tlb_sync = qcom_smmu_tlb_sync,
 	.alloc_context_bank = qcom_sm8350_smmu500_alloc_context_bank,
 #ifdef CONFIG_ARM_SMMU_QCOM_DEBUG
