+			afe->hw_vote[hw_block_id].uncertain = true;
+			dev_err(afe->dev, "AFE vote block %u failed: %d, state unknown until DSP rebind\n",
+				hw_block_id, ret);
+		}
+	}
+	mutex_unlock(&afe->lock);
 
 	return ret;
 }
