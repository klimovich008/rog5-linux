+	mutex_lock(&afe->lock);
+	afe->hw_vote[hw_block_id].wanted = false;
+	if (afe->hw_vote[hw_block_id].uncertain ||
+	    !afe->hw_vote[hw_block_id].confirmed ||
+	    afe->hw_vote[hw_block_id].handle != client_handle) {
+		ret = -EIO;
+		goto unlock;
+	}
+	ret = q6afe_hw_vote_send(afe, pkt, NULL);
+	if (!ret) {
+		afe->hw_vote[hw_block_id].confirmed = false;
+		afe->hw_vote[hw_block_id].handle = 0;
+	} else {
+		/* The void CCF unprepare callback cannot propagate this error. */
+		afe->hw_vote[hw_block_id].uncertain = true;
+		dev_err(afe->dev, "AFE unvote block %u failed: %d, state unknown until DSP rebind\n",
+			hw_block_id, ret);
+	}
+unlock:
+	mutex_unlock(&afe->lock);
 
 	return ret;
 }
