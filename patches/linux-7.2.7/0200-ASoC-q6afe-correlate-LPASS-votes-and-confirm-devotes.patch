+/* afe->lock serialises submission with clocks and all port commands. */
+static int q6afe_hw_vote_send(struct q6afe *afe, struct apr_pkt *pkt, u32 *handle)
+{
+	unsigned long flags;
+	long left;
+	int ret;
+
+	lockdep_assert_held(&afe->lock);
+	spin_lock_irqsave(&afe->hw_vote_lock, flags);
+	/* Never reuse a token, including after timeout. */
+	if (afe->hw_vote_seq == 0x7fffffff) {
+		spin_unlock_irqrestore(&afe->hw_vote_lock, flags);
+		return -EOVERFLOW;
+	}
+	pkt->hdr.token = BIT(31) | ++afe->hw_vote_seq;
+	afe->hw_vote_token = pkt->hdr.token;
+	afe->hw_vote_opcode = pkt->hdr.opcode;
+	afe->hw_vote_error = 0;
+	afe->hw_vote_handle = 0;
+	WRITE_ONCE(afe->hw_vote_pending, true);
+	spin_unlock_irqrestore(&afe->hw_vote_lock, flags);
+
+	ret = apr_send_pkt(afe->apr, pkt);
+	if (ret >= 0) {
+		left = wait_event_timeout(afe->wait, !READ_ONCE(afe->hw_vote_pending),
+					  msecs_to_jiffies(TIMEOUT_MS));
+		spin_lock_irqsave(&afe->hw_vote_lock, flags);
+		ret = left ? afe->hw_vote_error : -ETIMEDOUT;
+		if (!ret && handle)
+			*handle = afe->hw_vote_handle;
+		spin_unlock_irqrestore(&afe->hw_vote_lock, flags);
+	}
+	spin_lock_irqsave(&afe->hw_vote_lock, flags);
+	WRITE_ONCE(afe->hw_vote_pending, false);
+	spin_unlock_irqrestore(&afe->hw_vote_lock, flags);
+	return ret;
+}
