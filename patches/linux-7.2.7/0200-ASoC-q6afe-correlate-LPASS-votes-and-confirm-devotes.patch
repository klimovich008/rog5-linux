+/* APR echoes an opaque token; high-bit tokens are reserved for HW votes. */
+static void q6afe_hw_vote_reply(struct q6afe *afe, const struct apr_resp_pkt *data)
+{
+	const struct aprv2_ibasic_rsp_result_t *res = data->payload;
+	const struct apr_hdr *hdr = &data->hdr;
+	unsigned long flags;
+	u32 handle = 0;
+	int error = 0;
+
+	spin_lock_irqsave(&afe->hw_vote_lock, flags);
+	if (!afe->hw_vote_pending || hdr->token != afe->hw_vote_token)
+		goto out;
+
+	if (hdr->opcode == APR_BASIC_RSP_RESULT) {
+		if (data->payload_size < sizeof(*res)) {
+			error = -EPROTO;
+		} else if (res->opcode != afe->hw_vote_opcode) {
+			goto out;
+		} else if (res->status ||
+			   afe->hw_vote_opcode == AFE_CMD_REMOTE_LPASS_CORE_HW_VOTE_REQUEST) {
+			/* A vote must return a nonzero handle, not basic success. */
+			error = -EINVAL;
+		}
+	} else if (hdr->opcode == AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST &&
+		   afe->hw_vote_opcode == AFE_CMD_REMOTE_LPASS_CORE_HW_VOTE_REQUEST) {
+		if (data->payload_size != sizeof(handle)) {
+			error = -EPROTO;
+		} else {
+			memcpy(&handle, data->payload, sizeof(handle));
+			if (!handle)
+				error = -EPROTO;
+		}
+	} else {
+		goto out;
+	}
+
+	afe->hw_vote_handle = handle;
+	afe->hw_vote_error = error;
+	WRITE_ONCE(afe->hw_vote_pending, false);
+	wake_up(&afe->wait);
+out:
+	spin_unlock_irqrestore(&afe->hw_vote_lock, flags);
+}
+
