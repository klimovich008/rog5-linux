From: Claude <noreply@anthropic.com>
Subject: [PATCH] drm/msm/dp: ROG5 use at most the lanes the Type-C pin assignment routes, propagate PHY errors

The lane count was min(DPCD, DT data-lanes, LTTPR): with data-lanes <0 1 2 3>
a 4-lane receiver behind pin assignment D (DP + USB3) would train 4 lanes.
Also limit it to the DP PHY's bus width (0136: the lanes the assignment
routes; 0 = not reported, no limit), as stock msm-5.4 limits multi-function
(D/F) partners to 2 lanes (dp_panel_read_dpcd).

The sink's link_info was never cleared: the rate is only derived while it is
0, so a previous sink's rate (a converter capped at HBR by 0110) survived an
unplug and replug of another sink. Build it from zero in a local struct for
every capability read, apply the 0110 converter cap, then publish it. The
struct copy is not atomic, and hpd_irq reruns the read while a stream is up,
so the readers take plugged_lock like the writers (plug/unplug/detect
already do): irq_hpd handling, mode_valid, and atomic_enable after the eDP
plug handler. None of these holders take modeset locks, so the order
modeset locks -> plugged_lock stays the only one.

phy_configure()/phy_power_on() results were ignored (also for the voltage
updates during training). Return them, and power the PHY off only when it was
powered on: the PHY core counts power_on/off, and an unbalanced
phy_power_off() leaves power_count at -1 so that no later phy_power_on()
reaches the driver again (DP dead until reboot). Link clocks likewise are
disabled only when enabled, and the main link control register (link clock
domain) is not touched while they are off: a failed re-enable during link
training returns with them off, and the cleanup that follows would stall the
bus on an unclocked access. Sink requests (hpd_irq) are ignored while the
link clocks are off for the same reason.

--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -140,6 +140,8 @@
 	bool core_clks_on;
 	bool link_clks_on;
 	bool stream_clks_on;
+	/* ROG5: phy_power_on() succeeded and no phy_power_off() since */
+	bool phy_powered;
 };
 
 static inline u32 msm_dp_read_ahb(const struct msm_dp_ctrl_private *ctrl, u32 offset)
@@ -334,6 +336,14 @@
 {
 	u32 mainlink_ctrl;
 
+	/*
+	 * ROG5: the link registers are only clocked with the link clocks: a
+	 * failed main link re-enable (PHY error) leaves them off, and the
+	 * cleanup that follows must not stall the bus.
+	 */
+	if (!ctrl->link_clks_on)
+		return;
+
 	drm_dbg_dp(ctrl->drm_dev, "disable\n");
 
 	mainlink_ctrl = msm_dp_read_link(ctrl, REG_DP_MAINLINK_CTRL);
@@ -1360,15 +1370,16 @@
 			     u8 v_level, u8 p_level)
 {
 	union phy_configure_opts *phy_opts = &ctrl->phy_opts;
+	int ret;
 
 	/* TODO: Update for all lanes instead of just first one */
 	phy_opts->dp.voltage[0] = v_level;
 	phy_opts->dp.pre[0] = p_level;
 	phy_opts->dp.set_voltages = 1;
-	phy_configure(ctrl->phy, phy_opts);
+	ret = phy_configure(ctrl->phy, phy_opts);
 	phy_opts->dp.set_voltages = 0;
 
-	return 0;
+	return ret;
 }
 
 static int msm_dp_ctrl_update_phy_vx_px(struct msm_dp_ctrl_private *ctrl,
@@ -1835,6 +1846,10 @@
 
 	ctrl = container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
 
+	/* ROG5: a failed (re)enable leaves them off; keep the clk counts balanced */
+	if (!ctrl->link_clks_on)
+		return;
+
 	clk_bulk_disable_unprepare(ctrl->num_link_clks, ctrl->link_clks);
 
 	ctrl->link_clks_on = false;
@@ -1846,6 +1861,36 @@
 		   str_on_off(ctrl->core_clks_on));
 }
 
+/*
+ * ROG5: phy_power_on() failures are reported now (the QMP PHY refuses more
+ * lanes than the Type-C pin assignment routes, and PLL lock timeouts). The
+ * PHY core counts power_on/off, so only power off what was powered on: an
+ * unbalanced phy_power_off() leaves power_count at -1 and the next
+ * phy_power_on() never reaches the driver again.
+ */
+static int msm_dp_ctrl_phy_power_on(struct msm_dp_ctrl_private *ctrl)
+{
+	int ret;
+
+	if (ctrl->phy_powered)
+		return 0;
+
+	ret = phy_power_on(ctrl->phy);
+	if (!ret)
+		ctrl->phy_powered = true;
+
+	return ret;
+}
+
+static void msm_dp_ctrl_phy_power_off(struct msm_dp_ctrl_private *ctrl)
+{
+	if (!ctrl->phy_powered)
+		return;
+
+	phy_power_off(ctrl->phy);
+	ctrl->phy_powered = false;
+}
+
 static int msm_dp_ctrl_enable_mainlink_clocks(struct msm_dp_ctrl_private *ctrl)
 {
 	int ret = 0;
@@ -1856,13 +1901,26 @@
 	ctrl->phy_opts.dp.link_rate = ctrl->link->link_params.rate / 100;
 	ctrl->phy_opts.dp.ssc = msm_dp_ctrl_ssc(dpcd);
 
-	phy_configure(phy, &ctrl->phy_opts);
-	phy_power_on(phy);
+	ret = phy_configure(phy, &ctrl->phy_opts);
+	if (ret) {
+		DRM_ERROR("DP PHY rejected %u lanes x %u kHz: %d\n",
+			  ctrl->link->link_params.num_lanes,
+			  ctrl->link->link_params.rate, ret);
+		return ret;
+	}
+
+	ret = msm_dp_ctrl_phy_power_on(ctrl);
+	if (ret) {
+		DRM_ERROR("DP PHY power on failed: %d\n", ret);
+		return ret;
+	}
 
 	dev_pm_opp_set_rate(ctrl->dev, ctrl->link->link_params.rate * 1000);
 	ret = msm_dp_ctrl_link_clk_enable(&ctrl->msm_dp_ctrl);
-	if (ret)
+	if (ret) {
 		DRM_ERROR("Unable to start link clocks. ret=%d\n", ret);
+		msm_dp_ctrl_phy_power_off(ctrl);
+	}
 
 	drm_dbg_dp(ctrl->drm_dev, "link rate=%d\n", ctrl->link->link_params.rate);
 
@@ -2005,7 +2063,9 @@
 
 	msm_dp_ctrl_mainlink_disable(ctrl);
 	ctrl->phy_opts.dp.lanes = ctrl->link->link_params.num_lanes;
-	phy_configure(phy, &ctrl->phy_opts);
+	ret = phy_configure(phy, &ctrl->phy_opts);
+	if (ret)
+		return ret;
 
 	/*
 	 * Disable and re-enable the mainlink clock since the
@@ -2014,7 +2074,7 @@
 	 */
 	msm_dp_ctrl_link_clk_disable(&ctrl->msm_dp_ctrl);
 
-	phy_power_off(phy);
+	msm_dp_ctrl_phy_power_off(ctrl);
 	/* hw recommended delay before re-enabling clocks */
 	msleep(20);
 
@@ -2039,7 +2099,7 @@
 
 	msm_dp_ctrl_link_clk_disable(&ctrl->msm_dp_ctrl);
 
-	phy_power_off(phy);
+	msm_dp_ctrl_phy_power_off(ctrl);
 
 	/* aux channel down, reinit phy */
 	phy_exit(phy);
@@ -2266,6 +2326,16 @@
 	ctrl = container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
 	sink_request = ctrl->link->sink_request;
 
+	/*
+	 * ROG5: every request below touches the link registers, clocked only
+	 * with the link clocks (off after a failed link enable).
+	 */
+	if (!ctrl->link_clks_on) {
+		drm_dbg_dp(ctrl->drm_dev, "sink request 0x%x with the link off\n",
+			   sink_request);
+		return;
+	}
+
 	if (sink_request & DP_TEST_LINK_PHY_TEST_PATTERN) {
 		drm_dbg_dp(ctrl->drm_dev, "PHY_TEST_PATTERN request\n");
 		if (msm_dp_ctrl_process_phy_test_request(ctrl)) {
@@ -2643,7 +2713,7 @@
 	dev_pm_opp_set_rate(ctrl->dev, 0);
 	msm_dp_ctrl_link_clk_disable(&ctrl->msm_dp_ctrl);
 
-	phy_power_off(phy);
+	msm_dp_ctrl_phy_power_off(ctrl);
 
 	/* aux channel down, reinit phy */
 	phy_exit(phy);
@@ -2653,10 +2723,8 @@
 void msm_dp_ctrl_off(struct msm_dp_ctrl *msm_dp_ctrl)
 {
 	struct msm_dp_ctrl_private *ctrl;
-	struct phy *phy;
 
 	ctrl = container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
-	phy = ctrl->phy;
 
 	msm_dp_panel_disable_vsc_sdp(ctrl->panel);
 
@@ -2671,7 +2739,7 @@
 
 	msm_dp_ctrl_link_clk_disable(&ctrl->msm_dp_ctrl);
 
-	phy_power_off(phy);
+	msm_dp_ctrl_phy_power_off(ctrl);
 }
 
 irqreturn_t msm_dp_ctrl_isr(struct msm_dp_ctrl *msm_dp_ctrl)
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -493,6 +493,13 @@
 	u32 sink_request;
 	int rc = 0;
 
+	/*
+	 * ROG5: serialise with plug/unplug, mode validation and link enable:
+	 * a DS_PORT_STATUS_CHANGED rereads the sink's link_info, and sink
+	 * requests retrain the link.
+	 */
+	guard(mutex)(&dp->plugged_lock);
+
 	/* irq_hpd can happen at either connected or disconnected state */
 	drm_dbg_dp(dp->drm_dev, "Before, type=%d, sink_count=%d\n",
 			dp->msm_dp_display.connector_type,
@@ -556,6 +563,8 @@
 		goto error_link;
 	}
 
+	dp->link->phy = phy;
+
 	dp->panel = msm_dp_panel_get(dev, dp->aux, dp->link, dp->link_base, dp->p0_base);
 	if (IS_ERR(dp->panel)) {
 		rc = PTR_ERR(dp->panel);
@@ -791,6 +800,14 @@
 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
 	link_info = &msm_dp_display->panel->link_info;
 
+	/*
+	 * ROG5: link_info (lanes, rate) is rewritten at every capability read
+	 * under plugged_lock; never validate against a half-updated copy.
+	 * Called with mode_config.mutex/modeset locks held; no plugged_lock
+	 * holder takes those.
+	 */
+	guard(mutex)(&msm_dp_display->plugged_lock);
+
 	is_yuv_420 = drm_mode_is_420_only(&dp->connector->display_info, mode);
 
 	/*
@@ -1473,6 +1490,13 @@
 		return;
 	}
 
+	/*
+	 * ROG5: the link enable reads the sink's link_info (bpp, lanes, rate)
+	 * and trains the link: serialise with capability rereads and sink
+	 * requests (hpd/irq_hpd). After the eDP plug handler, which takes it.
+	 */
+	guard(mutex)(&msm_dp_display->plugged_lock);
+
 	if (msm_dp_display->link->sink_count == 0)
 		return;
 
--- a/drivers/gpu/drm/msm/dp/dp_link.h
+++ b/drivers/gpu/drm/msm/dp/dp_link.h
@@ -64,7 +64,12 @@
 	u8 p_level;
 };
 
+struct phy;
+
 struct msm_dp_link {
+	/* ROG5: the DP PHY; its bus width = lanes the Type-C pin assignment routes */
+	struct phy *phy;
+
 	u8 lttpr_common_caps[DP_LTTPR_COMMON_CAP_SIZE];
 	int lttpr_count;
 
--- a/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -14,6 +14,7 @@
 
 #include <linux/io.h>
 #include <linux/moduleparam.h>
+#include <linux/phy/phy.h>
 #include <linux/types.h>
 #include <asm/byteorder.h>
 
@@ -86,11 +87,17 @@
 	}
 }
 
-static int msm_dp_panel_read_dpcd(struct msm_dp_panel *msm_dp_panel)
+/*
+ * ROG5: fills the caller's link_info; msm_dp_panel_read_sink_caps() publishes
+ * it once every cap is applied (callers hold plugged_lock, like the readers:
+ * mode_valid, atomic_enable, irq_hpd), so no reader sees a cleared or
+ * uncapped copy.
+ */
+static int msm_dp_panel_read_dpcd(struct msm_dp_panel *msm_dp_panel,
+				  struct msm_dp_link_info *link_info)
 {
-	int rc, max_lttpr_lanes, max_lttpr_rate;
+	int rc, max_lttpr_lanes, max_lttpr_rate, phy_lanes;
 	struct msm_dp_panel_private *panel;
-	struct msm_dp_link_info *link_info;
 	struct msm_dp_link *link;
 	u8 *dpcd, major, minor;
 
@@ -101,7 +108,12 @@
 		return rc;
 
 	msm_dp_panel->vsc_sdp_supported = drm_dp_vsc_sdp_supported(panel->aux, dpcd);
-	link_info = &msm_dp_panel->link_info;
+	/*
+	 * ROG5: recompute everything for this sink. The rate below is only
+	 * derived while it is 0, so a previous sink's rate (a converter capped
+	 * at HBR by 0110, a 4-lane monitor) survived an unplug and replug.
+	 */
+	memset(link_info, 0, sizeof(*link_info));
 	link_info->revision = dpcd[DP_DPCD_REV];
 	major = (link_info->revision >> 4) & 0x0f;
 	minor = link_info->revision & 0x0f;
@@ -194,6 +206,19 @@
 	if (link_info->num_lanes > link->max_dp_lanes)
 		link_info->num_lanes = link->max_dp_lanes;
 
+	/*
+	 * ROG5: limit data lanes to what the Type-C pin assignment routes to DP
+	 * (the combo PHY's bus width: C/E 4, D 2; 0 = not reported). A receiver
+	 * behind assignment D (a USB-C hub) may still offer 4 lanes in DPCD.
+	 */
+	phy_lanes = link->phy ? phy_get_bus_width(link->phy) : 0;
+	if (phy_lanes > 0 && link_info->num_lanes > phy_lanes) {
+		drm_info(panel->drm_dev,
+			 "DP: sink offers %u lanes, the Type-C pin assignment routes %d\n",
+			 link_info->num_lanes, phy_lanes);
+		link_info->num_lanes = phy_lanes;
+	}
+
 	/* Limit data lanes from LTTPR capabilities, if any */
 	if (max_lttpr_lanes && max_lttpr_lanes < link_info->num_lanes)
 		link_info->num_lanes = max_lttpr_lanes;
@@ -227,9 +252,9 @@
 module_param_named(dp_pcon_max_rate, msm_dp_pcon_max_rate, uint, 0644);
 MODULE_PARM_DESC(dp_pcon_max_rate, "cap the link rate (kHz) behind a DP-to-HDMI/DVI converter, 0 = no cap");
 
-static void msm_dp_panel_cap_pcon_rate(struct msm_dp_panel *msm_dp_panel)
+static void msm_dp_panel_cap_pcon_rate(struct msm_dp_panel *msm_dp_panel,
+				       struct msm_dp_link_info *link_info)
 {
-	struct msm_dp_link_info *link_info = &msm_dp_panel->link_info;
 	const u8 *dpcd = msm_dp_panel->dpcd;
 	int i;
 
@@ -322,6 +347,7 @@
 	int rc, bw_code;
 	int count;
 	struct msm_dp_panel_private *panel;
+	struct msm_dp_link_info link_info;
 
 	if (!msm_dp_panel || !connector) {
 		DRM_ERROR("invalid input\n");
@@ -330,18 +356,18 @@
 
 	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
 
-	rc = msm_dp_panel_read_dpcd(msm_dp_panel);
+	rc = msm_dp_panel_read_dpcd(msm_dp_panel, &link_info);
 	if (rc) {
 		DRM_ERROR("read dpcd failed %d\n", rc);
 		return rc;
 	}
 
-	bw_code = drm_dp_link_rate_to_bw_code(msm_dp_panel->link_info.rate);
+	bw_code = drm_dp_link_rate_to_bw_code(link_info.rate);
 	if (!is_link_rate_valid(bw_code) ||
-			!is_lane_count_valid(msm_dp_panel->link_info.num_lanes) ||
+			!is_lane_count_valid(link_info.num_lanes) ||
 			(bw_code > msm_dp_panel->max_bw_code)) {
-		DRM_ERROR("Illegal link rate=%d lane=%d\n", msm_dp_panel->link_info.rate,
-				msm_dp_panel->link_info.num_lanes);
+		DRM_ERROR("Illegal link rate=%d lane=%d\n", link_info.rate,
+				link_info.num_lanes);
 		return -EINVAL;
 	}
 
@@ -358,7 +384,10 @@
 	if (rc)
 		return rc;
 
-	msm_dp_panel_cap_pcon_rate(msm_dp_panel);
+	msm_dp_panel_cap_pcon_rate(msm_dp_panel, &link_info);
+
+	/* ROG5: publish the sink's link limits, caps applied (plugged_lock held) */
+	msm_dp_panel->link_info = link_info;
 
 	drm_edid_free(msm_dp_panel->drm_edid);
 
