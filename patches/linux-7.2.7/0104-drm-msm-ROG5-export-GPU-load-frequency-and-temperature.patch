From: Claude <noreply@anthropic.com>
Subject: [PATCH] drm/msm: ROG5 export GPU load, frequency and temperature

System monitors (GNOME Resources, nvtop-style tools) read GPU load from the
amdgpu-style device/gpu_busy_percent and temperature/clock from a hwmon under
the DRM card's device. msm has neither, so the Adreno shows no load, clock
or temperature.

Keep the devfreq sample's busy/total ratio (0 while suspended) and export it
as gpu_busy_percent on the GPU device, and register an "msm_gpu" hwmon with
freq1_input (current GPU clock, Hz) and temp1_input (hottest GPU thermal
zone, millidegrees).

--- a/drivers/gpu/drm/msm/msm_gpu.h	2026-09-29 16:46:20.180143862 +0200
+++ b/drivers/gpu/drm/msm/msm_gpu.h	2026-09-29 16:46:20.196773154 +0200
@@ -148,6 +148,12 @@
 	 * cycles since last sampling period.
 	 */
 	u64 busy_cycles;
+
+	/**
+	 * @busy_percent: GPU load over the last devfreq sample, 0 while
+	 * suspended (ROG5: exported as gpu_busy_percent for monitors)
+	 */
+	unsigned int busy_percent;
 	/** @time: Time of last sampling period.  */
 	ktime_t time;
 	/** @idle_time: Time of last transition to idle.  */
--- a/drivers/gpu/drm/msm/msm_gpu_devfreq.c	2026-09-29 16:46:20.180077611 +0200
+++ b/drivers/gpu/drm/msm/msm_gpu_devfreq.c	2026-09-29 16:46:36.914712984 +0200
@@ -9,6 +9,9 @@
 
 #include <linux/devfreq.h>
 #include <linux/devfreq_cooling.h>
+#include <linux/hwmon.h>
+#include <linux/hwmon-sysfs.h>
+#include <linux/thermal.h>
 #include <linux/math64.h>
 #include <linux/units.h>
 
@@ -91,6 +94,7 @@
 	df->time = time;
 
 	if (df->suspended) {
+		df->busy_percent = 0;
 		mutex_unlock(&df->lock);
 		status->busy_time = 0;
 		return 0;
@@ -108,6 +112,8 @@
 		busy_time = ~0LU;
 
 	status->busy_time = busy_time;
+	WRITE_ONCE(df->busy_percent, status->total_time ?
+		   min_t(u64, div64_u64((u64)busy_time * 100, status->total_time), 100) : 0);
 
 	return 0;
 }
@@ -130,6 +136,86 @@
 static void msm_devfreq_boost_work(struct kthread_work *work);
 static void msm_devfreq_idle_work(struct kthread_work *work);
 
+/*
+ * ROG5: system monitors (Resources, nvtop-style tools) look for the
+ * amdgpu-style device/gpu_busy_percent and a hwmon with temp1_input and
+ * freq1_input under the DRM card's device. Export both from devfreq's view.
+ */
+static ssize_t gpu_busy_percent_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(dev_to_gpu(dev)->devfreq.busy_percent));
+}
+static DEVICE_ATTR_RO(gpu_busy_percent);
+
+static struct attribute *msm_gpu_busy_attrs[] = {
+	&dev_attr_gpu_busy_percent.attr,
+	NULL
+};
+
+static const struct attribute_group msm_gpu_busy_group = {
+	.attrs = msm_gpu_busy_attrs,
+};
+
+static ssize_t freq1_input_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct msm_gpu *gpu = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%lu\n", get_freq(gpu));
+}
+static SENSOR_DEVICE_ATTR_RO(freq1_input, freq1_input, 0);
+
+static ssize_t freq1_label_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "sclk\n");
+}
+static SENSOR_DEVICE_ATTR_RO(freq1_label, freq1_label, 0);
+
+static const char * const msm_gpu_tz_names[] = {
+	"gpu-top-thermal", "gpu-bottom-thermal", "gpuss-0-thermal", "gpuss-1-thermal",
+};
+
+static ssize_t temp1_input_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	int i, t, best = INT_MIN;
+
+	for (i = 0; i < ARRAY_SIZE(msm_gpu_tz_names); i++) {
+		struct thermal_zone_device *tz =
+			thermal_zone_get_zone_by_name(msm_gpu_tz_names[i]);
+
+		if (!IS_ERR(tz) && !thermal_zone_get_temp(tz, &t) && t > best)
+			best = t;
+	}
+	if (best == INT_MIN)
+		return -ENODATA;
+	return sysfs_emit(buf, "%d\n", best);
+}
+static SENSOR_DEVICE_ATTR_RO(temp1_input, temp1_input, 0);
+
+static struct attribute *msm_gpu_hwmon_attrs[] = {
+	&sensor_dev_attr_freq1_input.dev_attr.attr,
+	&sensor_dev_attr_freq1_label.dev_attr.attr,
+	&sensor_dev_attr_temp1_input.dev_attr.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(msm_gpu_hwmon);
+
+static void msm_devfreq_export(struct msm_gpu *gpu)
+{
+	struct device *dev = &gpu->pdev->dev;
+	struct device *hwmon;
+
+	if (devm_device_add_group(dev, &msm_gpu_busy_group))
+		dev_warn(dev, "gpu_busy_percent not exported\n");
+	hwmon = devm_hwmon_device_register_with_groups(dev, "msm_gpu", gpu,
+						       msm_gpu_hwmon_groups);
+	if (IS_ERR(hwmon))
+		dev_warn(dev, "GPU hwmon not registered: %ld\n", PTR_ERR(hwmon));
+}
+
 static bool has_devfreq(struct msm_gpu *gpu)
 {
 	struct msm_gpu_devfreq *df = &gpu->devfreq;
@@ -188,6 +274,7 @@
 	}
 
 	devfreq_suspend_device(df->devfreq);
+	msm_devfreq_export(gpu);
 
 	gpu->cooling = of_devfreq_cooling_register(gpu->pdev->dev.of_node, df->devfreq);
 	if (IS_ERR(gpu->cooling)) {
@@ -251,6 +338,7 @@
 
 	mutex_lock(&df->lock);
 	df->suspended = true;
+	df->busy_percent = 0;
 	mutex_unlock(&df->lock);
 
 	devfreq_suspend_device(df->devfreq);
