--- a/drivers/gpu/drm/panel/panel-asus-rog5-ams678.c
+++ b/drivers/gpu/drm/panel/panel-asus-rog5-ams678.c
@@ -393,6 +393,16 @@
 	 */
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
+	/*
+	 * Only the first 0x51 byte reaches the panel through the Iris6 analog
+	 * bypass: it sets DBV[9:8], giving off plus three visible levels (a lone
+	 * byte, the second byte or a generic long write change nothing else).
+	 * Spread 1..1023 over those three levels so only 0 is dark; the plain
+	 * high byte made every value below 256 black.
+	 */
+	if (brightness)
+		brightness = (1 + (brightness - 1) * 3 / 1023) << 8;
+
 	/* Vendor inverted-DBV handling sends the high byte first. */
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
 	dsi->mode_flags = mode_flags;
