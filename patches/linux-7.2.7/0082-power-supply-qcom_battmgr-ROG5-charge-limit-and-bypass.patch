+static void qcom_battmgr_shutdown(struct auxiliary_device *adev)
+{
+	struct qcom_battmgr *battmgr = auxiliary_get_drvdata(adev);
+
+	if (battmgr && battmgr->oem_client)
+		qcom_battmgr_asus_chg_stop(battmgr);
+}
