+/* Stop the policy and hand the charger back in its default state. */
+static void qcom_battmgr_asus_chg_stop(struct qcom_battmgr *battmgr)
+{
+	int ret;
+
+	disable_delayed_work_sync(&battmgr->asus_chg_work);
+
+	if (battmgr->asus_chg_usbin_suspended) {
+		ret = qcom_battmgr_asus_set_usbin_suspend(battmgr, false);
+		if (ret)
+			dev_warn(battmgr->dev, "failed to resume USB input: %d\n", ret);
+		else
+			battmgr->asus_chg_usbin_suspended = false;
+	}
+
+	if (battmgr->asus_chg_paused) {
+		ret = qcom_battmgr_asus_set_bypass(battmgr, false);
+		if (ret)
+			dev_warn(battmgr->dev, "failed to resume charging: %d\n", ret);
+		else
+			battmgr->asus_chg_paused = false;
+	}
+}
+
+static void qcom_battmgr_asus_chg_release(void *data)
+{
+	qcom_battmgr_asus_chg_stop(data);
+}
+
+static void qcom_battmgr_asus_chg_cancel(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	disable_delayed_work_sync(&battmgr->asus_chg_work);
+}
