+static int qcom_battmgr_resume(struct device *dev)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+
+	/* The charge mode may have changed while suspended (replug). */
+	qcom_battmgr_asus_chg_kick(battmgr, true);
+
+	return 0;
+}
