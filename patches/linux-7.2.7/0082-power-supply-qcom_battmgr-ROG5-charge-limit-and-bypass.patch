From: Claude <noreply@anthropic.com>
Subject: [PATCH] power: supply: qcom_battmgr: ROG5 charge limit and bypass

The ZS673KS firmware does not know the battery manager charge control
(opcode 0x48, properties 25/26); the stock kernel limits charging itself
through the ASUS OEM owner (asus_battery_charger.c monitor_charging_enable()):
SET_CHG_LIMIT_MODE2 (0x2117, u32 mode + u32 value) with SET_BYPASS_CHG_MODE
(0x8) pauses charging while the system keeps running from VBUS, and
SET_USBIN_SUSPNED (0x2105, u32 enable) cuts the input. Both acks have the
request's length. Add the same policy to the OEM client of patch 0018:

- the battery gets charge_behaviour (auto, inhibit-charge, force-discharge)
  and writable charge_control_start/end_threshold, kept in memory only.
  Defaults are auto and 0/100, so nothing is sent until userspace sets a
  value. Setting end fills in start = end - 5 when start is unset, and
  setting start >= end moves end to start + 5, as on sm8550;
- a work item pauses charging (mode2 0x8 = 1) for inhibit-charge or once the
  capacity reaches the end threshold, resumes (0) at or below the start
  threshold, and suspends USBIN only for force-discharge. It runs on
  battery and USB notifications, a threshold write, OEM/BC PDR up, resume
  and the stock VBUS-attached event (OEM notification 0x2112), and every
  60 s while a limit is set. Messages go out on a state change; an active
  pause or input suspend is also re-sent after an ADSP restart, a resume, a
  VBUS attach and every 60 s while USB is online (stock sends only on
  change, but the firmware state across replugs is unverified);
- the OEM request path is shared with the cell voltage read. The ack is
  matched against the pending opcode, and OEM notifications no longer
  complete a pending request with -EPROTO. Poisoned channels send nothing;
- unbind and shutdown restore charging and the USB input before the
  pmic_glink clients go away.

Other SoCs, and SM8350 without asus,cell-voltage-readonly, keep their
descriptors and behaviour; the resume callback only kicks the ROG5 work.

--- a/drivers/power/supply/qcom_battmgr.c	2026-09-28 04:20:58.264247843 +0200
+++ b/drivers/power/supply/qcom_battmgr.c	2026-09-28 04:20:58.280285141 +0200
@@ -21,8 +21,21 @@
 #define BATTMGR_STRING_LEN	128
 
 #define PMIC_GLINK_OWNER_ASUS_ROG5	32782
+#define ASUS_ROG5_SET_USBIN_SUSPEND	0x2105
+#define ASUS_ROG5_EVT_ADSP_TO_HLOS	0x2112
+#define ASUS_ROG5_SET_CHG_LIMIT_MODE2	0x2117
 #define ASUS_ROG5_GET_CELL_VOLTAGE	0x3005
 
+/* SET_CHG_LIMIT_MODE2 mode bit: run the system from VBUS, cells rest */
+#define ASUS_ROG5_CHG_MODE_BYPASS	0x8
+/* ADSP_TO_HLOS event: VBUS attached (value 1) or detached (value 0) */
+#define ASUS_ROG5_EVT_VBUS_ATTACHED	0x2
+
+/* ROG5 kernel-side charge limit (stock asus_battery_charger.c policy) */
+#define ASUS_ROG5_CHG_END_MIN		20
+#define ASUS_ROG5_CHG_DELTA		5
+#define ASUS_ROG5_CHG_INTERVAL		(60 * HZ)
+
 enum qcom_battmgr_variant {
 	QCOM_BATTMGR_SC8280XP,
 	QCOM_BATTMGR_SM8350,
@@ -159,6 +172,25 @@
 	__le16 cell2_voltage;
 };
 
+/* SET_CHG_LIMIT_MODE2 request; the ADSP acks with a message of equal length */
+struct qcom_battmgr_asus_chg_mode2_msg {
+	struct pmic_glink_hdr hdr;
+	__le32 mode;
+	__le32 value;
+};
+
+/* SET_USBIN_SUSPEND request; the ADSP acks with a message of equal length */
+struct qcom_battmgr_asus_usbin_suspend_msg {
+	struct pmic_glink_hdr hdr;
+	__le32 enable;
+};
+
+struct qcom_battmgr_asus_evt_msg {
+	struct pmic_glink_hdr hdr;
+	__le32 evt_id;
+	__le32 value;
+};
+
 struct qcom_battmgr_message {
 	struct pmic_glink_hdr hdr;
 	union {
@@ -344,9 +376,27 @@
 	bool oem_service_up;
 	bool oem_request_poisoned;
 	u32 oem_service_generation;
+	u32 oem_opcode;
 	u16 cell1_voltage_mv;
 	u16 cell2_voltage_mv;
 
+	/*
+	 * ROG5 charge control (only with @oem_client). @asus_chg_lock protects
+	 * the requested behaviour, the thresholds and the hysteresis state;
+	 * the ADSP-side state below it is owned by @asus_chg_work.
+	 */
+	struct delayed_work asus_chg_work;
+	struct mutex asus_chg_lock;
+	int asus_chg_behaviour;
+	unsigned int asus_chg_start;
+	unsigned int asus_chg_end;
+	bool asus_chg_limit_hold;
+	atomic_t asus_chg_reassert;
+	bool asus_chg_paused;
+	bool asus_chg_usbin_suspended;
+	bool asus_chg_usb_online;
+	unsigned long asus_chg_asserted;
+
 	struct qcom_battmgr_info info;
 	struct qcom_battmgr_status status;
 	struct qcom_battmgr_ac ac;
@@ -362,66 +412,203 @@
 	struct mutex lock;
 };
 
-static int qcom_battmgr_request_asus_cell_voltages(struct qcom_battmgr *battmgr,
-						   u16 *cell1_mv, u16 *cell2_mv)
+/*
+ * Send one request to the ASUS OEM client and wait for its ack; called with
+ * @battmgr->lock held. The callback checks the ack against @oem_opcode.
+ */
+static int qcom_battmgr_asus_request_locked(struct qcom_battmgr *battmgr,
+					    void *data, size_t len)
 {
-	struct qcom_battmgr_asus_cell_voltage_request request = {
-		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_ASUS_ROG5),
-		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
-		.hdr.opcode = cpu_to_le32(ASUS_ROG5_GET_CELL_VOLTAGE),
-	};
+	struct pmic_glink_hdr *hdr = data;
 	unsigned long left;
 	u32 generation;
 	int ret;
 
+	lockdep_assert_held(&battmgr->lock);
+
 	if (!READ_ONCE(battmgr->oem_service_up))
 		return -EAGAIN;
 	if (READ_ONCE(battmgr->oem_request_poisoned))
 		return -EIO;
 
-	mutex_lock(&battmgr->lock);
-	if (!READ_ONCE(battmgr->oem_service_up)) {
-		ret = -EAGAIN;
-		goto out_unlock;
-	}
-	if (READ_ONCE(battmgr->oem_request_poisoned)) {
-		ret = -EIO;
-		goto out_unlock;
-	}
-
 	generation = READ_ONCE(battmgr->oem_service_generation);
 	reinit_completion(&battmgr->oem_ack);
 	battmgr->oem_error = 0;
+	WRITE_ONCE(battmgr->oem_opcode, le32_to_cpu(hdr->opcode));
 	if (!READ_ONCE(battmgr->oem_service_up) ||
-	    READ_ONCE(battmgr->oem_service_generation) != generation) {
-		ret = -EAGAIN;
-		goto out_unlock;
-	}
+	    READ_ONCE(battmgr->oem_service_generation) != generation)
+		return -EAGAIN;
 
-	ret = pmic_glink_send(battmgr->oem_client, &request, sizeof(request));
+	ret = pmic_glink_send(battmgr->oem_client, data, len);
 	if (ret < 0)
-		goto out_unlock;
+		return ret;
 
 	left = wait_for_completion_timeout(&battmgr->oem_ack, HZ);
 	if (!left) {
 		WRITE_ONCE(battmgr->oem_request_poisoned, true);
-		ret = -ETIMEDOUT;
-		goto out_unlock;
+		return -ETIMEDOUT;
 	}
 	if (!READ_ONCE(battmgr->oem_service_up) ||
-	    READ_ONCE(battmgr->oem_service_generation) != generation) {
-		ret = -ENOTCONN;
-		goto out_unlock;
-	}
+	    READ_ONCE(battmgr->oem_service_generation) != generation)
+		return -ENOTCONN;
+
+	return battmgr->oem_error;
+}
+
+static int qcom_battmgr_asus_request(struct qcom_battmgr *battmgr,
+				     void *data, size_t len)
+{
+	int ret;
+
+	if (!READ_ONCE(battmgr->oem_service_up))
+		return -EAGAIN;
+	if (READ_ONCE(battmgr->oem_request_poisoned))
+		return -EIO;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_asus_request_locked(battmgr, data, len);
+	mutex_unlock(&battmgr->lock);
+
+	return ret;
+}
+
+static int qcom_battmgr_request_asus_cell_voltages(struct qcom_battmgr *battmgr,
+						   u16 *cell1_mv, u16 *cell2_mv)
+{
+	struct qcom_battmgr_asus_cell_voltage_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_ASUS_ROG5),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(ASUS_ROG5_GET_CELL_VOLTAGE),
+	};
+	int ret;
 
-	ret = battmgr->oem_error;
+	if (!READ_ONCE(battmgr->oem_service_up))
+		return -EAGAIN;
+	if (READ_ONCE(battmgr->oem_request_poisoned))
+		return -EIO;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_asus_request_locked(battmgr, &request, sizeof(request));
 	if (!ret) {
 		*cell1_mv = battmgr->cell1_voltage_mv;
 		*cell2_mv = battmgr->cell2_voltage_mv;
 	}
-
-out_unlock:
 	mutex_unlock(&battmgr->lock);
+
+	return ret;
+}
+
+/* Stock asus_set_charger_limit_mode(SET_BYPASS_CHG_MODE, pause) */
+static int qcom_battmgr_asus_set_bypass(struct qcom_battmgr *battmgr, bool pause)
+{
+	struct qcom_battmgr_asus_chg_mode2_msg request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_ASUS_ROG5),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(ASUS_ROG5_SET_CHG_LIMIT_MODE2),
+		.mode = cpu_to_le32(ASUS_ROG5_CHG_MODE_BYPASS),
+		.value = cpu_to_le32(pause),
+	};
+
+	return qcom_battmgr_asus_request(battmgr, &request, sizeof(request));
+}
+
+/* Stock usbin_suspend_to_ADSP(enable) */
+static int qcom_battmgr_asus_set_usbin_suspend(struct qcom_battmgr *battmgr,
+					       bool suspend)
+{
+	struct qcom_battmgr_asus_usbin_suspend_msg request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_ASUS_ROG5),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(ASUS_ROG5_SET_USBIN_SUSPEND),
+		.enable = cpu_to_le32(suspend),
+	};
+
+	return qcom_battmgr_asus_request(battmgr, &request, sizeof(request));
+}
+
+/* Re-evaluate the charge policy; safe from atomic (glink callback) context. */
+static void qcom_battmgr_asus_chg_kick(struct qcom_battmgr *battmgr,
+				       bool reassert)
+{
+	if (!battmgr->oem_client)
+		return;
+
+	if (reassert)
+		atomic_set(&battmgr->asus_chg_reassert, 1);
+	mod_delayed_work(system_freezable_wq, &battmgr->asus_chg_work, 0);
+}
+
+static int qcom_battmgr_asus_chg_get(struct qcom_battmgr *battmgr,
+				     enum power_supply_property psp,
+				     union power_supply_propval *val)
+{
+	mutex_lock(&battmgr->asus_chg_lock);
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		val->intval = battmgr->asus_chg_behaviour;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		val->intval = battmgr->asus_chg_start;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		val->intval = battmgr->asus_chg_end;
+		break;
+	default:
+		break;
+	}
+	mutex_unlock(&battmgr->asus_chg_lock);
+
+	return 0;
+}
+
+static int qcom_battmgr_asus_chg_set(struct qcom_battmgr *battmgr,
+				     enum power_supply_property psp, int val)
+{
+	int ret = 0;
+
+	mutex_lock(&battmgr->asus_chg_lock);
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		if (val != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO &&
+		    val != POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE &&
+		    val != POWER_SUPPLY_CHARGE_BEHAVIOUR_FORCE_DISCHARGE) {
+			ret = -EINVAL;
+			break;
+		}
+		battmgr->asus_chg_behaviour = val;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		if (val < 0 || val > 99) {
+			ret = -EINVAL;
+			break;
+		}
+		battmgr->asus_chg_start = val;
+		/* Like the sm8550 path: move the end one delta above the start. */
+		if (battmgr->asus_chg_start >= battmgr->asus_chg_end)
+			battmgr->asus_chg_end = min(val + ASUS_ROG5_CHG_DELTA, 100);
+		battmgr->asus_chg_limit_hold = false;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		if (val < ASUS_ROG5_CHG_END_MIN || val > 100) {
+			ret = -EINVAL;
+			break;
+		}
+		battmgr->asus_chg_end = val;
+		/* Without a usable start, resume one delta below the end. */
+		if (val < 100 && (!battmgr->asus_chg_start ||
+				  battmgr->asus_chg_start >= val))
+			battmgr->asus_chg_start = val - ASUS_ROG5_CHG_DELTA;
+		battmgr->asus_chg_limit_hold = false;
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	mutex_unlock(&battmgr->asus_chg_lock);
+
+	if (!ret)
+		qcom_battmgr_asus_chg_kick(battmgr, false);
+
 	return ret;
 }
 
