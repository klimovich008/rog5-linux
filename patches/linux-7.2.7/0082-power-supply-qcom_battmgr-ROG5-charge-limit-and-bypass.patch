+/*
+ * ROG5 charge policy, after the stock monitor_charging_enable(): pause
+ * charging with SET_CHG_LIMIT_MODE2(BYPASS, 1) for inhibit-charge or once the
+ * capacity reaches the end threshold, resume at or below the start threshold;
+ * force-discharge suspends USBIN. Only state changes are sent, plus a
+ * re-assertion of an active pause/suspend after an ADSP restart, a resume,
+ * a VBUS attach and every 60 s while VBUS is present.
+ */
+static void qcom_battmgr_asus_chg_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(to_delayed_work(work),
+						    struct qcom_battmgr,
+						    asus_chg_work);
+	bool reassert = atomic_xchg(&battmgr->asus_chg_reassert, 0);
+	bool online = battmgr->asus_chg_usb_online;
+	bool active, hold, pause, usbin;
+	int start, end;
+	int capacity = -1;
+	int behaviour;
+	int ret;
+
+	mutex_lock(&battmgr->asus_chg_lock);
+	behaviour = battmgr->asus_chg_behaviour;
+	end = battmgr->asus_chg_end;
+	mutex_unlock(&battmgr->asus_chg_lock);
+
+	active = behaviour != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO || end < 100;
+	/* Defaults requested and nothing to undo: leave the firmware alone. */
+	if (!active && !battmgr->asus_chg_paused &&
+	    !battmgr->asus_chg_usbin_suspended)
+		return;
+
+	/* PDR up re-queues the work (and clears a poisoned channel). */
+	if (!READ_ONCE(battmgr->oem_service_up) ||
+	    READ_ONCE(battmgr->oem_request_poisoned))
+		return;
+
+	if (READ_ONCE(battmgr->service_up)) {
+		if (end < 100 &&
+		    !qcom_battmgr_bat_sm8350_update(battmgr,
+						    POWER_SUPPLY_PROP_CAPACITY))
+			capacity = READ_ONCE(battmgr->status.percent);
+		if (!qcom_battmgr_usb_sm8350_update(battmgr,
+						    POWER_SUPPLY_PROP_ONLINE))
+			online = READ_ONCE(battmgr->usb.online);
+	}
+
+	/* The firmware may drop the mode on a replug: assert it again. */
+	if (online && !battmgr->asus_chg_usb_online)
+		reassert = true;
+	battmgr->asus_chg_usb_online = online;
+	if (online && time_after_eq(jiffies, battmgr->asus_chg_asserted +
+				    ASUS_ROG5_CHG_INTERVAL))
+		reassert = true;
+
+	mutex_lock(&battmgr->asus_chg_lock);
+	behaviour = battmgr->asus_chg_behaviour;
+	start = battmgr->asus_chg_start;
+	end = battmgr->asus_chg_end;
+	hold = battmgr->asus_chg_limit_hold;
+	if (end >= 100)
+		hold = false;
+	else if (capacity >= 0 && capacity >= end)
+		hold = true;
+	else if (capacity >= 0 && capacity <= start)
+		hold = false;
+	battmgr->asus_chg_limit_hold = hold;
+	mutex_unlock(&battmgr->asus_chg_lock);
+
+	active = behaviour != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO || end < 100;
+	pause = hold || behaviour == POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+	usbin = behaviour == POWER_SUPPLY_CHARGE_BEHAVIOUR_FORCE_DISCHARGE;
+
+	if (usbin != battmgr->asus_chg_usbin_suspended || (reassert && usbin)) {
+		ret = qcom_battmgr_asus_set_usbin_suspend(battmgr, usbin);
+		if (ret) {
+			dev_warn_ratelimited(battmgr->dev,
+					     "failed to %s USB input: %d\n",
+					     usbin ? "suspend" : "resume", ret);
+		} else {
+			battmgr->asus_chg_usbin_suspended = usbin;
+			battmgr->asus_chg_asserted = jiffies;
+		}
+	}
+
+	if (pause != battmgr->asus_chg_paused || (reassert && pause)) {
+		ret = qcom_battmgr_asus_set_bypass(battmgr, pause);
