+static int q6asm_dai_pcm_cleanup(struct snd_soc_component *component,
+				   struct snd_pcm_substream *substream)
+{
+	struct q6asm_dai_rtd *prtd = substream->runtime->private_data;
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	int ret;
+
+	prtd->state = Q6ASM_STREAM_STOPPED;
+	if (prtd->cleanup_failed)
+		return -EIO;
+	if (prtd->stream_open) {
+		ret = q6asm_cmd(prtd->audio_client, prtd->stream_id, CMD_CLOSE);
+		if (ret < 0)
+			goto quarantine;
+		prtd->stream_open = false;
+	}
+	if (prtd->routed) {
+		q6routing_stream_close(rtd->dai_link->id, substream->stream);
+		prtd->routed = false;
+	}
+	if (prtd->mapped) {
+		ret = q6asm_unmap_memory_regions(substream->stream, prtd->audio_client);
+		if (ret < 0)
+			goto quarantine;
+		prtd->mapped = false;
+	}
+	return 0;
+
+quarantine:
+	prtd->cleanup_failed = true;
+	q6asm_audio_client_quarantine(prtd->audio_client);
+	/*
+	 * Fixed preallocation is owned by ALSA even after hw_free. Transfer
+	 * ownership so card removal cannot recycle memory the DSP may fetch.
+	 * Keep the client, buffer and device until a host reboot: no proven
+	 * quiescence boundary is exposed by this driver's APR API.
+	 */
+	prtd->dma_buffer = substream->dma_buffer;
+	substream->dma_buffer.area = NULL;
+	substream->dma_buffer.bytes = 0;
+	get_device(component->dev);
+	dev_err(component->dev,
+		"q6asm cleanup failed: %d; session and DMA buffer quarantined until reboot\n", ret);
+	return ret;
+}
