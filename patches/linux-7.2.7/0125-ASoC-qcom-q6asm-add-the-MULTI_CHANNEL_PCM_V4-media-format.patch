From: Claude <noreply@anthropic.com>
Subject: [PATCH] ASoC: qcom: q6asm: add the MULTI_CHANNEL_PCM_V4 media format

q6asm only speaks ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2. Its 24-bit mode is
defined by the ADSP API (msm-5.4 apr_audio-v2.h, struct
asm_multi_channel_pcm_fmt_blk_v2) as "24-bit samples packed in 32-bit
words, placed in the most significant 24 bits" for playback and for
recording: ALSA S32_LE with 24 valid bits, not S24_LE.

MULTI_CHANNEL_PCM_V4 (0x0001320C, what the stock msm-5.4 driver uses on
ADSPs without the ASM API v2, V5 otherwise) adds sample_word_size,
endianness and a Q-format "mode" (0 default, 15, 23 for "24b packed or
8.24 format", 31), so 24 bits in the low bits of a 32-bit word can be
described exactly.

Add FORMAT_LINEAR_PCM_V4 for q6asm_open_write() (outside the
SND_AUDIOCODEC_* ids the compress front end passes) and
q6asm_media_format_block_multi_ch_pcm_v4(). The V2 paths are unchanged.

--- a/sound/soc/qcom/qdsp6/q6asm.c
+++ b/sound/soc/qcom/qdsp6/q6asm.c
@@ -40,6 +40,7 @@
 #define ASM_PARAM_ID_ENCDEC_ENC_CFG_BLK_V2	0x00010DA3
 #define ASM_SESSION_CMD_RUN_V2			0x00010DAA
 #define ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2	0x00010DA5
+#define ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V4	0x0001320C
 #define ASM_MEDIA_FMT_MP3			0x00010BE9
 #define ASM_MEDIA_FMT_FLAC			0x00010C16
 #define ASM_MEDIA_FMT_WMA_V9			0x00010DA8
@@ -99,6 +100,25 @@ struct asm_multi_channel_pcm_fmt_blk_v2 {
 	u8 channel_mapping[PCM_MAX_NUM_CHANNEL];
 } __packed;
 
+/*
+ * With PCM_V2 a 24-bit sample must sit in the most significant 24 bits of a
+ * 32-bit word (ALSA S32_LE, not S24_LE). PCM_V4 names the word size and the
+ * Q format, so 24 bits in the low bits of a 32-bit word (S24_LE) are
+ * bits_per_sample 24, sample_word_size 32, mode 23 (the "8.24" format).
+ */
+struct asm_multi_channel_pcm_fmt_blk_v4 {
+	struct asm_data_cmd_media_fmt_update_v2 fmt_blk;
+	u16 num_channels;
+	u16 bits_per_sample;
+	u32 sample_rate;
+	u16 is_signed;
+	u16 sample_word_size;
+	u8 channel_mapping[PCM_MAX_NUM_CHANNEL];
+	u16 endianness;
+	u16 mode;
+} __packed;
+static_assert(sizeof(struct asm_multi_channel_pcm_fmt_blk_v4) == 28);
+
 struct asm_flac_fmt_blk_v2 {
 	struct asm_data_cmd_media_fmt_update_v2 fmt_blk;
 	u16 is_stream_info_present;
@@ -964,6 +984,9 @@ int q6asm_open_write(struct audio_client *ac, uint32_t stream_id,
 	case FORMAT_LINEAR_PCM:
 		open->dec_fmt_id = ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2;
 		break;
+	case FORMAT_LINEAR_PCM_V4:
+		open->dec_fmt_id = ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V4;
+		break;
 	case SND_AUDIOCODEC_FLAC:
 		open->dec_fmt_id = ASM_MEDIA_FMT_FLAC;
 		break;
@@ -1130,6 +1153,64 @@ int q6asm_media_format_block_multi_ch_pcm(struct audio_client *ac,
 }
 EXPORT_SYMBOL_GPL(q6asm_media_format_block_multi_ch_pcm);
 
+/**
+ * q6asm_media_format_block_multi_ch_pcm_v4() - PCM_V4 playback configuration
+ *
+ * @ac: audio client pointer
+ * @stream_id: stream id
+ * @rate: audio sample rate
+ * @channels: number of audio channels.
+ * @channel_map: channel map pointer, or NULL for the default map
+ * @bits_per_sample: valid bits per sample (16, 24 or 32)
+ * @sample_word_size: bits of the word holding one sample (16, 24 or 32)
+ * @q_format: ASM_PCM_Q_FORMAT_* of the samples in their word
+ *
+ * The stream must have been opened with FORMAT_LINEAR_PCM_V4.
+ *
+ * Return: Will be an negative value on error or zero on success
+ */
+int q6asm_media_format_block_multi_ch_pcm_v4(struct audio_client *ac,
+					     uint32_t stream_id,
+					     uint32_t rate, uint32_t channels,
+					     u8 channel_map[PCM_MAX_NUM_CHANNEL],
+					     uint16_t bits_per_sample,
+					     uint16_t sample_word_size,
+					     uint16_t q_format)
+{
+	struct asm_multi_channel_pcm_fmt_blk_v4 *fmt;
+	struct apr_pkt *pkt;
+	int pkt_size = APR_HDR_SIZE + sizeof(*fmt);
+
+	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	pkt = p;
+	fmt = p + APR_HDR_SIZE;
+
+	q6asm_add_hdr(ac, &pkt->hdr, pkt_size, true, stream_id);
+
+	pkt->hdr.opcode = ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2;
+	fmt->fmt_blk.fmt_blk_size = sizeof(*fmt) - sizeof(fmt->fmt_blk);
+	fmt->num_channels = channels;
+	fmt->bits_per_sample = bits_per_sample;
+	fmt->sample_rate = rate;
+	fmt->is_signed = 1;
+	fmt->sample_word_size = sample_word_size;
+	fmt->endianness = 0;	/* little endian */
+	fmt->mode = q_format;
+
+	if (channel_map) {
+		memcpy(fmt->channel_mapping, channel_map, PCM_MAX_NUM_CHANNEL);
+	} else if (q6dsp_map_channels(fmt->channel_mapping, channels)) {
+		dev_err(ac->dev, " map channels failed %d\n", channels);
+		return -EINVAL;
+	}
+
+	return q6asm_ac_send_cmd_sync(ac, pkt);
+}
+EXPORT_SYMBOL_GPL(q6asm_media_format_block_multi_ch_pcm_v4);
+
 int q6asm_stream_media_format_block_flac(struct audio_client *ac,
 					 uint32_t stream_id,
 					 struct q6asm_flac_cfg *cfg)
--- a/sound/soc/qcom/qdsp6/q6asm.h
+++ b/sound/soc/qcom/qdsp6/q6asm.h
@@ -32,6 +32,17 @@ enum {
 
 #define MAX_SESSIONS	8
 #define FORMAT_LINEAR_PCM   0x0000
+/*
+ * Linear PCM described by ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V4 (sample word
+ * size and Q format given explicitly). Outside the SND_AUDIOCODEC_* range
+ * the compress front end passes to q6asm_open_write().
+ */
+#define FORMAT_LINEAR_PCM_V4	0x00010000
+/* Q format ("mode") of ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V4 samples */
+#define ASM_PCM_Q_FORMAT_DEFAULT	0
+#define ASM_PCM_Q_FORMAT_Q15		15
+#define ASM_PCM_Q_FORMAT_Q23		23
+#define ASM_PCM_Q_FORMAT_Q31		31
 #define ASM_LAST_BUFFER_FLAG           BIT(30)
 
 struct q6asm_flac_cfg {
@@ -115,6 +126,13 @@ int q6asm_media_format_block_multi_ch_pcm(struct audio_client *ac,
 					  uint32_t rate, uint32_t channels,
 					  u8 channel_map[PCM_MAX_NUM_CHANNEL],
 					  uint16_t bits_per_sample);
+int q6asm_media_format_block_multi_ch_pcm_v4(struct audio_client *ac,
+					     uint32_t stream_id,
+					     uint32_t rate, uint32_t channels,
+					     u8 channel_map[PCM_MAX_NUM_CHANNEL],
+					     uint16_t bits_per_sample,
+					     uint16_t sample_word_size,
+					     uint16_t q_format);
 int q6asm_stream_media_format_block_flac(struct audio_client *ac,
 					 uint32_t stream_id,
 					 struct q6asm_flac_cfg *cfg);
