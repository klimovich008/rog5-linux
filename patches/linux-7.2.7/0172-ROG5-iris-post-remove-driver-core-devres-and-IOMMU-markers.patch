From: GPT-6.1-Sol (Codex CLI) <noreply@openai.com>
Subject: [PATCH] ROG5-iris-post-remove-driver-core-devres-and-IOMMU-markers

Keep the normal cleanup order. Arm built-in diagnostics from Iris removal,
copying markers and marker_delay_ms while the module still exists. Logging
never dereferences its core or calls module text after managed core release.
Bracket every devres callback and action (including PM/OPP/ICC/clocks/resets,
IRQ and mappings), DMA ownership, and driver-core cleanup. Only the SM8350
Iris OF node, including its virtual domain devices, matches. No logging by
default. Sleep only in non-atomic contexts. Domain logging remains armed
until the next Iris probe, to include asynchronous detach workers.

diff --git a/include/linux/rog5_iris_trace.h b/include/linux/rog5_iris_trace.h
new file mode 100644
--- /dev/null
+++ b/include/linux/rog5_iris_trace.h
@@ -0,0 +1,10 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_ROG5_IRIS_TRACE_H
+#define _LINUX_ROG5_IRIS_TRACE_H
+#include <linux/device.h>
+
+/* Built-in diagnostics survive qcom_iris and its devres allocations. */
+void rog5_iris_remove_trace_set(bool enabled, unsigned int delay_ms);
+void rog5_iris_remove_mark(struct device *dev, const char *fmt, ...) __printf(2, 3);
+void rog5_iris_domain_mark(const char *name, const char *step, bool settle);
+#endif
diff --git a/drivers/base/rog5_iris_trace.c b/drivers/base/rog5_iris_trace.c
new file mode 100644
--- /dev/null
+++ b/drivers/base/rog5_iris_trace.c
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* ROG5: removal diagnostics only; no module callbacks or retained core pointer. */
+#include <linux/delay.h>
+#include <linux/export.h>
+#include <linux/of.h>
+#include <linux/preempt.h>
+#include <linux/string.h>
+#include <linux/rog5_iris_trace.h>
+
+static bool trace_enabled;
+static unsigned int trace_delay_ms;
+
+void rog5_iris_remove_trace_set(bool enabled, unsigned int delay_ms)
+{
+	WRITE_ONCE(trace_delay_ms, min(delay_ms, 1000U));
+	WRITE_ONCE(trace_enabled, enabled);
+}
+EXPORT_SYMBOL_GPL(rog5_iris_remove_trace_set);
+
+static void rog5_iris_trace_settle(void)
+{
+	unsigned int ms = READ_ONCE(trace_delay_ms);
+
+	/* Provider locks may be spinlocks. Never sleep or busy-wait there. */
+	if (ms && !in_atomic() && !irqs_disabled())
+		msleep(ms);
+}
+
+void rog5_iris_remove_mark(struct device *dev, const char *fmt, ...)
+{
+	struct va_format vaf;
+	va_list args;
+
+	if (!READ_ONCE(trace_enabled) || !dev ||
+	    !of_device_is_compatible(dev->of_node, "qcom,sm8350-iris"))
+		return;
+	va_start(args, fmt);
+	vaf.fmt = fmt;
+	vaf.va = &args;
+	dev_warn(dev, "mark: cleanup: %pV\n", &vaf);
+	va_end(args);
+	rog5_iris_trace_settle();
+}
+EXPORT_SYMBOL_GPL(rog5_iris_remove_mark);
+
+void rog5_iris_domain_mark(const char *name, const char *step, bool settle)
+{
+	if (!READ_ONCE(trace_enabled) || !name ||
+	    (strcmp(name, "mvs0_gdsc") && strcmp(name, "mvs0c_gdsc") &&
+	     strcmp(name, "mx") && strcmp(name, "mmcx")))
+		return;
+	pr_warn("rog5-iris: mark: domain %s: %s\n", name, step);
+	if (settle)
+		rog5_iris_trace_settle();
+}
+EXPORT_SYMBOL_GPL(rog5_iris_domain_mark);
