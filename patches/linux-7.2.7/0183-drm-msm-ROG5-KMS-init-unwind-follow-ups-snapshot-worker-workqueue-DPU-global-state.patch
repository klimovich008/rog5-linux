From: Claude <noreply@anthropic.com>
Subject: [PATCH] drm/msm: KMS init unwind follow-ups: snapshot worker, workqueue, DPU global state

With 0182 a failed msm_drm_kms_init() unwinds the steps that completed and
calls the kms ->destroy() hook. The sashiko review of upstream v3 3/8
pointed at three teardown helpers that still assume a fully initialised
KMS; the 2026-10-02 GPT-6.1-Sol audit asked for the same ("include
NULL-workqueue handling in destruction"):

- msm_disp_snapshot_init() kept an ERR_PTR in kms->dump_worker when the
  kthread could not be created and returned success;
  msm_disp_snapshot_destroy() then passed it to kthread_destroy_worker()
  and msm_disp_snapshot_state() would queue work on it. Fail the init
  instead (0182 returns at once when the snapshot init fails).
- msm_kms_destroy() called destroy_workqueue(kms->wq) unconditionally; it
  is NULL when alloc_ordered_workqueue() failed in msm_kms_init().
- dpu_kms_hw_init() finalises the DPU global private object on its own
  error path and dpu_kms_destroy() finalises it again (list_del() of a
  poisoned node), and it is finalised without ever being initialised when
  dpu_kms_init() failed before hw_init. Make the fini idempotent and check
  drm_atomic_private_obj_init(), whose error was ignored.

Hardware: none of these paths runs on a healthy boot.

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
index da3556eb6..15d9ac54c 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -402,7 +402,15 @@ static const struct drm_private_state_funcs dpu_kms_global_state_funcs = {
 
 static void dpu_kms_global_obj_fini(struct dpu_kms *dpu_kms)
 {
+	/*
+	 * A failed dpu_kms_hw_init() already tore the object down, and
+	 * dpu_kms_destroy() runs for a kms whose hw_init never ran.
+	 */
+	if (!dpu_kms->global_state.funcs)
+		return;
+
 	drm_atomic_private_obj_fini(&dpu_kms->global_state);
+	dpu_kms->global_state.funcs = NULL;
 }
 
 static int dpu_kms_parse_data_bus_icc_path(struct dpu_kms *dpu_kms)
@@ -1154,8 +1162,10 @@ static int dpu_kms_hw_init(struct msm_kms *kms)
 	dev->mode_config.cursor_width = 512;
 	dev->mode_config.cursor_height = 512;
 
-	drm_atomic_private_obj_init(dpu_kms->dev, &dpu_kms->global_state,
-				    &dpu_kms_global_state_funcs);
+	rc = drm_atomic_private_obj_init(dpu_kms->dev, &dpu_kms->global_state,
+					 &dpu_kms_global_state_funcs);
+	if (rc)
+		goto error;
 
 	atomic_set(&dpu_kms->bandwidth_ref, 0);
 
diff --git a/drivers/gpu/drm/msm/disp/msm_disp_snapshot.c b/drivers/gpu/drm/msm/disp/msm_disp_snapshot.c
index d99771684..149643122 100644
--- a/drivers/gpu/drm/msm/disp/msm_disp_snapshot.c
+++ b/drivers/gpu/drm/msm/disp/msm_disp_snapshot.c
@@ -110,8 +110,14 @@ int msm_disp_snapshot_init(struct drm_device *drm_dev)
 	mutex_init(&kms->dump_mutex);
 
 	kms->dump_worker = kthread_run_worker(0, "%s", "disp_snapshot");
-	if (IS_ERR(kms->dump_worker))
+	if (IS_ERR(kms->dump_worker)) {
+		int ret = PTR_ERR(kms->dump_worker);
+
 		DRM_ERROR("failed to create disp state task\n");
+		kms->dump_worker = NULL;
+		mutex_destroy(&kms->dump_mutex);
+		return ret;
+	}
 
 	kthread_init_work(&kms->dump_work, _msm_disp_snapshot_work);
 
diff --git a/drivers/gpu/drm/msm/msm_kms.h b/drivers/gpu/drm/msm/msm_kms.h
index f25b31e50..d8696215d 100644
--- a/drivers/gpu/drm/msm/msm_kms.h
+++ b/drivers/gpu/drm/msm/msm_kms.h
@@ -203,7 +203,9 @@ static inline void msm_kms_destroy(struct msm_kms *kms)
 	for (i = 0; i < ARRAY_SIZE(kms->pending_timers); i++)
 		msm_atomic_destroy_pending_timer(&kms->pending_timers[i]);
 
-	destroy_workqueue(kms->wq);
+	if (kms->wq)
+		destroy_workqueue(kms->wq);
+	kms->wq = NULL;
 }
 
 #define for_each_crtc_mask(dev, crtc, crtc_mask) \
