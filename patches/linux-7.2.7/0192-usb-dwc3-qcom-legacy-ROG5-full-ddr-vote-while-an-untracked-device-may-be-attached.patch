From: Claude <noreply@anthropic.com>
Subject: [PATCH] usb: dwc3: qcom-legacy: full usb-ddr vote while an untracked device may be attached

0148 counts the attached devices to choose the usb-ddr vote. When the
tracking entry for a new device could not be allocated it voted full for
DWC3_QCOM_BW_ROLE_HOLD (2 s) only; after that the controller fell to the
floor vote although the untracked (possibly high-speed) device was still
attached and transferring, and its removal can never be seen.

Keep the full vote (bw_untracked) until the xHCI's primary (USB 2, removed
last) bus is deregistered: USB_BUS_REMOVE comes after all its devices are
gone and the controller is stopped, so it is the first point where the
untracked device is known to be gone; then prune and re-evaluate. Clearing
at the role change instead (first version) lost the flag when HOST->NONE->
HOST requests coalesced and the xHCI stayed. Found by the 2026-10-02
GPT-6.1-Sol audit.

Hardware: none on a healthy system (the path needs a failed kzalloc);
hub hotplug and the usb-ddr vote trace stay as before.

diff --git a/drivers/usb/dwc3/dwc3-qcom-legacy.c b/drivers/usb/dwc3/dwc3-qcom-legacy.c
index 86482c537..0a03357ba 100644
--- a/drivers/usb/dwc3/dwc3-qcom-legacy.c
+++ b/drivers/usb/dwc3/dwc3-qcom-legacy.c
@@ -136,6 +136,8 @@ struct dwc3_qcom {
 	unsigned int		bw_slow_devs;	/* low and full speed */
 	bool			bw_device_role;
 	bool			bw_role_hold;
+	/* a device went untracked: full vote until its xHCI bus is removed */
+	bool			bw_untracked;
 	bool			bw_role_known;
 	bool			bw_ss;
 	bool			bw_ready;
@@ -207,7 +209,7 @@ static DEFINE_MUTEX(dwc3_qcom_bw_list_lock);
 static enum dwc3_qcom_bw_level dwc3_qcom_bw_need(struct dwc3_qcom *qcom)
 {
 	if (!READ_ONCE(ddr_bw_follows_devices) || qcom->bw_device_role ||
-	    qcom->bw_role_hold || qcom->bw_fast_devs)
+	    qcom->bw_role_hold || qcom->bw_untracked || qcom->bw_fast_devs)
 		return DWC3_QCOM_BW_FULL;
 	if (qcom->bw_slow_devs)
 		return DWC3_QCOM_BW_FS;
@@ -334,7 +336,29 @@ static int dwc3_qcom_usb_notify(struct notifier_block *nb,
 	struct usb_device *udev = data;
 	struct dwc3_qcom_bw_dev *d;
 
-	/* USB_BUS_ADD/REMOVE pass a struct usb_bus. */
+	/*
+	 * USB_BUS_ADD/REMOVE pass a struct usb_bus. The removal of our xHCI's
+	 * primary (USB 2, removed last) bus, after all its devices are gone
+	 * and the controller is stopped, is the only point where a device
+	 * that went untracked is known to be gone as well.
+	 */
+	if (action == USB_BUS_REMOVE) {
+		struct usb_bus *bus = data;
+		struct device *hcd_dev = bus->controller;
+
+		if (hcd_dev && hcd_dev->parent &&
+		    hcd_dev->parent->parent == qcom->dev &&
+		    usb_hcd_is_primary_hcd(bus_to_hcd(bus))) {
+			mutex_lock(&qcom->bw_lock);
+			if (qcom->bw_untracked) {
+				qcom->bw_untracked = false;
+				dwc3_qcom_bw_prune(qcom);
+				dwc3_qcom_bw_apply(qcom);
+			}
+			mutex_unlock(&qcom->bw_lock);
+		}
+		return NOTIFY_OK;
+	}
 	if (action != USB_DEVICE_ADD && action != USB_DEVICE_REMOVE)
 		return NOTIFY_DONE;
 
@@ -360,10 +384,12 @@ static int dwc3_qcom_usb_notify(struct notifier_block *nb,
 			else
 				qcom->bw_fast_devs++;
 		} else {
-			/* Not tracked: vote as if it were fast until then. */
-			qcom->bw_role_hold = true;
-			mod_delayed_work(system_wq, &qcom->bw_work,
-					 DWC3_QCOM_BW_ROLE_HOLD);
+			/*
+			 * Not tracked, so its removal cannot be seen: vote as
+			 * if it were fast while it may still be attached, i.e.
+			 * until the xHCI bus goes away (USB_BUS_REMOVE).
+			 */
+			qcom->bw_untracked = true;
 		}
 	}
 	dwc3_qcom_bw_apply(qcom);
