+/*
+ * ROG5: complete a buffer that was just taken off the m2m list, but only if
+ * vb2 still owns it as ACTIVE. A stale list entry (for example one that was
+ * already completed on a failed qbuf) is dropped and reported instead of
+ * being completed a second time (vb2_buffer_done() warns on that).
+ */
+void iris_m2m_buf_done(struct iris_inst *inst, struct vb2_v4l2_buffer *vbuf,
+		       enum vb2_buffer_state state)
+{
+	struct iris_buffer *buf = to_iris_buffer(vbuf);
+
+	buf->attr &= ~(BUF_ATTR_QUEUED | BUF_ATTR_DEFERRED);
+	buf->attr |= BUF_ATTR_BUFFER_DONE;
+
+	if (vbuf->vb2_buf.state != VB2_BUF_STATE_ACTIVE) {
+		dev_warn_ratelimited(inst->core->dev,
+				     "buffer %u of queue %u is not active (state %d); not completing it again\n",
+				     vbuf->vb2_buf.index, vbuf->vb2_buf.type, vbuf->vb2_buf.state);
+		return;
+	}
+
+	v4l2_m2m_buf_done(vbuf, state);
+}
+
 void iris_helper_buffers_done(struct iris_inst *inst, unsigned int type,
 			      enum vb2_buffer_state state)
 {
@@ -60,10 +84,10 @@ void iris_helper_buffers_done(struct iris_inst *inst, unsigned int type,
 
 	if (V4L2_TYPE_IS_OUTPUT(type)) {
 		while ((buf = v4l2_m2m_src_buf_remove(m2m_ctx)))
-			v4l2_m2m_buf_done(buf, state);
+			iris_m2m_buf_done(inst, buf, state);
 	} else if (V4L2_TYPE_IS_CAPTURE(type)) {
 		while ((buf = v4l2_m2m_dst_buf_remove(m2m_ctx)))
-			v4l2_m2m_buf_done(buf, state);
+			iris_m2m_buf_done(inst, buf, state);
 	}
 }
 
