 drivers/media/platform/qcom/iris/iris_core.c  | 84 ++++++++++++++++++-
 drivers/media/platform/qcom/iris/iris_core.h  | 27 ++++++
 .../qcom/iris/iris_hfi_gen1_command.c         | 31 ++++++-
 .../qcom/iris/iris_hfi_gen1_defines.h         |  8 ++
 .../qcom/iris/iris_hfi_gen1_response.c        | 20 ++++-
 .../media/platform/qcom/iris/iris_hfi_queue.c |  6 +-
 6 files changed, 172 insertions(+), 4 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_core.c b/drivers/media/platform/qcom/iris/iris_core.c
index 194b334..3a6fe98 100644
--- a/drivers/media/platform/qcom/iris/iris_core.c
+++ b/drivers/media/platform/qcom/iris/iris_core.c
@@ -3,13 +3,93 @@
  * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/ctype.h>
 #include <linux/pm_runtime.h>
+#include <linux/timekeeping.h>
 
 #include "iris_core.h"
 #include "iris_firmware.h"
 #include "iris_state.h"
 #include "iris_vpu_common.h"
 
+/* ROG5: called with core->lock held; @pkt starts with the HFI size word */
+void iris_core_trace(struct iris_core *core, u32 dir, const void *pkt)
+{
+	struct iris_trace_entry *e = &core->trace[core->trace_next++ % IRIS_TRACE_ENTRIES];
+	u32 size = *(const u32 *)pkt;
+
+	e->ns = ktime_get_ns();
+	e->dir = dir;
+	memset(e->w, 0, sizeof(e->w));
+	memcpy(e->w, pkt, min_t(u32, size, sizeof(e->w)));
+}
+
+/* ROG5: one firmware debug-queue message (not NUL-terminated) */
+void iris_core_fw_log(struct iris_core *core, const u8 *msg, size_t len)
+{
+	char *line = core->fw_log[core->fw_log_next++ % IRIS_FW_LOG_LINES];
+	size_t i, n = 0;
+
+	for (i = 0; i < len && msg[i] && n < IRIS_FW_LOG_LEN - 1; i++)
+		line[n++] = isprint(msg[i]) ? msg[i] : ' ';
+	while (n && line[n - 1] == ' ')
+		n--;
+	line[n] = '\0';
+	dev_err_ratelimited(core->dev, "fw: %s\n", line);
+}
+
+/*
+ * ROG5: print what the firmware left in the SFR (Subsystem Failure Reason)
+ * buffer, the last HFI packets in both directions and the last firmware
+ * messages. Called with core->lock held, before teardown frees the SFR and
+ * queue memory. Rate limited to one dump per 10 s unless @force.
+ */
+void iris_core_dump_diag_locked(struct iris_core *core, const char *reason, bool force)
+{
+	u64 now = ktime_get_ns();
+	char sfr[256];
+	u32 i, n;
+
+	if (!force && core->diag_jiffies &&
+	    time_before(jiffies, core->diag_jiffies + 10 * HZ))
+		return;
+	core->diag_jiffies = jiffies ?: 1;
+
+	dev_err(core->dev, "diagnostics (%s): state %d, attempt %u\n",
+		reason, core->state, core->init_attempt);
+
+	if (core->sfr_vaddr) {
+		const u8 *p = (const u8 *)core->sfr_vaddr + sizeof(u32);
+		u32 size = READ_ONCE(*(u32 *)core->sfr_vaddr);
+
+		for (n = 0; n < sizeof(sfr) - 1 && n < SFR_SIZE - sizeof(u32) && p[n]; n++)
+			sfr[n] = isprint(p[n]) ? p[n] : '.';
+		sfr[n] = '\0';
+		dev_err(core->dev, "SFR (size word %#x): %s\n", size, n ? sfr : "<empty>");
+	} else {
+		dev_err(core->dev, "SFR: not allocated\n");
+	}
+
+	for (i = 0; i < IRIS_TRACE_ENTRIES; i++) {
+		const struct iris_trace_entry *e =
+			&core->trace[(core->trace_next + i) % IRIS_TRACE_ENTRIES];
+
+		if (!e->dir)
+			continue;
+		dev_err(core->dev,
+			"hfi %c -%llu us: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			e->dir, div_u64(now - e->ns, NSEC_PER_USEC), e->w[0], e->w[1],
+			e->w[2], e->w[3], e->w[4], e->w[5], e->w[6], e->w[7]);
+	}
+
+	for (i = 0; i < IRIS_FW_LOG_LINES; i++) {
+		const char *line = core->fw_log[(core->fw_log_next + i) % IRIS_FW_LOG_LINES];
+
+		if (line[0])
+			dev_err(core->dev, "fw log: %s\n", line);
+	}
+}
+
 /* called with core->lock held and the core not in IRIS_CORE_DEINIT */
 static void iris_core_teardown(struct iris_core *core, bool powered)
 {
@@ -45,9 +125,11 @@ static void __iris_core_deinit(struct iris_core *core, bool any, u32 attempt, in
 
 	mutex_lock(&core->lock);
 	if (core->state != IRIS_CORE_DEINIT && (any || core->init_attempt == attempt)) {
-		if (!any)
+		if (!any) {
 			dev_err(core->dev, "firmware did not complete system init (%d), powering the core off\n",
 				err);
+			iris_core_dump_diag_locked(core, "core init", true);
+		}
 		iris_core_teardown(core, !ret);
 	}
 	mutex_unlock(&core->lock);
diff --git a/drivers/media/platform/qcom/iris/iris_core.h b/drivers/media/platform/qcom/iris/iris_core.h
index 78dd70d..2523658 100644
--- a/drivers/media/platform/qcom/iris/iris_core.h
+++ b/drivers/media/platform/qcom/iris/iris_core.h
@@ -25,6 +25,18 @@ struct icc_info {
 #define IRIS_FW_VERSION_LENGTH		128
 #define IFACEQ_CORE_PKT_SIZE		(1024 * 4)
 
+/* ROG5: bounded HFI packet trace and firmware log, dumped on fatal errors */
+#define IRIS_TRACE_ENTRIES		64
+#define IRIS_TRACE_WORDS		8
+#define IRIS_FW_LOG_LINES		16
+#define IRIS_FW_LOG_LEN			160
+
+struct iris_trace_entry {
+	u64	ns;
+	u32	dir;		/* 't' sent, 'r' received */
+	u32	w[IRIS_TRACE_WORDS];
+};
+
 enum domain_type {
 	ENCODER	= BIT(0),
 	DECODER	= BIT(1),
@@ -78,6 +90,12 @@ struct qcom_ubwc_cfg_data;
  * @instances: a list_head of all instances
  * @inst_fw_caps_dec: an array of supported instance capabilities by decoder
  * @inst_fw_caps_enc: an array of supported instance capabilities by encoder
+ * @trace: ring of the first words of the last HFI packets sent and received
+ * @trace_next: next slot in @trace
+ * @fw_log: ring of the last firmware debug-queue messages
+ * @fw_log_next: next slot in @fw_log
+ * @diag_jiffies: time of the last diagnostic dump (rate limit)
+ * @diag_pending: a system error asked for a dump once the debug queue is read
  */
 
 struct iris_core {
@@ -125,9 +143,18 @@ struct iris_core {
 	/* encoder and decoder have overlapping caps, so two different arrays are required */
 	struct platform_inst_fw_cap		inst_fw_caps_dec[INST_FW_CAP_MAX];
 	struct platform_inst_fw_cap		inst_fw_caps_enc[INST_FW_CAP_MAX];
+	struct iris_trace_entry			trace[IRIS_TRACE_ENTRIES];
+	u32					trace_next;
+	char					fw_log[IRIS_FW_LOG_LINES][IRIS_FW_LOG_LEN];
+	u32					fw_log_next;
+	unsigned long				diag_jiffies;
+	bool					diag_pending;
 };
 
 int iris_core_init(struct iris_core *core);
 void iris_core_deinit(struct iris_core *core);
+void iris_core_trace(struct iris_core *core, u32 dir, const void *pkt);
+void iris_core_fw_log(struct iris_core *core, const u8 *msg, size_t len);
+void iris_core_dump_diag_locked(struct iris_core *core, const char *reason, bool force);
 
 #endif
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c b/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
index 7674b47..6e76f8b 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_command.c
@@ -3,11 +3,22 @@
  * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/module.h>
+
 #include "iris_hfi_gen1.h"
 #include "iris_hfi_gen1_defines.h"
 #include "iris_instance.h"
 #include "iris_vpu_buffer.h"
 
+/*
+ * ROG5: firmware debug-queue message mask sent after SYS_INIT (HFI debug
+ * config, queue mode). 0x18 = errors and fatal messages, what the stock
+ * msm_vidc driver requests by default (FW_ERROR | FW_FATAL); 0 sends nothing.
+ */
+static unsigned int fw_debug = 0x18;
+module_param(fw_debug, uint, 0644);
+MODULE_PARM_DESC(fw_debug, "HFI firmware debug mask after SYS_INIT (0x18 = error|fatal, 0 = off)");
+
 static u32 iris_hfi_gen1_buf_type_from_driver(enum iris_buffer_type buffer_type)
 {
 	switch (buffer_type) {
@@ -33,12 +44,30 @@ static u32 iris_hfi_gen1_buf_type_from_driver(enum iris_buffer_type buffer_type)
 static int iris_hfi_gen1_sys_init(struct iris_core *core)
 {
 	struct hfi_sys_init_pkt sys_init_pkt;
+	struct {
+		struct hfi_pkt_hdr hdr;
+		u32 num_properties;
+		u32 property;
+		struct hfi_debug_config cfg;
+	} __packed dbg;
+	int ret;
 
 	sys_init_pkt.hdr.size = sizeof(sys_init_pkt);
 	sys_init_pkt.hdr.pkt_type = HFI_CMD_SYS_INIT;
 	sys_init_pkt.arch_type = HFI_VIDEO_ARCH_OX;
 
-	return iris_hfi_queue_cmd_write_locked(core, &sys_init_pkt, sys_init_pkt.hdr.size);
+	ret = iris_hfi_queue_cmd_write_locked(core, &sys_init_pkt, sys_init_pkt.hdr.size);
+	if (ret || !fw_debug)
+		return ret;
+
+	dbg.hdr.size = sizeof(dbg);
+	dbg.hdr.pkt_type = HFI_CMD_SYS_SET_PROPERTY;
+	dbg.num_properties = 1;
+	dbg.property = HFI_PROPERTY_SYS_DEBUG_CONFIG;
+	dbg.cfg.debug_config = fw_debug;
+	dbg.cfg.debug_mode = HFI_DEBUG_MODE_QUEUE;
+
+	return iris_hfi_queue_cmd_write_locked(core, &dbg, dbg.hdr.size);
 }
 
 static int iris_hfi_gen1_sys_image_version(struct iris_core *core)
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1_defines.h b/drivers/media/platform/qcom/iris/iris_hfi_gen1_defines.h
index 0e4dee1..f346845 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_defines.h
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_defines.h
@@ -80,6 +80,7 @@
 #define HFI_BUFFER_INTERNAL_SCRATCH_1			0x7
 #define HFI_BUFFER_INTERNAL_SCRATCH_2			0x8
 
+#define HFI_PROPERTY_SYS_DEBUG_CONFIG			0x1
 #define HFI_PROPERTY_SYS_CODEC_POWER_PLANE_CTRL		0x5
 #define HFI_PROPERTY_SYS_IMAGE_VERSION			0x6
 
@@ -326,6 +327,13 @@ struct hfi_enable {
 	u32 enable;
 };
 
+#define HFI_DEBUG_MODE_QUEUE				0x1
+
+struct hfi_debug_config {
+	u32 debug_config;
+	u32 debug_mode;
+};
+
 struct hfi_profile_level {
 	u32 profile;
 	u32 level;
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c b/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
index fca73b7..8eca959 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
@@ -225,6 +225,9 @@ iris_hfi_gen1_sys_event_notify(struct iris_core *core, void *packet)
 			pkt->event_id, pkt->shdr.session_id, pkt->event_data1,
 			pkt->event_data2);
 
+	/* ROG5: dumped after the debug queue is drained (response handler) */
+	core->diag_pending = true;
+
 	core->state = IRIS_CORE_ERROR;
 
 	mutex_lock(&core->lock);
@@ -257,6 +260,9 @@ iris_hfi_gen1_event_session_error(struct iris_inst *inst, struct hfi_msg_event_n
 			"session error for command: %x, event id:%x, session id:%x\n",
 			pkt->event_data2, pkt->event_data1,
 			pkt->shdr.session_id);
+		mutex_lock(&inst->core->lock);
+		iris_core_dump_diag_locked(inst->core, "session error", false);
+		mutex_unlock(&inst->core->lock);
 		iris_vb2_queue_error(inst);
 		iris_inst_change_state(inst, IRIS_INST_ERROR);
 		break;
@@ -681,8 +687,13 @@ static void iris_hfi_gen1_flush_debug_queue(struct iris_core *core, u8 *packet)
 		if (pkt->hdr.pkt_type != HFI_MSG_SYS_COV) {
 			struct hfi_msg_sys_debug_pkt *pkt =
 				(struct hfi_msg_sys_debug_pkt *)packet;
+			size_t len = 0;
 
-			dev_dbg(core->dev, "%s", pkt->msg_data);
+			if (pkt->hdr.size > sizeof(*pkt) && pkt->hdr.size <= IFACEQ_CORE_PKT_SIZE)
+				len = min_t(size_t, pkt->msg_size, pkt->hdr.size - sizeof(*pkt));
+			mutex_lock(&core->lock);
+			iris_core_fw_log(core, pkt->msg_data, len);
+			mutex_unlock(&core->lock);
 		}
 	}
 }
@@ -696,4 +707,11 @@ void iris_hfi_gen1_response_handler(struct iris_core *core)
 	}
 
 	iris_hfi_gen1_flush_debug_queue(core, core->response_packet);
+
+	if (core->diag_pending) {
+		mutex_lock(&core->lock);
+		core->diag_pending = false;
+		iris_core_dump_diag_locked(core, "sys error", true);
+		mutex_unlock(&core->lock);
+	}
 }
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_queue.c b/drivers/media/platform/qcom/iris/iris_hfi_queue.c
index bf6db23..85bc520 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_queue.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_queue.c
@@ -117,6 +117,7 @@ int iris_hfi_queue_cmd_write_locked(struct iris_core *core, void *pkt, u32 pkt_s
 		return -EINVAL;
 
 	if (!iris_hfi_queue_write(q_info, pkt, pkt_size)) {
+		iris_core_trace(core, 't', pkt);
 		iris_vpu_raise_interrupt(core);
 	} else {
 		dev_err(core->dev, "queue full\n");
@@ -167,6 +168,7 @@ int iris_hfi_queue_msg_read(struct iris_core *core, void *pkt)
 		ret = -ENODATA;
 		goto unlock;
 	}
+	iris_core_trace(core, 'r', pkt);
 
 unlock:
 	mutex_unlock(&core->lock);
@@ -180,7 +182,9 @@ int iris_hfi_queue_dbg_read(struct iris_core *core, void *pkt)
 	int ret = 0;
 
 	mutex_lock(&core->lock);
-	if (core->state != IRIS_CORE_INIT) {
+	/* ROG5: also after a system error, while the queues still exist */
+	if ((core->state != IRIS_CORE_INIT && core->state != IRIS_CORE_ERROR) ||
+	    !q_info->qhdr) {
 		ret = -EINVAL;
 		goto unlock;
 	}
