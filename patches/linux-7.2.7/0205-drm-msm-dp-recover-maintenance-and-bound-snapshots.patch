 	} else {
 		ret = clk_prepare_enable(ctrl->pixel_clk);
 		if (ret) {
-			DRM_ERROR("Failed to start pixel clocks. ret=%d\n", ret);
+			DRM_ERROR_RATELIMITED("Failed to start pixel clocks. ret=%d\n", ret);
 			goto end;
