 #include <drm/drm_edid.h>
@@ -62,6 +64,7 @@ struct msm_dp_display_private {
 	unsigned int snoop_step;
 	struct work_struct link_bad_work;
 	bool retry_pending;
+	bool crc_started;
 
 	struct drm_device *drm_dev;
 
@@ -409,13 +412,18 @@ static void msm_dp_display_handle_video_request(struct msm_dp_display_private *d
 	}
 }
 
+static void msm_dp_display_handle_plugged_change(struct msm_dp *msm_dp_display,
+		bool plugged);
+static void msm_dp_display_stop_crc(struct msm_dp_display_private *dp);
+
 static int msm_dp_display_handle_irq_hpd(struct msm_dp_display_private *dp)
 {
 	u32 sink_request = dp->link->sink_request;
+	int ret;
 
 	drm_dbg_dp(dp->drm_dev, "%d\n", sink_request);
 
-	msm_dp_ctrl_handle_sink_request(dp->ctrl);
+	ret = msm_dp_ctrl_handle_sink_request(dp->ctrl);
 	/* The active IRQ thread will consume any reset-captured HPD next. */
 	if (dp->ctrl->reset_hpd_status) {
 		unsigned long flags;
@@ -427,6 +435,19 @@ static int msm_dp_display_handle_irq_hpd(struct msm_dp_display_private *dp)
 		irq_wake_thread(dp->irq, dp);
 	}
 
+	if (ret) {
+		msm_dp_ctrl_log_link(dp->ctrl, "maintenance-failed", ret);
+		cancel_delayed_work(&dp->snoop_work);
+		msm_dp_display_stop_crc(dp);
+		msm_dp_ctrl_abort(dp->ctrl, dp->phy_initialized);
+		msm_dp_display_host_phy_exit(dp);
+		dp->msm_dp_display.power_on = false;
+		msm_dp_display_handle_plugged_change(&dp->msm_dp_display, false);
+		dp->msm_dp_display.audio_enabled = false;
+		dp->retry_pending = true;
+		schedule_work(&dp->link_bad_work);
+		return ret;
+	}
 	if (sink_request & DP_TEST_LINK_VIDEO_PATTERN)
 		msm_dp_display_handle_video_request(dp);
 
@@ -491,13 +512,14 @@ static int msm_dp_hpd_unplug_handle(struct msm_dp_display_private *dp)
 	dp->panel->video_test = false;
 
 	cancel_delayed_work_sync(&dp->snoop_work);
-	msm_dp_aux_enable_xfers(dp->aux, false);
 
 	drm_dbg_dp(dp->drm_dev, "Before, type=%d sink_count=%d\n",
 			dp->msm_dp_display.connector_type,
 			dp->link->sink_count);
 
 	guard(mutex)(&dp->plugged_lock);
+	msm_dp_display_stop_crc(dp);
+	msm_dp_aux_enable_xfers(dp->aux, false);
 	if (!dp->plugged)
 		return 0;
 
@@ -664,37 +686,70 @@ MODULE_PARM_DESC(dp_polarity, "copy the mode's sync polarity into the DP timing"
 static bool msm_dp_snoop = true;
 module_param_named(dp_snoop, msm_dp_snoop, bool, 0644);
 MODULE_PARM_DESC(dp_snoop, "log sink status while streaming");
+static bool msm_dp_snoop_errors;
+module_param_named(dp_snoop_errors, msm_dp_snoop_errors, bool, 0644);
+MODULE_PARM_DESC(dp_snoop_errors, "ROG5: opt in to read-to-clear symbol counters during snooping (default 0)");
+
 static bool msm_dp_crc;
 module_param_named(dp_crc, msm_dp_crc, bool, 0644);
 MODULE_PARM_DESC(dp_crc, "start the sink CRC (TEST_SINK) during the status log");
 
 static const unsigned int msm_dp_snoop_at_ms[] = { 20, 100, 1000, 5000, 15000 };
 
+static void msm_dp_display_stop_crc(struct msm_dp_display_private *dp)
+{
+	int ret;
+
+	if (!dp->crc_started)
+		return;
+	if (dp->phy_initialized && msm_dp_aux_is_link_connected(dp->aux)) {
+		ret = drm_dp_dpcd_writeb(dp->aux, DP_TEST_SINK, 0);
+		if (ret != 1)
+			DRM_ERROR_RATELIMITED("DP: CRC stop transfer=%d\n", ret);
+	}
+	dp->crc_started = false;
+}
+
 static void msm_dp_snoop_fn(struct work_struct *work)
 {
 	struct msm_dp_display_private *dp = container_of(to_delayed_work(work),
 			struct msm_dp_display_private, snoop_work);
 	unsigned int step = dp->snoop_step;
 	u8 st[8] = {}, err[4] = {}, esi[4] = {}, esi2[4] = {}, pcon[6] = {}, crc[7] = {};
-	int r1, r2, r3, r4, r5, r6 = 0;
+	int r1, r2 = -ENODATA, r3, r4, r5 = -ENODATA, r6 = -ENODATA;
+	static DEFINE_RATELIMIT_STATE(limit, 5 * HZ, 10);
 
-	if (!dp->msm_dp_display.power_on)
+	guard(mutex)(&dp->plugged_lock);
+	if (!dp->msm_dp_display.power_on || !dp->phy_initialized ||
+	    !__ratelimit(&limit))
 		return;
 
-	if (msm_dp_crc && step == 0)
-		drm_dp_dpcd_writeb(dp->aux, DP_TEST_SINK, DP_TEST_SINK_START);
+	if (msm_dp_crc && step == 0) {
+		u8 cap;
+
+		if (drm_dp_dpcd_readb(dp->aux, DP_TEST_SINK_MISC, &cap) == 1 &&
+		    (cap & DP_TEST_CRC_SUPPORTED))
+			dp->crc_started = drm_dp_dpcd_writeb(dp->aux, DP_TEST_SINK,
+							       DP_TEST_SINK_START) == 1;
+	}
 
 	r1 = drm_dp_dpcd_read(dp->aux, DP_SINK_COUNT, st, sizeof(st));
-	r2 = drm_dp_dpcd_read(dp->aux, 0x210, err, sizeof(err));
+	if (READ_ONCE(msm_dp_snoop_errors))
+		r2 = drm_dp_dpcd_read(dp->aux, 0x210, err, sizeof(err));
 	r3 = drm_dp_dpcd_read(dp->aux, DP_SINK_COUNT_ESI, esi, sizeof(esi));
 	r4 = drm_dp_dpcd_read(dp->aux, 0x200c, esi2, sizeof(esi2));
-	r5 = drm_dp_dpcd_read(dp->aux, 0x3036, pcon, sizeof(pcon));
-	if (msm_dp_crc)
+	if (drm_dp_is_branch(dp->panel->dpcd) &&
+	    drm_dp_get_pcon_max_frl_bw(dp->panel->dpcd,
+					 dp->panel->downstream_ports))
+		r5 = drm_dp_dpcd_read(dp->aux, DP_PCON_HDMI_POST_FRL_STATUS, pcon, sizeof(pcon));
+	if (dp->crc_started)
 		r6 = drm_dp_dpcd_read(dp->aux, DP_TEST_CRC_R_CR, crc, sizeof(crc));
 
 	drm_info(dp->drm_dev,
-		 "DP sink @%ums: 200:%*ph 210:%*ph 2002:%*ph 200c:%*ph 3036:%*ph crc:%*ph (%d %d %d %d %d %d)\n",
