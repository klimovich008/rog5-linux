From: Claude <noreply@anthropic.com>
Subject: [PATCH] drm/msm/dp: ROG5 bring-up knobs dp_widebus, dp_tpg and a mode line

The USB-C HDMI hub trains the link and reports dp_video_ready, but the
monitor cannot lock, with HDMI mode (0094), 8 bpc and 1920x1080 alike.
Two runtime knobs split the path: msm.dp_widebus=0 turns the wide bus off
in the DPU interface and the DP controller together (both read it at each
modeset), and msm.dp_tpg=1 replaces the DPU stream with the DP controller's
checkered test pattern. Log one info line per enable with the mode, link,
bpp, wide bus and TPG state.

--- a/drivers/gpu/drm/msm/dp/dp_display.c	2026-09-29 12:01:05.017844317 +0200
+++ b/drivers/gpu/drm/msm/dp/dp_display.c	2026-09-29 12:01:05.031761036 +0200
@@ -1291,13 +1291,26 @@
 	return drm_mode_is_420_only(&msm_dp_display->connector->display_info, mode);
 }
 
+/*
+ * ROG5 bring-up knobs, applied at the next modeset: dp_widebus=0 turns the
+ * DP wide bus off in the DPU interface and the DP controller together;
+ * dp_tpg=1 replaces the DPU stream with the DP controller's checkered test
+ * pattern (use with dp_widebus=0: the TPG counts pixels at the stream clock).
+ */
+static int msm_dp_widebus = -1;
+module_param_named(dp_widebus, msm_dp_widebus, int, 0644);
+MODULE_PARM_DESC(dp_widebus, "DP wide bus: -1 = as the SoC supports, 0 = off");
+static bool msm_dp_tpg;
+module_param_named(dp_tpg, msm_dp_tpg, bool, 0644);
+MODULE_PARM_DESC(dp_tpg, "show the DP controller test pattern on the next modeset");
+
 bool msm_dp_wide_bus_available(const struct msm_dp *msm_dp_display)
 {
 	struct msm_dp_display_private *dp;
 
 	dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
 
-	if (dp->msm_dp_mode.out_fmt_is_yuv_420)
+	if (dp->msm_dp_mode.out_fmt_is_yuv_420 || !msm_dp_widebus)
 		return false;
 
 	return dp->wide_bus_supported;
@@ -1396,6 +1409,19 @@
 
 	msm_dp_display_enable(msm_dp_display, force_link_train);
 
+	if (msm_dp_tpg)
+		msm_dp_panel_tpg_config(msm_dp_display->panel, true);
+	drm_info(msm_dp_display->drm_dev,
+		 "DP: %ux%u@%u pclk %u kHz, %u lanes x %u kHz, bpp %u, widebus %d, tpg %d\n",
+		 msm_dp_display->msm_dp_mode.drm_mode.hdisplay,
+		 msm_dp_display->msm_dp_mode.drm_mode.vdisplay,
+		 drm_mode_vrefresh(&msm_dp_display->msm_dp_mode.drm_mode),
+		 msm_dp_display->msm_dp_mode.drm_mode.clock,
+		 msm_dp_display->link->link_params.num_lanes,
+		 msm_dp_display->link->link_params.rate,
+		 msm_dp_display->msm_dp_mode.bpp,
+		 msm_dp_display->ctrl->wide_bus_en, msm_dp_tpg);
+
 	rc = msm_dp_display_post_enable(dp);
 	if (rc) {
 		DRM_ERROR("DP display post enable failed, rc=%d\n", rc);
@@ -1483,7 +1509,8 @@
 
 	/* populate wide_bus_support to different layers */
 	msm_dp_display->ctrl->wide_bus_en =
-		msm_dp_display->msm_dp_mode.out_fmt_is_yuv_420 ? false : msm_dp_display->wide_bus_supported;
+		msm_dp_display->msm_dp_mode.out_fmt_is_yuv_420 || !msm_dp_widebus ?
+		false : msm_dp_display->wide_bus_supported;
 }
 
 void msm_dp_bridge_hpd_enable(struct drm_bridge *bridge)
