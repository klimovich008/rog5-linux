From: Claude <noreply@anthropic.com>
Subject: [PATCH] usb: hub: optional delayed re-enumeration of root ports without port power control

After "unable to enumerate USB device" usbcore disables the port and waits
for a new connect change. On a root port whose power the host controller
cannot switch (xHCI with HCC_PPC = 0, e.g. dwc3 behind a Type-C port whose
VBUS belongs to the charger firmware), the "attempt power cycle" in the retry
loop changes nothing on the wire, and a device that stays plugged in never
produces another connect change: the port is dead until a replug or a
controller re-init.

ROG Phone 5 side port: a USB-C monitor's hub that appears on an already
running host within about a second of the attach fails every try with
"device descriptor read/64, error -71" at full speed; a port reset some
seconds later (hub driver rebind, or the rog5-usb-reconnect helper's
controller re-init) enumerates it at high speed.

New usbcore parameters (writable at runtime):
  root_enum_retries   (default 0 = off, max 10): per connection, how many
                      times such a port is enumerated again after a failure
                      with a transport error (-EPROTO, -EILSEQ, -ETIME,
                      -ETIMEDOUT, -EPIPE, -EOVERFLOW)
  root_enum_retry_ms  (default 2000, 100..30000): the delay

Only root hubs without port power switching take part. A pending retry holds
a hub reference and an autopm reference on the hub interface (else the root
hub would autosuspend with the failed port and never look at it again);
hub_quiesce() cancels it and drops both (disconnect, pre-reset, suspend;
resume re-checks connected ports through hub_activate() anyway). The
scheduling checks quiescing/disconnected under irq_urb_lock, which
hub_quiesce() takes to set quiescing, so no retry is queued after the cancel.
The worker only marks the ports due and kicks hub_wq; hub_event(), with the
hub locked, turns a due port into a connect change only if it has no device
by then, so a retry never touches a device that enumerated meanwhile. A new
connect change resets the budget, as do a disconnect and a successful
enumeration; hub_port_connect() drops pending and due bits for its port.
Ports share one delayed work, so a second port can be retried a little
earlier than its logged delay.

Revised after GPT-6.1-Sol's review of the first draft (unbounded u8 counter,
retries on any error, no autosuspend hold, stale bits, default on) and of
this version (synthetic change on an enumerated port -> due bitmap).

--- a/drivers/usb/core/hub.h
+++ b/drivers/usb/core/hub.h
@@ -46,6 +46,9 @@
 							children */
 	unsigned long		warm_reset_bits[1]; /* ports requesting warm
 							reset recovery */
+	unsigned long		enum_retry_bits[1]; /* root ports waiting for a
+							delayed re-enumeration */
+	unsigned long		enum_retry_due_bits[1]; /* ... whose delay is over */
 #if USB_MAXCHILDREN > 31 /* 8*sizeof(unsigned long) - 1 */
 #error event_bits[] is too short!
 #endif
@@ -71,6 +74,7 @@
 	struct delayed_work	leds;
 	struct delayed_work	init_work;
 	struct delayed_work	post_resume_work;
+	struct delayed_work	enum_retry_work;
 	struct work_struct      events;
 	spinlock_t		irq_urb_lock;
 	struct timer_list	irq_urb_retry;
@@ -97,6 +101,7 @@
  * @usb3_lpm_u2_permit: whether USB3 U2 LPM is permitted.
  * @early_stop: whether port initialization will be stopped earlier.
  * @ignore_event: whether events of the port are ignored.
+ * @enum_retries: delayed re-enumerations done since the last connect/success
  */
 struct usb_port {
 	struct usb_device *child;
@@ -113,6 +118,7 @@
 	u32 over_current_count;
 	u8 portnum;
 	u32 quirks;
+	unsigned int enum_retries;
 	unsigned int early_stop:1;
 	unsigned int ignore_event:1;
 	unsigned int is_superspeed:1;
--- a/drivers/usb/core/hub.c
+++ b/drivers/usb/core/hub.c
@@ -94,6 +94,29 @@
 MODULE_PARM_DESC(blinkenlights, "true to cycle leds on hubs");
 
 /*
+ * A root port whose power the host controller cannot switch (xHCI without
+ * port power control, HCC_PPC = 0) has nothing that brings a device back after
+ * "unable to enumerate": the "attempt power cycle" changes nothing on the
+ * wire, and no new connect change arrives while the device stays plugged in.
+ * Seen on the ROG Phone 5 side port (dwc3, VBUS owned by the Type-C side): a
+ * hub that shows up on an already running host during the first second after
+ * the attach fails with -71 at full speed, while a later port reset
+ * enumerates it at high speed. With root_enum_retries > 0, such a port is
+ * enumerated again root_enum_retry_ms later, at most root_enum_retries times
+ * per connection. Off by default.
+ */
+#define ROOT_ENUM_RETRIES_MAX	10
+static unsigned int root_enum_retries;
+module_param(root_enum_retries, uint, 0644);
+MODULE_PARM_DESC(root_enum_retries,
+		"delayed re-enumerations of a root port without port power control after \"unable to enumerate\" (0 = off, max 10)");
+
+static unsigned int root_enum_retry_ms = 2000;
+module_param(root_enum_retry_ms, uint, 0644);
+MODULE_PARM_DESC(root_enum_retry_ms,
+		"delay before such a re-enumeration in milliseconds (100-30000, default 2000)");
+
+/*
  * Device SATA8000 FW1.0 from DATAST0R Technology Corp requires about
  * 10 seconds to send reply for the initial 64-byte descriptor request.
  */
@@ -1388,6 +1411,85 @@
 	hub_put(hub);
 }
 
+/*
+ * Delayed re-enumeration of root ports (root_enum_retries). A pending retry
+ * holds a hub reference and an autopm reference on the hub interface, so the
+ * root hub doesn't autosuspend in between (it would then never look at the
+ * port again). hub_quiesce() cancels it; resume re-checks connected ports on
+ * its own (hub_activate()). The worker only marks the port due; hub_event()
+ * turns that into a connect change with the hub locked, and only for a port
+ * that has no device by then.
+ */
+static void hub_enum_retry_work(struct work_struct *ws)
+{
+	struct usb_hub *hub = container_of(ws, struct usb_hub,
+					   enum_retry_work.work);
+	struct usb_interface *intf = to_usb_interface(hub->intfdev);
+	unsigned long flags;
+	int port1;
+
+	spin_lock_irqsave(&hub->irq_urb_lock, flags);
+	if (!hub->quiescing && !hub->disconnected) {
+		for (port1 = 1; port1 <= hub->hdev->maxchild; port1++)
+			if (test_and_clear_bit(port1, hub->enum_retry_bits))
+				set_bit(port1, hub->enum_retry_due_bits);
+		kick_hub_wq(hub);
+	}
+	spin_unlock_irqrestore(&hub->irq_urb_lock, flags);
+
+	usb_autopm_put_interface_async(intf);
+	hub_put(hub);
+}
+
+static bool hub_enum_retry_status(int status)
+{
+	switch (status) {
+	case -EPROTO:
+	case -EILSEQ:
+	case -ETIME:
+	case -ETIMEDOUT:
+	case -EPIPE:
+	case -EOVERFLOW:
+		return true;
+	}
+	return false;
+}
+
+/* Called from hub_port_connect() with the hub locked. */
+static void hub_schedule_enum_retry(struct usb_hub *hub,
+				    struct usb_port *port_dev, int status)
+{
+	unsigned int max = min(READ_ONCE(root_enum_retries),
+			       ROOT_ENUM_RETRIES_MAX);
+	unsigned int ms = clamp(READ_ONCE(root_enum_retry_ms), 100U, 30000U);
+	struct usb_interface *intf = to_usb_interface(hub->intfdev);
+	unsigned long flags;
+
+	if (hub->hdev->parent || hub_is_port_power_switchable(hub) ||
+	    !hub_enum_retry_status(status) || port_dev->enum_retries >= max)
+		return;
+
+	spin_lock_irqsave(&hub->irq_urb_lock, flags);
+	if (hub->quiescing || hub->disconnected) {
+		spin_unlock_irqrestore(&hub->irq_urb_lock, flags);
+		return;
+	}
+	port_dev->enum_retries++;
+	set_bit(port_dev->portnum, hub->enum_retry_bits);
+	usb_autopm_get_interface_no_resume(intf);
+	hub_get(hub);
+	if (!schedule_delayed_work(&hub->enum_retry_work,
+				   msecs_to_jiffies(ms))) {
+		/* Already pending for another port: it covers this one. */
+		usb_autopm_put_interface_no_suspend(intf);
+		hub_put(hub);
+	}
+	spin_unlock_irqrestore(&hub->irq_urb_lock, flags);
+
+	dev_info(&port_dev->dev, "enumeration failed (%d); retrying in %u ms (%u/%u)\n",
+		 status, ms, port_dev->enum_retries, max);
+}
+
 enum hub_quiescing_type {
 	HUB_DISCONNECT, HUB_PRE_RESET, HUB_SUSPEND
 };
@@ -1414,6 +1516,13 @@
 	/* Stop hub_wq and related activity */
 	timer_delete_sync(&hub->irq_urb_retry);
 	flush_delayed_work(&hub->post_resume_work);
+	if (cancel_delayed_work_sync(&hub->enum_retry_work)) {
+		usb_autopm_put_interface_no_suspend(
+				to_usb_interface(hub->intfdev));
+		hub_put(hub);
+	}
+	hub->enum_retry_bits[0] = 0;
+	hub->enum_retry_due_bits[0] = 0;
 	usb_kill_urb(hub->urb);
 	if (hub->has_indicators)
 		cancel_delayed_work_sync(&hub->leds);
@@ -1973,6 +2082,7 @@
 	INIT_DELAYED_WORK(&hub->leds, led_work);
 	INIT_DELAYED_WORK(&hub->init_work, NULL);
 	INIT_DELAYED_WORK(&hub->post_resume_work, hub_post_resume);
+	INIT_DELAYED_WORK(&hub->enum_retry_work, hub_enum_retry_work);
 	INIT_WORK(&hub->events, hub_event);
 	INIT_LIST_HEAD(&hub->onboard_devs);
 	spin_lock_init(&hub->irq_urb_lock);
@@ -5413,6 +5523,10 @@
 	static int unreliable_port = -1;
 	bool retry_locked;
 
+	/* This evaluation supersedes a pending delayed re-enumeration. */
+	clear_bit(port1, hub->enum_retry_bits);
+	clear_bit(port1, hub->enum_retry_due_bits);
+
 	/* Disconnect any existing devices under this port */
 	if (udev) {
 		if (hcd->usb_phy && !hdev->parent)
@@ -5427,6 +5541,10 @@
 			(portchange & USB_PORT_STAT_C_CONNECTION))
 		clear_bit(port1, hub->removed_bits);
 
+	/* A new connection gets a new budget of delayed re-enumerations. */
+	if (portchange & USB_PORT_STAT_C_CONNECTION)
+		port_dev->enum_retries = 0;
+
 	if (portchange & (USB_PORT_STAT_C_CONNECTION |
 				USB_PORT_STAT_C_ENABLE)) {
 		status = hub_port_debounce_be_stable(hub, port1);
@@ -5447,6 +5565,7 @@
 	 */
 	if (!(portstatus & USB_PORT_STAT_CONNECTION) ||
 			test_bit(port1, hub->removed_bits)) {
+		port_dev->enum_retries = 0;
 
 		/*
 		 * maybe switch power back on (e.g. root hub was reset)
@@ -5598,6 +5717,7 @@
 		if (status)
 			dev_dbg(hub->intfdev, "%dmA power budget left\n", status);
 
+		port_dev->enum_retries = 0;
 		return;
 
 loop_disable:
@@ -5630,6 +5750,7 @@
 			dev_err(&port_dev->dev,
 					"unable to enumerate USB device\n");
 	}
+	hub_schedule_enum_retry(hub, port_dev, status);
 
 done:
 	hub_port_disable(hub, port1, 1);
@@ -5948,6 +6069,11 @@
 	for (i = 1; i <= hdev->maxchild; i++) {
 		struct usb_port *port_dev = hub->ports[i - 1];
 
+		/* A due re-enumeration; the hub lock keeps ->child stable. */
+		if (test_and_clear_bit(i, hub->enum_retry_due_bits) &&
+		    !port_dev->child)
+			set_bit(i, hub->change_bits);
+
 		if (test_bit(i, hub->event_bits)
 				|| test_bit(i, hub->change_bits)
 				|| test_bit(i, hub->wakeup_bits)) {
