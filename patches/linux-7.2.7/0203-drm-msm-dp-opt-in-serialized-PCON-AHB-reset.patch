From 4a44477abce1a000b570750078d7ad48c50a734b Mon Sep 17 00:00:00 2001
From: "GPT-6.1-Sol" <noreply@openai.com>
Date: Fri, 2 Oct 2026 20:11:21 +0200
Subject: [PATCH] drm/msm/dp: gate serialized PCON AHB training reset

dp_pcon_ahb_reset defaults off. Reset only with core/link clocks live, serialize with AUX transfers, restore AUX/HPD configuration and controller IRQ masks, and replay captured HPD through the existing IRQ thread. Mainlink and link configuration are restored by training.

Co-Authored-By: GPT-6.1-Sol (Codex CLI) <noreply@openai.com>
---
 drivers/gpu/drm/msm/dp/dp_aux.c     | 27 +++++++++++++++++++++++++++
 drivers/gpu/drm/msm/dp/dp_aux.h     |  2 ++
 drivers/gpu/drm/msm/dp/dp_ctrl.c    | 14 ++++++++++++++
 drivers/gpu/drm/msm/dp/dp_ctrl.h    |  1 +
 drivers/gpu/drm/msm/dp/dp_display.c | 26 ++++++++++++++++++++++++++
 5 files changed, 70 insertions(+)

diff --git a/drivers/gpu/drm/msm/dp/dp_aux.c b/drivers/gpu/drm/msm/dp/dp_aux.c
index 3825a2f..8c148f2 100644
--- a/drivers/gpu/drm/msm/dp/dp_aux.c
+++ b/drivers/gpu/drm/msm/dp/dp_aux.c
@@ -10,6 +10,7 @@
 
 #include "dp_reg.h"
 #include "dp_aux.h"
+#include "dp_ctrl.h"
 
 enum msm_dp_aux_err {
 	DP_AUX_ERR_NONE,
@@ -537,6 +538,32 @@ void msm_dp_aux_init(struct drm_dp_aux *msm_dp_aux)
 	mutex_unlock(&aux->mutex);
 }
 
+/* Serialize SW_RESET with all AUX transfers, including the AUX chardev. */
+int msm_dp_aux_reset_ctrl(struct drm_dp_aux *msm_dp_aux, struct msm_dp_ctrl *ctrl)
+{
+	struct msm_dp_aux_private *aux =
+		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
+	u32 hpd_ctrl, hpd_timer, hpd_mask, pending;
+
+	guard(mutex)(&aux->mutex);
+	if (!aux->initted)
+		return -EIO;
+
+	hpd_ctrl = msm_dp_read_aux(aux, REG_DP_DP_HPD_CTRL);
+	hpd_timer = msm_dp_read_aux(aux, REG_DP_DP_HPD_REFTIMER);
+	hpd_mask = msm_dp_read_aux(aux, REG_DP_DP_HPD_INT_MASK);
+	pending = msm_dp_aux_get_hpd_intr_status(msm_dp_aux);
+	ctrl->reset_hpd_status |= pending & hpd_mask & DP_DP_HPD_INT_MASK;
+
+	msm_dp_ctrl_reset(ctrl);
+	msm_dp_ctrl_enable_irq(ctrl);
+	msm_dp_aux_enable(aux);
+	msm_dp_write_aux(aux, REG_DP_DP_HPD_REFTIMER, hpd_timer);
+	msm_dp_write_aux(aux, REG_DP_DP_HPD_CTRL, hpd_ctrl);
+	msm_dp_write_aux(aux, REG_DP_DP_HPD_INT_MASK, hpd_mask);
+	return 0;
+}
+
 void msm_dp_aux_deinit(struct drm_dp_aux *msm_dp_aux)
 {
 	struct msm_dp_aux_private *aux;
diff --git a/drivers/gpu/drm/msm/dp/dp_aux.h b/drivers/gpu/drm/msm/dp/dp_aux.h
index 4be02e8..e21bc7e 100644
--- a/drivers/gpu/drm/msm/dp/dp_aux.h
+++ b/drivers/gpu/drm/msm/dp/dp_aux.h
@@ -13,6 +13,8 @@ void msm_dp_aux_unregister(struct drm_dp_aux *msm_dp_aux);
 irqreturn_t msm_dp_aux_isr(struct drm_dp_aux *msm_dp_aux, u32 isr);
 void msm_dp_aux_enable_xfers(struct drm_dp_aux *msm_dp_aux, bool enabled);
 void msm_dp_aux_init(struct drm_dp_aux *msm_dp_aux);
+struct msm_dp_ctrl;
+int msm_dp_aux_reset_ctrl(struct drm_dp_aux *msm_dp_aux, struct msm_dp_ctrl *ctrl);
 void msm_dp_aux_deinit(struct drm_dp_aux *msm_dp_aux);
 void msm_dp_aux_reconfig(struct drm_dp_aux *msm_dp_aux);
 
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 0e5fe10..dffc553 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -460,6 +460,10 @@ static uint msm_dp_async_msa;
 module_param_named(dp_async_msa, msm_dp_async_msa, uint, 0644);
 MODULE_PARM_DESC(dp_async_msa, "ROG5 EXPERIMENT (static M/N, not spec-complete): 1 = asynchronous MSA clock signalling at the next modeset (0 = synchronous)");
 
+static bool msm_dp_pcon_ahb_reset;
+module_param_named(dp_pcon_ahb_reset, msm_dp_pcon_ahb_reset, bool, 0644);
+MODULE_PARM_DESC(dp_pcon_ahb_reset, "ROG5 PCON experiment: serialized AHB SW_RESET before link training (default 0)");
+
 static bool msm_dp_pcon_single_train;
 module_param_named(dp_pcon_single_train, msm_dp_pcon_single_train, bool, 0644);
 MODULE_PARM_DESC(dp_pcon_single_train, "ROG5 PCON experiment: terminate initial training before video and retrain only on bad EQ (default 0)");
@@ -1827,6 +1831,16 @@ static int msm_dp_ctrl_setup_main_link(struct msm_dp_ctrl_private *ctrl,
 {
 	int ret = 0;
 
+	if (!(ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN) &&
+	    READ_ONCE(msm_dp_pcon_ahb_reset) && msm_dp_ctrl_is_pcon(ctrl)) {
+		if (!ctrl->core_clks_on || !ctrl->link_clks_on)
+			return -EIO;
+		ret = msm_dp_aux_reset_ctrl(ctrl->aux, &ctrl->msm_dp_ctrl);
+		if (ret)
+			return ret;
+		dev_info_ratelimited(ctrl->dev, "DP: PCON AHB reset before training\n");
+	}
+
 	msm_dp_ctrl_mainlink_enable(ctrl);
 
 	if (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN)
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.h b/drivers/gpu/drm/msm/dp/dp_ctrl.h
index eb94f07..06355ce 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.h
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.h
@@ -12,6 +12,7 @@
 
 struct msm_dp_ctrl {
 	bool wide_bus_en;
+	u32 reset_hpd_status;
 };
 
 struct phy;
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index f21c8d0..438a6a4 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -416,6 +416,16 @@ static int msm_dp_display_handle_irq_hpd(struct msm_dp_display_private *dp)
 	drm_dbg_dp(dp->drm_dev, "%d\n", sink_request);
 
 	msm_dp_ctrl_handle_sink_request(dp->ctrl);
+	/* The active IRQ thread will consume any reset-captured HPD next. */
+	if (dp->ctrl->reset_hpd_status) {
+		unsigned long flags;
+
+		spin_lock_irqsave(&dp->irq_thread_lock, flags);
+		dp->hpd_isr_status |= dp->ctrl->reset_hpd_status;
+		dp->ctrl->reset_hpd_status = 0;
+		spin_unlock_irqrestore(&dp->irq_thread_lock, flags);
+		irq_wake_thread(dp->irq, dp);
+	}
 
 	if (sink_request & DP_TEST_LINK_VIDEO_PATTERN)
 		msm_dp_display_handle_video_request(dp);
@@ -1540,6 +1550,20 @@ int msm_dp_modeset_init(struct msm_dp *msm_dp_display, struct drm_device *dev,
 	return 0;
 }
 
+static void msm_dp_display_replay_reset_hpd(struct msm_dp_display_private *dp)
+{
+	unsigned long flags;
+	u32 pending = dp->ctrl->reset_hpd_status;
+
+	dp->ctrl->reset_hpd_status = 0;
+	if (!pending)
+		return;
+	spin_lock_irqsave(&dp->irq_thread_lock, flags);
+	dp->hpd_isr_status |= pending;
+	spin_unlock_irqrestore(&dp->irq_thread_lock, flags);
+	irq_wake_thread(dp->irq, dp);
+}
+
 void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 				 struct drm_atomic_commit *state)
 {
@@ -1615,12 +1639,14 @@ void msm_dp_bridge_atomic_enable(struct drm_bridge *drm_bridge,
 		goto failed_enable;
 
 	rc = msm_dp_ctrl_on_link(msm_dp_display->ctrl);
+	msm_dp_display_replay_reset_hpd(msm_dp_display);
 	if (rc) {
 		DRM_ERROR("Failed link training (rc=%d)\n", rc);
 		goto failed_enable;
 	}
 
 	rc = msm_dp_display_enable(msm_dp_display, force_link_train);
+	msm_dp_display_replay_reset_hpd(msm_dp_display);
 	if (rc)
 		goto failed_enable;
 	msm_dp_display->retry_pending = false;
-- 
