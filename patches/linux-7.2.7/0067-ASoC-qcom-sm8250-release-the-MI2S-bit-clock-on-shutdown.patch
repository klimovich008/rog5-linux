From: Claude <noreply@anthropic.com>
Subject: [PATCH] ASoC: qcom: sm8250: release the MI2S bit clock on shutdown

sm8250_snd_startup() enables the MI2S bit clock of PRIMARY..SENARY MI2S RX
through the AFE (snd_soc_dai_set_sysclk(..., MI2S_BCLK_RATE)), but the
backend .shutdown is only qcom_snd_sdw_shutdown(), so nothing ever sends
the matching frequency 0. After the first stream (even a sound server's
short probe open) the ADSP keeps the LPASS clock voted and never
power-collapses again, which also keeps CX/DDR/XO out of RPMh sleep.

Add a shutdown that disables the bit clock startup enabled, then runs the
SoundWire shutdown. Verified on SM8350 (SENARY MI2S): after an ADSP restart
the ADSP sleep counter (qcom_stats/adsp) stopped for good once PipeWire
opened the PCM with the old module; with this change it keeps counting
through PipeWire start and after a stream closes.

--- a/sound/soc/qcom/sm8250.c	2026-09-26 23:52:52.316620899 +0200
+++ b/sound/soc/qcom/sm8250.c	2026-09-26 23:52:52.335054425 +0200
@@ -133,6 +133,44 @@
 	return qcom_snd_sdw_startup(substream);
 }
 
+static void sm8250_snd_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	int clk_id = 0;
+
+	/*
+	 * Undo the MI2S bit clock that startup enabled through the AFE.
+	 * Without this the ADSP keeps the LPASS clock voted after the first
+	 * stream closes and never power-collapses again.
+	 */
+	switch (cpu_dai->id) {
+	case PRIMARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT;
+		break;
+	case SECONDARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_SEC_MI2S_IBIT;
+		break;
+	case TERTIARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_TER_MI2S_IBIT;
+		break;
+	case QUINARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_QUI_MI2S_IBIT;
+		break;
+	case SENARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_SEN_MI2S_IBIT;
+		break;
+	default:
+		break;
+	}
+
+	if (clk_id)
+		snd_soc_dai_set_sysclk(cpu_dai, clk_id, 0,
+				       SNDRV_PCM_STREAM_PLAYBACK);
+
+	qcom_snd_sdw_shutdown(substream);
+}
+
 static int sm8250_snd_prepare(struct snd_pcm_substream *substream)
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
@@ -153,7 +191,7 @@
 
 static const struct snd_soc_ops sm8250_be_ops = {
 	.startup = sm8250_snd_startup,
-	.shutdown = qcom_snd_sdw_shutdown,
+	.shutdown = sm8250_snd_shutdown,
 	.hw_free = sm8250_snd_hw_free,
 	.prepare = sm8250_snd_prepare,
 };
