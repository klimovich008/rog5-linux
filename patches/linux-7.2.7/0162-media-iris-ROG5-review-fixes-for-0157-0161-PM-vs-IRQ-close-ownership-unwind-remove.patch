+			 */
+			if (qcom_scm_pas_shutdown(IRIS_PAS_ID)) {
+				dev_err(core->dev,
+					"firmware shutdown (PAS) failed; keeping the video core powered and its memory mapped\n");
+				core->fatal = true;
+				core->fw_held = true;
+			}
 			return ret;
 		}
 	}
