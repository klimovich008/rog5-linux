@@ -102,7 +102,17 @@ int iris_fw_load(struct iris_core *core)
 						     cp_config->cp_nonpixel_size);
 		if (ret) {
 			dev_err(core->dev, "qcom_scm_mem_protect_video_var failed: %d\n", ret);
-			qcom_scm_pas_shutdown(IRIS_PAS_ID);
+			/*
+			 * ROG5: the image already runs; if TrustZone does not
+			 * stop it, keep power and memory (iris_core_init()'s
