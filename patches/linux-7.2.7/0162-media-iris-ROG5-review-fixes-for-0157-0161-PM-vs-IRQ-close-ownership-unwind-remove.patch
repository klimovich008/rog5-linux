+++ b/drivers/media/platform/qcom/iris/iris_vidc.c
@@ -225,14 +225,14 @@ fail_v4l2_fh_deinit:
 	return ret;
 }
 
-static void iris_session_close(struct iris_inst *inst)
+/* ROG5: 0 when the firmware acknowledged the end of the session (or never had one) */
+static int iris_session_close(struct iris_inst *inst)
 {
 	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
-	bool wait_for_response = true;
 	int ret;
 
 	if (inst->state == IRIS_INST_DEINIT)
-		return;
+		return 0;
 
 	/* ROG5: if END already went out (failed streamoff), wait for its answer */
 	if (!inst->end_sent) {
@@ -240,11 +240,49 @@ static void iris_session_close(struct iris_inst *inst)
 
 		ret = hfi_ops->session_close(inst);
 		if (ret)
-			wait_for_response = false;
+			return ret;
 	}
 
-	if (wait_for_response)
-		iris_wait_for_session_response(inst, false);
+	/*
+	 * Any answer to END counts as the firmware letting go of the session,
+	 * also one with an error code; only a timeout or a wake-up by the
+	 * fatal-error containment does not.
+	 */
+	mutex_unlock(&inst->lock);
+	ret = wait_for_completion_timeout(&inst->completion,
+					  msecs_to_jiffies(HW_RESPONSE_TIMEOUT_VALUE));
+	mutex_lock(&inst->lock);
+	if (!ret) {
+		iris_inst_change_state(inst, IRIS_INST_ERROR);
+		return -ETIMEDOUT;
+	}
+
+	return READ_ONCE(inst->core->fatal) ? -EIO : 0;
+}
+
+/*
+ * ROG5: may the session's firmware-visible memory (internal buffers, EOS
+ * buffer) be freed? Only once the firmware acknowledged SESSION_END, or the
+ * firmware was shut down after a fatal error. Otherwise it may still run and
+ * access them, and they are leaked on purpose.
+ */
+static bool iris_session_memory_released(struct iris_inst *inst, int end_ret)
+{
+	struct iris_core *core = inst->core;
+	bool released;
+
+	if (!end_ret)
+		return true;
+
+	mutex_lock(&core->lock);
+	released = core->fatal && !core->fw_held && core->state == IRIS_CORE_DEINIT;
+	mutex_unlock(&core->lock);
+	if (!released)
+		dev_err(core->dev,
+			"session %#x: no end acknowledgement (%d) and the firmware is not shut down; leaking its buffers\n",
+			inst->session_id, end_ret);
+
+	return released;
 }
 
 static void iris_check_num_queued_internal_buffers(struct iris_inst *inst, u32 plane)
@@ -290,6 +328,8 @@ static void iris_check_num_queued_internal_buffers(struct iris_inst *inst, u32 p
 int iris_close(struct file *filp)
 {
 	struct iris_inst *inst = iris_get_inst(filp);
+	bool fw_held;
+	int end_ret;
 
 	/*
 	 * ROG5: from here on, responses for this session only complete waits
@@ -303,20 +343,43 @@ int iris_close(struct file *filp)
 	inst->closing = true;
 	mutex_unlock(&inst->lock);
 
-	v4l2_m2m_ctx_release(inst->m2m_ctx);
-	v4l2_m2m_release(inst->m2m_dev);
+	/*
+	 * ROG5: after a fatal error, let the containment shut the firmware
+	 * down before vb2 releases the client buffers it may still access
+	 * (the work takes inst->lock, so no instance lock may be held here).
+	 */
+	if (READ_ONCE(inst->core->fatal))
+		flush_delayed_work(&inst->core->sys_error_handler);
+
+	/*
+	 * ROG5: if the firmware could not be shut down it may still access
+	 * the client buffers: keep them (and the m2m context) instead.
+	 */
+	mutex_lock(&inst->core->lock);
+	fw_held = inst->core->fw_held;
+	mutex_unlock(&inst->core->lock);
+	if (!fw_held) {
+		v4l2_m2m_ctx_release(inst->m2m_ctx);
+		v4l2_m2m_release(inst->m2m_dev);
+	} else {
+		dev_err(inst->core->dev,
+			"session %#x: firmware still held; leaking its client buffers\n",
+			inst->session_id);
+	}
 	mutex_lock(&inst->lock);
-	iris_session_close(inst);
+	end_ret = iris_session_close(inst);
 	iris_inst_change_state(inst, IRIS_INST_DEINIT);
 	iris_v4l2_fh_deinit(inst, filp);
-	iris_destroy_all_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
-	iris_destroy_all_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
-	iris_check_num_queued_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
-	iris_check_num_queued_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	if (iris_session_memory_released(inst, end_ret)) {
+		iris_destroy_all_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+		iris_destroy_all_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+		iris_check_num_queued_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+		iris_check_num_queued_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+		if (inst->eos_vaddr)
+			dma_free_attrs(inst->core->dev, SZ_4K, inst->eos_vaddr,
+				       inst->eos_daddr, 0);
+	}
 	iris_remove_session(inst);
-	/* ROG5: after SESSION_END; kept if the firmware could not be shut down */
-	if (inst->eos_vaddr && !inst->core->fw_held)
-		dma_free_attrs(inst->core->dev, SZ_4K, inst->eos_vaddr, inst->eos_daddr, 0);
 	mutex_unlock(&inst->lock);
 	v4l2_ctrl_handler_free(&inst->ctrl_handler);
 	/* the memory goes with the last response handler's reference */
diff --git a/drivers/media/platform/qcom/iris/iris_vpu_common.c b/drivers/media/platform/qcom/iris/iris_vpu_common.c
index 4c6739e..ab0c65d 100644
--- a/drivers/media/platform/qcom/iris/iris_vpu_common.c
+++ b/drivers/media/platform/qcom/iris/iris_vpu_common.c
@@ -238,12 +238,15 @@ void iris_vpu_power_off_hw(struct iris_core *core)
 void iris_vpu_power_off(struct iris_core *core)
 {
 	/*
-	 * ROG5: stop interrupt handling before the clocks go, not after: the
-	 * interrupt thread reads and clears VPU registers. Every caller has
-	 * already quiesced the line outside core->lock, so this does not wait.
+	 * ROG5: mask the line before the clocks go, not after, and without
