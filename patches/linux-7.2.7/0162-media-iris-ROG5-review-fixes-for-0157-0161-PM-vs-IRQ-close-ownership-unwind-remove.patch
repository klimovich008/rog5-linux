+++ b/drivers/media/platform/qcom/iris/iris_probe.c
@@ -200,8 +200,17 @@ static void iris_remove(struct platform_device *pdev)
 	if (!core)
 		return;
 
+	/* ROG5: no containment work may start or run after this */
+	mutex_lock(&core->lock);
+	core->removing = true;
+	mutex_unlock(&core->lock);
 	cancel_delayed_work_sync(&core->sys_error_handler);
 	iris_core_deinit(core);
+	/*
+	 * ROG5: a core whose firmware could not be shut down keeps its line
+	 * enabled; no handler may run once the lock below is destroyed.
+	 */
+	disable_irq(core->irq);
 
 	video_unregister_device(core->vdev_dec);
 	video_unregister_device(core->vdev_enc);
@@ -316,11 +325,13 @@ err_v4l2_unreg:
 }
 
 /*
- * ROG5: both callbacks quiesce the interrupt before taking core->lock: the
- * interrupt thread takes that lock, and the power-off path waits for it in
- * disable_irq(). The extra disable is undone at the end, which leaves the
- * depth power off/on set. After a fatal error the hardware is left to
- * iris_core_contain_fatal().
+ * ROG5: the PM callbacks never wait for the interrupt thread: that thread
+ * can wait for inst->lock held by a task that waits for this very runtime PM
+ * transition (pm_runtime_resume_and_get() on a command), or call it itself.
+ * iris_vpu_power_off() therefore only disables the line without waiting,
+ * and the thread touches VPU registers only while core->powered (checked
+ * under core->lock, which power off holds). After a fatal error the hardware
+ * is left to iris_core_contain_fatal().
  */
 static int __maybe_unused iris_pm_suspend(struct device *dev)
 {
@@ -329,7 +340,6 @@ static int __maybe_unused iris_pm_suspend(struct device *dev)
 
 	core = dev_get_drvdata(dev);
 
-	disable_irq(core->irq);
 	mutex_lock(&core->lock);
 	if (core->state != IRIS_CORE_INIT || core->fatal)
 		goto exit;
@@ -338,7 +348,6 @@ static int __maybe_unused iris_pm_suspend(struct device *dev)
 
 exit:
 	mutex_unlock(&core->lock);
-	enable_irq(core->irq);
 
 	return ret;
 }
@@ -350,7 +359,6 @@ static int __maybe_unused iris_pm_resume(struct device *dev)
 
 	core = dev_get_drvdata(dev);
 
-	disable_irq(core->irq);
 	mutex_lock(&core->lock);
 	if (core->state != IRIS_CORE_INIT || core->fatal)
 		goto exit;
@@ -360,7 +368,6 @@ static int __maybe_unused iris_pm_resume(struct device *dev)
 
 exit:
 	mutex_unlock(&core->lock);
-	enable_irq(core->irq);
 
 	return ret;
 }
diff --git a/drivers/media/platform/qcom/iris/iris_vidc.c b/drivers/media/platform/qcom/iris/iris_vidc.c
index 207be7a..f3301af 100644
