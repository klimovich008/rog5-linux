+/* Failed enables have no power_on flag; unwind actual acquisitions only. */
+void msm_dp_ctrl_abort(struct msm_dp_ctrl *msm_dp_ctrl, bool sink_access)
+{
+	struct msm_dp_ctrl_private *ctrl =
+		container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
+	int ret;
+
+	if (ctrl->core_clks_on && ctrl->link_clks_on) {
+		msm_dp_panel_disable_vsc_sdp(ctrl->panel);
+		msm_dp_write_link(ctrl, REG_DP_STATE_CTRL, 0);
+		msm_dp_ctrl_mainlink_disable(ctrl);
+	}
+	/* AUX remains live until after the receiver has been put into D3. */
+	if (sink_access && ctrl->core_clks_on && msm_dp_aux_is_link_connected(ctrl->aux)) {
+		ret = msm_dp_ctrl_clear_training_pattern(ctrl, DP_PHY_DPRX);
+		if (ret)
+			DRM_ERROR_RATELIMITED("DP: abort TP disable rc=%d\n", ret);
+		ret = msm_dp_link_psm_config(ctrl->link, &ctrl->panel->link_info, true);
+		if (ret)
+			DRM_ERROR_RATELIMITED("DP: abort D3 rc=%d\n", ret);
+	}
+	if (ctrl->stream_clks_on) {
+		clk_disable_unprepare(ctrl->pixel_clk);
+		ctrl->stream_clks_on = false;
+	}
+	msm_dp_ctrl_link_clk_disable(msm_dp_ctrl);
+	dev_pm_opp_set_rate(ctrl->dev, 0);
+	msm_dp_ctrl_phy_power_off(ctrl);
+}
