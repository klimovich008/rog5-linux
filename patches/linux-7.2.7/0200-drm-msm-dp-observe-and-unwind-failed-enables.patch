From 7fda7055aa772ea9c9b72b8cb8a7b0efcc9ab1d3 Mon Sep 17 00:00:00 2001
From: "GPT-6.1-Sol" <noreply@openai.com>
Date: Fri, 2 Oct 2026 20:08:02 +0200
Subject: [PATCH] drm/msm/dp: report enable errors and unwind actual resources

Check required AUX transfers, training exhaustion, bandwidth and stream readiness. Keep failure snapshots bounded and read-only. Defer link-BAD notification until modeset locks drop and refresh capabilities on the next enable. Preserve unclocked-register protection and PM reference ownership.

Co-Authored-By: GPT-6.1-Sol (Codex CLI) <noreply@openai.com>
---
 drivers/gpu/drm/msm/dp/dp_ctrl.c    | 225 ++++++++++++++++++++--------
 drivers/gpu/drm/msm/dp/dp_ctrl.h    |   4 +-
 drivers/gpu/drm/msm/dp/dp_display.c | 115 +++++++++++---
 drivers/gpu/drm/msm/dp/dp_link.c    |  13 +-
 4 files changed, 263 insertions(+), 94 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 0931283..923c6b7 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -14,6 +14,8 @@
 #include <linux/phy/phy-dp.h>
 #include <linux/pm_opp.h>
 #include <linux/rational.h>
