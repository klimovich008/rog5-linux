@@ -174,6 +176,51 @@ static inline void msm_dp_write_link(struct msm_dp_ctrl_private *ctrl,
 	writel(data, ctrl->link_base + offset);
 }
 
+/* Bounded, read-only AUX snapshots; byte counts qualify every field. */
+void msm_dp_ctrl_log_link(struct msm_dp_ctrl *msm_dp_ctrl, const char *stage, int rc)
+{
+	struct msm_dp_ctrl_private *ctrl =
+		container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
+	static DEFINE_RATELIMIT_STATE(limit, 5 * HZ, 10);
+	u8 status[DP_LINK_STATUS_SIZE] = {}, power = 0, pcon[3] = {}, tx = 0;
+	int st = -ENODATA, pw = -ENODATA, pc = -ENODATA, ht = -ENODATA;
+
+	if (!__ratelimit(&limit))
+		return;
+
+	if (ctrl->core_clks_on && msm_dp_aux_is_link_connected(ctrl->aux)) {
+		st = drm_dp_dpcd_read(ctrl->aux, DP_LANE0_1_STATUS, status, sizeof(status));
+		pw = drm_dp_dpcd_readb(ctrl->aux, DP_SET_POWER, &power);
+		if (drm_dp_is_branch(ctrl->panel->dpcd) &&
+		    (ctrl->panel->dpcd[DP_DOWNSTREAMPORT_PRESENT] &
+		     DP_DWN_STRM_PORT_TYPE_MASK) == DP_DWN_STRM_PORT_TYPE_TMDS &&
+		    ctrl->panel->dpcd[DP_DPCD_REV] >= 0x13) {
+			pc = drm_dp_dpcd_read(ctrl->aux, DP_PROTOCOL_CONVERTER_CONTROL_0,
+					      pcon, sizeof(pcon));
+			ht = drm_dp_dpcd_readb(ctrl->aux, DP_PCON_HDMI_TX_LINK_STATUS, &tx);
+		}
+	}
+	drm_info(ctrl->drm_dev,
+		 "DP: %s rc=%d @%llu ms %u x %u kHz bpp=%u 202=%*ph(%d/6) 600=%02x(%d/1) 3050=%*ph(%d/3) 303b=%02x(%d/1)\n",
+		 stage, rc, (unsigned long long)ktime_to_ms(ktime_get_boottime()),
+		 ctrl->link->link_params.num_lanes, ctrl->link->link_params.rate,
+		 ctrl->panel->msm_dp_mode.bpp, (int)sizeof(status), status, st,
+		 power, pw, (int)sizeof(pcon), pcon, pc, tx, ht);
+	/* Never touch the link block without its clocks (0091). */
+	if (ctrl->core_clks_on && ctrl->link_clks_on)
+		drm_info(ctrl->drm_dev,
+			 "DP: %s ready=%08x cfg=%08x misc=%08x M/N=%x/%x TU=%x/%x/%x pixel=%lu Hz link=%lu Hz\n",
+			 stage, msm_dp_read_link(ctrl, REG_DP_MAINLINK_READY),
+			 msm_dp_read_link(ctrl, REG_DP_CONFIGURATION_CTRL),
+			 msm_dp_read_link(ctrl, REG_DP_MISC1_MISC0),
+			 msm_dp_read_link(ctrl, REG_DP_SOFTWARE_MVID),
+			 msm_dp_read_link(ctrl, REG_DP_SOFTWARE_NVID),
+			 msm_dp_read_link(ctrl, REG_DP_TU),
+			 msm_dp_read_link(ctrl, REG_DP_VALID_BOUNDARY),
+			 msm_dp_read_link(ctrl, REG_DP_VALID_BOUNDARY_2),
+			 clk_get_rate(ctrl->pixel_clk), clk_get_rate(ctrl->link_clks[0].clk));
+}
