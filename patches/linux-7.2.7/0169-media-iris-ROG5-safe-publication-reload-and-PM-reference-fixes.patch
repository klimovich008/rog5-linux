 {
-	return qcom_scm_pas_shutdown(IRIS_PAS_ID);
+	int ret;
+
+	ret = qcom_scm_pas_shutdown(IRIS_PAS_ID);
+	/*
+	 * ROG5: the module pin of iris_fw_load() stays until the power off
+	 * after this has completed without a hold (iris_core_unpin()).
+	 */
+	return ret;
 }
 
