+static int __iris_open(struct file *filp, struct iris_core *core);
+
 int iris_open(struct file *filp)
 {
 	struct iris_core *core = video_drvdata(filp);
+	int ret;
+
+	/* ROG5: seen by iris_core_unload_idle() */
+	atomic_inc(&core->openers);
+	ret = __iris_open(filp, core);
+	atomic_dec(&core->openers);
+
+	return ret;
+}
+
+static int __iris_open(struct file *filp, struct iris_core *core)
+{
 	struct video_device *vdev;
 	struct iris_inst *inst;
 	u32 session_type;
