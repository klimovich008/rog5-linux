 		cp_config = &core->iris_platform_data->tz_cp_config_data[i];
 		ret = qcom_scm_mem_protect_video_var(cp_config->cp_start,
@@ -107,7 +121,7 @@ int iris_fw_load(struct iris_core *core)
 			 * stop it, keep power and memory (iris_core_init()'s
 			 * unwind honours fw_held) like iris_core_teardown().
 			 */
-			if (qcom_scm_pas_shutdown(IRIS_PAS_ID)) {
+			if (iris_fw_unload(core)) {
 				dev_err(core->dev,
 					"firmware shutdown (PAS) failed; keeping the video core powered and its memory mapped\n");
 				core->fatal = true;
@@ -122,7 +136,14 @@ int iris_fw_load(struct iris_core *core)
 
