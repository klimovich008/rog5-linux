From: Claude <noreply@anthropic.com>
Subject: [PATCH] soc: qcom: pdr: stop workers and QMI callbacks before freeing the services

pdr_handle_release() freed the services first, then cancelled the
workers, destroyed both workqueues and only then released the QMI
handles. But:

- an indication callback that already looked its service up queues
  indack work that dereferences it, and the notifier/locator workers walk
  the services: a worker running or queued after the services were freed
  uses freed memory;
- the QMI callbacks run until qmi_handle_release() returns, and
  qmi_handle_release() itself calls ->del_server() for every service it
  knows (qmi_recv_del_server(qmi, -1, -1)), which queues notifier_work on
  the notifier_wq that was destroyed just before;
- indications still queued when indack_work is cancelled were leaked.

Set a stopping flag under the locks the producers use and check it where
work is queued (pdr_locator_new_server(), pdr_notifier_new/del_server(),
pdr_indication_cb(), which now queues under list_lock), cancel the
workers while the services and the QMI handles are still valid, release
the QMI handles (which waits for the callbacks), then destroy the
workqueues and free the pending indications and the services.

Not fixed upstream (linux-next 2026-10-02 has the same order). Found by
the 2026-10-02 GPT-6.1-Sol audit (F3).

Hardware: users are apr (q6 audio), pmic_glink (battery/USB-C) and the
slimbus NGD. Unbind/rebind pmic_glink or q6apr, or restart the ADSP while
audio plays; all must come back with no oops or KASAN report.

diff --git a/drivers/soc/qcom/pdr_interface.c b/drivers/soc/qcom/pdr_interface.c
index 6d879e154..2e4bff425 100644
--- a/drivers/soc/qcom/pdr_interface.c
+++ b/drivers/soc/qcom/pdr_interface.c
@@ -52,6 +52,12 @@ struct pdr_handle {
 
 	bool locator_init_complete;
 
+	/*
+	 * Set by pdr_handle_release(), with both list_lock and lock held:
+	 * the QMI callbacks queue no more work.
+	 */
+	bool stopping;
+
 	struct work_struct locator_work;
 	struct work_struct notifier_work;
 	struct work_struct indack_work;
@@ -83,10 +89,11 @@ static int pdr_locator_new_server(struct qmi_handle *qmi,
 	pdr->locator_addr.sq_port = svc->port;
 
 	pdr->locator_init_complete = true;
-	mutex_unlock(&pdr->lock);
 
 	/* Service pending lookup requests */
-	schedule_work(&pdr->locator_work);
+	if (!pdr->stopping)
+		schedule_work(&pdr->locator_work);
+	mutex_unlock(&pdr->lock);
 
 	return 0;
 }
@@ -204,7 +211,8 @@ static int pdr_notifier_new_server(struct qmi_handle *qmi,
 			pds->addr.sq_family = AF_QIPCRTR;
 			pds->addr.sq_node = svc->node;
 			pds->addr.sq_port = svc->port;
-			queue_work(pdr->notifier_wq, &pdr->notifier_work);
+			if (!pdr->stopping)
+				queue_work(pdr->notifier_wq, &pdr->notifier_work);
 		}
 	}
 	mutex_unlock(&pdr->list_lock);
@@ -227,7 +235,8 @@ static void pdr_notifier_del_server(struct qmi_handle *qmi,
 			pds->need_notifier_remove = true;
 			pds->addr.sq_node = 0;
 			pds->addr.sq_port = 0;
-			queue_work(pdr->notifier_wq, &pdr->notifier_work);
+			if (!pdr->stopping)
+				queue_work(pdr->notifier_wq, &pdr->notifier_work);
 		}
 	}
 	mutex_unlock(&pdr->list_lock);
@@ -331,10 +340,14 @@ static void pdr_indication_cb(struct qmi_handle *qmi,
 	ind->pds = pds;
 
 	mutex_lock(&pdr->list_lock);
+	if (pdr->stopping) {
+		mutex_unlock(&pdr->list_lock);
+		kfree(ind);
+		return;
+	}
 	list_add_tail(&ind->node, &pdr->indack_list);
-	mutex_unlock(&pdr->list_lock);
-
 	queue_work(pdr->indack_wq, &pdr->indack_work);
+	mutex_unlock(&pdr->list_lock);
 }
 
 static const struct qmi_msg_handler qmi_indication_handler[] = {
@@ -710,27 +723,44 @@ EXPORT_SYMBOL_GPL(pdr_handle_alloc);
  */
 void pdr_handle_release(struct pdr_handle *pdr)
 {
+	struct pdr_list_node *ind, *tmp_ind;
 	struct pdr_service *pds, *tmp;
 
 	if (IS_ERR_OR_NULL(pdr))
 		return;
 
+	/*
+	 * The workers use the services and both QMI handles, and the QMI
+	 * callbacks (still running until the handles are released) queue
+	 * them. Stop the callbacks from queueing, let the workers finish,
+	 * then release the handles, which waits for the callbacks; free the
+	 * services and pending indications last.
+	 */
 	mutex_lock(&pdr->list_lock);
-	list_for_each_entry_safe(pds, tmp, &pdr->lookups, node) {
-		list_del(&pds->node);
-		kfree(pds);
-	}
+	mutex_lock(&pdr->lock);
+	pdr->stopping = true;
+	mutex_unlock(&pdr->lock);
 	mutex_unlock(&pdr->list_lock);
 
 	cancel_work_sync(&pdr->locator_work);
 	cancel_work_sync(&pdr->notifier_work);
 	cancel_work_sync(&pdr->indack_work);
 
+	qmi_handle_release(&pdr->locator_hdl);
+	qmi_handle_release(&pdr->notifier_hdl);
+
 	destroy_workqueue(pdr->notifier_wq);
 	destroy_workqueue(pdr->indack_wq);
 
-	qmi_handle_release(&pdr->locator_hdl);
-	qmi_handle_release(&pdr->notifier_hdl);
+	list_for_each_entry_safe(ind, tmp_ind, &pdr->indack_list, node) {
+		list_del(&ind->node);
+		kfree(ind);
+	}
+
+	list_for_each_entry_safe(pds, tmp, &pdr->lookups, node) {
+		list_del(&pds->node);
+		kfree(pds);
+	}
 
 	kfree(pdr);
 }
