From: GPT-6.1-Sol <noreply@openai.com>
Subject: [PATCH] ASoC: cs35l45: latch restore faults and verify hardware defaults

Complete audit F4: a cached BBPE clear after an I2C failure must be forced
back to hardware; restore readback bypasses the cache. Keep the fault across
DSP restarts and reject GLOBAL_EN even if a DSP is running. A reset asserted
after failed mute remains latched until rebind; cached restore cannot clear it.
Propagate shutdown errors and hold the amplifier off while restoration fails.
Local follow-up to 0122/0151/0195; no matching upstream fix found.

Hardware: muted I2C fault-injection first; fail each vendor/restore write and
readback, request direct playback and DSP reload, assert no GLOBAL_EN write.
Rebind only after the bus recovers, then qualify both speaker paths.

diff --git a/sound/soc/codecs/cs35l45.c b/sound/soc/codecs/cs35l45.c
--- a/sound/soc/codecs/cs35l45.c
+++ b/sound/soc/codecs/cs35l45.c
@@ -108,6 +108,7 @@
 }
 
 static int cs35l45_set_prot_regs(struct cs35l45_private *cs35l45, bool vendor);
+static void cs35l45_prot_restore_failed(struct cs35l45_private *cs35l45);
 
 static int cs35l45_global_en_ev(struct snd_soc_dapm_widget *w,
 				struct snd_kcontrol *kcontrol, int event)
@@ -126,24 +127,34 @@
 		 * the defaults first, and leave the amplifier off (a DAPM
 		 * event error is only logged) while that fails.
 		 */
-		if (cs35l45->prot_regs_set && !cs35l45->dsp.cs_dsp.running) {
+		if (cs35l45->reset_held)
+			return -EIO;
+		if (cs35l45->prot_fault ||
+		    (cs35l45->prot_regs_set && !cs35l45->dsp.cs_dsp.running)) {
 			ret = cs35l45_set_prot_regs(cs35l45, false);
 			if (ret) {
 				dev_err(cs35l45->dev,
 					"protection registers not restored, amplifier stays off\n");
+				cs35l45_prot_restore_failed(cs35l45);
 				return ret;
 			}
 		}
 
-		regmap_write(cs35l45->regmap, CS35L45_GLOBAL_ENABLES,
-			     CS35L45_GLOBAL_EN_MASK);
+		ret = regmap_write(cs35l45->regmap, CS35L45_GLOBAL_ENABLES,
+				   CS35L45_GLOBAL_EN_MASK);
+		if (ret)
+			return ret;
 
 		usleep_range(CS35L45_POST_GLOBAL_EN_US, CS35L45_POST_GLOBAL_EN_US + 100);
 		break;
 	case SND_SOC_DAPM_PRE_PMD:
 		usleep_range(CS35L45_PRE_GLOBAL_DIS_US, CS35L45_PRE_GLOBAL_DIS_US + 100);
 
-		regmap_write(cs35l45->regmap, CS35L45_GLOBAL_ENABLES, 0);
+		ret = regmap_write(cs35l45->regmap, CS35L45_GLOBAL_ENABLES, 0);
+		if (ret) {
+			cs35l45_prot_restore_failed(cs35l45);
+			return ret;
+		}
 		break;
 	default:
 		break;
@@ -183,13 +194,17 @@
 
 static int cs35l45_set_prot_regs(struct cs35l45_private *cs35l45, bool vendor)
 {
+	unsigned int val, i;
 	int ret;
+
+	if (cs35l45->reset_held)
+		return -EIO;
 
 	/*
 	 * prot_regs_set means "restore needed": a requested vendor setup is
 	 * always written in full, even after a failed setup and rollback.
 	 */
-	if (!vendor && !cs35l45->prot_regs_set)
+	if (!vendor && !cs35l45->prot_regs_set && !cs35l45->prot_fault)
 		return 0;
 
 	if (vendor) {
@@ -198,16 +213,32 @@
 		ret = regmap_multi_reg_write(cs35l45->regmap, cs35l45_vendor_prot_regs,
 					     ARRAY_SIZE(cs35l45_vendor_prot_regs));
 		if (!ret)
-			ret = regmap_set_bits(cs35l45->regmap, CS35L45_BLOCK_ENABLES2,
-					      CS35L45_BBPE_EN_MASK);
+			ret = regmap_write_bits(cs35l45->regmap, CS35L45_BLOCK_ENABLES2,
+					       CS35L45_BBPE_EN_MASK, CS35L45_BBPE_EN_MASK);
 	} else {
-		ret = regmap_clear_bits(cs35l45->regmap, CS35L45_BLOCK_ENABLES2,
-					CS35L45_BBPE_EN_MASK);
+		ret = regmap_write_bits(cs35l45->regmap, CS35L45_BLOCK_ENABLES2,
+					       CS35L45_BBPE_EN_MASK, 0);
 		if (!ret)
 			ret = regmap_multi_reg_write(cs35l45->regmap, cs35l45_default_prot_regs,
 						     ARRAY_SIZE(cs35l45_default_prot_regs));
-		if (!ret)
+		/* Read hardware, not the cache updated before a failed I2C write. */
+		for (i = 0; !ret && i < ARRAY_SIZE(cs35l45_default_prot_regs); i++) {
+			ret = regmap_read_bypassed(cs35l45->regmap,
+				cs35l45_default_prot_regs[i].reg, &val);
+			if (!ret && val != cs35l45_default_prot_regs[i].def)
+				ret = -EIO;
+		}
+		if (!ret) {
+			ret = regmap_read_bypassed(cs35l45->regmap, CS35L45_BLOCK_ENABLES2, &val);
+			if (!ret && (val & CS35L45_BBPE_EN_MASK))
+				ret = -EIO;
+		}
+		if (!ret) {
 			cs35l45->prot_regs_set = false;
+			cs35l45->prot_fault = false;
+		} else {
+			cs35l45->prot_fault = true;
+		}
 	}
 
 	if (ret)
@@ -228,6 +259,7 @@
 {
 	int ret;
 
+	cs35l45->prot_fault = true;
 	dev_err(cs35l45->dev,
 		"protection registers not restored, switching the amplifier off\n");
 	ret = regmap_write(cs35l45->regmap, CS35L45_GLOBAL_ENABLES, 0);
@@ -235,6 +267,7 @@
 		/* Out of reach over I2C: hold it in reset until it is rebound */
 		dev_err(cs35l45->dev,
 			"cannot switch the amplifier off (%d), holding it in reset\n", ret);
+		cs35l45->reset_held = true;
 		gpiod_set_value_cansleep(cs35l45->reset_gpio, 0);
 	}
 }
@@ -256,6 +289,15 @@
 
 		return wm_adsp_early_event(w, kcontrol, event);
 	case SND_SOC_DAPM_POST_PMU:
+		if (cs35l45->reset_held)
+			return -EIO;
+		if (cs35l45->prot_fault) {
+			ret = cs35l45_set_prot_regs(cs35l45, false);
+			if (ret) {
+				cs35l45_prot_restore_failed(cs35l45);
+				return ret;
+			}
+		}
 		if (cs35l45->dsp.cs_dsp.running)
 			return 0;
 
@@ -289,8 +331,11 @@
 				return ret;
 		}
 
-		if (cs35l45_set_prot_regs(cs35l45, false))
+		ret = cs35l45_set_prot_regs(cs35l45, false);
+		if (ret) {
 			cs35l45_prot_restore_failed(cs35l45);
+			return ret;
+		}
 
 		ret = wm_adsp_early_event(w, kcontrol, event);
 
@@ -478,7 +523,7 @@
 	 * The vendor protection operating point is for speaker mode only; DSP
 	 * starts and stops run under the DAPM mutex, so check it here.
 	 */
-	if (cs35l45->prot_regs_set) {
+	if (cs35l45->prot_regs_set || cs35l45->prot_fault || cs35l45->reset_held) {
 		snd_soc_dapm_mutex_unlock(dapm);
 		return -EBUSY;
 	}
diff --git a/sound/soc/codecs/cs35l45.h b/sound/soc/codecs/cs35l45.h
--- a/sound/soc/codecs/cs35l45.h
+++ b/sound/soc/codecs/cs35l45.h
@@ -500,6 +500,9 @@
 	bool sysclk_set;
 	bool dsp_part_named;
 	bool prot_regs_set;
+	/* Failed restoration: no AMP power-up until verified defaults. */
+	bool prot_fault;
+	bool reset_held;
 	bool dsp_reload;
 	ktime_t dsp_resumed;
 	struct delayed_work dsp_reload_work;
