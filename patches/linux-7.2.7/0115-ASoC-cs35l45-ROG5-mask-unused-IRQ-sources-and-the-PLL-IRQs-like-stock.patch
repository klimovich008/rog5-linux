From: Claude <noreply@anthropic.com>
Subject: [PATCH] ASoC: cs35l45: mask unused IRQ sources before enabling INT and do not unmask the PLL IRQs, as the vendor driver does

The upstream driver unmasks PLL lock and PLL unlock, whose handlers only
print at debug level, so every stream start and stop raises INT and costs an
I2C sweep of 18 status registers per amplifier. It also leaves every source
it does not declare at its reset mask, and several are unmasked out of reset
(IRQ1_MASK_5 0x0EF80000, IRQ1_MASK_7 0xFFFFFF78, IRQ1_MASK_8 0x00003FFF);
regmap-irq never touches those bits.

On the ROG Phone 5 the bottom amplifier (0x31) delivered 11 PLL events and
then stopped: IRQ1_STATUS read 1 with PLL lock and unlock latched and
unmasked (raw I2C reads, bypassing the cache: INTB_GPIO2 0x2434 =
0x00400005, push-pull active-low INT; IRQ1_CFG 0; MASK_3 0xfdff87ed), yet
TLMM gpio2 read high and its count stayed at 11, while the top amplifier
kept counting. From then on no event from that amplifier, errors included,
reached the host.

The vendor ZS673KS driver masks the eight implemented banks first
(MASK_UNUSED_IRQ), clears their latched events, and unmasks only its error
monitors; its PLL monitors are compiled out. Do the same before the INT pad
is configured, skip the PLL children when requesting IRQs (their regmap-irq
masks stay set; the arrays keep their indices), and fail the probe if the
pad selector cannot be written.

--- a/sound/soc/codecs/cs35l45.c	2026-09-30 03:29:50.829867209 +0200
+++ b/sound/soc/codecs/cs35l45.c	2026-09-30 03:33:27.175113629 +0200
@@ -1110,10 +1110,15 @@
 					   val << CS35L45_GPIO_POL_SHIFT);
 
 		ret = of_property_read_u32(child, "gpio-ctrl", &val);
-		if (!ret)
-			regmap_update_bits(cs35l45->regmap, pad_regs[i],
-					   CS35L45_GPIO_CTRL_MASK,
-					   val << CS35L45_GPIO_CTRL_SHIFT);
+		if (!ret) {
+			ret = regmap_update_bits(cs35l45->regmap, pad_regs[i],
+						 CS35L45_GPIO_CTRL_MASK,
+						 val << CS35L45_GPIO_CTRL_SHIFT);
+			if (ret) {
+				of_node_put(child);
+				return ret;
+			}
+		}
 
 		ret = of_property_read_u32(child, "gpio-invert", &val);
 		if (!ret) {
@@ -1270,10 +1275,20 @@
 
 static int cs35l45_initialize(struct cs35l45_private *cs35l45)
 {
+	static const unsigned int irq_regs[][2] = {
+		{ CS35L45_IRQ1_MASK_1, CS35L45_IRQ1_EINT_1 },
+		{ CS35L45_IRQ1_MASK_2, CS35L45_IRQ1_EINT_2 },
+		{ CS35L45_IRQ1_MASK_3, CS35L45_IRQ1_EINT_3 },
+		{ CS35L45_IRQ1_MASK_4, CS35L45_IRQ1_EINT_4 },
+		{ CS35L45_IRQ1_MASK_5, CS35L45_IRQ1_EINT_5 },
+		{ CS35L45_IRQ1_MASK_7, CS35L45_IRQ1_EINT_7 },
+		{ CS35L45_IRQ1_MASK_8, CS35L45_IRQ1_EINT_8 },
+		{ CS35L45_IRQ1_MASK_18, CS35L45_IRQ1_EINT_18 },
+	};
 	struct device *dev = cs35l45->dev;
 	unsigned int dev_id[5];
 	unsigned int sts;
-	int ret;
+	int ret, i;
 
 	ret = regmap_read_poll_timeout(cs35l45->regmap, CS35L45_IRQ1_EINT_4, sts,
 				       (sts & CS35L45_OTP_BOOT_DONE_STS_MASK),
@@ -1310,6 +1325,24 @@
 		return ret;
 	}
 
+	/*
+	 * Mask every source and clear the latched events before the INT pad
+	 * is configured, as the vendor driver does (MASK_UNUSED_IRQ):
+	 * regmap-irq only ever touches the bits of the IRQs it knows, and
+	 * several other sources are unmasked out of reset (IRQ1_MASK_5
+	 * 0x0EF80000, IRQ1_MASK_7 0xFFFFFF78, IRQ1_MASK_8 0x00003FFF).
+	 */
+	if (cs35l45->irq) {
+		for (i = 0; i < ARRAY_SIZE(irq_regs); i++) {
+			ret = regmap_write(cs35l45->regmap, irq_regs[i][0], 0xffffffff);
+			if (!ret)
+				ret = regmap_write(cs35l45->regmap, irq_regs[i][1],
+						   0xffffffff);
+			if (ret)
+				return ret;
+		}
+	}
+
 	ret = cs35l45_apply_property_config(cs35l45);
 	if (ret < 0)
 		return ret;
@@ -1446,6 +1479,15 @@
 		}
 
 		for (i = 0; i < ARRAY_SIZE(cs35l45_irqs); i++) {
+			/*
+			 * PLL lock/unlock only log at debug level but raised INT
+			 * at every stream start and stop; the vendor driver never
+			 * unmasks them. Without a handler they stay masked.
+			 */
+			if (cs35l45_irqs[i].irq == CS35L45_PLL_LOCK_FLAG_IRQ ||
+			    cs35l45_irqs[i].irq == CS35L45_PLL_UNLOCK_FLAG_RISE_IRQ)
+				continue;
+
 			irq = regmap_irq_get_virq(cs35l45->irq_data, cs35l45_irqs[i].irq);
 			if (irq < 0) {
 				dev_err(dev, "Failed to get %s\n", cs35l45_irqs[i].name);
