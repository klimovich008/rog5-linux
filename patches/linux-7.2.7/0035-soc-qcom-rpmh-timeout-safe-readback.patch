 obj-$(CONFIG_QCOM_SMD_RPM)	+= rpm-proc.o smd-rpm.o
 obj-$(CONFIG_QCOM_SMEM) +=	smem.o
 obj-$(CONFIG_QCOM_SMEM_STATE) += smem_state.o
diff --git a/drivers/soc/qcom/rpmh-internal.h b/drivers/soc/qcom/rpmh-internal.h
index e3cf1beff8038827e45334efddceb69a3bf2cf32..9aa85cc586fcfc79469bca4ee52fb0d06a3b4a26 100644
--- a/drivers/soc/qcom/rpmh-internal.h
+++ b/drivers/soc/qcom/rpmh-internal.h
@@ -143,6 +143,7 @@ void rpmh_rsc_invalidate(struct rsc_drv *drv);
 void rpmh_rsc_write_next_wakeup(struct rsc_drv *drv);
 
 void rpmh_tx_done(const struct tcs_request *msg);
+void rpmh_read_tx_done(const struct tcs_request *msg);
 int rpmh_flush(struct rpmh_ctrlr *ctrlr);
 
 #endif /* __RPM_INTERNAL_H__ */
diff --git a/drivers/soc/qcom/rpmh-read.c b/drivers/soc/qcom/rpmh-read.c
new file mode 100644
index 0000000000000000000000000000000000000000..d6b2009156423f3a5de41053b754daa1b428c977
--- /dev/null
+++ b/drivers/soc/qcom/rpmh-read.c
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Readback transport based on the Qualcomm rpmh_read() proposal by
+ * Maulik Shah and Kamal Wadhwa; independently owned timeout lifetime.
+ */
+#include <linux/completion.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/refcount.h>
+#include <linux/slab.h>
+
+#include <soc/qcom/rpmh.h>
+
+#include "rpmh-internal.h"
+
+#define RPMH_READ_TIMEOUT_MS 10000
+
+struct rpmh_read_request {
+	struct rpmh_request request;
+	struct completion done;
+	refcount_t refs;
+};
+
+static void rpmh_read_put(struct rpmh_read_request *read)
+{
+	if (refcount_dec_and_test(&read->refs))
+		kfree(read);
+}
+
+void rpmh_read_tx_done(const struct tcs_request *msg)
+{
+	struct rpmh_request *request;
+	struct rpmh_read_request *read;
+
+	request = container_of(msg, struct rpmh_request, msg);
+	read = container_of(request, struct rpmh_read_request, request);
+	/* The IRQ has copied the response before publishing completion. */
+	complete(&read->done);
+	rpmh_read_put(read);
+}
+
+/**
+ * rpmh_read() - Read one APPS resource vote, without changing vote caches.
+ * @dev: device whose parent is an initialized RPMh RSC controller
+ * @cmd: resource address; data is changed only after a successful response
+ *
+ * This is not a measurement of the aggregate physical regulator state.
+ * A busy/conflicting TCS returns -EAGAIN without queuing anything. After a
+ * queued request times out, the IRQ retains its small allocation until it
+ * completes (or the machine resets). Never reuse/free an in-flight request.
+ * No caller-owned data, completion or module callback is retained by the IRQ.
+ *
+ * Context: may sleep. Must not be called from atomic context.
+ * Return: 0 on success; negative errno on failure, with cmd->data unchanged.
+ */
+int rpmh_read(const struct device *dev, struct tcs_cmd *cmd)
+{
+	struct rpmh_read_request *read;
+	struct rsc_drv *drv;
+	unsigned long completed;
+	int ret;
+
+	if (!dev || !dev->parent || !cmd)
+		return -EINVAL;
+	drv = dev_get_drvdata(dev->parent);
+	if (!drv)
+		return -ENODEV;
+	read = kzalloc(sizeof(*read), GFP_KERNEL);
+	if (!read)
+		return -ENOMEM;
+
+	init_completion(&read->done);
+	refcount_set(&read->refs, 2); /* Caller plus the reserved IRQ reference. */
+	read->request.msg.state = RPMH_ACTIVE_ONLY_STATE;
+	read->request.msg.wait_for_compl = true;
+	read->request.msg.num_cmds = 1;
+	read->request.msg.cmds = read->request.cmd;
+	read->request.msg.is_read = true;
+	read->request.cmd[0].addr = cmd->addr;
+
+	/* Bypass __rpmh_write(): a read must never create or modify wake votes. */
+	ret = rpmh_rsc_send_data(drv, &read->request.msg);
+	if (ret) {
+		/* No request was published, so no IRQ can own this reference. */
+		rpmh_read_put(read);
+		goto put_caller;
+	}
+	completed = wait_for_completion_timeout(&read->done,
+					msecs_to_jiffies(RPMH_READ_TIMEOUT_MS));
+	if (!completed) {
+		ret = -ETIMEDOUT;
+	} else {
+		cmd->data = read->request.cmd[0].data;
+		ret = 0;
+	}
+put_caller:
+	rpmh_read_put(read);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(rpmh_read);
diff --git a/drivers/soc/qcom/rpmh-rsc.c b/drivers/soc/qcom/rpmh-rsc.c
index 66928ca40b9aadc203a797f59fa7e89cc9375107..c95a17624871b74fd6e68a8cb8e2900fb5cd404c 100644
--- a/drivers/soc/qcom/rpmh-rsc.c
+++ b/drivers/soc/qcom/rpmh-rsc.c
@@ -356,8 +356,15 @@ static const struct tcs_request *get_req_from_tcs(struct rsc_drv *drv,
 
 	for (i = 0; i < TCS_TYPE_NR; i++) {
 		tcs = &drv->tcs[i];
-		if (tcs->mask & BIT(tcs_id))
-			return tcs->req[tcs_id - tcs->offset];
+		if (tcs->mask & BIT(tcs_id)) {
+			const struct tcs_request *req;
+
+			req = tcs->req[tcs_id - tcs->offset];
+			/* A late read completion may release the final reference. */
+			if (req && req->is_read)
+				tcs->req[tcs_id - tcs->offset] = NULL;
+			return req;
+		}
 	}
 
 	return NULL;
@@ -451,6 +458,9 @@ static irqreturn_t tcs_tx_done(int irq, void *p)
 		if (WARN_ON(!req))
 			goto skip;
 
+		if (req->is_read)
+			req->cmds[0].data = read_tcs_reg(drv,
+					drv->regs[RSC_DRV_CMD_RESP_DATA], i);
 		trace_rpmh_tx_done(drv, i, req);
 
 		/* Clear AMC trigger & enable modes and
@@ -493,13 +503,15 @@ static void __tcs_buffer_write(struct rsc_drv *drv, int tcs_id, int cmd_id,
 			       const struct tcs_request *msg)
 {
 	u32 msgid;
-	u32 cmd_msgid = CMD_MSGID_LEN | CMD_MSGID_WRITE;
+	u32 cmd_msgid = CMD_MSGID_LEN;
 	u32 cmd_enable = 0;
 	struct tcs_cmd *cmd;
 	int i, j;
 
 	/* Convert all commands to RR when the request has wait_for_compl set */
 	cmd_msgid |= msg->wait_for_compl ? CMD_MSGID_RESP_REQ : 0;
+	if (!msg->is_read)
+		cmd_msgid |= CMD_MSGID_WRITE;
 
 	for (i = 0, j = cmd_id; i < msg->num_cmds; i++, j++) {
 		cmd = &msg->cmds[i];
@@ -513,7 +525,8 @@ static void __tcs_buffer_write(struct rsc_drv *drv, int tcs_id, int cmd_id,
 
 		write_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_MSGID], tcs_id, j, msgid);
 		write_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_ADDR], tcs_id, j, cmd->addr);
-		write_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_DATA], tcs_id, j, cmd->data);
+		if (!msg->is_read)
+			write_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_DATA], tcs_id, j, cmd->data);
 		trace_rpmh_send_msg(drv, tcs_id, msg->state, j, msgid, cmd);
 	}
 
@@ -646,16 +659,34 @@ int rpmh_rsc_send_data(struct rsc_drv *drv, const struct tcs_request *msg)
 
 	might_sleep();
 
+	if (msg->is_read && (msg->state != RPMH_ACTIVE_ONLY_STATE ||
+			    msg->num_cmds != 1 || !msg->wait_for_compl))
+		return -EINVAL;
+	/* Reads do not dirty the vote cache, so they must not displace WAKE
+	 * commands that rpmh_flush() would otherwise have no reason to restore.
+	 */
+	if (msg->is_read && !drv->tcs[ACTIVE_TCS].num_tcs)
+		return -EOPNOTSUPP;
+
 	tcs = get_tcs_for_msg(drv, msg);
 	if (IS_ERR(tcs))
 		return PTR_ERR(tcs);
 
 	spin_lock_irq(&drv->lock);
 
-	/* Wait forever for a free tcs. It better be there eventually! */
-	wait_event_lock_irq(drv->tcs_wait,
-			    (tcs_id = claim_tcs_for_req(drv, tcs, msg)) >= 0,
-			    drv->lock);
+	if (msg->is_read) {
+		/* Diagnostic reads must not inherit the unbounded writer wait. */
+		tcs_id = claim_tcs_for_req(drv, tcs, msg);
+		if (tcs_id < 0) {
+			spin_unlock_irq(&drv->lock);
+			return tcs_id == -EBUSY ? -EAGAIN : tcs_id;
+		}
+	} else {
+		/* Preserve the existing writer slot-wait behavior. */
+		wait_event_lock_irq(drv->tcs_wait,
+				    (tcs_id = claim_tcs_for_req(drv, tcs, msg)) >= 0,
+				    drv->lock);
+	}
 
 	tcs->req[tcs_id - tcs->offset] = msg;
 	set_bit(tcs_id, drv->tcs_in_use);
@@ -742,6 +773,9 @@ int rpmh_rsc_write_ctrl_data(struct rsc_drv *drv, const struct tcs_request *msg)
 	int tcs_id = 0, cmd_id = 0;
 	int ret;
 
+	if (msg->is_read)
+		return -EINVAL;
+
 	tcs = get_tcs_for_msg(drv, msg);
 	if (IS_ERR(tcs))
 		return PTR_ERR(tcs);
diff --git a/drivers/soc/qcom/rpmh.c b/drivers/soc/qcom/rpmh.c
index ca37da3dc2b148c76e50e25885bd85a0cb47c9b6..eecca2d46ed141b76953135885c24d9a8f08e936 100644
--- a/drivers/soc/qcom/rpmh.c
+++ b/drivers/soc/qcom/rpmh.c
@@ -83,6 +83,11 @@ void rpmh_tx_done(const struct tcs_request *msg)
 	struct completion *compl = rpm_msg->completion;
 	bool free = rpm_msg->needs_free;
 
+	if (msg->is_read) {
+		rpmh_read_tx_done(msg);
+		return;
+	}
+
 	if (!compl)
 		goto exit;
 
@@ -204,6 +209,7 @@ static int __fill_rpmh_msg(struct rpmh_request *req, enum rpmh_state state,
 	req->msg.state = state;
 	req->msg.cmds = req->cmd;
 	req->msg.num_cmds = n;
+	req->msg.is_read = false;
 
 	return 0;
 }
diff --git a/include/soc/qcom/rpmh.h b/include/soc/qcom/rpmh.h
index bdbee1a97d3685d8a6153d586ddf650bd3bd3dde..14ecbf242b6bd67c8167c176ed0970f42432f4f4 100644
--- a/include/soc/qcom/rpmh.h
+++ b/include/soc/qcom/rpmh.h
@@ -11,6 +11,8 @@
 
 
 #if IS_ENABLED(CONFIG_QCOM_RPMH)
+int rpmh_read(const struct device *dev, struct tcs_cmd *cmd);
+
 int rpmh_write(const struct device *dev, enum rpmh_state state,
 	       const struct tcs_cmd *cmd, u32 n);
 
@@ -24,6 +26,9 @@ void rpmh_invalidate(const struct device *dev);
 
 #else
 
+static inline int rpmh_read(const struct device *dev, struct tcs_cmd *cmd)
+{ return -ENODEV; }
+
 static inline int rpmh_write(const struct device *dev, enum rpmh_state state,
 			     const struct tcs_cmd *cmd, u32 n)
 { return -ENODEV; }
diff --git a/include/soc/qcom/tcs.h b/include/soc/qcom/tcs.h
index cff67ce25488e2d3603a7707af2ca77f8266a713..89a4a67564f34d1665a55b685ac75e747ce6cea6 100644
--- a/include/soc/qcom/tcs.h
+++ b/include/soc/qcom/tcs.h
@@ -54,12 +54,14 @@ struct tcs_cmd {
  * @wait_for_compl: wait until we get a response from the h/w accelerator
  *                  (same as setting cmd->wait for all commands in the request)
  * @num_cmds:       the number of @cmds in this request
+ * @is_read:        one active-only read request, never a vote update
  * @cmds:           an array of tcs_cmds
  */
 struct tcs_request {
 	enum rpmh_state state;
 	u32 wait_for_compl;
 	u32 num_cmds;
+	bool is_read;
 	struct tcs_cmd *cmds;
 };
 
