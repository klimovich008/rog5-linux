+/* Core calls in sleepable context after halt or complete gadget exit. */
+static void dwc3_qcom_legacy_post_gadget_stop(struct dwc3 *dwc)
+{
+	struct dwc3_qcom *qcom = dev_get_drvdata(dwc->dev->parent);
