From: Claude <noreply@anthropic.com>
Subject: [PATCH] drm/msm: deferred framebuffer release: serialise against vblank off, wait on allocation failure

Follow-up to 0184 (upstream v3 4/8 of "drm/msm: fix SMMU fault dumps"):

1. msm_crtc_queue_fb_unpin() published the work on the per-crtc list,
   dropped the lock and only then called drm_vblank_work_schedule(). A
   commit that switches the crtc off runs msm_crtc_vblank_off() in
   parallel with the previous commit's cleanup_planes (the next commit
   only waits for hw_done), and it could take the work off the list and
   free it in between: drm_vblank_work_schedule() and, on failure, the
   kfree() then hit freed memory (sashiko review of v3 4/8, "[High]
   Concurrent execution of msm_crtc_queue_fb_unpin() and
   msm_crtc_vblank_off() causes a use-after-free"). A work queued after
   the drain but before drm_crtc_vblank_off() was cancelled by it (WARN
   "Cancelling pending vblank works!") and its framebuffer stayed pinned.
   Publish and schedule under the lock, and mark the crtc as going off
   (->off) for the drain and drm_crtc_vblank_off(): a framebuffer retired
   meanwhile is released directly (the interface is already disabled),
   and after drm_crtc_vblank_off() drm_vblank_work_schedule() refuses a
   crtc in modeset, which releases directly too.
2. When the work could not be allocated the framebuffer was released at
   once, i.e. while the crtc may still fetch from it (the unsafe old
   behaviour). Wait (at most 100 ms) for the crtc to pass a vblank first;
   cleanup_fb runs in sleepable context (commit tail, async commit ioctl).
   If the crtc neither passes a vblank nor is known to be off (vblank
   enable failed, or the wait timed out), keep the framebuffer and its pin
   for good instead (logged): a leak, never an unmapped scanout. The same
   fallback covers drm_vblank_work_schedule() failing in drm_vblank_get().
3. Whether to defer was decided from crtc->state->active, but a later
   commit may already have swapped in a state that switches the crtc off
   while the hardware still fetches (GPT-6.1-Sol review). Ask the vblank
   machinery instead, which follows the hardware: drm_vblank_work_schedule()
   returns 0 for a crtc in modeset (never enabled since reset, or past
   drm_crtc_vblank_off(), which runs after the interface is disabled), and
   ->off covers msm_crtc_vblank_off() up to that point.

4. msm's async (legacy cursor) path in msm_atomic_commit_tail() cleans
   its planes up before its deferred flush has run (about 1 ms before the
   next vblank); a flush that misses that vblank latches a frame later
   than the release. A framebuffer retired while its crtc has a flush
   pending (kms->pending_crtc_mask) now waits for that flush:
   msm_kms_fb_unpin_flushed(), called after every completed CTL flush in
   msm_atomic (async and synchronous), counts flushes and notes the vblank
   count, and the unpin work re-arms itself until a vblank has passed
   after the flush (GPT-6.1-Sol review, second round). Phosh/phoc and
   GNOME do not use legacy cursor ioctls, so this path is idle here.

Hardware: Phosh page flips, DPMS off/on and suspend with the panel on,
DP hotplug while scanning out; dmesg must stay free of SMMU context
faults and of "Cancelling pending vblank works".

diff --git a/drivers/gpu/drm/msm/msm_atomic.c b/drivers/gpu/drm/msm/msm_atomic.c
index 7b480981b..6a886684c 100644
--- a/drivers/gpu/drm/msm/msm_atomic.c
+++ b/drivers/gpu/drm/msm/msm_atomic.c
@@ -90,6 +90,7 @@ static void msm_atomic_async_commit(struct msm_kms *kms, int crtc_idx)
 	trace_msm_atomic_wait_flush_start(crtc_mask);
 	kms->funcs->wait_flush(kms, crtc_mask);
 	trace_msm_atomic_wait_flush_finish(crtc_mask);
+	msm_kms_fb_unpin_flushed(kms, crtc_mask);
 
 	vblank_put(kms, crtc_mask);
 
@@ -294,6 +295,7 @@ void msm_atomic_commit_tail(struct drm_atomic_commit *state)
 	trace_msm_atomic_wait_flush_start(crtc_mask);
 	kms->funcs->wait_flush(kms, crtc_mask);
 	trace_msm_atomic_wait_flush_finish(crtc_mask);
+	msm_kms_fb_unpin_flushed(kms, crtc_mask);
 
 	vblank_put(kms, crtc_mask);
 
diff --git a/drivers/gpu/drm/msm/msm_kms.c b/drivers/gpu/drm/msm/msm_kms.c
index bb95e64a5..4c360a6d0 100644
--- a/drivers/gpu/drm/msm/msm_kms.c
+++ b/drivers/gpu/drm/msm/msm_kms.c
@@ -172,7 +172,11 @@ struct msm_fb_unpin_work {
 	struct drm_vblank_work base;
 	struct list_head node;
 	struct msm_kms_fb_unpin *pending;
+	struct drm_crtc *crtc;
 	struct drm_framebuffer *fb;
+	/* retired by an async commit whose flush was still pending */
+	bool await_flush;
+	u32 flush_seq;
 };
 
 static void msm_kms_fb_unpin_release(struct msm_fb_unpin_work *unpin)
@@ -188,18 +192,62 @@ static void msm_kms_fb_unpin_work(struct kthread_work *work)
 		container_of(to_drm_vblank_work(work), struct msm_fb_unpin_work,
 			     base);
 	struct msm_kms_fb_unpin *pending = unpin->pending;
+	u64 count, target = 0;
 
 	spin_lock(&pending->lock);
 	if (list_empty(&unpin->node)) {
 		spin_unlock(&pending->lock);
 		return;
 	}
+
+	/*
+	 * An async commit (msm_atomic_commit_tail()) cleans its planes up
+	 * before its deferred flush has run: the old framebuffer is fetched
+	 * until a vblank after that flush. Look again at the next vblank
+	 * while the flush is outstanding.
+	 */
+	if (unpin->await_flush) {
+		count = drm_crtc_vblank_count(unpin->crtc);
+		if (pending->flush_seq == unpin->flush_seq)
+			target = count + 1;
+		else if (count <= pending->flush_vbl)
+			target = pending->flush_vbl + 1;
+	}
+	/* A crtc in modeset refuses: it does not scan out any more. */
+	if (target && drm_vblank_work_schedule(&unpin->base, target, true) == 1) {
+		spin_unlock(&pending->lock);
+		return;
+	}
+
 	list_del_init(&unpin->node);
 	spin_unlock(&pending->lock);
 
 	msm_kms_fb_unpin_release(unpin);
 }
 
+/*
+ * Called after the CTL flush of @crtc_mask completed (wait_flush): a
+ * framebuffer retired before it is not fetched past the next vblank.
+ */
+void msm_kms_fb_unpin_flushed(struct msm_kms *kms, unsigned int crtc_mask)
+{
+	struct drm_crtc *crtc;
+
+	for_each_crtc_mask(kms->dev, crtc, crtc_mask) {
+		unsigned int idx = drm_crtc_index(crtc);
+		struct msm_kms_fb_unpin *pending;
+
+		if (idx >= ARRAY_SIZE(kms->fb_unpin))
+			continue;
+
+		pending = &kms->fb_unpin[idx];
+		spin_lock(&pending->lock);
+		pending->flush_seq++;
+		pending->flush_vbl = drm_crtc_vblank_count(crtc);
+		spin_unlock(&pending->lock);
+	}
+}
+
 void msm_crtc_vblank_off(struct drm_crtc *crtc)
 {
 	struct msm_drm_private *priv = crtc->dev->dev_private;
@@ -215,8 +263,17 @@ void msm_crtc_vblank_off(struct drm_crtc *crtc)
 
 	/*
 	 * The crtc stops fetching here, and with it the vblanks the pending
-	 * works are waiting for, so release the framebuffers directly.
+	 * works are waiting for, so release the framebuffers directly. A
+	 * commit which retires a framebuffer from this crtc concurrently
+	 * releases it directly as well: until drm_crtc_vblank_off() through
+	 * ->off, afterwards because drm_vblank_work_schedule() refuses to
+	 * schedule on a crtc in modeset. Nothing is left for
+	 * drm_crtc_vblank_off() to cancel behind our back.
 	 */
+	spin_lock(&pending->lock);
+	pending->off = true;
+	spin_unlock(&pending->lock);
+
 	for (;;) {
 		spin_lock(&pending->lock);
 		unpin = list_first_entry_or_null(&pending->fbs, typeof(*unpin),
@@ -232,10 +289,68 @@ void msm_crtc_vblank_off(struct drm_crtc *crtc)
 		msm_kms_fb_unpin_release(unpin);
 	}
 
+	drm_crtc_vblank_off(crtc);
+
+	spin_lock(&pending->lock);
+	pending->off = false;
+	spin_unlock(&pending->lock);
+
+	return;
+
 out:
 	drm_crtc_vblank_off(crtc);
 }
 
+/*
+ * Whether the crtc no longer fetches from what it scanned out before: it has
+ * passed a vblank since, or it is off (vblank in modeset: drm_crtc_vblank_get()
+ * fails with -EINVAL). Bounded wait; a crtc that neither passes a vblank in
+ * 100 ms nor is off gives no answer.
+ */
+static bool msm_crtc_wait_one_vblank(struct drm_crtc *crtc)
+{
+	wait_queue_head_t *queue = drm_crtc_vblank_waitqueue(crtc);
+	long left;
+	u64 count;
+	int ret;
+
+	ret = drm_crtc_vblank_get(crtc);
+	if (ret)
+		return ret == -EINVAL;
+
+	count = drm_crtc_vblank_count(crtc);
+	left = wait_event_timeout(*queue, drm_crtc_vblank_count(crtc) != count,
+				  msecs_to_jiffies(100));
+
+	drm_crtc_vblank_put(crtc);
+
+	return left > 0;
+}
+
+/*
+ * The release could not be deferred to a vblank work. Release now only once
+ * the crtc is known to have stopped fetching from @fb; otherwise keep the
+ * framebuffer and its pin for good (a leak, but never an unmapped scanout).
+ */
+static bool msm_crtc_fb_unpin_fallback(struct drm_crtc *crtc,
+				       struct drm_framebuffer *fb)
+{
+	if (msm_crtc_wait_one_vblank(crtc))
+		return false;
+
+	drm_err_ratelimited(crtc->dev,
+			    "crtc %u: end of scanout of FB %u unknown, keeping it pinned\n",
+			    crtc->base.id, fb->base.id);
+	drm_framebuffer_get(fb);
+
+	return true;
+}
+
+/*
+ * Returns true when the release of @fb is taken care of (deferred to the
+ * next vblank of @crtc, or deliberately kept), false when @fb is to be
+ * released now because @crtc does not scan out.
+ */
 bool msm_crtc_queue_fb_unpin(struct drm_crtc *crtc, struct drm_framebuffer *fb)
 {
 	struct msm_drm_private *priv = crtc->dev->dev_private;
@@ -243,42 +358,61 @@ bool msm_crtc_queue_fb_unpin(struct drm_crtc *crtc, struct drm_framebuffer *fb)
 	unsigned int idx = drm_crtc_index(crtc);
 	struct msm_kms_fb_unpin *pending;
 	struct msm_fb_unpin_work *unpin;
+	int ret = 0;
 
 	if (!kms || idx >= ARRAY_SIZE(kms->fb_unpin))
 		return false;
 
-	if (!crtc->state->active)
-		return false;
-
 	pending = &kms->fb_unpin[idx];
 
 	unpin = kzalloc_obj(*unpin);
 	if (!unpin)
-		return false;
+		return msm_crtc_fb_unpin_fallback(crtc, fb);
 
 	unpin->fb = fb;
+	unpin->crtc = crtc;
 	unpin->pending = pending;
 	drm_framebuffer_get(fb);
 
 	drm_vblank_work_init(&unpin->base, crtc, msm_kms_fb_unpin_work);
 
+	/*
+	 * Publish and schedule under the lock: msm_crtc_vblank_off() must
+	 * not take the work off the list and free it in between.
+	 *
+	 * Whether the crtc still scans out is not read from crtc->state: a
+	 * later commit may already have swapped in a state that switches it
+	 * off while the hardware still fetches. Ask the vblank machinery,
+	 * which follows the hardware: drm_vblank_work_schedule() returns 0
+	 * for a crtc in modeset (never enabled since reset, or past
+	 * drm_crtc_vblank_off(), which runs after the interface is disabled),
+	 * and ->off covers msm_crtc_vblank_off() up to that point.
+	 */
 	spin_lock(&pending->lock);
-	list_add_tail(&unpin->node, &pending->fbs);
-	spin_unlock(&pending->lock);
-
-	if (drm_vblank_work_schedule(&unpin->base,
-				     drm_crtc_vblank_count(crtc) + 1, true) != 1) {
-		spin_lock(&pending->lock);
+	unpin->await_flush = READ_ONCE(kms->pending_crtc_mask) &
+			     drm_crtc_mask(crtc);
+	unpin->flush_seq = pending->flush_seq;
+	if (!pending->off) {
+		list_add_tail(&unpin->node, &pending->fbs);
+		ret = drm_vblank_work_schedule(&unpin->base,
+					       drm_crtc_vblank_count(crtc) + 1,
+					       true);
+		if (ret == 1) {
+			spin_unlock(&pending->lock);
+			return true;
+		}
 		list_del_init(&unpin->node);
-		spin_unlock(&pending->lock);
+	}
+	spin_unlock(&pending->lock);
 
-		drm_framebuffer_put(fb);
-		kfree(unpin);
+	drm_framebuffer_put(fb);
+	kfree(unpin);
 
-		return false;
-	}
+	/* No vblank reference (vblank enable failed) while maybe scanning out */
+	if (ret < 0)
+		return msm_crtc_fb_unpin_fallback(crtc, fb);
 
-	return true;
+	return false;
 }
 
 static int msm_kms_fault_handler(void *arg, unsigned long iova, int flags, void *data)
diff --git a/drivers/gpu/drm/msm/msm_kms.h b/drivers/gpu/drm/msm/msm_kms.h
index 4fcf22020..92adfe19e 100644
--- a/drivers/gpu/drm/msm/msm_kms.h
+++ b/drivers/gpu/drm/msm/msm_kms.h
@@ -136,9 +136,14 @@ struct msm_drm_thread {
 };
 
 struct msm_kms_fb_unpin {
-	/* protects the list of framebuffers waiting for a vblank: */
+	/* protects the list of framebuffers waiting for a vblank, and off: */
 	spinlock_t lock;
 	struct list_head fbs;
+	/* the crtc is being switched off: release retired framebuffers directly */
+	bool off;
+	/* completed CTL flushes, and the vblank count after the last one */
+	u32 flush_seq;
+	u64 flush_vbl;
 };
 
 struct msm_kms {
@@ -181,6 +186,7 @@ struct msm_kms {
 };
 
 bool msm_crtc_queue_fb_unpin(struct drm_crtc *crtc, struct drm_framebuffer *fb);
+void msm_kms_fb_unpin_flushed(struct msm_kms *kms, unsigned int crtc_mask);
 void msm_crtc_vblank_off(struct drm_crtc *crtc);
 
 static inline int msm_kms_init(struct msm_kms *kms,
