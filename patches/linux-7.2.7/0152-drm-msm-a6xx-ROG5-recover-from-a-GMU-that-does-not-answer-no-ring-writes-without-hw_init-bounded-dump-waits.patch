 	if (ret) {
diff --git a/drivers/gpu/drm/msm/msm_gpu.c b/drivers/gpu/drm/msm/msm_gpu.c
index 83888dae7..4112970a3 100644
--- a/drivers/gpu/drm/msm/msm_gpu.c
+++ b/drivers/gpu/drm/msm/msm_gpu.c
@@ -18,6 +18,28 @@
 #include <linux/sched/task.h>
 #include <linux/sched/mm.h>
 #include <linux/utsname.h>
+#include <linux/moduleparam.h>
+
+/*
+ * ROG5: GPU health for user space (rog5-gpu-watchdog), readable without any
+ * lock. gpu_init_failures counts hardware inits in a row that failed (the GMU
+ * did not answer: CP and ring were never set up); a successful init resets
+ * it. gpu_inits_ok and gpu_recoveries count successful inits and started
+ * recoveries since boot, so two samples tell one long incident from two short
+ * ones. gpu_recovering is set while the recover worker runs.
+ */
+static unsigned int rog5_gpu_init_failures;
+module_param_named(gpu_init_failures, rog5_gpu_init_failures, uint, 0444);
+MODULE_PARM_DESC(gpu_init_failures, "ROG5: failed GPU hardware inits in a row (read-only)");
+static unsigned int rog5_gpu_inits_ok;
+module_param_named(gpu_inits_ok, rog5_gpu_inits_ok, uint, 0444);
+MODULE_PARM_DESC(gpu_inits_ok, "ROG5: successful GPU hardware inits since boot (read-only)");
+static unsigned int rog5_gpu_recoveries;
+module_param_named(gpu_recoveries, rog5_gpu_recoveries, uint, 0444);
+MODULE_PARM_DESC(gpu_recoveries, "ROG5: GPU recoveries started since boot (read-only)");
+static bool rog5_gpu_recovering;
+module_param_named(gpu_recovering, rog5_gpu_recovering, bool, 0444);
+MODULE_PARM_DESC(gpu_recovering, "ROG5: a GPU recovery is running (read-only)");
 
 /*
  * Power Management:
@@ -172,6 +194,47 @@ int msm_gpu_hw_init(struct msm_gpu *gpu)
 		gpu->needs_hw_init = false;
 	enable_irq(gpu->irq);
 
+	if (!ret) {
+		WRITE_ONCE(rog5_gpu_inits_ok, rog5_gpu_inits_ok + 1);
+		if (READ_ONCE(rog5_gpu_init_failures)) {
+			DRM_DEV_INFO(gpu->dev->dev, "%s: hardware init succeeded after %u failed\n",
+				     gpu->name, rog5_gpu_init_failures);
+			WRITE_ONCE(rog5_gpu_init_failures, 0);
+		}
+	} else {
+		WRITE_ONCE(rog5_gpu_init_failures, rog5_gpu_init_failures + 1);
+		DRM_DEV_ERROR_RATELIMITED(gpu->dev->dev, "%s: hardware init failed: %d (%u in a row)\n",
+					  gpu->name, ret, rog5_gpu_init_failures);
+	}
+
+	return ret;
+}
+
+/*
+ * ROG5: power the GPU up for register access. A failed runtime resume (the
+ * GMU did not boot; a6xx_gmu_resume() has undone its steps) leaves the device
+ * suspended with power.runtime_error set, and the PM core then fails every
+ * later resume at once with -EINVAL, without calling the driver. Clear the
+ * error (the device is known to be suspended) so that the next attempt boots
+ * the GMU again, and count the failure like a failed hardware init. On
+ * failure no reference is held and the caller must not touch the hardware.
+ */
+int msm_gpu_runtime_get(struct msm_gpu *gpu)
+{
+	struct device *dev = &gpu->pdev->dev;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret >= 0)
+		return 0;
+
+	if (pm_runtime_enabled(dev) && pm_runtime_status_suspended(dev))
+		pm_runtime_set_suspended(dev);
+
+	WRITE_ONCE(rog5_gpu_init_failures, rog5_gpu_init_failures + 1);
+	DRM_DEV_ERROR_RATELIMITED(gpu->dev->dev, "%s: hardware init failed: runtime resume %d (%u in a row)\n",
+				  gpu->name, ret, rog5_gpu_init_failures);
+
 	return ret;
 }
 
@@ -461,6 +524,8 @@ static void get_comm_cmdline(struct msm_gem_submit *submit, char **comm, char **
 	put_task_struct(task);
 }
 
+static void hangcheck_timer_reset(struct msm_gpu *gpu);
+
 static void recover_worker(struct kthread_work *work)
 {
 	struct msm_gpu *gpu = container_of(work, struct msm_gpu, recover_work);
@@ -471,12 +536,29 @@ static void recover_worker(struct kthread_work *work)
 	char *comm = NULL, *cmd = NULL;
 	unsigned int noreclaim_flag;
 	struct task_struct *task;
+	bool resumed = false;
 	int i;
 
 	mutex_lock(&gpu->lock);
+	WRITE_ONCE(rog5_gpu_recovering, true);
+	WRITE_ONCE(rog5_gpu_recoveries, rog5_gpu_recoveries + 1);
 
 	DRM_DEV_ERROR(dev->dev, "%s: hangcheck recover!\n", gpu->name);
 
+	/*
+	 * ROG5: the GPU was never set up since it last resumed (hw_init failed:
+	 * the GMU did not answer), or submits wait unwritten for this replay.
+	 * The first pending submit did not run, so none is to blame or to
+	 * skip: restart the GMU and GPU and replay everything in order.
+	 */
+	if (gpu->needs_hw_init || gpu->deferred_submits) {
+		DRM_DEV_ERROR(dev->dev, "%s: submits not run (GPU init failed): restarting GMU and GPU, no submit blamed\n",
+			      gpu->name);
+		if (msm_gpu_runtime_get(gpu))
+			goto resume_failed;
+		goto recover;
+	}
+
 	submit = find_submit(cur_ring, cur_ring->memptrs->fence + 1);
 
 	/*
@@ -525,9 +607,13 @@ static void recover_worker(struct kthread_work *work)
 		msm_rd_dump_submit(priv->hangrd, submit, NULL);
 	}
 
-	/* Record the crash state */
-	pm_runtime_get_sync(&gpu->pdev->dev);
-	msm_gpu_crashstate_capture(gpu, submit, NULL, comm, cmd);
+	/*
+	 * Record the crash state. ROG5: only from a powered GPU; if it does not
+	 * resume, nothing but the memory-side fence update below is safe.
+	 */
+	resumed = !msm_gpu_runtime_get(gpu);
+	if (resumed)
+		msm_gpu_crashstate_capture(gpu, submit, NULL, comm, cmd);
 
 	memalloc_noreclaim_restore(noreclaim_flag);
 
@@ -554,6 +640,10 @@ static void recover_worker(struct kthread_work *work)
 		msm_update_fence(ring->fctx, fence);
 	}
 
+	if (!resumed)
+		goto resume_failed;
+
+recover:
 	priv->disable_err_irq = false;
 
 	gpu->funcs->recover(gpu);
@@ -561,6 +651,25 @@ static void recover_worker(struct kthread_work *work)
 	/* retire completed submits, plus the one that hung: */
 	retire_submits(gpu);
 
+	/*
+	 * ROG5: the GPU did not come back (hw_init failed again): never write
+	 * the rings of an uninitialised CP. Keep the submits queued, defer
+	 * every later one until they are replayed (a later fence written
+	 * directly would retire them unexecuted) and let the hangcheck timer
+	 * start the next attempt (hangcheck_handler).
+	 */
+	if (gpu->needs_hw_init) {
+		DRM_DEV_ERROR_RATELIMITED(dev->dev, "%s: GPU did not come back, retrying\n",
+					  gpu->name);
+		gpu->deferred_submits = true;
+		for (i = 0; i < gpu->nr_rings; i++)
+			if (fence_after(gpu->rb[i]->fctx->last_fence,
+					gpu->rb[i]->memptrs->fence))
+				hangcheck_timer_reset(gpu);
+		goto put;
+	}
+	gpu->deferred_submits = false;
+
 	/*
 	 * Replay all remaining submits starting with highest priority
 	 * ring
@@ -573,18 +682,46 @@ static void recover_worker(struct kthread_work *work)
 		list_for_each_entry(submit, &ring->submits, node) {
 			/*
 			 * If the submit uses an unusable vm make sure
-			 * we don't actually run it
+			 * we don't actually run it. ROG5: likewise for a
+			 * closed context (msm_job_run() empties those, but a
+			 * deferred submit was never written: keep the rule).
 			 */
-			if (to_msm_vm(submit->vm)->unusable)
+			if (to_msm_vm(submit->vm)->unusable ||
+			    submit->queue->ctx->closed)
 				submit->nr_cmds = 0;
 			gpu->funcs->submit(gpu, submit);
 		}
 		spin_unlock_irqrestore(&ring->submit_lock, flags);
 	}
 
+	/* ROG5: the replayed work needs hangcheck (the failed submit or the
+	 * fault IRQ deleted the timer) */
+	for (i = 0; i < gpu->nr_rings; i++)
+		if (fence_after(gpu->rb[i]->fctx->last_fence,
+				gpu->rb[i]->memptrs->fence))
+			hangcheck_timer_reset(gpu);
+
+put:
 	pm_runtime_put(&gpu->pdev->dev);
+	goto out_unlock;
+
+resume_failed:
+	/*
+	 * ROG5: the GPU did not power up, so neither recovery nor replay may
+	 * touch it. Retire what completed, keep the rest queued and deferred
+	 * (needs_hw_init stays set) and let the hangcheck timer start the next
+	 * attempt, as for a failed hw_init above.
+	 */
+	retire_submits(gpu);
+	for (i = 0; i < gpu->nr_rings; i++)
+		if (fence_after(gpu->rb[i]->fctx->last_fence,
+				gpu->rb[i]->memptrs->fence)) {
+			gpu->deferred_submits = true;
+			hangcheck_timer_reset(gpu);
+		}
 
 out_unlock:
+	WRITE_ONCE(rog5_gpu_recovering, false);
 	mutex_unlock(&gpu->lock);
 
 	msm_gpu_retire(gpu);
@@ -615,10 +752,11 @@ void msm_gpu_fault_crashstate_capture(struct msm_gpu *gpu, struct msm_gpu_fault_
 		submit->fault_dumped = true;
 	}
 
-	/* Record the crash state */
-	pm_runtime_get_sync(&gpu->pdev->dev);
-	msm_gpu_crashstate_capture(gpu, submit, fault_info, comm, cmd);
-	pm_runtime_put_sync(&gpu->pdev->dev);
+	/* Record the crash state (ROG5: only from a powered GPU) */
+	if (!msm_gpu_runtime_get(gpu)) {
+		msm_gpu_crashstate_capture(gpu, submit, fault_info, comm, cmd);
+		pm_runtime_put_sync(&gpu->pdev->dev);
+	}
 
 	memalloc_noreclaim_restore(noreclaim_flag);
 
@@ -658,6 +796,17 @@ static void hangcheck_handler(struct timer_list *t)
 	struct msm_ringbuffer *ring = gpu->funcs->active_ring(gpu);
 	uint32_t fence = ring->memptrs->fence;
 
+	/*
+	 * ROG5: submits wait for a GPU whose hardware init failed (the GMU did
+	 * not answer): no CP runs, so do not read its registers for progress;
+	 * try the recovery again.
+	 */
+	if (READ_ONCE(gpu->deferred_submits) ||
+	    (READ_ONCE(gpu->needs_hw_init) && READ_ONCE(rog5_gpu_init_failures))) {
+		kthread_queue_work(gpu->worker, &gpu->recover_work);
+		return;
+	}
+
 	if (fence != ring->hangcheck_fence) {
 		/* some progress has been made.. ya! */
 		ring->hangcheck_fence = fence;
@@ -794,12 +943,24 @@ void msm_gpu_submit(struct msm_gpu *gpu, struct msm_gem_submit *submit)
 {
 	struct msm_ringbuffer *ring = submit->ring;
 	unsigned long flags;
+	bool hw_ok = false, rpm = false;
 
 	WARN_ON(!mutex_is_locked(&gpu->lock));
 
-	pm_runtime_get_sync(&gpu->pdev->dev);
-
-	msm_gpu_hw_init(gpu);
+	/*
+	 * ROG5: the return value was ignored. After a failed init (the GMU did
+	 * not answer the GPU_SET OOB request) the ring was written anyway and
+	 * the uninitialised CP fetched from iova 0 (2026-10-01 13:32: CP
+	 * translation fault at 0, rptr 0, ib1/ib2 0). Queue the submit but
+	 * leave the rings alone; recovery restarts the GMU and replays it, and
+	 * every later submit waits for that replay to keep the order. A GPU
+	 * that does not even resume must not be touched at all (not even by
+	 * hw_init); while submits are deferred the replay powers it up.
+	 */
+	if (!gpu->deferred_submits) {
+		rpm = !msm_gpu_runtime_get(gpu);
+		hw_ok = rpm && !msm_gpu_hw_init(gpu);
+	}
 
 	submit->seqno = submit->hw_fence->seqno;
 
@@ -822,11 +983,19 @@ void msm_gpu_submit(struct msm_gpu *gpu, struct msm_gem_submit *submit)
 	gpu->active_submits++;
 	mutex_unlock(&gpu->active_lock);
 
-	gpu->funcs->submit(gpu, submit);
-	submit->ring->cur_ctx_seqno = submit->queue->ctx->seqno;
+	if (hw_ok) {
+		gpu->funcs->submit(gpu, submit);
+		submit->ring->cur_ctx_seqno = submit->queue->ctx->seqno;
+	} else {
+		gpu->deferred_submits = true;
+		timer_delete(&gpu->hangcheck_timer);
+		kthread_queue_work(gpu->worker, &gpu->recover_work);
+	}
 
-	pm_runtime_put(&gpu->pdev->dev);
-	hangcheck_timer_reset(gpu);
+	if (rpm)
+		pm_runtime_put(&gpu->pdev->dev);
+	if (hw_ok)
+		hangcheck_timer_reset(gpu);
 }
 
