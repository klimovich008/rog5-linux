diff --git a/drivers/gpu/drm/msm/msm_gpu.h b/drivers/gpu/drm/msm/msm_gpu.h
index 5fa51535a..aab1c4600 100644
--- a/drivers/gpu/drm/msm/msm_gpu.h
+++ b/drivers/gpu/drm/msm/msm_gpu.h
@@ -224,6 +224,14 @@ struct msm_gpu {
 	/* does gpu need hw_init? */
 	bool needs_hw_init;
 
+	/*
+	 * ROG5: submits were queued without being written to a ring (hw_init
+	 * had failed). Later submits must wait for the recovery that replays
+	 * them in order: a later fence written directly would retire them
