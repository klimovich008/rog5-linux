@@ -127,8 +127,25 @@ int iris_hfi_queue_cmd_write_locked(struct iris_core *core, void *pkt, u32 pkt_s
 	}
 
 	if (!iris_hfi_queue_write(q_info, pkt, pkt_size)) {
+		u32 *w = pkt;
+		bool mark = true;
+
 		iris_core_trace(core, 't', pkt);
+		/* ROG5: markers; buffer traffic only at the start of a session */
+		if (w[1] == 0x10007)		/* SYS_SESSION_INIT */
+			core->mark_budget = 6;
+		if (w[1] == 0x211004 || w[1] == 0x211005) {	/* ETB, FTB */
+			mark = core->mark_budget > 0;
+			if (mark)
+				core->mark_budget--;
+		}
+		if (mark)
+			iris_mark(core, "tx %#x size %u w2 %#x w3 %#x w4 %#x", w[1], w[0],
+				  pkt_size > 8 ? w[2] : 0, pkt_size > 12 ? w[3] : 0,
+				  pkt_size > 16 ? w[4] : 0);
 		iris_vpu_raise_interrupt(core);
+		if (mark)
+			iris_mark(core, "tx %#x raised", w[1]);
 	} else {
 		dev_err(core->dev, "queue full\n");
 		return -ENODATA;
@@ -317,6 +334,18 @@ int iris_hfi_queues_init(struct iris_core *core)
 		return -ENOMEM;
 	}
 
+	/* ROG5: the queues and the SFR must lie in the non-secure IOVA window */
+	if (!iris_dma_range_ok(core, core->iface_q_table_daddr, queue_size, "HFI queues") ||
+	    !iris_dma_range_ok(core, core->sfr_daddr, SFR_SIZE, "SFR")) {
+		dma_free_attrs(core->dev, SFR_SIZE, core->sfr_vaddr,
