diff --git a/drivers/media/platform/qcom/iris/iris_core.h b/drivers/media/platform/qcom/iris/iris_core.h
index d3bf6f1..cdaeecc 100644
--- a/drivers/media/platform/qcom/iris/iris_core.h
+++ b/drivers/media/platform/qcom/iris/iris_core.h
@@ -27,10 +27,25 @@ struct icc_info {
 
 /* ROG5: bounded HFI packet trace and firmware log, dumped on fatal errors */
 #define IRIS_TRACE_ENTRIES		64
-#define IRIS_TRACE_WORDS		14
+#define IRIS_TRACE_WORDS		16
 #define IRIS_FW_LOG_LINES		16
 #define IRIS_FW_LOG_LEN			160
 
+/*
+ * ROG5: markers (module parameter "markers"): one warning-level line before
+ * and after each step that can stop the SoC (runtime PM, core init, every
+ * command except routine buffer traffic, the first buffers of a session).
+ * Printed synchronously to the consoles, so netconsole (CONFIG_NETCONSOLE,
+ * loaded by hand) delivers them to another machine before a hard hang;
+ * the in-memory trace dies with the SoC.
+ */
+extern bool iris_markers;
+#define iris_mark(core, fmt, ...)						\
+	do {								\
+		if (READ_ONCE(iris_markers))				\
+			dev_warn((core)->dev, "mark: " fmt "\n", ##__VA_ARGS__); \
+	} while (0)
+
 struct iris_trace_entry {
 	u64	ns;
 	u32	dir;		/* 't' sent, 'r' received */
@@ -106,6 +121,7 @@ struct qcom_ubwc_cfg_data;
  * @removing: iris_remove() started: no new containment work (ROG5)
  * @enc_enabled: the encoder node is registered (ROG5)
  * @dec_fmts_size: number of advertised decoder (OUTPUT) formats (ROG5)
+ * @mark_budget: buffer packets still marked after the last SESSION_INIT (ROG5)
  */
 
 struct iris_core {
@@ -165,6 +181,7 @@ struct iris_core {
 	bool					removing;
 	bool					enc_enabled;
 	u32					dec_fmts_size;
+	u32					mark_budget;
 };
 
 int iris_core_init(struct iris_core *core);
diff --git a/drivers/media/platform/qcom/iris/iris_ctrls.c b/drivers/media/platform/qcom/iris/iris_ctrls.c
index 391e1fc..344e802 100644
--- a/drivers/media/platform/qcom/iris/iris_ctrls.c
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.c
@@ -1493,8 +1493,23 @@ int iris_set_properties(struct iris_inst *inst, u32 plane)
 		if (!iris_valid_cap_id(cap->cap_id))
 			continue;
 
-		if (cap->cap_id && cap->set)
-			cap->set(inst, i);
+		if (cap->cap_id && cap->set) {
+			ret = cap->set(inst, i);
+			/*
+			 * ROG5: -EINVAL is how setters say "not applicable now"
+			 * (e.g. bitrate before streaming); anything else (failed
+			 * or refused command, full queue, failed resume, dead
+			 * firmware, allocation) fails the stream-on.
+			 */
+			if (ret && ret != -EINVAL) {
+				dev_err(inst->core->dev, "session %#x: property %u failed: %d\n",
+					inst->session_id, cap->cap_id, ret);
+				return ret;
+			}
+			if (ret)
+				dev_dbg(inst->core->dev, "session %#x: property %u not set: %d\n",
+					inst->session_id, cap->cap_id, ret);
+		}
 	}
 
 	return 0;
