+/*
+ * ROG5: every buffer the firmware sees must lie in the non-secure IOVA window
+ * [cp_size, dma_mask + 1): below cp_size are the content-protection ranges
+ * handed to TrustZone (DMA there faults and can reboot the SoC), above the
+ * mask the firmware cannot address.
+ */
+/* ROG5: the experimental SM8350 encoder starts only with both ports streaming */
+bool iris_enc_start_gated(struct iris_inst *inst)
+{
+	const struct iris_oem_quirks *oem = inst->core->iris_platform_data->oem;
+
+	return inst->domain == ENCODER && oem && oem->encoder_experimental;
+}
+
+bool iris_dma_range_ok(struct iris_core *core, u64 daddr, u64 size, const char *what)
+{
+	const struct iris_platform_data *pd = core->iris_platform_data;
+	u64 lo = pd->tz_cp_config_data_size ? pd->tz_cp_config_data[0].cp_size : 0;
+	u64 hi = pd->dma_mask + 1;
+
+	if (size && daddr >= lo && size <= hi && daddr <= hi - size)
+		return true;
+
+	dev_err_ratelimited(core->dev, "%s at %#llx + %#llx is outside [%#llx, %#llx); not sent\n",
+			    what, daddr, size, lo, hi);
+	return false;
+}
+
