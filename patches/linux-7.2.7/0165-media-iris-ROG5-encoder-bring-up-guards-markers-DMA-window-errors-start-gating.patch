 	iris_hfi_gen1_packet_session_cmd(inst, &packet, HFI_CMD_SESSION_LOAD_RESOURCES);
@@ -431,12 +464,23 @@ static int iris_hfi_gen1_session_stop(struct iris_inst *inst, u32 plane)
