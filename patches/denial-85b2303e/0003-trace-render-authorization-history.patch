+// Bound diagnostic work even if a client repeatedly requests an unauthorized target.
+fn next_authorization_trace_sequence(counter: &std::sync::atomic::AtomicUsize) -> Option<usize> {
+    counter
+        .fetch_update(std::sync::atomic::Ordering::Relaxed, std::sync::atomic::Ordering::Relaxed, |value| {
+            (value < 512).then(|| value + 1)
+        })
+        .ok()
+}
+
+fn trace_render_authorization(
+    event: &'static str,
+    pool: &OutputBufferPool,
+    authorization: Option<AuthorizedOutputRequest>,
+    now: Instant,
+) {
+    if !render_audit_enabled() {
+        return;
+    }
+    static SEQUENCE: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+    let Some(sequence) = next_authorization_trace_sequence(&SEQUENCE) else {
+        return;
+    };
+    let serial = authorization.map(|a| a.request.dirty_serial);
+    let age_us = authorization.map(|a| now.saturating_duration_since(a.authorized_at).as_micros());
+    let slots = pool.slots.iter().map(|slot| {
+        (slot.framebuffer, slot.state, slot.output_refs, slot.request.map(|request| request.dirty_serial))
+    }).collect::<Vec<_>>();
+    info!(sequence, event, view = pool.render_view_id.get(), ?serial, ?age_us, ?slots,
+        final_record = sequence == 511, "bounded render authorization trace");
 }
 
