+import 'package:denial_dart_shell/src/widgets/icon_stage_diagnostics.dart';
+import 'package:test/test.dart';
+
+void main() {
+  test('duplicate stages cannot exhaust the total record budget', () {
+    final records = <String>[];
+    final diagnostics = IconStageDiagnostics(sink: records.add);
+    for (var i = 0; i < 100; i += 1) {
+      diagnostics.record('svg.placeholder', path: '/icons/app.svg');
+    }
+    diagnostics.record('svg.error', path: '/icons/app.svg');
+
+    expect(records, hasLength(3));
+    expect(records.last, contains('seq=3 stage=svg.error'));
+  });
+
+  test('distinct paths and stages still obey the hard record cap', () {
+    final records = <String>[];
+    final diagnostics = IconStageDiagnostics(sink: records.add);
+    for (var i = 0; i < 1000; i += 1) {
+      diagnostics.record('select.svg', path: '/icons/$i.svg');
+    }
+
+    expect(records, hasLength(IconStageDiagnostics.maxRecords));
+    expect(records.last, contains('seq=48 '));
+  });
+
+  test('path identifiers are stable, bounded and distinguish directories', () {
+    const path = '/private/account/icons/app\n name.svg';
+    final identifier = IconStageDiagnostics.pathId(path);
+
+    expect(identifier, IconStageDiagnostics.pathId(path));
+    expect(identifier, startsWith('app__name.svg@'));
+    expect(identifier, isNot(contains('/private')));
+    expect(identifier, isNot(contains('\n')));
+    expect(
+      identifier,
+      isNot(IconStageDiagnostics.pathId('/other/icons/app\n name.svg')),
+    );
+    expect(
+      IconStageDiagnostics.pathId('/icons/${'a' * 200}.svg').length,
+      lessThanOrEqualTo(49),
+    );
+  });
+
+  test('errors report type without messages or full paths', () {
+    final records = <String>[];
+    final diagnostics = IconStageDiagnostics(sink: records.add);
+    diagnostics.record(
+      'svg.file.error',
+      path: '/private/account/app.svg',
+      error: StateError('SECRET file contents\nextra forged record'),
+    );
+
+    expect(records.single, contains('error=StateError'));
+    expect(records.single, isNot(contains('SECRET')));
+    expect(records.single, isNot(contains('/private/account')));
+    expect(records.single, isNot(contains('\n')));
+  });
+}
