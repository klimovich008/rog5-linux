+/// Temporary bounded observations for the home icon investigation.
+///
+/// Each isolate has its own instance and limit. Records contain a basename and
+/// deterministic path fingerprint, never a full path or exception message.
+class IconStageDiagnostics {
+  IconStageDiagnostics({void Function(String)? sink}) : _sink = sink ?? print;
+
+  static const int maxRecords = 48;
+  static const int maxPerStageAndSource = 2;
+
+  final void Function(String) _sink;
+  final Map<String, int> _counts = <String, int>{};
+  int _sequence = 0;
+
+  void record(
+    String stage, {
+    String? path,
+    Object? loader,
+    Object? error,
+    int? bytes,
+    bool? synchronous,
+  }) {
+    if (_sequence >= maxRecords) {
+      return;
+    }
+    final source = path == null ? 'none' : pathId(path);
+    final safeStage = _token(stage, 40);
+    final key = '$safeStage:$source';
+    final count = _counts[key] ?? 0;
+    if (count >= maxPerStageAndSource) {
+      return;
+    }
+    _counts[key] = count + 1;
+    _sequence += 1;
+    _sink(
+      'ROG5_ICON_STAGE source=shell seq=$_sequence stage=$safeStage '
+      'path=$source'
+      '${loader == null ? '' : ' loader=${_token(loader.runtimeType.toString(), 48)}#${loader.hashCode}'}'
+      '${error == null ? '' : ' error=${_token(error.runtimeType.toString(), 48)}'}'
+      '${bytes == null ? '' : ' bytes=$bytes'}'
+      '${synchronous == null ? '' : ' synchronous=$synchronous'}',
+    );
+  }
+
+  static String pathId(String path) {
+    var hash = 0x811c9dc5;
+    for (final unit in path.codeUnits) {
+      hash = ((hash ^ unit) * 0x01000193) & 0xffffffff;
+    }
+    final basename = path.substring(path.lastIndexOf('/') + 1);
+    return '${_token(basename, 40)}@${hash.toRadixString(16).padLeft(8, '0')}';
+  }
+
+  static String _token(String value, int limit) {
+    final clipped = value.length > limit ? value.substring(0, limit) : value;
+    return clipped.replaceAll(RegExp(r'[^a-zA-Z0-9_.-]'), '_');
+  }
+}
+
+final iconStageDiagnostics = IconStageDiagnostics();
