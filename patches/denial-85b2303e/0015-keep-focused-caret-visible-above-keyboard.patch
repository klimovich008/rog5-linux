+import 'package:flutter/widgets.dart';
+
+import 'denial_window.dart';
+
+/// Native committed caret, normalized to its owning window's content origin.
+/// A zero-width insertion caret is valid; absence is represented by null.
+class DenialTextInputCaret {
+  const DenialTextInputCaret({
+    required this.windowId,
+    required this.surfaceId,
+    required this.rect,
+  });
+
+  final int windowId;
+  final int surfaceId;
+  final Rect rect;
+
+  bool get isValid =>
+      windowId > 0 && surfaceId > 0 &&
+      rect.left.isFinite && rect.top.isFinite &&
+      rect.width.isFinite && rect.height.isFinite &&
+      rect.width >= 0.0 && rect.height > 0.0;
+
+  bool belongsTo(DenialWindow? window) =>
+      isValid && window != null && window.objectId == windowId &&
+      (window.surfaceId == surfaceId ||
+          window.visibleSurfaceIds.contains(surfaceId));
+}
