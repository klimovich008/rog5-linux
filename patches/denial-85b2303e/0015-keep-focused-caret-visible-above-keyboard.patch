+import 'package:flutter/widgets.dart';
+
+import '../models/denial_text_input_caret.dart';
+import '../models/denial_window.dart';
+import 'input_layout.dart';
+
+/// Positive upward displacement shared by painting and native hit testing.
+/// Caret coordinates are already normalized; contentX/contentY are not removed
+/// again. A manual override is explicit and survives caret motion until reset.
+double keyboardViewportOffset({
+  required Size viewSize,
+  required double progress,
+  required double manualScroll,
+  required bool manualOverride,
+  DenialTextInputCaret? caret,
+  DenialWindow? window,
+}) {
+  if (!viewSize.width.isFinite || !viewSize.height.isFinite ||
+      viewSize.width <= 0.0 || viewSize.height <= 0.0 ||
+      !progress.isFinite) {
+    return 0.0;
+  }
+  final height = ShellMetrics.edgePanelHeight(viewSize) *
+      progress.clamp(0.0, 1.0).toDouble();
+  if (height <= 0.0) {
+    return 0.0;
+  }
+  final scroll = manualScroll.isFinite ? manualScroll : 0.0;
+  final fallback = (height - scroll).clamp(0.0, height).toDouble();
+  if (manualOverride || caret == null || !caret.belongsTo(window)) {
+    return fallback;
+  }
+  final source = window!.contentCoordinateRect;
+  final top = window.isUserApp ? ShellMetrics.appStatusBarHeight : 0.0;
+  final contentHeight = viewSize.height - top;
+  if (!source.width.isFinite || !source.height.isFinite ||
+      source.width <= 0.0 || source.height <= 0.0 || contentHeight <= 0.0) {
+    return fallback;
+  }
+  final scaleY = contentHeight / source.height;
+  final caretTop = top + caret.rect.top * scaleY;
+  final caretBottom = top + caret.rect.bottom * scaleY;
+  if (!caretTop.isFinite || !caretBottom.isFinite) {
+    return fallback;
+  }
+  const margin = 8.0;
+  final needed = (caretBottom + margin - (viewSize.height - height))
+      .clamp(0.0, height).toDouble();
+  // If an oversized/offscreen rectangle cannot fit, preserve its upper edge
+  // rather than translating it underneath the fixed status/header area.
+  final upperLimit = (caretTop - top - margin)
+      .clamp(0.0, height).toDouble();
+  return needed.clamp(0.0, upperLimit).toDouble();
+}
