+  void _sendWire(Uint8List bytes, {int? focusWindowId}) {
+    if (focusWindowId != null) {
+      traceFocus(FocusTraceStage.send, windowId: focusWindowId);
+    }
+    final response = ServicesBinding.instance.defaultBinaryMessenger
+        .send(wire.denialWireToNativeChannel, ByteData.sublistView(bytes));
+    if (focusWindowId == null) {
+      response?.catchError((Object _) => null);
+      return;
+    }
+    if (response == null) {
+      traceFocus(FocusTraceStage.noReply, windowId: focusWindowId);
+      return;
+    }
+    response.then((reply) {
+          if (focusWindowId != null) {
+            traceFocus(FocusTraceStage.reply, windowId: focusWindowId);
+          }
+          return reply;
+        }).catchError((Object error) {
+          if (focusWindowId != null) {
+            traceFocus(FocusTraceStage.error, windowId: focusWindowId,
+                status: error.runtimeType.toString());
+          }
+          return null;
+        });
