diff --git a/dart_shell/lib/src/platform/focus_trace.dart b/dart_shell/lib/src/platform/focus_trace.dart
new file mode 100644
--- /dev/null
+++ b/dart_shell/lib/src/platform/focus_trace.dart
@@ -0,0 +1,35 @@
+import 'dart:convert';
+import 'dart:io';
+
+// Diagnostic only: bounded, default-off, and no titles or message payloads.
+final bool _focusTraceEnabled = Platform.environment['DENIA_FOCUS_TRACE'] == '1';
+int _focusTraceCount = 0;
+final Stopwatch _focusTraceClock = Stopwatch()..start();
+
+enum FocusTraceStage {
+  animateStart, animationStatus, interrupted, dispose,
+  commit, noTarget, send, reply, noReply, error, invalidTarget,
+}
+
+void traceFocus(
+  FocusTraceStage stage, {
+  int? windowId,
+  int? objectId,
+  int? direction,
+  String? status,
+}) {
+  if (!_focusTraceEnabled || _focusTraceCount >= 64) {
+    return;
+  }
+  final boundedStatus = status == null || status.length <= 48
+      ? status : status.substring(0, 48);
+  print('FOCUS_TRACE dart ${jsonEncode({
+    'sequence': ++_focusTraceCount,
+    'elapsed_us': _focusTraceClock.elapsedMicroseconds,
+    'stage': stage.name,
+    if (windowId != null) 'window_id': windowId,
+    if (objectId != null) 'object_id': objectId,
+    if (direction != null) 'direction': direction,
+    if (boundedStatus != null) 'status': boundedStatus,
+  })}');
+}
