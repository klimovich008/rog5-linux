+// Read snapshots outside set_focus/grab callbacks so the keyboard lock is not held.
+#[cfg(feature = "flutter")]
+fn trace_keyboard_focus(
+    state: &RuntimeState,
+    stage: &'static str,
+    window_id: u64,
+    activated: Option<bool>,
+) {
+    if !crate::focus_trace::enabled() {
+        return;
+    }
+    let frontend = state.wayland.as_ref().expect("missing Wayland frontend");
+    let keyboard = frontend.seat.get_keyboard().expect("seat has no keyboard");
+    let effective_window_id = keyboard.current_focus().and_then(|focus| {
+        let surface = focus.wl_surface()?;
+        let root = frontend.owning_toplevel_surface(&surface)?;
+        frontend.surface_id(&root)
+    });
+    crate::focus_trace::log(
+        stage, window_id, effective_window_id, Some(keyboard.is_grabbed()), activated,
+    );
+}
+
