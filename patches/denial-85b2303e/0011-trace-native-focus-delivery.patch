diff --git a/compositor/src/bin/deniald/focus_trace.rs b/compositor/src/bin/deniald/focus_trace.rs
new file mode 100644
index 0000000..ce135b2
--- /dev/null
+++ b/compositor/src/bin/deniald/focus_trace.rs
@@ -0,0 +1,52 @@
+//! Opt-in, process-bounded native focus diagnostics. IDs are protocol IDs only.
+use std::sync::{OnceLock, atomic::{AtomicUsize, Ordering}};
+
+const MAX_EVENTS: usize = 64;
+
+pub(super) struct FocusTrace {
+    enabled: bool,
+    emitted: AtomicUsize,
+}
+
+#[derive(Debug, PartialEq)]
+pub(super) struct Event {
+    pub sequence: usize,
+    pub stage: &'static str,
+    pub window_id: u64,
+    pub effective_window_id: Option<u64>,
+    pub grabbed: Option<bool>,
+    pub activated: Option<bool>,
+}
+
+impl FocusTrace {
+    fn new(value: Option<&str>) -> Self {
+        Self { enabled: value == Some("1"), emitted: AtomicUsize::new(0) }
+    }
+
+    fn emit_with(&self, stage: &'static str, window_id: u64,
+        effective_window_id: Option<u64>, grabbed: Option<bool>, activated: Option<bool>,
+        sink: impl FnOnce(Event)) {
+        if !self.enabled { return; }
+        let Ok(sequence) = self.emitted.fetch_update(Ordering::Relaxed, Ordering::Relaxed,
+            |count| (count < MAX_EVENTS).then_some(count + 1)) else { return; };
+        sink(Event { sequence: sequence + 1, stage, window_id, effective_window_id, grabbed, activated });
+    }
+}
+
+fn process_trace() -> &'static FocusTrace {
+    static TRACE: OnceLock<FocusTrace> = OnceLock::new();
+    TRACE.get_or_init(|| FocusTrace::new(std::env::var("DENIA_FOCUS_TRACE").ok().as_deref()))
+}
+
+pub(super) fn enabled() -> bool { process_trace().enabled }
+
+// The dependency-free policy above is compiled verbatim by the host regression.
+pub(super) fn log(stage: &'static str, window_id: u64, effective_window_id: Option<u64>,
+    grabbed: Option<bool>, activated: Option<bool>) {
+    process_trace().emit_with(stage, window_id, effective_window_id, grabbed, activated, |event| {
+        tracing::info!(focus_trace = true, sequence = event.sequence, stage = event.stage,
+            window_id = event.window_id, effective_window_id = ?event.effective_window_id,
+            grabbed = ?event.grabbed, activated = ?event.activated,
+            "native focus delivery");
+    });
+}
