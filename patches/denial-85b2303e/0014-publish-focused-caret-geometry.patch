+#[cfg(test)]
+mod caret_wire_tests {
+    use super::*;
+
+    #[test]
+    fn zero_width_caret_and_ownership_round_trip() {
+        let mut builder = FlatBufferBuilder::new();
+        encode_text_input_state(&mut builder, 1, true, true, false, 0, 0, 77,
+            Some(crate::wayland_frontend::TextInputCaret {
+                window_id: 11, surface_id: 12, x: -5, y: 900, width: 0, height: 20,
+            })).unwrap();
+        let envelope = fb::root_as_envelope(builder.finished_data()).unwrap();
+        let state = envelope.payload_as_text_input_state().unwrap();
+        assert_eq!(state.activation_serial(), 77);
+        let caret = state.caret().unwrap();
+        assert_eq!((caret.window_id(), caret.surface_id()), (11, 12));
+        assert_eq!((caret.x(), caret.y(), caret.width(), caret.height()), (-5, 900, 0, 20));
+    }
+
+    #[test]
+    fn no_caret_remains_absent_on_wire() {
+        let mut builder = FlatBufferBuilder::new();
+        encode_text_input_state(&mut builder, 1, true, true, false, 0, 0, 78, None).unwrap();
+        let envelope = fb::root_as_envelope(builder.finished_data()).unwrap();
+        let state = envelope.payload_as_text_input_state().unwrap();
+        assert_eq!(state.activation_serial(), 78);
+        assert!(state.caret().is_none());
+    }
+}
