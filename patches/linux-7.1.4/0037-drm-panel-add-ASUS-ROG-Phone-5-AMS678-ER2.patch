index 000000000..7445e270b
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/asus,rog5-ams678.yaml
@@ -0,0 +1,73 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/asus,rog5-ams678.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: ASUS ROG Phone 5 Samsung AMS678 ER2 OLED panel
+
+maintainers:
+  - ROG5 Linux contributors <klimovich008@gmail.com>
+
+description: |
+  The Samsung AMS678 ER2 is a 1080x2448 command-mode MIPI-DSI OLED panel
+  connected through a Pixelworks Iris6 processor. This binding requires the
+  Iris6 one-wire analog-bypass and ready GPIOs so the panel driver can prove a
+  transparent path before transmitting panel commands.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: asus,rog5-ams678-er2
+
+  reg:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+
+  iris-wakeup-gpios:
+    maxItems: 1
+    description: Pixelworks Iris6 one-wire command input.
+
+  iris-bypass-ready-gpios:
+    maxItems: 1
+    description: High when Pixelworks Iris6 analog bypass is active.
+
+  vddio-supply:
+    description: 1.8 V panel I/O supply.
+
+  vdd-supply:
+    description: 3.0 V panel core supply.
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - iris-wakeup-gpios
+  - iris-bypass-ready-gpios
+  - vddio-supply
+  - vdd-supply
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "asus,rog5-ams678-er2";
+            reg = <0>;
+            reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+            iris-wakeup-gpios = <&tlmm 92 GPIO_ACTIVE_HIGH>;
+            iris-bypass-ready-gpios = <&tlmm 84 GPIO_ACTIVE_HIGH>;
+            vddio-supply = <&vreg_l12c_1p8>;
+            vdd-supply = <&vreg_l13c_3p0>;
+        };
+    };
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index d592f4f4b..6b3cb78ee 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -37,6 +37,18 @@ config DRM_PANEL_ASUS_Z00T_TM5P5_NT35596
 	  NT35596 1080x1920 video mode panel as found in some Asus
 	  Zenfone 2 Laser Z00T devices.
 
+config DRM_PANEL_ASUS_ROG5_AMS678
+	tristate "ASUS ROG Phone 5 Samsung AMS678 ER2 panel"
+	depends on GPIOLIB && OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DSC_HELPER
+	help
+	  Say Y here to enable the 1080x2448 command-mode DSC OLED panel
+	  found in the ASUS ROG Phone 5. The initial implementation exposes
+	  only 60 Hz and requires the Pixelworks Iris6 processor to enter
+	  verified analog-bypass mode before panel commands are sent.
+
 config DRM_PANEL_AUO_A030JTN01
 	tristate "AUO A030JTN01"
 	depends on SPI
