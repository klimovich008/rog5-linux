From c732b0b41d8d5fd2f4ccd76e1f4dbff8ff06c087 Mon Sep 17 00:00:00 2001
From: ROG5 Linux Project <rog5-linux@localhost>
Date: Thu, 13 Aug 2026 05:16:35 +0200
Subject: [PATCH] phy: qcom: qmp-ufs: cross third clock with runtime-PM fix

Generation 43 proved that the first two fixed-rate symbol-clock registrations
preserve target USB/NCM with the generic CCF runtime-PM correction. Advance the
SM8350 RAM-only discriminator through exactly the third fixed-rate clock,
`tx_symbol_0`, then return before OF provider publication.

The UFS core and host remain absent, so this diagnostic cannot enumerate or
access storage.

Signed-off-by: ROG5 Linux Project <rog5-linux@localhost>
---
 drivers/phy/qualcomm/phy-qcom-qmp-ufs.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c b/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
index d781ed6b9..52031e4f5 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
@@ -2102,10 +2102,6 @@ static int qmp_ufs_register_clocks(struct qmp_ufs *qmp, struct device_node *np)
 
 	clk_data->hws[1] = hw;
 
-	if (of_device_is_compatible(qmp->dev->of_node,
-				    "qcom,sm8350-qmp-ufs-phy"))
-		return 0;
-
 	snprintf(name, sizeof(name), "%s::tx_symbol_0", dev_name(qmp->dev));
 	hw = devm_clk_hw_register_fixed_rate(qmp->dev, name, NULL, 0, 0);
 	if (IS_ERR(hw))
@@ -2113,6 +2109,10 @@ static int qmp_ufs_register_clocks(struct qmp_ufs *qmp, struct device_node *np)
 
 	clk_data->hws[2] = hw;
 
+	if (of_device_is_compatible(qmp->dev->of_node,
+				    "qcom,sm8350-qmp-ufs-phy"))
+		return 0;
+
 	ret = of_clk_add_hw_provider(np, of_clk_hw_onecell_get, clk_data);
 	if (ret)
 		return ret;
@@ -2244,7 +2244,7 @@ static int qmp_ufs_probe(struct platform_device *pdev)
 	if (of_device_is_compatible(dev->of_node,
 				    "qcom,sm8350-qmp-ufs-phy")) {
 		dev_notice(dev,
-			   "ROG5 QMP-UFS diagnostic: second clock with runtime-PM stage complete\n");
+			   "ROG5 QMP-UFS diagnostic: third clock with runtime-PM stage complete\n");
 		of_node_put(np);
 		return 0;
 	}
-- 
2.50.1

