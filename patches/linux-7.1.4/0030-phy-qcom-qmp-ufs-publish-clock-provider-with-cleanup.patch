From 07858678c59cc4acdb4e2949100225b2320997b9 Mon Sep 17 00:00:00 2001
From: ROG5 Linux Project <rog5-linux@localhost>
Date: Thu, 13 Aug 2026 11:07:16 +0200
Subject: [PATCH] phy: qcom: qmp-ufs: publish clocks with cleanup

Generation 44 proved that all three fixed-rate symbol-clock registrations
preserve target USB/NCM with the generic CCF runtime-PM correction. Advance
the SM8350 RAM-only discriminator through OF clock-provider publication and
its paired devm cleanup registration, then return before PHY creation.

Keeping publication and cleanup in one step avoids leaving a registered OF
provider without a module-lifetime release action. The UFS core and host
remain absent, so this diagnostic cannot enumerate or access storage.

Signed-off-by: ROG5 Linux Project <rog5-linux@localhost>
---
 drivers/phy/qualcomm/phy-qcom-qmp-ufs.c | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c b/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
index 52031e4f5..32357eaf3 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
@@ -2109,10 +2109,6 @@ static int qmp_ufs_register_clocks(struct qmp_ufs *qmp, struct device_node *np)
 
 	clk_data->hws[2] = hw;
 
-	if (of_device_is_compatible(qmp->dev->of_node,
-				    "qcom,sm8350-qmp-ufs-phy"))
-		return 0;
-
 	ret = of_clk_add_hw_provider(np, of_clk_hw_onecell_get, clk_data);
 	if (ret)
 		return ret;
@@ -2244,7 +2240,7 @@ static int qmp_ufs_probe(struct platform_device *pdev)
 	if (of_device_is_compatible(dev->of_node,
 				    "qcom,sm8350-qmp-ufs-phy")) {
 		dev_notice(dev,
-			   "ROG5 QMP-UFS diagnostic: third clock with runtime-PM stage complete\n");
+			   "ROG5 QMP-UFS diagnostic: OF clock provider with cleanup stage complete\n");
 		of_node_put(np);
 		return 0;
 	}
-- 
2.50.1

