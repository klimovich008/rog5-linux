+static void qcom_battmgr_asus_callback(const void *data, size_t len, void *priv)
+{
+	const struct qcom_battmgr_asus_cell_voltage_response *resp = data;
+	struct qcom_battmgr *battmgr = priv;
+
+	if (len != sizeof(*resp)) {
+		battmgr->oem_error = -EMSGSIZE;
+		goto out_complete;
+	}
+
+	if (le32_to_cpu(resp->hdr.owner) != PMIC_GLINK_OWNER_ASUS_ROG5 ||
+	    le32_to_cpu(resp->hdr.type) != PMIC_GLINK_REQ_RESP ||
+	    le32_to_cpu(resp->hdr.opcode) != ASUS_ROG5_GET_CELL_VOLTAGE) {
+		battmgr->oem_error = -EPROTO;
+		goto out_complete;
+	}
+
+	battmgr->cell1_voltage_mv = le16_to_cpu(resp->cell1_voltage);
+	battmgr->cell2_voltage_mv = le16_to_cpu(resp->cell2_voltage);
+	battmgr->oem_error = 0;
+
+out_complete:
+	complete(&battmgr->oem_ack);
+}
+
+static void qcom_battmgr_asus_pdr_notify(void *priv, int state)
+{
+	struct qcom_battmgr *battmgr = priv;
+	bool service_up = state == SERVREG_SERVICE_STATE_UP;
+
+	WRITE_ONCE(battmgr->oem_service_generation,
+		   READ_ONCE(battmgr->oem_service_generation) + 1);
+	WRITE_ONCE(battmgr->oem_service_up, service_up);
+	WRITE_ONCE(battmgr->oem_request_poisoned, false);
+	if (!service_up) {
+		battmgr->oem_error = -ENOTCONN;
+		complete(&battmgr->oem_ack);
+	}
+}
