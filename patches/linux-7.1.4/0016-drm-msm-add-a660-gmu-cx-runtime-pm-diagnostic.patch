From c0797aa6dc862ea962164f539a9176793a4155d3 Mon Sep 17 00:00:00 2001
From: ROG5 Linux maintainers <rog5-linux@invalid>
Date: Mon, 27 Jul 2026 19:00:00 +0200
Subject: [PATCH 16/16] drm/msm: add A660 GMU/CX runtime-PM diagnostic

Add a default-off, read-only, exact-A660.1 diagnostic that exercises
one normal GMU-device runtime resume and its linked CX supplier, then
synchronously rolls both back before GX, clocks, secure setup, MMIO,
IRQs, firmware start, or HFI.

Use an atomic unused/attempted/passed state so only complete settled
rollback can produce EUCLEAN. Balance failed gets without idling,
reject every later open, and reuse the accepted firmware/ucode load
rollback.

Signed-off-by: ROG5 Linux maintainers <rog5-linux@invalid>

diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
index 197a9ac3e..004bb315b 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -1273,6 +1273,39 @@ int a6xx_gmu_resume(struct a6xx_gpu *a6xx_gpu)
 		return -EUCLEAN;
 	}
 
+	if (msm_a660_gmu_cx_runtime_pm_only_enabled()) {
+		if (adreno_gpu->chip_id != 0x06060001)
+			return -ENODEV;
+
+		if (!msm_a660_gmu_cx_runtime_pm_only_mark_attempt())
+			return -EALREADY;
+
+		ret = pm_runtime_get_sync(gmu->dev);
+		if (ret < 0) {
+			pm_runtime_put_noidle(gmu->dev);
+			return ret;
+		}
+
+		ret = pm_runtime_put_sync_suspend(gmu->dev);
+		if (ret < 0)
+			return ret;
+
+		ret = pm_runtime_suspend(gmu->cxpd);
+		if (ret < 0)
+			return ret;
+
+		if (!pm_runtime_suspended(gmu->dev) ||
+		    !pm_runtime_suspended(gmu->cxpd))
+			return -EBUSY;
+
+		if (!msm_a660_gmu_cx_runtime_pm_only_mark_passed())
+			return -EALREADY;
+
+		DRM_DEV_INFO(gmu->dev,
+			     "A660 GMU/CX runtime PM resumed and synchronously suspended; reject resume\n");
+		return -EUCLEAN;
+	}
+
 	gmu->hung = false;
 
 	/* Turn on the resources */
diff --git a/drivers/gpu/drm/msm/msm_drv.c b/drivers/gpu/drm/msm/msm_drv.c
index 475e2663e..6a86ad2df 100644
--- a/drivers/gpu/drm/msm/msm_drv.c
+++ b/drivers/gpu/drm/msm/msm_drv.c
@@ -93,6 +93,34 @@ bool msm_a660_gmu_resume_entry_only_was_hit(void)
 	return atomic_read(&gmu_resume_entry_only_hit) != 0;
 }
 
+static bool gmu_cx_runtime_pm_only;
+MODULE_PARM_DESC(gmu_cx_runtime_pm_only,
+		 "Resume and synchronously roll back exact A660 GMU/CX power once before GX");
+module_param(gmu_cx_runtime_pm_only, bool, 0400);
+
+static atomic_t gmu_cx_runtime_pm_only_open_consumed = ATOMIC_INIT(0);
+static atomic_t gmu_cx_runtime_pm_only_state = ATOMIC_INIT(0);
+
+bool msm_a660_gmu_cx_runtime_pm_only_enabled(void)
+{
+	return gmu_cx_runtime_pm_only;
+}
+
+bool msm_a660_gmu_cx_runtime_pm_only_mark_attempt(void)
+{
+	return atomic_cmpxchg(&gmu_cx_runtime_pm_only_state, 0, 1) == 0;
+}
+
+bool msm_a660_gmu_cx_runtime_pm_only_mark_passed(void)
+{
+	return atomic_cmpxchg(&gmu_cx_runtime_pm_only_state, 1, 2) == 1;
+}
+
+bool msm_a660_gmu_cx_runtime_pm_only_was_passed(void)
+{
+	return atomic_read(&gmu_cx_runtime_pm_only_state) == 2;
+}
+
 DECLARE_FAULT_ATTR(fail_gem_alloc);
 DECLARE_FAULT_ATTR(fail_gem_iova);
 
@@ -302,10 +330,11 @@ static int msm_open(struct drm_device *dev, struct drm_file *file)
 {
 	struct msm_drm_private *priv = dev->dev_private;
 	bool hit;
+	bool passed;
 	int ret;
 
 	if (firmware_request_only + ucode_allocation_only +
-	    gmu_resume_entry_only > 1)
+	    gmu_resume_entry_only + gmu_cx_runtime_pm_only > 1)
 		return -EINVAL;
 
 	if (gmu_resume_entry_only) {
@@ -330,6 +359,28 @@ static int msm_open(struct drm_device *dev, struct drm_file *file)
 		return -EUCLEAN;
 	}
 
+	if (gmu_cx_runtime_pm_only) {
+		if (atomic_cmpxchg(&gmu_cx_runtime_pm_only_open_consumed, 0, 1))
+			return -EALREADY;
+
+		load_gpu(dev);
+		passed = msm_a660_gmu_cx_runtime_pm_only_was_passed();
+
+		if (priv->gpu)
+			return -EPROTO;
+
+		ret = adreno_rollback_gpu_load_only(dev);
+		if (ret)
+			return ret;
+
+		if (!passed)
+			return -EPROTO;
+
+		DRM_DEV_INFO(dev->dev,
+			     "A660 GMU/CX runtime PM passed and GPU load rolled back; reject open\n");
+		return -EUCLEAN;
+	}
+
 	if (ucode_allocation_only) {
 		if (atomic_cmpxchg(&ucode_allocation_only_consumed, 0, 1))
 			return -EALREADY;
diff --git a/drivers/gpu/drm/msm/msm_gpu.h b/drivers/gpu/drm/msm/msm_gpu.h
index 173c19605..ad68a13dc 100644
--- a/drivers/gpu/drm/msm/msm_gpu.h
+++ b/drivers/gpu/drm/msm/msm_gpu.h
@@ -714,6 +714,10 @@ int adreno_rollback_gpu_load_only(struct drm_device *dev);
 bool msm_a660_gmu_resume_entry_only_enabled(void);
 bool msm_a660_gmu_resume_entry_only_mark_hit(void);
 bool msm_a660_gmu_resume_entry_only_was_hit(void);
+bool msm_a660_gmu_cx_runtime_pm_only_enabled(void);
+bool msm_a660_gmu_cx_runtime_pm_only_mark_attempt(void);
+bool msm_a660_gmu_cx_runtime_pm_only_mark_passed(void);
+bool msm_a660_gmu_cx_runtime_pm_only_was_passed(void);
 bool adreno_has_gpu(struct device_node *node);
 void __init adreno_register(void);
 void __exit adreno_unregister(void);
-- 
