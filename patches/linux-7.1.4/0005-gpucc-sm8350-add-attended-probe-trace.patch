From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ROG5 Linux Project <rog5-linux@localhost>
Date: Sat, 25 Jul 2026 00:00:00 +0000
Subject: [PATCH] clk: qcom: gpucc-sm8350: add attended probe trace

Add a read-only, default-off module parameter that emits progress notices
around the existing SM8350 GPUCC probe phases.  This makes an attended
watchdog-backed diagnostic useful even if a hardware access stops forward
progress.

The parameter does not skip, add, or alter any register access.

Signed-off-by: ROG5 Linux Project <rog5-linux@localhost>
---
 drivers/clk/qcom/gpucc-sm8350.c | 30 +++++++++++++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/qcom/gpucc-sm8350.c b/drivers/clk/qcom/gpucc-sm8350.c
--- a/drivers/clk/qcom/gpucc-sm8350.c
+++ b/drivers/clk/qcom/gpucc-sm8350.c
@@ -25,7 +25,12 @@
 #include "clk-regmap-divider.h"
 #include "gdsc.h"
 #include "reset.h"
 
+static bool probe_trace;
+module_param(probe_trace, bool, 0400);
+MODULE_PARM_DESC(probe_trace,
+		 "Emit progress notices for attended SM8350 GPUCC diagnostics");
+
 enum {
 	P_BI_TCXO,
 	P_GPLL0_OUT_MAIN,
@@ -594,18 +599,41 @@ static const struct qcom_cc_desc gpu_cc_sm8350_desc = {
 
 static int gpu_cc_sm8350_probe(struct platform_device *pdev)
 {
 	struct regmap *regmap;
+	int ret;
+
+	if (probe_trace)
+		dev_notice(&pdev->dev, "ROG5 GPUCC diagnostic: begin\n");
 
 	regmap = qcom_cc_map(pdev, &gpu_cc_sm8350_desc);
 	if (IS_ERR(regmap)) {
 		dev_err(&pdev->dev, "Failed to map gpu cc registers\n");
 		return PTR_ERR(regmap);
 	}
+	if (probe_trace)
+		dev_notice(&pdev->dev, "ROG5 GPUCC diagnostic: map-complete\n");
 
+	if (probe_trace)
+		dev_notice(&pdev->dev, "ROG5 GPUCC diagnostic: pll0-begin\n");
 	clk_lucid_pll_configure(&gpu_cc_pll0, regmap, &gpu_cc_pll0_config);
+	if (probe_trace)
+		dev_notice(&pdev->dev, "ROG5 GPUCC diagnostic: pll0-complete\n");
+
+	if (probe_trace)
+		dev_notice(&pdev->dev, "ROG5 GPUCC diagnostic: pll1-begin\n");
 	clk_lucid_pll_configure(&gpu_cc_pll1, regmap, &gpu_cc_pll1_config);
+	if (probe_trace)
+		dev_notice(&pdev->dev, "ROG5 GPUCC diagnostic: pll1-complete\n");
 
-	return qcom_cc_really_probe(&pdev->dev, &gpu_cc_sm8350_desc, regmap);
+	if (probe_trace)
+		dev_notice(&pdev->dev, "ROG5 GPUCC diagnostic: registration-begin\n");
+	ret = qcom_cc_really_probe(&pdev->dev, &gpu_cc_sm8350_desc, regmap);
+	if (probe_trace)
+		dev_notice(&pdev->dev,
+			   "ROG5 GPUCC diagnostic: registration-complete ret=%d\n",
+			   ret);
+
+	return ret;
 }
 
 static const struct of_device_id gpu_cc_sm8350_match_table[] = {
-- 
