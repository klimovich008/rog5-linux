From: ROG5 Linux contributors <klimovich008@gmail.com>
Subject: [PATCH] drm/panel: asus-rog5-ams678: soft reset, then the XBL init sequence

On the phone the Android-DT sequence left the panel reporting sleep out
and display on, answering DCS reads and raising TE, but emitting no light:
all pixels on at brightness 1023 drew no extra current (2026-09-23,
production display trials d2 and d3). The reset GPIO and a full
vddio/vdd power-off do not change that; a DCS soft reset does.

After a DCS soft reset, the ASUS XBL DisplayDxe sequence (sleep out,
10 ms, 0x9d 0x01, the 0x9e PPS, TE on, 60 ms, brightness, display on)
made a white frame draw the USB input limit plus battery current while a
black frame stayed at idle, on two boots. The XBL sequence without the
soft reset did not. Send the soft reset and that sequence, drop the
Samsung level-2 register writes (0xd1, 0xd3, 0xd5, 0xe4, 0xec, 0xf7,
0x60), and turn the panel off with display off and sleep in as the XBL
term sequence does.

---
--- a/drivers/gpu/drm/panel/panel-asus-rog5-ams678.c
+++ b/drivers/gpu/drm/panel/panel-asus-rog5-ams678.c
@@ -103,32 +103,18 @@
 
 	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
+	/*
+	 * Neither the reset GPIO nor removing vddio/vdd clears the controller
+	 * state left by earlier software: after them it reports sleep out and
+	 * display on but emits no light, even with all pixels on. A DCS soft
+	 * reset does clear it. Then send the sequence the ASUS XBL display
+	 * driver uses; the Android DT sequence also programs Samsung level-2
+	 * registers (0xd1, 0xd3, 0xd5, 0xe4, 0xec, 0xf7 and 0x60), not needed.
+	 */
+	mipi_dsi_dcs_soft_reset_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
 	mipi_dsi_usleep_range(&dsi_ctx, 10000, 11000);
-	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
-	mipi_dsi_dcs_set_tear_scanline_multi(&dsi_ctx, 0x0980);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x13);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd1, 0x6b);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x17);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd1, 0x2e);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
-	mipi_dsi_dcs_set_column_address_multi(&dsi_ctx, 0x0000, 0x0437);
-	mipi_dsi_dcs_set_page_address_multi(&dsi_ctx, 0x0000, 0x098f);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x0a);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd5, 0x05);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x02);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xec, 0x00, 0xc2, 0xc2, 0x42);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x0d);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xec, 0x19);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x06);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe4, 0x10);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9d, 0x01);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9e,
 				     0x11, 0x00, 0x00, 0x89, 0x30, 0x80, 0x09,
@@ -150,22 +136,6 @@
 				     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
 				     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
 				     0x00, 0x00);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x17);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd1, 0x2e);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x2a);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd3, 0x0b);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x2e);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd3, 0x0b);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0xaf);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd3, 0x0b);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0xb3);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd3, 0x0b);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x03);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x00);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
 
 	return dsi_ctx.accum_err;
 }
@@ -176,10 +146,6 @@
 
 	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x02);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xec, 0x00, 0x00, 0x00, 0x00);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
 	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 20);
 	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
@@ -242,6 +208,7 @@
 {
 	struct ams678_er2_plus_dsc *ctx = to_ams678_er2_plus_dsc(panel);
 	struct device *dev = &ctx->dsi->dev;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 	struct drm_dsc_picture_parameter_set pps;
 	int ret;
 
@@ -286,7 +253,13 @@
 		goto err_off;
 	}
 
-	msleep(28); /* TODO: Is this panel-dependent? */
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_msleep(&dsi_ctx, 60); /* XBL settle time before display on */
+	ret = dsi_ctx.accum_err;
+	if (ret < 0) {
+		dev_err(dev, "failed to enable tearing effect: %d\n", ret);
+		goto err_off;
+	}
 	ctx->initialized = true;
 	goto out;
 
