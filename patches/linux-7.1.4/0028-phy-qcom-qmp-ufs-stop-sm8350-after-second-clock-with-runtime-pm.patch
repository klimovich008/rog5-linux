From ad56d4021003b1f1c65ee92f583fda232013e301 Mon Sep 17 00:00:00 2001
From: ROG5 Linux Project <rog5-linux@localhost>
Date: Thu, 13 Aug 2026 04:17:54 +0200
Subject: [PATCH] phy: qcom: qmp-ufs: cross second clock with runtime-PM fix

Generation 42 proved that the first fixed-rate symbol-clock registration
preserves target USB/NCM when CCF orphan walks hold balanced runtime-PM
references for all clock providers.  Advance the SM8350 RAM-only
discriminator through exactly the second fixed-rate clock registration,
then return before the third clock or OF provider publication.

The UFS core and host remain absent, so this diagnostic cannot enumerate or
access storage.

Signed-off-by: ROG5 Linux Project <rog5-linux@localhost>
---
 drivers/phy/qualcomm/phy-qcom-qmp-ufs.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c b/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
index 88a93274a..d781ed6b9 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-ufs.c
@@ -2095,10 +2095,6 @@ static int qmp_ufs_register_clocks(struct qmp_ufs *qmp, struct device_node *np)
 
 	clk_data->hws[0] = hw;
 
-	if (of_device_is_compatible(qmp->dev->of_node,
-				    "qcom,sm8350-qmp-ufs-phy"))
-		return 0;
-
 	snprintf(name, sizeof(name), "%s::rx_symbol_1", dev_name(qmp->dev));
 	hw = devm_clk_hw_register_fixed_rate(qmp->dev, name, NULL, 0, 0);
 	if (IS_ERR(hw))
@@ -2106,6 +2102,10 @@ static int qmp_ufs_register_clocks(struct qmp_ufs *qmp, struct device_node *np)
 
 	clk_data->hws[1] = hw;
 
+	if (of_device_is_compatible(qmp->dev->of_node,
+				    "qcom,sm8350-qmp-ufs-phy"))
+		return 0;
+
 	snprintf(name, sizeof(name), "%s::tx_symbol_0", dev_name(qmp->dev));
 	hw = devm_clk_hw_register_fixed_rate(qmp->dev, name, NULL, 0, 0);
 	if (IS_ERR(hw))
@@ -2244,7 +2244,7 @@ static int qmp_ufs_probe(struct platform_device *pdev)
 	if (of_device_is_compatible(dev->of_node,
 				    "qcom,sm8350-qmp-ufs-phy")) {
 		dev_notice(dev,
-			   "ROG5 QMP-UFS diagnostic: first clock with runtime-PM stage complete\n");
+			   "ROG5 QMP-UFS diagnostic: second clock with runtime-PM stage complete\n");
 		of_node_put(np);
 		return 0;
 	}
-- 
2.50.1

