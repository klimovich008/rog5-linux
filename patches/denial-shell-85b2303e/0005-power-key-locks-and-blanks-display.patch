+/// Linux evdev `KEY_POWER`, emitted by the PMIC power button (`pmic_pwrkey`).
+#[cfg(feature = "flutter")]
+const EVDEV_KEY_POWER: u32 = 116;
+
+/// Claims the physical power key for the compositor, like a phone's.
+///
+/// A press is queued for the event loop, which either locks the session and
+/// blanks every output or, when the outputs are already off, wakes them to
+/// the lock screen. Press and release are both consumed before activity is
+/// noted, so neither the shell nor a client ever sees `KEY_POWER`, and the
+/// release cannot undo the power-off. logind keeps its own reading of the
+/// device (`HandlePowerKey=ignore`, long-press power-off).
+#[cfg(feature = "flutter")]
+fn intercept_power_key(state: &mut RuntimeState, keycode: Keycode, key_state: KeyState) -> bool {
+    // Smithay/XKB keycodes carry the conventional eight-code offset.
+    if keycode.raw().checked_sub(8) != Some(EVDEV_KEY_POWER) {
+        return false;
+    }
+    if key_state == KeyState::Pressed {
+        state.power_key_pending = true;
+    }
+    true
+}
