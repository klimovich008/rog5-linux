+// Saved networks ---------------------------------------------------------------
+
+class _WifiSavedNetworksPage extends ConsumerStatefulWidget {
+  const _WifiSavedNetworksPage({required this.onNavigate, super.key});
+
+  final ValueChanged<WifiSettingsRoute> onNavigate;
+
+  @override
+  ConsumerState<_WifiSavedNetworksPage> createState() =>
+      _WifiSavedNetworksPageState();
+}
+
+class _WifiSavedNetworksPageState
+    extends ConsumerState<_WifiSavedNetworksPage> {
+  List<WifiProfile>? _profiles;
+  List<WifiNetwork>? _lastNetworks;
+  final Set<String> _busy = <String>{};
+  bool _loading = true;
+  bool _reloadQueued = false;
+  bool _failed = false;
+  String? _error;
+  int _generation = 0;
+
+  @override
+  void initState() {
+    super.initState();
+    _lastNetworks = ref.read(networkConnectivityProvider).snapshot.networks;
+    unawaited(_reload());
+  }
+
+  Future<void> _reload() async {
+    final generation = ++_generation;
+    final profiles = await ref
+        .read(networkConnectivityProvider.notifier)
+        .readSavedProfiles();
+    if (!mounted || generation != _generation) {
+      return;
+    }
+    setState(() {
+      _loading = false;
+      _failed = profiles == null;
+      if (profiles != null) {
+        _profiles = profiles;
+      }
+    });
+  }
+
+  void _queueReload() {
+    if (_reloadQueued) {
+      return;
+    }
+    _reloadQueued = true;
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      _reloadQueued = false;
+      if (mounted) {
+        unawaited(_reload());
+      }
+    });
+  }
+
+  Future<void> _setAutoconnect(WifiProfile profile, bool value) async {
+    if (_busy.contains(profile.path)) {
+      return;
+    }
+    setState(() {
+      _busy.add(profile.path);
+      _error = null;
+      _replace(profile.copyWith(autoconnect: value));
+    });
+    final error = await ref
+        .read(networkConnectivityProvider.notifier)
+        .updateProfile(profile.copyWith(autoconnect: value), reapply: false);
+    if (!mounted) {
+      return;
+    }
+    setState(() {
+      _busy.remove(profile.path);
+      _error = error;
+      if (error != null) {
+        _replace(profile);
+      }
+    });
+  }
+
+  Future<void> _forget(WifiProfile profile) async {
+    if (_busy.contains(profile.path)) {
+      return;
+    }
+    setState(() {
+      _busy.add(profile.path);
+      _error = null;
+    });
+    final error = await ref
+        .read(networkConnectivityProvider.notifier)
+        .deleteProfile(profile);
+    if (!mounted) {
+      return;
+    }
+    setState(() {
+      _busy.remove(profile.path);
+      _error = error;
+      if (error == null) {
+        _profiles = _profiles
+            ?.where((candidate) => candidate.path != profile.path)
+            .toList(growable: false);
+      }
+    });
+  }
+
+  void _replace(WifiProfile profile) {
+    _profiles = _profiles
+        ?.map(
+          (candidate) => candidate.path == profile.path ? profile : candidate,
+        )
+        .toList(growable: false);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final state = ref.watch(networkConnectivityProvider);
+    final snapshot = state.snapshot;
+    if (!identical(snapshot.networks, _lastNetworks) &&
+        !listEquals(snapshot.networks, _lastNetworks)) {
+      _lastNetworks = snapshot.networks;
+      _queueReload();
+    }
+    final l10n = context.l10n;
+    final accent = ShellTheme.of(context).accent;
+    final profiles = _profiles;
+    if (_loading && profiles == null) {
+      return Padding(
+        padding: const EdgeInsets.symmetric(vertical: 24),
+        child: Center(
+          child: SizedBox.square(
+            dimension: 22,
+            child: CircularProgressIndicator(strokeWidth: 2, color: accent),
+          ),
+        ),
+      );
+    }
+    if (profiles == null) {
+      return _WifiNotice(
+        icon: Icons.error_outline_rounded,
+        message: l10n.wifiDetailsUnavailable,
+      );
+    }
+    if (profiles.isEmpty) {
+      return Padding(
+        padding: const EdgeInsets.symmetric(vertical: 24),
+        child: _WifiEmptyState(
+          icon: Icons.bookmark_border_rounded,
+          title: l10n.wifiNoSavedNetworks,
+          body: l10n.wifiNoSavedNetworksDescription,
+        ),
+      );
+    }
+    final canModify = snapshot.modifyPermission != NetworkPermission.denied;
+    final connected = snapshot.connectedNetwork;
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        if (_error case final message?) ...[
+          _WifiInlineError(message: message),
+          const SizedBox(height: 9),
+        ],
+        if (_failed) ...[
+          _WifiNotice(
+            icon: Icons.error_outline_rounded,
+            message: l10n.wifiDetailsUnavailable,
+          ),
+          const SizedBox(height: 9),
+        ],
+        for (var index = 0; index < profiles.length; index++) ...[
+          if (index > 0) const SizedBox(height: 7),
+          Builder(
+            builder: (context) {
+              final profile = profiles[index];
+              final network = _networkWithIdentity(snapshot, profile.identity);
+              final isConnected =
+                  connected != null && connected.identity == profile.identity;
+              final status = isConnected
+                  ? l10n.settingsConnected
+                  : network != null && network.available
+                  ? l10n.wifiSavedInRange
+                  : _wifiSecurityLabel(l10n, profile.security);
+              return _WifiSavedProfileRow(
+                profile: profile,
+                status: profile.autoconnect
+                    ? status
+                    : '$status · ${l10n.wifiAutoConnectOff}',
+                connected: isConnected,
+                strength: network?.strength ?? 0,
+                busy:
+                    _busy.contains(profile.path) ||
+                    state.busyNetworks.contains(profile.identity),
+                canModify: canModify,
+                onOpen: () => widget.onNavigate(
+                  WifiNetworkDetailsRoute(
+                    identity: profile.identity,
+                    ssid: profile.ssid,
+                    profilePath: profile.path,
+                  ),
+                ),
+                onAutoconnect: (value) =>
+                    unawaited(_setAutoconnect(profile, value)),
+                onForget: () => unawaited(_forget(profile)),
+              );
+            },
+          ),
+        ],
+      ],
+    );
+  }
+}
+
+class _WifiSavedProfileRow extends StatelessWidget {
+  const _WifiSavedProfileRow({
+    required this.profile,
+    required this.status,
+    required this.connected,
+    required this.strength,
+    required this.busy,
+    required this.canModify,
+    required this.onOpen,
+    required this.onAutoconnect,
+    required this.onForget,
+  });
+
+  final WifiProfile profile;
+  final String status;
+  final bool connected;
+  final int strength;
+  final bool busy;
+  final bool canModify;
+  final VoidCallback onOpen;
+  final ValueChanged<bool> onAutoconnect;
+  final VoidCallback onForget;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final accent = ShellTheme.of(context).accent;
