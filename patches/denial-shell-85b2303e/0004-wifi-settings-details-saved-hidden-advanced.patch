+/// How a saved Wi-Fi profile obtains its IPv4 configuration. [other] covers
+/// methods the shell shows but does not edit (link-local, shared, disabled).
+enum WifiIpv4Method { auto, manual, other }
+
+enum WifiProxyMethod { none, auto }
+
+enum WifiMetered { unknown, yes, no }
+
+@immutable
+class WifiIpv4Address {
+  const WifiIpv4Address(this.address, this.prefix);
+
+  final String address;
+  final int prefix;
+
+  @override
+  bool operator ==(Object other) =>
+      other is WifiIpv4Address &&
+      other.address == address &&
+      other.prefix == prefix;
+
+  @override
+  int get hashCode => Object.hash(address, prefix);
+
+  @override
+  String toString() => '$address/$prefix';
+}
+
+/// The editable view of one saved Wi-Fi connection profile. Secrets are never
+/// part of it; the backend keeps the stored password when it writes a profile.
+@immutable
+class WifiProfile {
+  WifiProfile({
+    required this.path,
+    required this.name,
+    required this.uuid,
+    required List<int> ssidBytes,
+    required this.security,
+    required this.hidden,
+    required this.autoconnect,
+    required this.ipv4Method,
+    required this.ipv4MethodName,
+    required List<WifiIpv4Address> addresses,
+    required this.gateway,
+    required List<String> dns,
+    required this.ignoreAutoDns,
+    required this.proxyMethod,
+    required this.pacUrl,
+    required this.metered,
+    required this.timestamp,
+  }) : ssidBytes = List<int>.unmodifiable(ssidBytes),
+       addresses = List<WifiIpv4Address>.unmodifiable(addresses),
+       dns = List<String>.unmodifiable(dns);
+
+  final String path;
+  final String name;
+  final String uuid;
+  final List<int> ssidBytes;
+  final WifiSecurity security;
+  final bool hidden;
+  final bool autoconnect;
+  final WifiIpv4Method ipv4Method;
+  final String ipv4MethodName;
+  final List<WifiIpv4Address> addresses;
+  final String gateway;
+  final List<String> dns;
+  final bool ignoreAutoDns;
+  final WifiProxyMethod proxyMethod;
+  final String pacUrl;
+  final WifiMetered metered;
+
+  /// Seconds since the epoch of the last successful activation, or 0.
+  final int timestamp;
+
+  String get ssid => utf8.decode(ssidBytes, allowMalformed: true);
+
+  String get identity => WifiNetwork.identityFor(ssidBytes, security);
+
+  WifiProfile copyWith({
+    bool? autoconnect,
+    WifiIpv4Method? ipv4Method,
+    List<WifiIpv4Address>? addresses,
+    String? gateway,
+    List<String>? dns,
+    bool? ignoreAutoDns,
+    WifiProxyMethod? proxyMethod,
+    String? pacUrl,
+    WifiMetered? metered,
+  }) {
+    final method = ipv4Method ?? this.ipv4Method;
+    return WifiProfile(
+      path: path,
+      name: name,
+      uuid: uuid,
+      ssidBytes: ssidBytes,
+      security: security,
+      hidden: hidden,
+      autoconnect: autoconnect ?? this.autoconnect,
+      ipv4Method: method,
+      ipv4MethodName: switch (method) {
+        WifiIpv4Method.auto => 'auto',
+        WifiIpv4Method.manual => 'manual',
+        WifiIpv4Method.other => ipv4MethodName,
+      },
+      addresses: addresses ?? this.addresses,
+      gateway: gateway ?? this.gateway,
+      dns: dns ?? this.dns,
+      ignoreAutoDns: ignoreAutoDns ?? this.ignoreAutoDns,
+      proxyMethod: proxyMethod ?? this.proxyMethod,
+      pacUrl: pacUrl ?? this.pacUrl,
+      metered: metered ?? this.metered,
+      timestamp: timestamp,
+    );
+  }
+
+  /// Whether applying [other] over this profile changes how an active
+  /// connection is configured (so it must be reapplied or reactivated).
+  bool differsInLinkConfiguration(WifiProfile other) =>
+      other.ipv4Method != ipv4Method ||
+      !listEquals(other.addresses, addresses) ||
+      other.gateway != gateway ||
+      !listEquals(other.dns, dns) ||
+      other.ignoreAutoDns != ignoreAutoDns ||
+      other.proxyMethod != proxyMethod ||
+      other.pacUrl != pacUrl ||
+      other.metered != metered;
+
+  @override
+  bool operator ==(Object other) =>
+      identical(this, other) ||
+      other is WifiProfile &&
+          other.path == path &&
+          other.name == name &&
+          other.uuid == uuid &&
+          listEquals(other.ssidBytes, ssidBytes) &&
+          other.security == security &&
+          other.hidden == hidden &&
+          other.autoconnect == autoconnect &&
+          other.ipv4Method == ipv4Method &&
+          other.ipv4MethodName == ipv4MethodName &&
+          listEquals(other.addresses, addresses) &&
+          other.gateway == gateway &&
+          listEquals(other.dns, dns) &&
+          other.ignoreAutoDns == ignoreAutoDns &&
+          other.proxyMethod == proxyMethod &&
+          other.pacUrl == pacUrl &&
+          other.metered == metered &&
+          other.timestamp == timestamp;
+
+  @override
+  int get hashCode => Object.hash(
+    path,
+    name,
