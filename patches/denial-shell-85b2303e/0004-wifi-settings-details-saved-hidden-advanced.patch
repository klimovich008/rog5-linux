+part of 'wifi_detail_surface.dart';
+
+/// A Wi-Fi settings sub-page. Hosts (the quick-settings Wi-Fi surface and the
+/// Settings network page) keep a stack of routes and render the top one with
+/// [WifiSettingsRouteView]. All routes need NetworkManager
+/// ([NetworkSnapshot.profileManagement]).
+sealed class WifiSettingsRoute {
+  const WifiSettingsRoute();
+}
+
+final class WifiNetworkDetailsRoute extends WifiSettingsRoute {
+  const WifiNetworkDetailsRoute({
+    required this.identity,
+    required this.ssid,
+    this.profilePath,
+  });
+
+  factory WifiNetworkDetailsRoute.forNetwork(WifiNetwork network) =>
+      WifiNetworkDetailsRoute(
+        identity: network.identity,
+        ssid: network.ssid,
+        profilePath: network.connected ? null : network.savedNetworkPath,
+      );
+
+  final String identity;
+  final String ssid;
+
+  /// The saved profile to show; null follows the active (or matching saved)
+  /// profile of the network.
+  final String? profilePath;
+}
+
+final class WifiAdvancedSettingsRoute extends WifiSettingsRoute {
+  const WifiAdvancedSettingsRoute({
+    required this.profilePath,
+    required this.ssid,
+  });
+
+  final String profilePath;
+  final String ssid;
+}
+
+final class WifiSavedNetworksRoute extends WifiSettingsRoute {
+  const WifiSavedNetworksRoute();
+}
+
+final class WifiAddNetworkRoute extends WifiSettingsRoute {
+  const WifiAddNetworkRoute();
+}
+
+String wifiSettingsRouteTitle(WifiSettingsRoute route, AppLocalizations l10n) {
+  return switch (route) {
+    WifiNetworkDetailsRoute(:final ssid) => ssid,
+    WifiAdvancedSettingsRoute() => l10n.wifiAdvancedSettings,
+    WifiSavedNetworksRoute() => l10n.wifiSavedNetworks,
+    WifiAddNetworkRoute() => l10n.wifiAddNetwork,
+  };
+}
+
+String wifiSettingsRouteSubtitle(
+  WifiSettingsRoute route,
+  AppLocalizations l10n,
+) {
+  return switch (route) {
+    WifiNetworkDetailsRoute() => l10n.wifiNetworkDetails,
+    WifiAdvancedSettingsRoute(:final ssid) => ssid,
+    WifiSavedNetworksRoute() => l10n.commonWifi,
+    WifiAddNetworkRoute() => l10n.wifiHiddenNetwork,
+  };
+}
+
+/// The body of one Wi-Fi settings sub-page. It does not scroll by itself, so
+/// the host places it in its own scroll view (which also keeps focused text
+/// fields visible above the on-screen keyboard).
+class WifiSettingsRouteView extends StatelessWidget {
+  const WifiSettingsRouteView({
+    required this.route,
+    required this.onNavigate,
+    required this.onBack,
+    super.key,
+  });
+
+  final WifiSettingsRoute route;
+  final ValueChanged<WifiSettingsRoute> onNavigate;
+  final VoidCallback onBack;
+
+  @override
+  Widget build(BuildContext context) {
+    return switch (route) {
+      final WifiNetworkDetailsRoute details => _WifiNetworkDetailsPage(
+        key: ValueKey<Object>(details),
+        route: details,
+        onNavigate: onNavigate,
+        onBack: onBack,
+      ),
+      final WifiAdvancedSettingsRoute advanced => _WifiAdvancedSettingsPage(
+        key: ValueKey<Object>(advanced),
+        route: advanced,
+        onBack: onBack,
+      ),
+      WifiSavedNetworksRoute() => _WifiSavedNetworksPage(
+        key: ValueKey<Object>(route),
+        onNavigate: onNavigate,
+      ),
+      WifiAddNetworkRoute() => _WifiAddNetworkPage(
+        key: ValueKey<Object>(route),
+        onBack: onBack,
+      ),
+    };
+  }
+}
+
+WifiNetwork? _networkWithIdentity(NetworkSnapshot snapshot, String identity) {
+  for (final network in snapshot.networks) {
+    if (network.identity == identity) {
+      return network;
+    }
+  }
+  return null;
+}
+
+// Network details ------------------------------------------------------------
+
+class _WifiNetworkDetailsPage extends ConsumerStatefulWidget {
+  const _WifiNetworkDetailsPage({
+    required this.route,
+    required this.onNavigate,
+    required this.onBack,
+    super.key,
+  });
+
+  final WifiNetworkDetailsRoute route;
+  final ValueChanged<WifiSettingsRoute> onNavigate;
+  final VoidCallback onBack;
+
+  @override
+  ConsumerState<_WifiNetworkDetailsPage> createState() =>
+      _WifiNetworkDetailsPageState();
+}
+
+class _WifiNetworkDetailsPageState
+    extends ConsumerState<_WifiNetworkDetailsPage> {
+  static const Duration _pollInterval = Duration(seconds: 4);
+
+  WifiProfile? _profile;
+  WifiConnectionDetails? _details;
+  WifiNetwork? _lastNetwork;
+  Timer? _poll;
+  bool _loading = true;
+  bool _profileBusy = false;
+  bool _reloadQueued = false;
+  String? _error;
+  int _generation = 0;
+
+  @override
+  void initState() {
+    super.initState();
+    _lastNetwork = _networkWithIdentity(
+      ref.read(networkConnectivityProvider).snapshot,
+      widget.route.identity,
+    );
+    unawaited(_reload());
+    _poll = Timer.periodic(_pollInterval, (_) {
+      if (_lastNetwork?.connected ?? false) {
+        unawaited(_reload());
+      }
+    });
+  }
+
+  @override
+  void dispose() {
+    _poll?.cancel();
+    super.dispose();
+  }
+
+  Future<void> _reload() async {
+    final generation = ++_generation;
+    final controller = ref.read(networkConnectivityProvider.notifier);
+    final network = _networkWithIdentity(
+      ref.read(networkConnectivityProvider).snapshot,
+      widget.route.identity,
+    );
+    final details = network == null
+        ? null
+        : await controller.readConnectionDetails(network);
+    final path =
+        widget.route.profilePath ??
+        details?.activeProfilePath ??
+        network?.savedNetworkPath;
+    final profile = path == null ? null : await controller.readProfile(path);
+    if (!mounted || generation != _generation) {
+      return;
+    }
+    setState(() {
+      _details = details;
+      _profile = profile;
+      _loading = false;
+    });
+  }
+
+  void _queueReload() {
+    if (_reloadQueued) {
+      return;
+    }
+    _reloadQueued = true;
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      _reloadQueued = false;
+      if (mounted) {
+        unawaited(_reload());
+      }
+    });
+  }
+
+  Future<void> _setAutoconnect(bool value) async {
+    final profile = _profile;
+    if (profile == null || _profileBusy) {
+      return;
+    }
+    setState(() {
+      _profileBusy = true;
+      _error = null;
+      _profile = profile.copyWith(autoconnect: value);
+    });
+    final error = await ref
+        .read(networkConnectivityProvider.notifier)
+        .updateProfile(profile.copyWith(autoconnect: value), reapply: false);
+    if (!mounted) {
+      return;
+    }
+    setState(() {
+      _profileBusy = false;
+      _error = error;
+      if (error != null) {
+        _profile = profile;
+      }
+    });
+    unawaited(_reload());
+  }
+
+  Future<void> _forget(WifiNetwork? network) async {
+    final controller = ref.read(networkConnectivityProvider.notifier);
+    final profile = _profile;
+    setState(() {
+      _profileBusy = true;
+      _error = null;
+    });
+    String? error;
+    if (profile != null) {
+      error = await controller.deleteProfile(profile);
+    } else if (network != null && network.saved) {
+      await controller.forget(network);
+    }
+    if (!mounted) {
+      return;
+    }
+    setState(() {
+      _profileBusy = false;
+      _error = error;
+    });
+    if (error == null) {
+      widget.onBack();
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final state = ref.watch(networkConnectivityProvider);
+    final controller = ref.read(networkConnectivityProvider.notifier);
+    final snapshot = state.snapshot;
+    final network = _networkWithIdentity(snapshot, widget.route.identity);
+    if (network != _lastNetwork) {
+      _lastNetwork = network;
+      _queueReload();
+    }
+    final l10n = context.l10n;
+    final accent = ShellTheme.of(context).accent;
+    final profile = _profile;
+    final details = _details;
+    final busy =
+        _profileBusy ||
+        (network != null && state.busyNetworks.contains(network.identity)) ||
+        (profile != null && state.busyNetworks.contains(profile.identity));
+    final canModify = snapshot.modifyPermission != NetworkPermission.denied;
+    final canControl = snapshot.controlPermission != NetworkPermission.denied;
+    final connected = network?.connected ?? false;
+    final security =
+        details?.security ?? profile?.security ?? network?.security;
+    final strength = details?.strength ?? network?.strength ?? 0;
+    final frequency = details?.frequency ?? network?.frequency ?? 0;
+
+    final status = connected
+        ? l10n.settingsConnected
+        : network == null || !network.available
+        ? l10n.wifiSavedOutOfRange
+        : network.saved
+        ? l10n.wifiSavedInRange
+        : _wifiSecurityLabel(l10n, network.security);
+
+    final rows = <(String, String)>[
+      (l10n.wifiStatus, status),
+      if (strength > 0)
+        (
+          l10n.wifiSignal,
+          l10n.wifiSignalValue(_signalQuality(l10n, strength), strength),
+        ),
+      if (details != null && details.bitrateKbps > 0)
+        (
+          l10n.wifiLinkSpeed,
+          l10n.wifiLinkSpeedValue((details.bitrateKbps / 1000).round()),
+        ),
+      if (frequency > 0) (l10n.wifiFrequency, _frequencyLabel(l10n, frequency)),
+      if (security != null)
+        (l10n.wifiSecurity, _wifiSecurityLabel(l10n, security)),
+      if (details != null && details.ipv4Addresses.isNotEmpty)
+        (l10n.wifiIpAddress, details.ipv4Addresses.join('\n')),
+      if (details != null && details.ipv4Gateway.isNotEmpty)
+        (l10n.wifiGateway, details.ipv4Gateway),
+      if (details != null && details.ipv4Dns.isNotEmpty)
+        (l10n.wifiDnsServers, details.ipv4Dns.join('\n')),
+      if (details != null && details.ipv6Addresses.isNotEmpty)
+        (l10n.wifiIpv6Addresses, details.ipv6Addresses.join('\n')),
+      if (details != null && details.bssid.isNotEmpty)
+        (l10n.wifiBssid, details.bssid),
+      if (details != null && details.hardwareAddress.isNotEmpty)
+        (l10n.wifiMacAddress, details.hardwareAddress),
+      if (profile != null) ...[
+        (l10n.wifiIpSettings, _ipMethodLabel(l10n, profile)),
+        if (profile.ipv4Method == WifiIpv4Method.auto &&
+            profile.ignoreAutoDns &&
+            profile.dns.isNotEmpty &&
+            !connected)
+          (l10n.wifiDnsServers, profile.dns.join('\n')),
+        (
+          l10n.wifiProxy,
+          profile.proxyMethod == WifiProxyMethod.auto
+              ? l10n.wifiProxyAutomatic
+              : l10n.wifiProxyNone,
+        ),
+        (l10n.wifiMetered, _meteredLabel(l10n, profile.metered)),
+        if (profile.hidden) (l10n.wifiHiddenNetwork, l10n.wifiYes),
+      ],
+    ];
+
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        _WifiCard(
+          child: Row(
+            children: [
+              Icon(
+                _strengthIcon(strength),
+                size: 26,
+                color: connected ? accent : context.shellColors.textSecondary,
+              ),
+              const SizedBox(width: 12),
+              Expanded(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Text(
+                      profile?.ssid ?? network?.ssid ?? widget.route.ssid,
+                      maxLines: 2,
+                      overflow: TextOverflow.ellipsis,
+                      style: ShellText.cardTitle.copyWith(fontSize: 15),
+                    ),
+                    const SizedBox(height: 3),
+                    Text(
+                      status,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: ShellText.base.copyWith(
+                        color: context.shellColors.textTertiary,
+                        fontSize: 11,
+                        fontWeight: FontWeight.w600,
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+              if (busy)
+                SizedBox.square(
+                  dimension: 20,
+                  child: CircularProgressIndicator(
+                    strokeWidth: 2,
+                    color: accent,
+                  ),
+                ),
+            ],
+          ),
+        ),
+        const SizedBox(height: 9),
+        Wrap(
+          spacing: 8,
+          runSpacing: 8,
+          children: [
+            if (network != null && (connected || network.connectable))
+              _WifiTextButton(
+                label: connected
+                    ? l10n.settingsDisconnect
+                    : l10n.settingsConnect,
+                emphasized: !connected,
+                enabled: canControl && !busy,
+                onPressed: () => unawaited(
+                  connected
+                      ? controller.disconnect(network)
+                      : controller.connect(network),
+                ),
+              ),
+            if (profile != null || (network?.saved ?? false))
+              _WifiTextButton(
+                label: l10n.wifiForget,
+                enabled: canModify && !busy,
+                onPressed: () => unawaited(_forget(network)),
+              ),
+            if (profile != null)
+              _WifiTextButton(
+                label: l10n.wifiAdvancedSettings,
+                enabled: canModify && !busy,
+                onPressed: () => widget.onNavigate(
+                  WifiAdvancedSettingsRoute(
+                    profilePath: profile.path,
+                    ssid: profile.ssid,
+                  ),
+                ),
+              ),
+          ],
+        ),
+        if (_error case final message?) ...[
+          const SizedBox(height: 9),
+          _WifiInlineError(message: message),
+        ],
+        if (profile != null) ...[
+          const SizedBox(height: 9),
+          _WifiCard(
+            child: SettingsToggle(
+              label: l10n.wifiAutoConnect,
+              description: l10n.wifiAutoConnectDescription,
+              value: profile.autoconnect,
+              enabled: canModify && !busy,
+              onChanged: (value) => unawaited(_setAutoconnect(value)),
+            ),
+          ),
+        ],
+        const SizedBox(height: 9),
+        if (_loading)
+          Padding(
+            padding: const EdgeInsets.symmetric(vertical: 18),
+            child: Center(
+              child: SizedBox.square(
+                dimension: 22,
+                child: CircularProgressIndicator(strokeWidth: 2, color: accent),
+              ),
+            ),
+          )
+        else ...[
+          if (!connected) ...[
+            _WifiNotice(
+              icon: Icons.info_outline_rounded,
+              message: l10n.wifiConnectToSeeDetails,
+            ),
+            const SizedBox(height: 9),
+          ] else if (details == null) ...[
+            _WifiNotice(
+              icon: Icons.error_outline_rounded,
+              message: l10n.wifiDetailsUnavailable,
+            ),
+            const SizedBox(height: 9),
+          ],
+          _WifiCard(
+            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 4),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.stretch,
+              children: [
+                for (var index = 0; index < rows.length; index++) ...[
+                  if (index > 0)
+                    Container(
+                      height: 1,
+                      color: context.shellColors.hairlineSoft,
+                    ),
+                  _WifiInfoRow(label: rows[index].$1, value: rows[index].$2),
+                ],
+              ],
+            ),
+          ),
+        ],
+      ],
+    );
+  }
+}
+
+String _signalQuality(AppLocalizations l10n, int strength) {
+  if (strength >= 75) {
+    return l10n.wifiSignalExcellent;
+  }
+  if (strength >= 50) {
+    return l10n.wifiSignalGood;
+  }
+  if (strength >= 25) {
+    return l10n.wifiSignalFair;
+  }
+  return l10n.wifiSignalWeak;
+}
+
+String _frequencyLabel(AppLocalizations l10n, int frequency) {
+  final band = wifiBandForFrequency(frequency);
+  final channel = wifiChannelForFrequency(frequency);
+  if (band == null || channel == 0) {
+    return l10n.wifiFrequencyMegahertz(frequency);
+  }
+  return l10n.wifiFrequencyValue(band, channel, frequency);
+}
+
+String _ipMethodLabel(AppLocalizations l10n, WifiProfile profile) {
+  return switch (profile.ipv4Method) {
+    WifiIpv4Method.auto => l10n.wifiIpDhcp,
+    WifiIpv4Method.manual =>
+      profile.addresses.isEmpty
+          ? l10n.wifiIpStatic
+          : '${l10n.wifiIpStatic} · ${profile.addresses.first}',
+    WifiIpv4Method.other => l10n.wifiIpMethodOther(profile.ipv4MethodName),
+  };
+}
+
+String _meteredLabel(AppLocalizations l10n, WifiMetered metered) {
+  return switch (metered) {
+    WifiMetered.unknown => l10n.wifiMeteredAutomatic,
+    WifiMetered.yes => l10n.wifiMeteredYes,
+    WifiMetered.no => l10n.wifiMeteredNo,
+  };
+}
