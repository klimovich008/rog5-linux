+
+class _WifiAddNetworkPageState extends ConsumerState<_WifiAddNetworkPage> {
+  final TextEditingController _ssid = TextEditingController();
+  final TextEditingController _password = TextEditingController();
+  final FocusNode _ssidFocus = FocusNode(debugLabel: 'wifi-hidden-ssid');
+  final FocusNode _passwordFocus = FocusNode(
+    debugLabel: 'wifi-hidden-password',
+  );
+  WifiSecurity _security = WifiSecurity.wpaPersonal;
+  String? _ssidError;
+  String? _passwordError;
+  String? _error;
+  bool _busy = false;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (mounted) {
+        _ssidFocus.requestFocus();
+      }
+    });
+  }
+
+  @override
+  void dispose() {
+    _ssid.dispose();
+    _password
+      ..clear()
+      ..dispose();
+    _ssidFocus.dispose();
+    _passwordFocus.dispose();
+    super.dispose();
+  }
+
+  Future<void> _submit() async {
+    if (_busy) {
+      return;
+    }
+    final l10n = context.l10n;
+    final ssid = _ssid.text;
+    final bytes = utf8.encode(ssid);
+    final secret = _password.text;
+    final secured = _security != WifiSecurity.open;
+    setState(() {
+      _ssidError = bytes.isEmpty || bytes.length > 32 || ssid.trim().isEmpty
+          ? l10n.wifiInvalidSsid
+          : null;
+      _passwordError = secured && !_validPersonalPassword(secret)
+          ? l10n.wifiPasswordRequirements
+          : null;
+      _error = null;
+    });
+    if (_ssidError != null) {
+      _ssidFocus.requestFocus();
+      return;
+    }
+    if (_passwordError != null) {
+      _passwordFocus.requestFocus();
+      return;
+    }
+    setState(() => _busy = true);
+    final error = await ref
+        .read(networkConnectivityProvider.notifier)
+        .addHiddenNetwork(
+          ssid: ssid,
+          security: _security,
+          password: secured ? secret : null,
+        );
+    if (!mounted) {
+      return;
+    }
+    setState(() {
+      _busy = false;
+      _error = error;
+    });
+    if (error == null) {
+      _password.clear();
+      widget.onBack();
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final accent = ShellTheme.of(context).accent;
+    final secured = _security != WifiSecurity.open;
+    final snapshot = ref.watch(
+      networkConnectivityProvider.select((state) => state.snapshot),
+    );
+    final radioReady =
+        snapshot.wirelessEnabled &&
+        snapshot.wifiDeviceAvailable &&
+        snapshot.devicePath != null;
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        _WifiCard(
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              Text(
+                l10n.wifiAddHiddenNetworkDescription,
+                style: ShellText.base.copyWith(
+                  color: context.shellColors.textTertiary,
+                  fontSize: 11.5,
+                  height: 1.35,
+                ),
+              ),
+              const SizedBox(height: 12),
+              _WifiTextField(
+                label: l10n.wifiNetworkName,
+                controller: _ssid,
+                focusNode: _ssidFocus,
+                error: _ssidError,
+                enabled: !_busy,
+                textInputAction: secured
+                    ? TextInputAction.next
+                    : TextInputAction.done,
+                onSubmitted: secured
+                    ? _passwordFocus.requestFocus
+                    : () => unawaited(_submit()),
+                onChanged: () {
+                  if (_ssidError != null) {
+                    setState(() => _ssidError = null);
+                  }
+                },
+              ),
+              const SizedBox(height: 12),
+              _WifiSectionTitle(l10n.wifiSecurity),
+              SettingsSegmentedControl<WifiSecurity>(
+                value: _security,
+                choices: [
+                  SettingsChoice(WifiSecurity.open, l10n.wifiSecurityNone),
+                  SettingsChoice(
+                    WifiSecurity.wpaPersonal,
+                    l10n.wifiSecurityWpaPersonal,
+                  ),
+                  SettingsChoice(
+                    WifiSecurity.wpa3Personal,
+                    l10n.wifiSecurityWpa3Personal,
+                  ),
+                ],
+                onChanged: _busy
+                    ? (_) {}
+                    : (value) => setState(() {
+                        _security = value;
+                        _passwordError = null;
+                      }),
+              ),
+              if (secured) ...[
+                const SizedBox(height: 12),
+                _WifiTextField(
+                  label: l10n.wifiPassword,
+                  controller: _password,
+                  focusNode: _passwordFocus,
+                  error: _passwordError,
+                  obscureText: true,
+                  enabled: !_busy,
+                  keyboardType: TextInputType.visiblePassword,
+                  onSubmitted: () => unawaited(_submit()),
+                  onChanged: () {
+                    if (_passwordError != null) {
+                      setState(() => _passwordError = null);
+                    }
+                  },
+                ),
+              ],
+            ],
+          ),
+        ),
+        if (!radioReady) ...[
+          const SizedBox(height: 9),
+          _WifiNotice(
+            icon: Icons.wifi_off_rounded,
+            message: l10n.wifiOffDescription,
+          ),
+        ],
+        if (_error case final message?) ...[
+          const SizedBox(height: 9),
+          _WifiInlineError(message: message),
+        ],
+        const SizedBox(height: 12),
+        Row(
+          mainAxisAlignment: MainAxisAlignment.end,
+          children: [
+            if (_busy) ...[
+              SizedBox.square(
+                dimension: 20,
+                child: CircularProgressIndicator(strokeWidth: 2, color: accent),
+              ),
+              const SizedBox(width: 12),
+            ],
+            _WifiTextButton(
+              label: l10n.commonCancel,
+              enabled: !_busy,
+              onPressed: widget.onBack,
+            ),
+            const SizedBox(width: 8),
+            _WifiTextButton(
+              label: l10n.settingsConnect,
+              emphasized: true,
+              enabled: !_busy && radioReady,
+              onPressed: () => unawaited(_submit()),
+            ),
+          ],
+        ),
+      ],
