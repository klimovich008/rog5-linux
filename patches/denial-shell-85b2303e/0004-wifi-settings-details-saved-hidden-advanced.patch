+/// The 802.11 channel number for a centre frequency in MHz, or 0.
+int wifiChannelForFrequency(int frequency) {
+  if (frequency == 2484) {
+    return 14;
+  }
+  if (frequency >= 2412 && frequency < 2484) {
+    return (frequency - 2407) ~/ 5;
+  }
+  if (frequency == 5935) {
+    return 2;
+  }
+  if (frequency >= 5955 && frequency <= 7115) {
+    return (frequency - 5950) ~/ 5;
+  }
+  if (frequency >= 4910 && frequency < 5000) {
+    return (frequency - 4000) ~/ 5;
+  }
+  if (frequency >= 5000 && frequency <= 5895) {
+    return (frequency - 5000) ~/ 5;
+  }
+  if (frequency >= 58320 && frequency <= 70200) {
+    return (frequency - 56160) ~/ 2160;
+  }
+  return 0;
+}
+
+/// The band of a centre frequency in MHz as a GHz label ("2.4", "5", "6"), or
+/// null when it is unknown.
+String? wifiBandForFrequency(int frequency) {
+  if (frequency >= 2400 && frequency < 2500) {
+    return '2.4';
+  }
+  if (frequency == 5935 || (frequency >= 5955 && frequency <= 7125)) {
+    return '6';
+  }
+  if (frequency >= 4900 && frequency < 5950) {
+    return '5';
+  }
+  if (frequency >= 57000 && frequency <= 71000) {
+    return '60';
+  }
+  return null;
+}
+
+final RegExp _ipv4Pattern = RegExp(
+  r'^(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}$',
+);
+
+bool isValidIpv4Address(String value) => _ipv4Pattern.hasMatch(value.trim());
+
+/// Parses an IPv4 prefix length (1-32), or returns null.
+int? parseIpv4Prefix(String value) {
+  final prefix = int.tryParse(value.trim());
+  return prefix == null || prefix < 1 || prefix > 32 ? null : prefix;
+}
+
+/// Parses a comma-, space- or semicolon-separated list of IPv4 DNS servers.
+/// Returns null when any entry is invalid; an empty input gives an empty list.
+List<String>? parseIpv4DnsList(String value) {
+  final entries = value
+      .split(RegExp(r'[\s,;]+'))
+      .map((entry) => entry.trim())
+      .where((entry) => entry.isNotEmpty)
+      .toList(growable: false);
+  if (entries.any((entry) => !isValidIpv4Address(entry))) {
+    return null;
+  }
+  final unique = <String>[];
+  for (final entry in entries) {
+    if (!unique.contains(entry)) {
+      unique.add(entry);
+    }
+  }
+  return unique;
+}
