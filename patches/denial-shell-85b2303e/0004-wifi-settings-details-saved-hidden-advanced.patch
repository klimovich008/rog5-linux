+
+  void _selectMethod(WifiIpv4Method method) {
+    setState(() {
+      _method = method;
+      _fieldErrors.clear();
+      if (method != WifiIpv4Method.manual) {
+        return;
+      }
+      // Start a static configuration from the current lease, as a safe
+      // default the user only has to adjust.
+      final details = _details;
+      if (_text(_WifiField.address).text.trim().isEmpty && details != null) {
+        final lease = details.ipv4Addresses.firstOrNull;
+        if (lease != null) {
+          _text(_WifiField.address).text = lease.address;
+          _text(_WifiField.prefix).text = '${lease.prefix}';
+        }
+        if (_text(_WifiField.gateway).text.trim().isEmpty) {
+          _text(_WifiField.gateway).text = details.ipv4Gateway;
+        }
+        if (_text(_WifiField.dns).text.trim().isEmpty) {
+          _text(_WifiField.dns).text = details.ipv4Dns.join(', ');
+        }
+      }
+      if (_text(_WifiField.prefix).text.trim().isEmpty) {
+        _text(_WifiField.prefix).text = '24';
+      }
+    });
+  }
+
+  void _selectCustomDns(bool value) {
+    setState(() {
+      _customDns = value;
+      _fieldErrors.remove(_WifiField.dns);
+      final details = _details;
+      if (value &&
+          _text(_WifiField.dns).text.trim().isEmpty &&
+          details != null) {
+        _text(_WifiField.dns).text = details.ipv4Dns.join(', ');
+      }
+    });
+  }
+
+  /// Validates the form and returns the edited profile, or null after
+  /// recording field errors.
+  WifiProfile? _editedProfile(AppLocalizations l10n) {
+    final profile = _profile;
+    if (profile == null) {
+      return null;
+    }
+    final errors = <_WifiField, String>{};
+    var addresses = profile.addresses;
+    var gateway = profile.gateway;
+    var dns = profile.dns;
+    if (_method == WifiIpv4Method.manual) {
+      final address = _text(_WifiField.address).text.trim();
+      final prefix = parseIpv4Prefix(_text(_WifiField.prefix).text);
+      if (!isValidIpv4Address(address)) {
+        errors[_WifiField.address] = l10n.wifiInvalidAddress;
+      }
+      if (prefix == null) {
+        errors[_WifiField.prefix] = l10n.wifiInvalidPrefix;
+      }
+      gateway = _text(_WifiField.gateway).text.trim();
+      if (gateway.isNotEmpty && !isValidIpv4Address(gateway)) {
+        errors[_WifiField.gateway] = l10n.wifiInvalidGateway;
+      }
+      if (prefix != null && isValidIpv4Address(address)) {
+        addresses = <WifiIpv4Address>[WifiIpv4Address(address, prefix)];
+      }
+    } else if (_method == WifiIpv4Method.auto) {
+      addresses = const <WifiIpv4Address>[];
+      gateway = '';
+    }
+    if (_method == WifiIpv4Method.manual ||
+        (_method == WifiIpv4Method.auto && _customDns)) {
+      final parsed = parseIpv4DnsList(_text(_WifiField.dns).text);
+      if (parsed == null ||
+          (_method == WifiIpv4Method.auto && parsed.isEmpty)) {
+        errors[_WifiField.dns] = l10n.wifiInvalidDns;
+      } else {
+        dns = parsed;
+      }
+    } else if (_method == WifiIpv4Method.auto) {
+      dns = const <String>[];
+    }
+    var pacUrl = '';
+    if (_proxy == WifiProxyMethod.auto) {
+      pacUrl = _text(_WifiField.pacUrl).text.trim();
+      final uri = Uri.tryParse(pacUrl);
+      if (pacUrl.isNotEmpty &&
+          (uri == null ||
+              !const <String>{'http', 'https', 'file'}.contains(uri.scheme))) {
+        errors[_WifiField.pacUrl] = l10n.wifiInvalidPacUrl;
+      }
+    }
+    setState(() {
+      _fieldErrors
+        ..clear()
+        ..addAll(errors);
+    });
+    if (errors.isNotEmpty) {
+      _focusNodes[errors.keys.first]!.requestFocus();
+      return null;
+    }
+    return profile.copyWith(
+      ipv4Method: _method,
+      addresses: addresses,
+      gateway: gateway,
+      dns: dns,
+      ignoreAutoDns: _method == WifiIpv4Method.auto && _customDns,
+      proxyMethod: _proxy,
+      pacUrl: pacUrl,
+      metered: _metered,
+    );
+  }
+
+  Future<void> _save() async {
+    final profile = _profile;
+    if (profile == null || _saving) {
+      return;
+    }
+    final edited = _editedProfile(context.l10n);
+    if (edited == null) {
+      return;
+    }
+    if (edited == profile) {
+      widget.onBack();
+      return;
+    }
+    setState(() {
+      _saving = true;
+      _error = null;
+    });
+    final error = await ref
+        .read(networkConnectivityProvider.notifier)
+        .updateProfile(
+          edited,
+          reapply: profile.differsInLinkConfiguration(edited),
+        );
+    if (!mounted) {
+      return;
+    }
+    setState(() {
+      _saving = false;
+      _error = error;
+    });
+    if (error == null) {
+      widget.onBack();
+    }
+  }
+
+  Widget _field(
