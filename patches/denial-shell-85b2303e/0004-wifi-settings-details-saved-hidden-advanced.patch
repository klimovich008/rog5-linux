+// Advanced settings -----------------------------------------------------------
+
+enum _WifiField { address, prefix, gateway, dns, pacUrl }
+
+class _WifiAdvancedSettingsPage extends ConsumerStatefulWidget {
+  const _WifiAdvancedSettingsPage({
+    required this.route,
+    required this.onBack,
+    super.key,
+  });
+
+  final WifiAdvancedSettingsRoute route;
+  final VoidCallback onBack;
+
+  @override
+  ConsumerState<_WifiAdvancedSettingsPage> createState() =>
+      _WifiAdvancedSettingsPageState();
+}
+
+class _WifiAdvancedSettingsPageState
+    extends ConsumerState<_WifiAdvancedSettingsPage> {
+  final Map<_WifiField, TextEditingController> _controllers = {
+    for (final field in _WifiField.values) field: TextEditingController(),
+  };
+  final Map<_WifiField, FocusNode> _focusNodes = {
+    for (final field in _WifiField.values)
+      field: FocusNode(debugLabel: 'wifi-${field.name}'),
+  };
+  final Map<_WifiField, String> _fieldErrors = <_WifiField, String>{};
+
+  WifiProfile? _profile;
+  WifiConnectionDetails? _details;
+  bool _loading = true;
+  bool _saving = false;
+  bool _active = false;
+  String? _error;
+  WifiIpv4Method _method = WifiIpv4Method.auto;
+  bool _customDns = false;
+  WifiProxyMethod _proxy = WifiProxyMethod.none;
+  WifiMetered _metered = WifiMetered.unknown;
+
+  TextEditingController _text(_WifiField field) => _controllers[field]!;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_load());
+  }
+
+  @override
+  void dispose() {
+    for (final controller in _controllers.values) {
+      controller.dispose();
+    }
+    for (final node in _focusNodes.values) {
+      node.dispose();
+    }
+    super.dispose();
+  }
+
+  Future<void> _load() async {
+    final controller = ref.read(networkConnectivityProvider.notifier);
+    final profile = await controller.readProfile(widget.route.profilePath);
+    WifiConnectionDetails? details;
+    final connected = ref
+        .read(networkConnectivityProvider)
+        .snapshot
+        .connectedNetwork;
+    if (profile != null &&
+        connected != null &&
+        connected.identity == profile.identity) {
+      details = await controller.readConnectionDetails(connected);
+    }
+    if (!mounted) {
+      return;
+    }
+    setState(() {
+      _loading = false;
+      _profile = profile;
+      _details = details;
+      _active =
+          details != null &&
+          (details.activeProfilePath == null ||
+              details.activeProfilePath == profile?.path);
+      if (profile == null) {
+        return;
+      }
+      _method = profile.ipv4Method;
+      _customDns = profile.ignoreAutoDns;
+      _proxy = profile.proxyMethod;
+      _metered = profile.metered;
+      final address = profile.addresses.firstOrNull;
+      _text(_WifiField.address).text = address?.address ?? '';
+      _text(_WifiField.prefix).text = address == null
+          ? ''
+          : '${address.prefix}';
+      _text(_WifiField.gateway).text = profile.gateway;
+      _text(_WifiField.dns).text = profile.dns.join(', ');
