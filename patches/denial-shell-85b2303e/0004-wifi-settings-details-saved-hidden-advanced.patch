+    expect(ipv4.containsKey('addresses'), isFalse);
+    expect(ipv4.containsKey('dns-data'), isFalse);
+    expect(ipv4['ignore-auto-dns'], const DBusBoolean(false));
+    final addressData = (ipv4['address-data']! as DBusArray).children.single
+        .asStringVariantDict();
+    expect(addressData['address'], const DBusString('192.168.1.50'));
+    expect(addressData['prefix'], const DBusUint32(24));
+    expect(ipv4['dns']!.asUint32Array().toList(), <int>[
