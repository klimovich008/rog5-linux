+/// NetworkManager's legacy `au` IPv4 encoding: network byte order in a
+/// host-order integer.
+int _nmIpv4(List<int> octets) =>
+    ByteData.sublistView(Uint8List.fromList(octets)).getUint32(0, Endian.host);
+
+Map<String, Map<String, DBusValue>> _storedProfile() {
+  return <String, Map<String, DBusValue>>{
+    'connection': <String, DBusValue>{
+      'id': const DBusString('Home'),
+      'uuid': const DBusString('0b8e1f5c-5b0a-4c1e-9d0e-1f2a3b4c5d6e'),
+      'type': const DBusString('802-11-wireless'),
+      'timestamp': const DBusUint64(1790000000),
+    },
+    '802-11-wireless': <String, DBusValue>{
+      'ssid': DBusArray.byte('Home'.codeUnits),
+      'mode': const DBusString('infrastructure'),
+      'seen-bssids': DBusArray.string(const <String>['AA:BB:CC:DD:EE:FF']),
+    },
+    '802-11-wireless-security': <String, DBusValue>{
+      'key-mgmt': const DBusString('wpa-psk'),
+    },
+    'ipv4': <String, DBusValue>{
+      'method': const DBusString('auto'),
+      'dns-data': DBusArray.string(const <String>['9.9.9.9']),
+      'dns': DBusArray.uint32(<int>[
+        _nmIpv4(const <int>[9, 9, 9, 9]),
+      ]),
+      'ignore-auto-dns': const DBusBoolean(true),
+      'addresses': DBusArray(DBusSignature('au'), const <DBusValue>[]),
+    },
+    'ipv6': <String, DBusValue>{'method': const DBusString('auto')},
+    'proxy': <String, DBusValue>{
+      'method': const DBusInt32(1),
+      'pac-url': const DBusString('http://wpad/wpad.dat'),
+      'pac-script': const DBusString('function FindProxyForURL() {}'),
+    },
+  };
+}
+
+Map<String, Map<String, DBusValue>> _decode(DBusDict value) {
+  return <String, Map<String, DBusValue>>{
+    for (final entry in value.asDict().entries)
+      entry.key.asString(): entry.value.asStringVariantDict(),
+  };
+}
