+#[cfg(feature = "flutter")]
+impl ClientInputRoute {
+    /// Touch focus and touch location for a contact.
+    ///
+    /// Smithay hands a client `location - focus origin`, which cannot express
+    /// a region drawn at another scale (a phone window scaled down to fit the
+    /// screen). Such a region reports its focus and location in the window's
+    /// own root-surface coordinates instead; 1:1 regions keep scene
+    /// coordinates.
+    fn touch_focus_at(
+        &self,
+        position: Point<f64, Logical>,
+    ) -> ((WlSurface, Point<f64, Logical>), Point<f64, Logical>) {
+        let scene_position = position - self.scene_origin;
+        let (local_x, local_y) =
+            self.region
+                .rect
+                .map_to(self.region.source_rect, scene_position.x, scene_position.y);
+        let local_point = Point::from((local_x, local_y));
+        let scale_x = self.region.rect.width / self.region.source_rect.width;
+        let scale_y = self.region.rect.height / self.region.source_rect.height;
+        if (scale_x - 1.0).abs() < 1e-6 && (scale_y - 1.0).abs() < 1e-6 {
+            return (self.focus_at(position), position);
+        }
+        let (surface, local_origin) =
+            under_from_surface_tree(&self.surface, local_point, (0, 0), WindowSurfaceType::ALL)
+                .unwrap_or_else(|| (self.surface.clone(), (0, 0).into()));
+        ((surface, local_origin.to_f64()), local_point)
+    }
+}
