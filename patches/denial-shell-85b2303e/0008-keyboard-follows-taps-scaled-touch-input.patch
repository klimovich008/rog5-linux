+#[cfg(feature = "flutter")]
+impl WaylandFrontend {
+    /// A contact on `route` in its window's root-surface coordinates, the
+    /// space of a text-input caret rectangle. The contact may be on a popup;
+    /// the window's root region maps it either way.
+    pub(super) fn root_surface_point(
+        &self,
+        route: &ClientInputRoute,
+        position: Point<f64, Logical>,
+    ) -> Option<Point<f64, Logical>> {
+        let root = self.input_layout.as_ref()?.windows.iter().find(|region| {
+            region.object_id == route.region.object_id && region.surface_id == region.object_id
+        })?;
+        if root.rect.width <= 0.0 || root.rect.height <= 0.0 {
+            return None;
+        }
+        let scene_position = position - route.scene_origin;
+        let (x, y) = root
+            .rect
+            .map_to(root.source_rect, scene_position.x, scene_position.y);
+        Some(Point::from((x, y)))
+    }
+}
