+/// The system time zone and network time, through systemd-timedated
+/// (`org.freedesktop.timedate1` on the system bus).
+///
+/// A running process keeps the zone it started with (glibc reads
+/// `/etc/localtime` once), so the shell's own clock follows a new zone after
+/// the session restarts; newly started applications use it at once.
+class SettingsDateTimeSection extends StatefulWidget {
+  const SettingsDateTimeSection({super.key});
+
+  @override
+  State<SettingsDateTimeSection> createState() =>
+      _SettingsDateTimeSectionState();
+}
+
+class _SettingsDateTimeSectionState extends State<SettingsDateTimeSection> {
+  final DBusClient _bus = DBusClient.system();
+  final TextEditingController _search = TextEditingController();
+  late final DBusRemoteObject _timedate = DBusRemoteObject(
+    _bus,
+    name: _timedateName,
+    path: DBusObjectPath(_timedatePath),
+  );
+
+  bool _loading = true;
+  bool _available = false;
+  bool _busy = false;
+  bool _choosing = false;
+  bool _zoneChanged = false;
+  String? _startupZone;
+  String? _timezone;
+  bool _ntp = false;
+  bool _synchronized = false;
+  bool _canNtp = false;
+  List<String> _zones = const <String>[];
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_refresh());
+  }
+
+  @override
+  void dispose() {
+    _search.dispose();
+    unawaited(_bus.close());
+    super.dispose();
+  }
+
+  Future<void> _refresh() async {
+    try {
+      final properties = await _timedate
+          .getAllProperties(_timedateInterface)
+          .timeout(_timeout);
+      if (!mounted) {
+        return;
+      }
+      setState(() {
+        _available = true;
+        _loading = false;
+        _timezone = _string(properties['Timezone']);
+        _startupZone ??= _timezone;
+        _ntp = _boolean(properties['NTP']);
+        _synchronized = _boolean(properties['NTPSynchronized']);
+        _canNtp = _boolean(properties['CanNTP']);
+        _zoneChanged = _timezone != _startupZone;
+      });
+    } on Object {
+      if (mounted) {
+        setState(() {
+          _loading = false;
+          _available = false;
+        });
+      }
+    }
+  }
+
+  Future<void> _loadZones() async {
+    if (_zones.isNotEmpty) {
+      return;
+    }
+    try {
+      final reply = await _timedate
+          .callMethod(
+            _timedateInterface,
+            'ListTimezones',
+            const <DBusValue>[],
+            replySignature: DBusSignature('as'),
+          )
+          .timeout(_timeout);
+      final zones = reply.returnValues.single.asStringArray().toList()..sort();
+      if (mounted) {
+        setState(() => _zones = List<String>.unmodifiable(zones));
+      }
+    } on Object catch (error) {
+      if (mounted) {
+        setState(() => _error = _message(error));
+      }
+    }
+  }
+
+  Future<void> _call(String method, List<DBusValue> arguments) async {
+    if (_busy) {
+      return;
+    }
+    setState(() {
+      _busy = true;
+      _error = null;
+    });
+    try {
+      await _timedate
+          .callMethod(
+            _timedateInterface,
+            method,
+            arguments,
+            replySignature: DBusSignature(''),
+          )
+          .timeout(_timeout);
+    } on Object catch (error) {
+      if (mounted) {
+        setState(() => _error = _message(error));
+      }
+    }
+    if (mounted) {
+      setState(() => _busy = false);
+      await _refresh();
+    }
+  }
+
+  Future<void> _setZone(String zone) async {
+    setState(() => _choosing = false);
+    _search.clear();
+    await _call('SetTimezone', <DBusValue>[
+      DBusString(zone),
+      const DBusBoolean(false),
+    ]);
+  }
+
+  Future<void> _setNtp(bool enabled) => _call('SetNTP', <DBusValue>[
+    DBusBoolean(enabled),
+    const DBusBoolean(false),
+  ]);
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final muted = ShellText.base.copyWith(
+      color: context.shellColors.textTertiary,
+      fontSize: 11.5,
+      height: 1.35,
+    );
+    if (_loading) {
+      return SettingsSection(
+        title: l10n.settingsDateTimeTitle,
+        child: Text(l10n.commonLoading, style: muted),
+      );
+    }
+    if (!_available) {
+      return SettingsSection(
+        title: l10n.settingsDateTimeTitle,
+        child: Text(l10n.settingsDateTimeUnavailable, style: muted),
+      );
+    }
+    final query = _search.text.trim().toLowerCase();
+    final matches = query.isEmpty
+        ? _zones
+        : _zones
+              .where((zone) => zone.toLowerCase().contains(query))
+              .toList(growable: false);
+    return SettingsSection(
+      title: l10n.settingsDateTimeTitle,
+      status: _synchronized
+          ? l10n.settingsDateTimeSynchronized
+          : l10n.settingsDateTimeNotSynchronized,
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Row(
+            children: [
+              Expanded(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Text(l10n.settingsDateTimeZone, style: ShellText.cardTitle),
+                    const SizedBox(height: 3),
+                    Text(_timezone ?? '—', style: muted),
+                  ],
+                ),
+              ),
+              SettingsTextButton(
+                label: _choosing
+                    ? l10n.commonCancel
+                    : l10n.settingsDateTimeChange,
+                onPressed: _busy
+                    ? null
+                    : () {
+                        setState(() => _choosing = !_choosing);
+                        if (_choosing) {
+                          unawaited(_loadZones());
+                        }
+                      },
+              ),
+            ],
+          ),
+          if (_choosing) ...[
+            const SizedBox(height: 10),
+            TextField(
+              controller: _search,
+              autofocus: true,
+              onChanged: (_) => setState(() {}),
+              style: ShellText.base.copyWith(
+                color: context.shellColors.textPrimary,
+              ),
+              decoration: InputDecoration(
+                isDense: true,
+                prefixIcon: const Icon(Icons.search_rounded, size: 18),
+                hintText: l10n.settingsDateTimeSearch,
+              ),
+            ),
+            const SizedBox(height: 8),
+            SizedBox(
+              height: 220,
+              child: _zones.isEmpty
+                  ? Center(child: Text(l10n.commonLoading, style: muted))
+                  : ListView.builder(
+                      primary: false,
+                      itemCount: matches.length,
+                      itemBuilder: (context, index) {
+                        final zone = matches[index];
+                        return InkWell(
+                          onTap: () => unawaited(_setZone(zone)),
+                          child: Padding(
+                            padding: const EdgeInsets.symmetric(
+                              vertical: 9,
+                              horizontal: 4,
+                            ),
+                            child: Text(
+                              zone,
+                              style: ShellText.base.copyWith(
+                                color: zone == _timezone
+                                    ? ShellTheme.of(context).accent
+                                    : context.shellColors.textPrimary,
+                              ),
+                            ),
+                          ),
+                        );
+                      },
+                    ),
+            ),
+          ],
+          const SizedBox(height: 12),
+          SettingsToggle(
+            label: l10n.settingsDateTimeAutomatic,
+            description: l10n.settingsDateTimeAutomaticDescription,
+            value: _ntp,
+            enabled: _canNtp && !_busy,
+            onChanged: (value) => unawaited(_setNtp(value)),
+          ),
+          if (_zoneChanged) ...[
+            const SizedBox(height: 10),
+            Text(l10n.settingsDateTimeRestartNotice, style: muted),
+          ],
+          if (_error case final error?) ...[
+            const SizedBox(height: 10),
+            Text(
+              error,
+              style: muted.copyWith(color: context.shellColors.performanceBad),
+            ),
+          ],
+        ],
+      ),
+    );
+  }
+}
+
+String? _string(DBusValue? value) => value is DBusString ? value.value : null;
+
+bool _boolean(DBusValue? value) => value is DBusBoolean && value.value;
+
+String _message(Object error) => switch (error) {
+  DBusMethodResponseException(:final response) =>
+    response.values.isNotEmpty && response.values.first is DBusString
+        ? (response.values.first as DBusString).value
+        : response.errorName,
+  TimeoutException() => 'systemd-timedated did not answer',
+  _ => '$error',
+};
