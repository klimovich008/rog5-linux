+/// Status-bar Wi-Fi glyph for a [WifiIndicator].
+class WifiStateMark extends StatelessWidget {
+  const WifiStateMark({
+    super.key,
+    required this.indicator,
+    this.size = 17,
+    this.color,
+  });
+
+  final WifiIndicator indicator;
+  final double size;
+  final Color? color;
+
+  @override
+  Widget build(BuildContext context) {
+    final foreground = color ?? context.shellColors.textPrimary;
+    final icon = switch (indicator) {
+      WifiIndicator.hidden => null,
+      WifiIndicator.off => Icons.signal_wifi_off_rounded,
+      WifiIndicator.disconnected => Icons.signal_wifi_0_bar_rounded,
+      WifiIndicator.weak => Icons.network_wifi_1_bar_rounded,
+      WifiIndicator.fair => Icons.network_wifi_2_bar_rounded,
+      WifiIndicator.good => Icons.network_wifi_3_bar_rounded,
+      WifiIndicator.excellent => Icons.signal_wifi_4_bar_rounded,
+    };
+    if (icon == null) {
+      return const SizedBox.shrink();
+    }
+    final dimmed =
+        indicator == WifiIndicator.off ||
+        indicator == WifiIndicator.disconnected;
+    return Icon(
+      icon,
+      color: dimmed ? foreground.withValues(alpha: 0.55) : foreground,
+      size: size,
+    );
+  }
+}
