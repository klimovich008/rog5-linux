+class _AboutSystem extends StatefulWidget {
+  const _AboutSystem();
+
+  @override
+  State<_AboutSystem> createState() => _AboutSystemState();
+}
+
+class _AboutSystemState extends State<_AboutSystem> {
+  late final Future<_SystemFacts> _facts = _SystemFacts.load();
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    return FutureBuilder<_SystemFacts>(
+      future: _facts,
+      builder: (context, snapshot) {
+        final facts = snapshot.data;
+        if (facts == null) {
+          return const SizedBox.shrink();
+        }
+        final memory = facts.memoryBytes;
+        final processor = switch ((facts.processor, facts.cores)) {
+          (final name?, final cores?) => l10n.settingsAboutProcessorValue(
+            name,
+            cores,
+          ),
+          (final name?, null) => name,
+          (null, final cores?) => l10n.settingsAboutCores(cores),
+          _ => null,
+        };
+        final rows = <(String, String)>[
+          if (facts.device case final value?) (l10n.settingsAboutDevice, value),
+          if (facts.operatingSystem case final value?)
+            (l10n.settingsAboutOperatingSystem, value),
+          if (facts.kernel case final value?) (l10n.settingsAboutKernel, value),
+          if (processor != null) (l10n.settingsAboutProcessor, processor),
+          if (memory != null)
+            (
+              l10n.settingsAboutMemory,
+              l10n.settingsAboutMemoryValue(
+                (memory / (1 << 30)).toStringAsFixed(1),
+              ),
+            ),
+          if (facts.hostname case final value?)
+            (l10n.settingsAboutHostname, value),
+        ];
+        if (rows.isEmpty) {
+          return const SizedBox.shrink();
+        }
+        return Padding(
+          padding: const EdgeInsets.only(top: 4),
+          child: DecoratedBox(
+            decoration: BoxDecoration(
+              color: context.shellColors.surfaceContainer,
+              borderRadius: context.shellTheme.borderRadius(ShellRadii.chip),
+              border: Border.all(color: context.shellColors.hairlineSoft),
+            ),
+            child: Padding(
+              padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 14),
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                children: [
+                  Text(
+                    l10n.settingsAboutSystemTitle,
+                    style: ShellText.cardTitle,
+                  ),
+                  const SizedBox(height: 10),
+                  for (final (label, value) in rows)
+                    Padding(
+                      padding: const EdgeInsets.symmetric(vertical: 4),
+                      child: Row(
+                        crossAxisAlignment: CrossAxisAlignment.start,
+                        children: [
+                          SizedBox(
+                            width: 118,
+                            child: Text(
+                              label,
+                              style: ShellText.base.copyWith(
+                                color: context.shellColors.textTertiary,
+                                fontSize: 12,
+                              ),
+                            ),
+                          ),
+                          Expanded(
+                            child: Text(
+                              value,
+                              style: ShellText.base.copyWith(
+                                color: context.shellColors.textPrimary,
+                                fontSize: 12,
+                              ),
+                            ),
+                          ),
+                        ],
+                      ),
+                    ),
+                ],
+              ),
+            ),
+          ),
+        );
+      },
+    );
+  }
+}
 
