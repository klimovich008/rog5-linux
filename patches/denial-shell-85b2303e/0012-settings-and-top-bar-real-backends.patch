+/// Wi-Fi state for the status bar, from the network service.
+enum WifiIndicator { hidden, off, disconnected, weak, fair, good, excellent }
+
+/// Maps the network snapshot onto the status-bar Wi-Fi indicator: hidden when
+/// there is no Wi-Fi service or adapter, crossed out when the radio is off,
+/// an empty fan while disconnected or connecting, and the signal of the
+/// connected network otherwise.
+WifiIndicator wifiIndicatorFor(NetworkConnectivityState state) {
+  final snapshot = state.snapshot;
+  if (state.initializing ||
+      !snapshot.serviceAvailable ||
+      !snapshot.wifiDeviceAvailable) {
+    return WifiIndicator.hidden;
+  }
+  if (!snapshot.wirelessHardwareEnabled || !snapshot.wirelessEnabled) {
+    return WifiIndicator.off;
+  }
+  final connected = snapshot.connectedNetwork;
+  if (connected == null) {
+    return WifiIndicator.disconnected;
+  }
+  final strength = connected.strength;
+  if (strength >= 75) {
+    return WifiIndicator.excellent;
+  }
+  if (strength >= 50) {
+    return WifiIndicator.good;
+  }
+  if (strength >= 25) {
+    return WifiIndicator.fair;
+  }
+  return WifiIndicator.weak;
+}
