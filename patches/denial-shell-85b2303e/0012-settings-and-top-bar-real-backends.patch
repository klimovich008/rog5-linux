+/// Facts about this machine, read from procfs, the devicetree and
+/// os-release. Rows whose source is missing are left out.
+@immutable
+class _SystemFacts {
+  const _SystemFacts({
+    this.device,
+    this.operatingSystem,
+    this.kernel,
+    this.hostname,
+    this.processor,
+    this.cores,
+    this.memoryBytes,
+  });
+
+  final String? device;
+  final String? operatingSystem;
+  final String? kernel;
+  final String? hostname;
+  final String? processor;
+  final int? cores;
+  final int? memoryBytes;
+
+  static Future<String?> _read(String path) async {
+    try {
+      final text = (await File(
+        path,
+      ).readAsString()).replaceAll('\u0000', ' ').trim();
+      return text.isEmpty ? null : text;
+    } on Object {
+      return null;
+    }
+  }
+
+  static Future<_SystemFacts> load() async {
+    final results = await Future.wait<String?>(<Future<String?>>[
+      _read('/proc/device-tree/model'),
+      _read('/sys/class/dmi/id/product_name'),
+      _read('/etc/os-release'),
+      _read('/proc/sys/kernel/osrelease'),
+      _read('/proc/sys/kernel/hostname'),
+      _read('/proc/device-tree/compatible'),
+      _read('/proc/cpuinfo'),
+      _read('/proc/meminfo'),
+    ]);
+    String? osName;
+    for (final line in (results[2] ?? '').split('\n')) {
+      if (line.startsWith('PRETTY_NAME=')) {
+        osName = line.substring(12).replaceAll('"', '').trim();
+      }
+    }
+    // The last devicetree compatible entry names the SoC (qcom,sm8350).
+    final compatible = (results[5] ?? '')
+        .split(RegExp(r'\s+'))
+        .where((entry) => entry.isNotEmpty)
+        .toList();
+    String? processor = compatible.isEmpty ? null : compatible.last;
+    if (processor != null && processor.contains(',')) {
+      final parts = processor.split(',');
+      processor =
+          '${parts.first.toUpperCase() == 'QCOM' ? 'Qualcomm' : parts.first} ${parts.last.toUpperCase()}';
+    }
+    final cpuinfo = results[6] ?? '';
+    final cores = RegExp(
+      r'^processor\s*:',
+      multiLine: true,
+    ).allMatches(cpuinfo).length;
+    final memory = RegExp(
+      r'^MemTotal:\s+(\d+)\s+kB',
+      multiLine: true,
+    ).firstMatch(results[7] ?? '');
+    return _SystemFacts(
+      device: results[0] ?? results[1],
+      operatingSystem: osName,
+      kernel: results[3],
+      hostname: results[4],
+      processor: processor,
+      cores: cores == 0 ? null : cores,
+      memoryBytes: memory == null ? null : int.parse(memory.group(1)!) * 1024,
+    );
+  }
+}
