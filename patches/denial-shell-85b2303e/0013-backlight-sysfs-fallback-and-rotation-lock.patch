+    /// Whether the shell locked the internal panel's rotation
+    /// (`layout.rotationLock`). Missing or malformed means locked: a phone
+    /// shell starts upright until the user turns auto-rotate on.
+    pub(super) fn rotation_locked(&self) -> bool {
+        self.document
+            .get("layout")
+            .and_then(Value::as_object)
+            .and_then(|layout| layout.get("rotationLock"))
+            .and_then(Value::as_bool)
+            .unwrap_or(true)
+    }
+
     pub(super) fn document_json(&self) -> Result<String, SettingsError> {
         let bytes = render_document(&self.document)?;
         String::from_utf8(bytes)
