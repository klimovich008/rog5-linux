+/// Opt-in switch for locking the session on the power key.
+///
+/// Off by default: a device without a usable credential would only gain a
+/// swipe-to-unlock screen. Set `DENIAL_POWER_KEY_LOCK=1` in the session
+/// environment once the account has a password.
+#[cfg(feature = "flutter")]
+const POWER_KEY_LOCK_ENV: &str = "DENIAL_POWER_KEY_LOCK";
+
+#[cfg(feature = "flutter")]
+fn power_key_locks_session() -> bool {
+    std::env::var_os(POWER_KEY_LOCK_ENV).is_some_and(|value| value == "1")
+}
+
+/// Locks the session for a power-key blank. Returns whether it locked.
+#[cfg(feature = "flutter")]
+fn lock_session_for_power_key(events: &RuntimeState) -> bool {
+    let Some(authentication) = events.authentication.as_ref() else {
+        warn!("power key could not lock the session: authentication is unavailable");
+        return false;
+    };
+    authentication.lock();
+    true
+}
+
+/// Applies a queued physical power-key press at the DPMS boundary.
+///
+/// With any output lit, the press blanks every output through the same
+/// compositor-owned path as the shell's screen-off request (after locking
+/// the session, when [`POWER_KEY_LOCK_ENV`] opts in). With every output
+/// already off, it counts as user activity, which wakes the outputs the idle
+/// policy blanked.
+#[cfg(feature = "flutter")]
+pub(super) fn synchronize_power_key(scanouts: &[Scanout], events: &mut RuntimeState) {
+    if !std::mem::take(&mut events.power_key_pending) {
+        return;
+    }
+    if !scanouts.iter().any(|scanout| scanout.powered) {
+        events.note_user_activity();
+        info!("power key woke the displays");
+        return;
+    }
+    let locked = power_key_locks_session() && lock_session_for_power_key(events);
+    let requests = events.idle_policy.blank_now(
+        scanouts
+            .iter()
+            .map(|scanout| (scanout.output.id, scanout.powered)),
+    );
+    events.queue_idle_power_requests(requests);
+    info!(
+        locked,
+        "power key requested immediate compositor-owned display power-off"
+    );
+}
