+/// Whether the session account has a password that PAM could accept.
+///
+/// A shadow password field that matches no password (empty, `x`, `*`, or
+/// `!`-prefixed) means the device has no screen-lock secret, so locking would
+/// only add a swipe. Unknown or unreadable state keeps locking. The field is
+/// only classified, never logged or retained.
+pub(super) fn session_account_has_usable_password() -> bool {
+    let username = current_username();
+    let Ok(shadow) = std::fs::read_to_string("/etc/shadow") else {
+        return true;
+    };
+    shadow
+        .lines()
+        .filter_map(|line| line.split_once(':'))
+        .find(|(name, _)| *name == username)
+        .map(|(_, rest)| rest.split(':').next().unwrap_or_default())
+        .is_none_or(|field| {
+            !(field.is_empty() || field == "x" || field == "*" || field.starts_with('!'))
+        })
+}
