+/// Linux evdev `KEY_POWER`, emitted by the PMIC power button (`pmic_pwrkey`).
+#[cfg(feature = "flutter")]
+const EVDEV_KEY_POWER: u32 = 116;
+
+/// Handles the physical power key like a phone's: while any output is
+/// blanked it wakes the displays; otherwise it blanks them through the same
+/// compositor-owned path as the shell's screen-off request, first locking
+/// the session when the account has a usable password. Both press and
+/// release are consumed so no client or shell ever sees the key.
+#[cfg(feature = "flutter")]
+fn intercept_power_key(state: &mut RuntimeState, keycode: Keycode, key_state: KeyState) -> bool {
+    // Smithay/XKB keycodes carry the conventional eight-code offset.
+    if keycode.raw().checked_sub(8) != Some(EVDEV_KEY_POWER) {
+        return false;
+    }
+    if key_state != KeyState::Pressed {
+        return true;
+    }
+    if state.idle_policy.has_blanked_outputs() {
+        state.note_user_activity();
+        info!("power key woke the displays");
+        return true;
+    }
+    if super::super::authentication::session_account_has_usable_password() {
+        if let Some(authentication) = state.authentication.as_ref() {
+            authentication.lock();
+        } else {
+            warn!("power key could not lock the session: authentication is unavailable");
+        }
+    }
+    state.power_key_blank_requested = true;
+    info!("power key requested display power-off");
+    true
+}
