+++ b/compositor/src/bin/deniald/boot_animation.rs
@@ -0,0 +1,424 @@
+//! Boot animation between the boot splash and Flutter's first frame.
+//!
+//! Startup no longer commits a placeholder scanout buffer. Instead deniald
+//! draws a small animation on the CPU into two linear dumb buffers of its own
+//! and page-flips between them until Flutter delivers its first rendered
+//! frame. That frame then performs the output's initial modeset through the
+//! scheduler's wake path (`OutputScheduler::defer_initial_modeset`), which
+//! waits while an animation flip is still in flight. Nothing unrendered is
+//! ever scanned out, and no GPU or Flutter work is needed to draw it.
+//!
+//! The animation is an accent-coloured ring with a bright arc that sweeps
+//! around it (a comet tail), fading in on black. It is symmetric, so an output
+//! rotation only changes where the arc starts.
+
+use std::time::{Duration, Instant};
+
+use smithay::reexports::drm::buffer::Buffer as _;
+use smithay::reexports::drm::control::dumbbuffer::DumbBuffer;
+
+use super::kms_render::output_plane_state;
+use super::output_scheduler::OutputScheduler;
+use super::*;
+
+/// Frame pacing target. The ring is small, so drawing costs well under 1 ms.
+const FRAME_INTERVAL: Duration = Duration::from_millis(16);
+const FADE_IN: Duration = Duration::from_millis(400);
+/// One revolution of the bright arc.
+const REVOLUTION: Duration = Duration::from_millis(1100);
+/// Flutter normally takes 0.1-5 s. Beyond this the animation keeps running,
+/// but the stall is logged once.
+const FLUTTER_LATE_WARNING: Duration = Duration::from_secs(20);
+/// Test hook: keep animating at least this many milliseconds (at most 10 s)
+/// even when Flutter is ready sooner. Unset means hand over immediately.
+const MINIMUM_DURATION_ENV: &str = "DENIAL_BOOT_ANIMATION_MIN_MS";
+
+/// Ring radius and stroke as a fraction of the output's shorter side.
+const RING_RADIUS: f32 = 0.062;
+const RING_STROKE: f32 = 0.011;
+/// Brightness of the ring outside the arc, the arc's length in turns, and
+/// how far the arc's head is lifted toward white (wallpaper accents can be
+/// dark on black).
+const RING_BASE: f32 = 0.18;
+const ARC_TURNS: f32 = 0.45;
+const HEAD_LIFT: f32 = 0.45;
+
+struct AnimationBuffer {
+    buffer: Option<DumbBuffer>,
+    framebuffer: framebuffer::Handle,
+    /// Filled black once; later frames only redraw the ring's bounding box.
+    cleared: bool,
+}
+
+struct AnimatedOutput {
+    output_id: OutputId,
+    scanout_index: usize,
+    crtc: crtc::Handle,
+    size: PixelSize,
+    buffers: [AnimationBuffer; 2],
+    /// Buffer shown (or being flipped to) most recently.
+    front: usize,
+    flip_pending: bool,
+    next_frame_at: Instant,
+    /// Flutter's first frame is ready; no further flips are started.
+    handing_over: bool,
+    /// The scheduler's wake path may commit Flutter's frame now.
+    released: bool,
+}
+
+pub(super) enum BootAnimationStep {
+    Running,
+    Finished,
+}
+
+pub(super) struct BootAnimation {
+    outputs: Vec<AnimatedOutput>,
+    started_at: Instant,
+    frames: u64,
+    accent: [f32; 3],
+    late_warning_logged: bool,
+    minimum_duration: Duration,
+}
+
+impl BootAnimation {
+    /// Allocates the buffers, draws the first frame and performs the initial
+    /// modeset with it on every output the scheduler is waiting to wake.
+    pub(super) fn start(
+        drm: &DrmDevice,
+        scanouts: &[Scanout],
+        swapchains: &OutputSwapchains,
+        scheduler: &OutputScheduler,
+        accent: DesktopAccentColor,
+        events: &mut RuntimeState,
+    ) -> Result<Self, Box<dyn Error>> {
+        let started_at = Instant::now();
+        let mut animation = Self {
+            outputs: Vec::new(),
+            started_at,
+            frames: 0,
+            accent: [
+                srgb_to_linear(accent.red),
+                srgb_to_linear(accent.green),
+                srgb_to_linear(accent.blue),
+            ],
+            late_warning_logged: false,
+            minimum_duration: std::env::var(MINIMUM_DURATION_ENV)
+                .ok()
+                .and_then(|value| value.trim().parse::<u64>().ok())
+                .map_or(Duration::ZERO, |milliseconds| {
+                    Duration::from_millis(milliseconds.min(10_000))
+                }),
+        };
+        for (scanout_index, scanout) in scanouts.iter().enumerate() {
+            let output_id = scanout.output.id;
+            if !scanout.powered || !scheduler.power_on_pending(output_id) {
+                continue;
+            }
+            let size = swapchains
+                .for_output(output_id)
+                .ok_or("boot animation output has no native pool")?
+                .size;
+            let buffers = match [
+                AnimationBuffer::allocate(drm, size),
+                AnimationBuffer::allocate(drm, size),
+            ] {
+                [Ok(first), Ok(second)] => [first, second],
+                [first, second] => {
+                    for buffer in [first, second].into_iter().flatten() {
+                        buffer.release(drm);
+                    }
+                    animation.release(drm);
+                    return Err("could not allocate boot animation buffers".into());
+                }
+            };
+            animation.outputs.push(AnimatedOutput {
+                output_id,
+                scanout_index,
+                crtc: scanout.output.crtc,
+                size,
+                buffers,
+                front: 1,
+                flip_pending: false,
+                next_frame_at: started_at,
+                handing_over: false,
+                released: false,
+            });
+        }
+        if animation.outputs.is_empty() {
+            return Err("no output is waiting for its initial modeset".into());
+        }
+
+        let now = Instant::now();
+        let mut failure = None;
+        for index in 0..animation.outputs.len() {
+            if let Err(error) = animation.present(index, drm, scanouts, now, true) {
+                failure = Some(error);
+                break;
+            }
+        }
+        if let Some(error) = failure {
+            // An output may already show an animation frame; its buffers must
+            // outlive that. Keep them and let Flutter take over as before.
+            animation.abandon(events);
+            return Err(error);
+        }
+        for output in &animation.outputs {
+            events.boot_animation_crtcs.insert(output.crtc);
+        }
+        info!(
+            outputs = animation.outputs.len(),
+            setup_ms = started_at.elapsed().as_millis(),
+            "boot animation performed the initial modeset; waiting for Flutter's first frame"
+        );
+        Ok(animation)
+    }
+
+    /// Advances the animation and hands each output over once Flutter's
+    /// first frame is ready. Must run before the scheduler retires page-flip
+    /// completions, which would otherwise discard the animation's own.
+    pub(super) fn step(
+        &mut self,
+        drm: &DrmDevice,
+        scanouts: &[Scanout],
+        scheduler: &OutputScheduler,
+        events: &mut RuntimeState,
+    ) -> Result<BootAnimationStep, Box<dyn Error>> {
+        // Only this animation's own flips: once an output is released, its
+        // next completion belongs to Flutter's first frame.
+        let crtcs = self
+            .outputs
+            .iter()
+            .filter(|output| !output.released)
+            .map(|output| output.crtc)
+            .collect::<Vec<_>>();
+        events.completed_page_flips.retain(|completion| {
+            let ours = crtcs.contains(&completion.crtc);
+            if ours && let Some(output) = self
+                .outputs
+                .iter_mut()
+                .find(|output| output.crtc == completion.crtc)
+            {
+                output.flip_pending = false;
+            }
+            !ours
+        });
+
+        let now = Instant::now();
+        let minimum_reached = now.saturating_duration_since(self.started_at) >= self.minimum_duration;
+        for index in 0..self.outputs.len() {
+            let output = &mut self.outputs[index];
+            if output.released {
+                continue;
+            }
+            if !output.handing_over
+                && minimum_reached
+                && scheduler.wake_frame_ready(output.output_id)
+            {
+                output.handing_over = true;
+            }
+            if output.handing_over {
+                if !output.flip_pending {
+                    output.released = true;
+                    events.boot_animation_crtcs.remove(&output.crtc);
+                }
+                continue;
+            }
+            if !scheduler.power_on_pending(output.output_id) {
+                // The scheduler was rebuilt (topology change or recovery) and
+                // no longer waits for a first frame: stop drawing.
+                output.handing_over = true;
+                continue;
+            }
+            if output.flip_pending || now < output.next_frame_at {
+                continue;
+            }
+            self.present(index, drm, scanouts, now, false)?;
+        }
+
+        if !self.late_warning_logged && self.started_at.elapsed() >= FLUTTER_LATE_WARNING {
+            self.late_warning_logged = true;
+            warn!(
+                elapsed_ms = self.started_at.elapsed().as_millis(),
+                frames = self.frames,
+                "Flutter has not produced a first frame; the boot animation keeps running"
+            );
+        }
+
+        let handed_over = self.outputs.iter().all(|output| {
+            output.released && !output.flip_pending && !scheduler.power_on_pending(output.output_id)
+        });
+        if !handed_over {
+            return Ok(BootAnimationStep::Running);
+        }
+        info!(
+            duration_ms = self.started_at.elapsed().as_millis(),
+            frames = self.frames,
+            "boot animation handed over to Flutter's first frame"
+        );
+        self.release(drm);
+        Ok(BootAnimationStep::Finished)
+    }
+
+    /// Stops the animation after a failure. Buffers that may still be on
+    /// screen are kept (a scanned-out framebuffer must not be removed).
+    pub(super) fn abandon(&mut self, events: &mut RuntimeState) {
+        for output in &mut self.outputs {
+            output.handing_over = true;
+            output.released = true;
+            events.boot_animation_crtcs.remove(&output.crtc);
+        }
+    }
+
+    fn present(
+        &mut self,
+        index: usize,
+        drm: &DrmDevice,
+        scanouts: &[Scanout],
+        now: Instant,
+        modeset: bool,
+    ) -> Result<(), Box<dyn Error>> {
+        let elapsed = now.saturating_duration_since(self.started_at);
+        let accent = self.accent;
+        let output = &mut self.outputs[index];
+        let back = 1 - output.front;
+        let scanout = scanouts
+            .get(output.scanout_index)
+            .ok_or("boot animation output lost its scanout")?;
+        {
+            let buffer = output.buffers[back]
+                .buffer
+                .as_mut()
+                .ok_or("boot animation buffer was released")?;
+            let pitch = buffer.pitch() as usize;
+            let mut mapping = drm.map_dumb_buffer(buffer)?;
+            if !output.buffers[back].cleared {
+                mapping.fill(0);
+            }
+            draw_frame(&mut mapping, pitch, output.size, elapsed, accent);
+        }
+        output.buffers[back].cleared = true;
+        let state = output_plane_state(scanout, output.buffers[back].framebuffer, output.size);
+        if modeset {
+            scanout.surface.test_state([state.clone()], true)?;
+            scanout.surface.commit([state], true)?;
+        } else {
+            scanout.surface.page_flip([state], true)?;
+        }
+        output.front = back;
+        output.flip_pending = true;
+        output.next_frame_at = now + FRAME_INTERVAL;
+        self.frames = self.frames.saturating_add(1);
+        Ok(())
+    }
+
+    fn release(&mut self, drm: &DrmDevice) {
+        for output in &mut self.outputs {
+            for buffer in &mut output.buffers {
+                buffer.release_in_place(drm);
+            }
+        }
+        self.outputs.clear();
+    }
+}
+
+impl AnimationBuffer {
+    fn allocate(drm: &DrmDevice, size: PixelSize) -> Result<Self, Box<dyn Error>> {
+        let buffer = drm.create_dumb_buffer((size.width, size.height), DrmFourcc::Xrgb8888, 32)?;
+        let framebuffer = match drm.add_framebuffer(&buffer, 24, 32) {
+            Ok(framebuffer) => framebuffer,
+            Err(error) => {
+                let _ = drm.destroy_dumb_buffer(buffer);
+                return Err(error.into());
+            }
+        };
+        Ok(Self {
+            buffer: Some(buffer),
+            framebuffer,
+            cleared: false,
+        })
+    }
+
+    fn release(mut self, drm: &DrmDevice) {
+        self.release_in_place(drm);
+    }
+
+    fn release_in_place(&mut self, drm: &DrmDevice) {
+        if let Some(buffer) = self.buffer.take() {
+            if let Err(error) = drm.destroy_framebuffer(self.framebuffer) {
+                warn!(%error, "could not remove a boot animation framebuffer");
+            }
+            if let Err(error) = drm.destroy_dumb_buffer(buffer) {
+                warn!(%error, "could not free a boot animation buffer");
+            }
+        }
+    }
+}
+
+/// Draws one frame into a linear XRGB8888 mapping (bytes B, G, R, X).
+fn draw_frame(pixels: &mut [u8], pitch: usize, size: PixelSize, elapsed: Duration, accent: [f32; 3]) {
+    let width = size.width as f32;
+    let height = size.height as f32;
+    let short_side = width.min(height);
+    let radius = short_side * RING_RADIUS;
+    let half_stroke = short_side * RING_STROKE * 0.5;
+    let center_x = width * 0.5;
+    let center_y = height * 0.5;
+    let fade = (elapsed.as_secs_f32() / FADE_IN.as_secs_f32()).clamp(0.0, 1.0);
+    let fade = fade * fade * (3.0 - 2.0 * fade);
+    let head = (elapsed.as_secs_f32() / REVOLUTION.as_secs_f32()).fract();
+
+    let extent = radius + half_stroke + 2.0;
+    let left = (center_x - extent).floor().max(0.0) as usize;
+    let right = ((center_x + extent).ceil() as usize).min(size.width as usize);
+    let top = (center_y - extent).floor().max(0.0) as usize;
+    let bottom = ((center_y + extent).ceil() as usize).min(size.height as usize);
+    for y in top..bottom {
+        let row = y * pitch;
+        let dy = y as f32 + 0.5 - center_y;
+        for x in left..right {
+            let dx = x as f32 + 0.5 - center_x;
+            let distance = (dx * dx + dy * dy).sqrt();
+            let coverage = (half_stroke + 0.5 - (distance - radius).abs()).clamp(0.0, 1.0);
+            let offset = row + x * 4;
+            let Some(pixel) = pixels.get_mut(offset..offset + 4) else {
+                continue;
+            };
+            if coverage <= 0.0 {
+                pixel.copy_from_slice(&[0, 0, 0, 0xff]);
+                continue;
+            }
+            // Clockwise from the top, in turns.
+            let angle = (dx.atan2(-dy) / std::f32::consts::TAU).rem_euclid(1.0);
+            let behind = (head - angle).rem_euclid(1.0);
+            let tail = if behind < ARC_TURNS {
+                let t = 1.0 - behind / ARC_TURNS;
+                t * t * (3.0 - 2.0 * t)
+            } else {
+                0.0
+            };
+            let intensity = (RING_BASE + (1.0 - RING_BASE) * tail) * coverage * fade;
+            let lift = HEAD_LIFT * tail * tail;
+            let channel = |value: f32| linear_to_srgb((value + (1.0 - value) * lift) * intensity);
+            pixel.copy_from_slice(&[channel(accent[2]), channel(accent[1]), channel(accent[0]), 0xff]);
+        }
+    }
+}
+
+fn srgb_to_linear(value: u8) -> f32 {
+    let value = f32::from(value) / 255.0;
+    if value <= 0.04045 {
+        value / 12.92
+    } else {
+        ((value + 0.055) / 1.055).powf(2.4)
+    }
+}
+
+fn linear_to_srgb(value: f32) -> u8 {
+    let value = value.clamp(0.0, 1.0);
+    let encoded = if value <= 0.003_130_8 {
+        value * 12.92
+    } else {
+        1.055 * value.powf(1.0 / 2.4) - 0.055
+    };
+    (encoded * 255.0 + 0.5) as u8
+}
