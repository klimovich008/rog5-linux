+  /// Input regions for a window drawn at [placement] (its content rectangle
+  /// in view coordinates, see [MobileWindowLayout.contentRect]).
+  ///
+  /// The source rectangle is in root-surface coordinates, which start at the
+  /// client's shadow/CSD origin rather than at its window geometry, and the
+  /// content may be scaled down to fit.
+  List<InputWindowRegion> _placedInputRegions({
+    required DenialWindow window,
+    required Rect placement,
+    required Rect visibleArea,
+  }) {
+    final content = window.contentCoordinateRect;
+    if (placement.isEmpty || content.width <= 0.0 || content.height <= 0.0) {
+      return const <InputWindowRegion>[];
+    }
+    final regions = <InputWindowRegion>[];
+    for (final popup in window.popupRoots.toList(growable: false).reversed) {
+      final popupRect = window.mapSurfaceRect(popup, placement);
+      final clipped = popupRect.intersect(visibleArea);
+      if (clipped.isEmpty ||
+          popupRect.width <= 0.0 ||
+          popupRect.height <= 0.0) {
+        continue;
+      }
+      final scaleX = popup.surfaceWidth / popupRect.width;
+      final scaleY = popup.surfaceHeight / popupRect.height;
+      regions.add(
+        InputWindowRegion(
+          window: window,
+          surfaceId: popup.surfaceId,
+          rect: clipped,
+          sourceRect: Rect.fromLTWH(
+            (clipped.left - popupRect.left) * scaleX,
+            (clipped.top - popupRect.top) * scaleY,
+            clipped.width * scaleX,
+            clipped.height * scaleY,
+          ),
+          z: popup.compositionOrder + 1,
+          geometryLocked: true,
+        ),
+      );
+    }
+    final rect = placement.intersect(visibleArea);
+    if (rect.isEmpty) {
+      return regions;
+    }
+    final scaleX = content.width / placement.width;
+    final scaleY = content.height / placement.height;
+    regions.add(
+      InputWindowRegion(
+        window: window,
+        // Route through the toplevel root so native hit testing can select an
+        // input-capable subsurface rather than the current primary texture.
+        surfaceId: window.objectId,
+        rect: rect,
+        sourceRect: Rect.fromLTWH(
+          content.left + (rect.left - placement.left) * scaleX,
+          content.top + (rect.top - placement.top) * scaleY,
+          rect.width * scaleX,
+          rect.height * scaleY,
+        ),
+        z: 0,
+        geometryLocked: true,
+      ),
+    );
+    return regions;
+  }
