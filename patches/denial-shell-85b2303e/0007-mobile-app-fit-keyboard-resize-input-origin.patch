+/// Where a Wayland application window sits on the phone screen.
+///
+/// Apps are configured to the area between the status bar and the home-pill
+/// strip, and to the area above the software keyboard while it is open for
+/// them. A client that keeps a different size is not cropped or stretched:
+/// an oversized window is scaled down to fit that area (keeping its aspect
+/// ratio) and a smaller one is shown at its own size, centred (letterboxed).
+/// Painting and native input routing both use [contentRect], so a touch
+/// lands where the content is drawn.
+class MobileWindowLayout {
+  const MobileWindowLayout._();
+
+  /// Whether the software keyboard resizes [window] instead of panning the
+  /// whole scene up by its height.
+  static bool resizesForKeyboard(DenialWindow? window) {
+    return window != null && window.isUserApp && !window.isLocalFlutter;
+  }
+
+  /// The configured area of an application window in view coordinates.
+  static Rect frameRect(Size viewSize, {bool keyboard = false}) {
+    const top = ShellMetrics.appStatusBarHeight;
+    final bottom = keyboard
+        ? viewSize.height - ShellMetrics.edgePanelHeight(viewSize)
+        : viewSize.height - ShellMetrics.appGestureBandHeight;
+    return Rect.fromLTRB(
+      0.0,
+      top,
+      viewSize.width,
+      bottom < top + 64.0 ? top + 64.0 : bottom,
+    );
+  }
+
+  /// The size to configure [window] with for [frame].
+  ///
+  /// A client wider than the screen (a minimum width) is drawn scaled down
+  /// to the screen width, so it is asked for a proportionally taller window
+  /// and then fills the frame instead of leaving empty bands.
+  static Size configureSize(DenialWindow window, Rect frame) {
+    final contentWidth = window.contentCoordinateRect.width;
+    if (!window.isUserApp ||
+        frame.isEmpty ||
+        contentWidth <= frame.width + 1.0 ||
+        contentWidth > frame.width * 4.0) {
+      return frame.size;
+    }
+    return Size(frame.width, frame.height * contentWidth / frame.width);
+  }
+
+  /// The rectangle that shows [window]'s content (its window geometry).
+  static Rect contentRect(DenialWindow window, Size viewSize) {
+    final frame = frameRect(viewSize);
+    final content = window.contentCoordinateRect;
+    if (!window.isUserApp ||
+        content.width <= 0.0 ||
+        content.height <= 0.0 ||
+        frame.isEmpty) {
+      return frame;
+    }
+    var scale = frame.width / content.width;
+    final heightScale = frame.height / content.height;
+    if (heightScale < scale) {
+      scale = heightScale;
+    }
+    if (scale > 1.0) {
+      scale = 1.0;
+    }
+    final width = content.width * scale;
+    final height = content.height * scale;
+    final left = frame.left + (frame.width - width) / 2.0;
+    // A window about as tall as the area above the keyboard or taller stays
+    // at the top, so the keyboard resize (and terminals rounding to whole
+    // rows) never moves it; a smaller one (a video, a dialog) is centred.
+    final keyboardFrame = frameRect(viewSize, keyboard: true);
+    final top = content.height >= keyboardFrame.height - _topAlignSlack
+        ? frame.top
+        : frame.top + (frame.height - height) / 2.0;
+    return Rect.fromLTWH(
+      _snap(left),
+      _snap(top),
+      width,
+      height,
+    );
+  }
+
+  static const double _topAlignSlack = 48.0;
+
+  // Whole logical pixels; the texture viewport aligns to device pixels.
+  static double _snap(double value) => value.roundToDouble();
 }
 
