+/// Fills the frame outside the window content, so a translucent window still
+/// shows the blurred scene behind it while the letterbox bands are solid.
+class _LetterboxPainter extends CustomPainter {
+  const _LetterboxPainter({required this.color, required this.content});
+
+  final Color color;
+  final Rect content;
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    final path = Path()
+      ..fillType = PathFillType.evenOdd
+      ..addRect(Offset.zero & size)
+      ..addRect(content);
+    canvas.drawPath(path, Paint()..color = color);
+  }
+
+  @override
+  bool shouldRepaint(_LetterboxPainter oldDelegate) =>
+      oldDelegate.color != color || oldDelegate.content != content;
 }
