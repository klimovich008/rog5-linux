+import 'dart:async';
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+
+/// Reports whether the session account has an unlock secret.
+///
+/// Native PAM remains the authority for unlocking. This probe only decides
+/// whether the shell should start that PAM conversation by itself, which is
+/// the equivalent of Android's "Screen lock: None": an account whose password
+/// field is empty (`root::...` in the shadow file) authenticates without a
+/// prompt, so a swipe-to-unlock screen adds nothing.
+///
+/// Every uncertain case (unreadable files, unknown user, locked `!`/`*`
+/// fields, hashes) reports a credential, which keeps the ordinary lock screen.
+class SessionCredentialProbe {
+  SessionCredentialProbe({
+    this.statusPath = '/proc/self/status',
+    this.passwdPath = '/etc/passwd',
+    this.shadowPath = '/etc/shadow',
+  });
+
+  final String statusPath;
+  final String passwdPath;
+  final String shadowPath;
+
+  /// Returns false only when the account's password field is positively
+  /// known to be empty.
+  Future<bool> hasCredential() async {
+    try {
+      final uid = await _realUserId();
+      if (uid == null) {
+        return true;
+      }
+      final passwd = _findEntry(
+        await File(passwdPath).readAsLines(),
+        (fields) => fields.length >= 7 && fields[2] == uid,
+      );
+      if (passwd == null) {
+        return true;
+      }
+      if (passwd[1] != 'x') {
+        return passwd[1].isNotEmpty;
+      }
+      final name = passwd[0];
+      final shadow = _findEntry(
+        await File(shadowPath).readAsLines(),
+        (fields) => fields.length >= 2 && fields[0] == name,
+      );
+      if (shadow == null) {
+        return true;
+      }
+      return shadow[1].isNotEmpty;
+    } on FileSystemException catch (error) {
+      debugPrint('denia lock: credential probe failed: $error');
+      return true;
+    } on FormatException catch (error) {
+      debugPrint('denia lock: credential probe failed: $error');
+      return true;
+    }
+  }
+
+  /// Emits whenever the account databases may have changed (for example
+  /// after `passwd`, which replaces the shadow file by rename).
+  Stream<void> watchChanges() {
+    final directories = <String>{
+      File(passwdPath).parent.path,
+      File(shadowPath).parent.path,
+    };
+    final paths = <String>{passwdPath, shadowPath};
+    final controller = StreamController<void>.broadcast();
+    final subscriptions = <StreamSubscription<FileSystemEvent>>[];
+    controller
+      ..onListen = () {
+        for (final directory in directories) {
+          try {
+            subscriptions.add(
+              Directory(directory).watch().listen(
+                (event) {
+                  final destination = event is FileSystemMoveEvent
+                      ? event.destination
+                      : null;
+                  if (paths.contains(event.path) ||
+                      paths.contains(destination)) {
+                    controller.add(null);
+                  }
+                },
+                onError: (Object error) {
+                  debugPrint('denia lock: account watch failed: $error');
+                },
+              ),
+            );
+          } on FileSystemException catch (error) {
+            debugPrint('denia lock: account watch unavailable: $error');
+          }
+        }
+      }
+      ..onCancel = () async {
+        final active = List.of(subscriptions);
+        subscriptions.clear();
+        for (final subscription in active) {
+          await subscription.cancel();
+        }
+      };
+    return controller.stream;
+  }
+
+  Future<String?> _realUserId() async {
+    for (final line in await File(statusPath).readAsLines()) {
+      if (line.startsWith('Uid:')) {
+        final fields = line
+            .substring(4)
+            .trim()
+            .split(RegExp(r'\s+'))
+            .where((field) => field.isNotEmpty)
+            .toList(growable: false);
+        if (fields.isNotEmpty && int.tryParse(fields.first) != null) {
+          return fields.first;
+        }
+        return null;
+      }
+    }
+    return null;
+  }
+
+  static List<String>? _findEntry(
+    List<String> lines,
+    bool Function(List<String> fields) matches,
+  ) {
+    for (final line in lines) {
+      if (line.isEmpty || line.startsWith('#')) {
+        continue;
+      }
+      final fields = line.split(':');
+      if (matches(fields)) {
+        return fields;
+      }
+    }
+    return null;
+  }
+}
