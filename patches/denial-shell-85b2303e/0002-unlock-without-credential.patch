+import 'dart:async';
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../services/session_credential_probe.dart';
+import 'notifier_lifecycle.dart';
+
+final sessionCredentialProbeProvider = Provider<SessionCredentialProbe>(
+  (ref) => SessionCredentialProbe(),
+);
+
+/// Whether the session account has an unlock secret.
+///
+/// `null` means not yet known; consumers must treat that like `true` so the
+/// ordinary secure lock is kept until the probe positively reports an
+/// account without a password.
+final sessionCredentialProvider =
+    NotifierProvider<SessionCredentialController, bool?>(
+      SessionCredentialController.new,
+    );
+
+class SessionCredentialController extends Notifier<bool?>
+    with NotifierLifecycle<bool?> {
+  late SessionCredentialProbe _probe;
+  late int _generation;
+
+  @override
+  bool? build() {
+    _probe = ref.watch(sessionCredentialProbeProvider);
+    _generation = beginBuildGeneration();
+    final generation = _generation;
+    cancelOnDispose(
+      _probe.watchChanges().listen((_) {
+        if (isBuildGenerationActive(generation)) {
+          unawaited(refresh());
+        }
+      }),
+    );
+    scheduleMicrotask(() {
+      if (isBuildGenerationActive(generation)) {
+        unawaited(refresh());
+      }
+    });
+    return null;
+  }
+
+  /// Re-reads the account databases and returns the fresh answer.
+  Future<bool> refresh() async {
+    final generation = _generation;
+    final hasCredential = await _probe.hasCredential();
+    if (isBuildGenerationActive(generation)) {
+      state = hasCredential;
+    }
+    return hasCredential;
+  }
+}
