+
+// ROG5 diagnostic only: capped records, no scheduling or loading changes.
+int _rog5IconRecords = 0;
+void _rog5IconStage(String stage, String label) {
+  if (_rog5IconRecords >= 64) return;
+  final safe = label.replaceAll(RegExp(r'[^a-zA-Z0-9_#:. -]'), '_');
+  final bounded = safe.length > 100 ? safe.substring(0, 100) : safe;
+  print(
+    'ROG5_ICON_STAGE source=svg seq=${++_rog5IconRecords} stage=$stage loader=$bounded',
+  );
+}
