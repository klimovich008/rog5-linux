+def production_identity(identity, contract, owner):
+    """Check a caller-bound six-field identity; never promote discovery to proof.
+
+    This helper is not authentication. The original bootstrap and phase/common
+    gates remain mandatory; the launcher checks the source-bound concrete type.
+    """
+    need(contract is not None and callable(getattr(contract, 'expected', None)),
+         'explicit production contract required')
+    need(type(owner) is str and re.fullmatch('[0-9a-f]{32}', owner)
+         and owner == A.OWNER, 'production owner differs')
+    need(type(identity) is dict and set(identity) == ARTIFACT_FIELDS
+         and all(type(v) is str for v in identity.values())
+         and identity['owner'] == owner, 'production identity6 required')
+    expected = contract.expected(identity['boot_id'], owner)
+    need(type(expected) is dict and A.exact_json(identity, expected),
+         'production contract identity differs')
+    return dict(identity)
+
