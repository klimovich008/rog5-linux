+class ExpectationWriter:
+    """One exclusive expectation write. Never unlink, truncate, rename or retry.
+
+    Keep the creator FD through inspection of an error. An unknown pathname is
+    never adopted. C.save and its semantics for all other receipts are unchanged.
+    """
+    def __init__(self, value):
+        self.value=value;self.raw=publication_bytes(value)
+        self.path=OUTPUT/'production-boot-binding.json'
+        self.parent=self.fd=None;self.creator=None;self.written=0
+        self.frozen=None;self.closed=False;self.bad=False
+        need(OUTPUT.resolve(strict=True)==OUTPUT, 'publication parent alias')
+        info=OUTPUT.lstat()
+        need(stat.S_ISDIR(info.st_mode) and info.st_uid==1000
+             and stat.S_IMODE(info.st_mode)==0o700, 'publication parent metadata')
+        self.directory=stamp(info)[:5]
+
+    def parent_check(self):
+        need(OUTPUT.resolve(strict=True)==OUTPUT and stamp(OUTPUT.lstat())[:5]==self.directory,
+             'publication parent replaced')
+        if self.parent is not None:
+            need(stamp(os.fstat(self.parent))[:5]==self.directory, 'held publication parent differs')
+
+    def open(self):
+        # A real default SIGINT must not land between kernel creation and saving
+        # its returned FD. No handler is installed; the original mask is restored.
+        import signal
+        mask=signal.pthread_sigmask(signal.SIG_BLOCK,{signal.SIGINT})
+        try:
+            self.parent=os.open(OUTPUT,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC)
+            self.parent_check()
+            self.fd=os.open(self.path.name,os.O_RDWR|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW|os.O_CLOEXEC,
+                            0o600,dir_fd=self.parent)
+            info=os.fstat(self.fd);self.creator=stamp(info)[:6]
+            need(info.st_size==0 and os.lseek(self.fd,0,os.SEEK_CUR)==0, 'new expectation was not empty')
+        finally:signal.pthread_sigmask(signal.SIG_SETMASK,mask)
+
+    def inspect(self):
+        self.parent_check();need(not self.bad, 'expectation writer closure unproven')
+        if self.closed:
+            need(self.frozen is not None and A.exact_json(
+                 publication_file(self.value,prefix=True),self.frozen), 'closed writer snapshot changed')
+            return self.frozen
+        if self.fd is None:
+            need(self.creator is None and not os.path.lexists(self.path), 'unknown expectation creator')
+            return dict(status='absent')
+        info=os.fstat(self.fd)
+        need(self.creator is not None and stamp(info)[:6]==self.creator
+             and self.written<=os.lseek(self.fd,0,os.SEEK_CUR)==info.st_size<=len(self.raw),
+             'writer identity/offset changed')
+        return publication_snapshot(self.fd,self.path,self.raw,prefix=True)
+
+    def write(self):
+        self.open()
+        while self.written<len(self.raw):
+            self.inspect()
+            need(os.fstat(self.fd).st_size==self.written, 'unexpected write progress')
+            count=os.write(self.fd,self.raw[self.written:])
+            need(type(count) is int and 0<=count<=len(self.raw)-self.written, 'invalid expectation write result')
+            if count==0:raise OSError('expectation write stalled')
+            self.written+=count
+        os.fsync(self.fd);os.fsync(self.parent)
+        need(self.inspect()['status']=='present', 'expectation is incomplete')
+
+    def close(self):
+        if self.closed:return
+        import signal
+        error=None
+        try:self.frozen=self.inspect()
+        except BaseException as exc:error=exc;self.bad=True
+        mask=signal.pthread_sigmask(signal.SIG_BLOCK,{signal.SIGINT})
+        try:
+            for key in ('fd','parent'):
+                fd=getattr(self,key);setattr(self,key,None)
+                if fd is not None:
+                    try:os.close(fd)
+                    except BaseException as exc:
+                        self.bad=True
+                        if error is None:error=exc
+                        else:error.add_note('Additional writer close error: '+str(exc)[:256])
+            self.closed=True
+        finally:signal.pthread_sigmask(signal.SIG_SETMASK,mask)
+        if error is not None:raise error
+
