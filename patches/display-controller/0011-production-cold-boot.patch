+class ColdBoot:
+    """One static lock, one discovered boot, one immutable-by-use HostContract.
+
+    Created by the trusted launcher from ad.inputs(), never from a caller's
+    dictionary/digest pair. This does not authenticate an already executed ad.
+    Discovery selects an EXPECTATION; only the real health validator proves it.
+    """
+    def __init__(self, ad, session, owner):
+        need(ad.ColdBoot is ColdBoot and ad.inputs is inputs, 'cold admission module differs')
+        need(type(owner) is str and owner==A.OWNER, 'cold admitted owner required')
+        need(not os.path.lexists(ad.OUTPUT), 'existing execution cannot recreate cold binding')
+        value=ad.inputs()
+        need(value['format']==COLD_FORMAT, 'authenticated cold-boot inputs absent')
+        spec=cold_schema(value['production_cold_boot'])
+        need(spec['owner']==owner and spec['source_boot_id']==A.SOURCE_BOOT, 'cold source/owner differs')
+        self.ad,self.session,self.core=ad,session,ad.C
+        self._lock=json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False)
+        self._spec=json.dumps(spec,sort_keys=True,separators=(',',':'),allow_nan=False)
+        self.component=session.bind_sources(ad);self.health=session.H;self.restoration=ad.H.F
+        endpoint=self.component.dependency('display-endpoint.py')
+        need(spec['target']['release']==endpoint.RELEASE and spec['target']['board_dtb_sha256']==endpoint.BOARD,
+             'cold endpoint artifact differs')
+        self._boot=None;self._contract=None;self._proved=False;self._ready=False;self._record=None
+        self._publication='unselected';self._published_file=None
+        self._failure_record=None;self._failure_stamp=None;self._publication_cancellation=None
+        self.check()
+
+    @property
+    def static(self):return A.decode(self._spec)
+    @property
+    def owner(self):return self.static['owner']
+    @property
+    def target(self):return {k:self.static['target'][k] for k in ('bundle','release')}
+    @property
+    def states(self):return self.static['states']
+    @property
+    def selected_boot(self):return self._boot
+    @property
+    def publication_failed(self):return self._publication=='failed'
+    @property
+    def publication_cancellation(self):return self._publication_cancellation
+
+    def check(self):
+        need(self.ad.inputs is inputs and self.ad.C is self.core and self.ad.H.F is self.restoration,
+             'cold private module binding changed')
+        value=self.ad.inputs()
+        need(json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False)==self._lock,
+             'authenticated cold input changed')
+        need(json.dumps(value['production_cold_boot'],sort_keys=True,separators=(',',':'),allow_nan=False)==self._spec,
+             'retained static binding changed')
+        need(self.owner==A.OWNER and self.static['source_boot_id']==A.SOURCE_BOOT, 'cold source/owner changed')
+        self.session.cohort(self.ad)
+        modules=self.session._SOURCE_MODULES
+        need(modules.get('gpu-iommu-display-r1/display-component.py') is self.component
+             and modules.get('gpu-iommu-health-r1/successor-health.py') is self.health
+             and self.session.H is self.health
+             and self.session.T is modules.get('gpu-iommu-display-r1/transport.py')
+             and self.session.K is modules.get('gpu-iommu-session-r1/kernel-log.py')
+             and self.session.T.B is modules.get('gpu-iommu-display-r1/backend.py'),
+             'cold production module identity differs')
+        if self._boot is not None:
+            if self.publication_failed:
+                need(self._failure_record is not None and self._failure_stamp is not None,
+                     'publication failure has no committed fallback witness')
+                failed=publication_failure()
+                need(json.dumps(failed,sort_keys=True,separators=(',',':'),allow_nan=False)==self._failure_record
+                     and stamp((OUTPUT/'production-boot-publication-failure.json').lstat())==self._failure_stamp
+                     and failed['expectation']['identity']['boot_id']==self._boot,
+                     'retained publication failure witness changed')
+            else:
+                need(self._publication=='committed' and self._record is not None
+                     and not os.path.lexists(OUTPUT/'production-boot-publication-failure.json')
+                     and selected_boot()==self._boot
+                     and A.exact_json(publication_file(A.decode(self._record)),self._published_file),
+                     'retained cold binding record changed')
+        if self._ready:self.check_health_seal()
+        return self.static
+
+    def check_health_seal(self):
+        spec=self.static;seal=self.health.inputs()
+        need(spec['health_inputs_sha256']==self.health.INPUT_SHA
+             and A.exact_json(seal,self.health.SEAL) and self.health.A.OWNER==self.owner
+             and self.health.A.SOURCE_BOOT==spec['source_boot_id'], 'cold health seal binding differs')
+        expected=dict(target=spec['target'],owner=self.owner,source_boot_id=spec['source_boot_id'],
+                      ssh_fingerprint=spec['ssh_fingerprint'],trial_id=spec['trial_id'],
+                      healthy_state_sha256=spec['states']['healthy'])
+        need(all(A.exact_json(seal.get(k),v) for k,v in expected.items()), 'historical or incompatible production health seal')
+
+    def runtime_ready(self):
+        self.check()
+        self.session.initialize(self.ad)  # Unchanged 0009; no exception or fallback.
+        self.check_health_seal()
+        need(self.ad.D.BOOT.IMAGE_SHA==self.static['boot_image_sha256'], 'cold boot image differs')
+        need(self.restoration.OWNER==self.owner and self.restoration.SOURCE_BOOT==self.static['source_boot_id'],
+             'restoration source/owner differs')
+        # Supplied consumers reveal these exact generator contracts. Do not call
+        # an unknown generator or replace its historical values to pass this gate.
+        for guard in (A.G,self.restoration.G):
+            need((guard.OLD_SHA,guard.PENDING_SHA,guard.HEALTHY_SHA)==
+                 tuple(self.states[k] for k in ('old','pending','healthy')), 'unqualified state generator inputs')
+            need(tuple(guard.OPERATIONS['restore-target'][:2])==
+                 tuple(self.target[k] for k in ('bundle','release')), 'unqualified target recovery generator')
+        self._ready=True
+        return self.check()
+
+    def discovery(self, identity):
+        self.core.same_identity(identity,self.target,excluded=(self.static['source_boot_id'],))
+        need(self._boot is None or identity['boot_id']==self._boot, 'cold boot selection changed')
+        return dict(identity)
+
+    def observe_boot(self, phase_name, context, results, pin, identity):
+        self.check();need(self._ready, 'cold runtime is not ready')
+        need(not self.publication_failed, 'failed publication cannot bind a target')
+        self.discovery(identity)
+        self.ad.phase(phase_name,context,results,pin,contract=self,owner=self.owner)
+        boot=self.ad.discovered_boot(phase_name,'target',results,contract=self,owner=self.owner,ready=False)
+        need(boot==identity['boot_id'], 'discovery receipt/binding differs')
+        if self._boot is None:
+            need(phase_name in ('observe_target','locate_fallback'), 'cold boot must bind at first target discovery')
+            self._boot=boot  # Retain selection even if publication/construction fails.
+            record=dict(format='rog5-production-boot-expectation-v1',context=context,
+                inputs_sha256=INPUTS_SHA,phase=phase_name,intent_sha256=pin,
+                identity=dict(self.static['target'],owner=self.owner,boot_id=boot))
+            self._record=json.dumps(record,sort_keys=True,separators=(',',':'),allow_nan=False)
+            need(not os.path.lexists(OUTPUT/'production-boot-binding.json')
+                 and not os.path.lexists(OUTPUT/'production-boot-publication-failure.json'),
+                 'publication path already exists')
+            self.publish_expectation()
+            self._contract=self.session.host_contract(self.ad,dict(self.static['target'],owner=self.owner,boot_id=boot))
+        need(self._contract is not None, 'previous cold binding attempt failed')
+        self.identity(self.expected(boot,self.owner))
+        return self._contract  # Repeated same-boot reads reuse, never re-create.
+
+    def publish_expectation(self):
+        writer=None;primary=None
+        try:
+            self._publication='publishing'
+            # Normal finalization belongs to the same failure boundary as write.
+            # In particular, a first cancellation at the final close still needs
+            # both retention and an exclusion-only witness, not an early raise.
+            try:
+                writer=ExpectationWriter(A.decode(self._record))
+                writer.write()
+                self._published_file=writer.inspect()
+                writer.close()
+            except BaseException as original:
+                primary=original
+                if isinstance(original,(KeyboardInterrupt,SystemExit)):
+                    self._publication_cancellation=original
+                raise
+            finally:
+                try:
+                    if writer is not None:writer.close()
+                except BaseException as close_error:
+                    if self._publication_cancellation is None and isinstance(close_error,(KeyboardInterrupt,SystemExit)):
+                        self._publication_cancellation=close_error
+                    if primary is None:raise
+                    primary.add_note('Writer closure unavailable: '+str(close_error)[:512])
+            self._publication='committed'
+        except (OSError,KeyboardInterrupt,SystemExit) as original:
+            self._publication='failed'
+            if self._publication_cancellation is None and isinstance(original,(KeyboardInterrupt,SystemExit)):
+                self._publication_cancellation=original
+            try:
+                need(not isinstance(original,FileExistsError) and writer is not None, 'publication collision or absent writer')
+                # Finish only the still-owned writer cleanup, never retry an FD
+                # number. A closed writer must validate its frozen snapshot;
+                # cancellation itself supplies no file or recovery authority.
+                if not writer.closed:writer.close()
+                need(writer.closed, 'publication writer closure incomplete')
+                failed=dict(format='rog5-production-boot-publication-failure-v2',
+                    expectation=A.decode(self._record),file=writer.inspect())
+                path=OUTPUT/'production-boot-publication-failure.json'
+                C.save(path,failed)
+                info=stamp(path.lstat())
+                need(A.exact_json(publication_failure(),failed) and stamp(path.lstat())==info,
+                     'publication failure witness changed while recording')
+                self._failure_record=json.dumps(failed,sort_keys=True,separators=(',',':'),allow_nan=False)
+                self._failure_stamp=info
+            except BaseException as witness_error:
+                original.add_note('Fallback witness unavailable: '+str(witness_error)[:512])
+                if self._publication_cancellation is None and isinstance(witness_error,(KeyboardInterrupt,SystemExit)):
+                    self._publication_cancellation=witness_error
+            raise
+
+    def expected(self, boot, owner):
+        need(self._publication=='committed', 'target expectation is not committed')
