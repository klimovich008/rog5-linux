+def publication_snapshot(fd, path, expected, *, prefix=False):
+    """Read only. A prefix is acceptable ONLY as failed-writer evidence."""
+    before=os.fstat(fd)
+    need(stat.S_ISREG(before.st_mode) and before.st_uid==1000 and before.st_nlink==1
+         and stat.S_IMODE(before.st_mode)==0o600 and 0<=before.st_size<=len(expected),
+         'expectation file metadata')
+    raw=os.pread(fd,len(expected)+1,0)
+    need(len(raw)==before.st_size and raw==expected[:len(raw)]
+         and (prefix or raw==expected), 'expectation bytes differ')
+    need(stamp(before)==stamp(os.fstat(fd))==stamp(path.lstat())
+         and path.resolve(strict=True)==path, 'expectation file changed')
+    return dict(status='present' if raw==expected else 'writer-prefix',
+                stamp=list(stamp(before)),sha256=A.sha(raw))
+
+
+def publication_file(value, *, prefix=False):
+    """Observe exact complete bytes, or recheck an explicitly witnessed prefix."""
+    path=OUTPUT/'production-boot-binding.json'
+    need(OUTPUT.resolve(strict=True)==OUTPUT and OUTPUT.is_dir(), 'publication parent changed')
+    try:before=path.lstat()
+    except FileNotFoundError:return dict(status='absent')
+    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC)
+    try:
+        need(stamp(before)==stamp(os.fstat(fd)), 'expectation replaced before read')
+        return publication_snapshot(fd,path,publication_bytes(value),prefix=prefix)
+    finally:os.close(fd)
+
