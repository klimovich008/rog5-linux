+def cold_schema(spec):
+    """Pure structural producer/consumer check, NOT authentication or issuance."""
+    need(type(spec) is dict and set(spec) == {'source_boot_id','owner','target','trial_id',
+         'ssh_fingerprint','health_inputs_sha256','boot_image_sha256','states'}, 'cold static schema')
+    C.boot_id(spec['source_boot_id'])
+    need(type(spec['owner']) is str and re.fullmatch('[0-9a-f]{32}',spec['owner']), 'cold owner')
+    target=spec['target']; states=spec['states']
+    need(type(target) is dict and set(target)=={'bundle','release','descriptor_sha256','board_dtb_sha256'}
+         and all(type(v) is str for v in target.values())
+         and target['release']=='7.1.4-rog5-production'
+         and re.fullmatch('[a-z0-9][a-z0-9._-]{0,63}',target['bundle'])
+         and '..' not in target['bundle'], 'cold target schema')
+    need(type(states) is dict and set(states)=={'old','pending','healthy'}, 'cold selection states')
+    for value in [target['descriptor_sha256'],target['board_dtb_sha256'],spec['trial_id'],
+                  spec['health_inputs_sha256'],spec['boot_image_sha256'],*states.values()]:
+        need(type(value) is str and re.fullmatch('[0-9a-f]{64}',value), 'cold digest')
+    need(len(set(states.values()))==3, 'cold selection states must differ')
+    need(type(spec['ssh_fingerprint']) is str
+         and re.fullmatch(r'SHA256:[A-Za-z0-9+/]{43}',spec['ssh_fingerprint']), 'cold SSH fingerprint')
+    descriptor=(f'format=rog5-persistent-wifi-health-v1\ntrial_id={spec["trial_id"]}\n'
+                f'primary_bundle={target["bundle"]}\nmode=try-once\n').encode()
+    need(A.sha(descriptor)==target['descriptor_sha256'], 'cold descriptor/trial differs')
+    return A.decode(json.dumps(spec,allow_nan=False))
