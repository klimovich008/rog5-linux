+def bind_worker_sources(ad, *, authenticated_inputs):
+    """Trusted bootstrap entry, NOT authentication of ad or of a callable.
+
+    The caller must already have authenticated this session and the exact ad
+    module/inputs implementation, INPUTS_SHA trust anchor and its dependencies.
+    Passing a dictionary, a boolean or a hash alongside candidate data is NOT
+    this interface. Current private bootstrap imports are not qualified here.
+    One session instance permits only one binding; a failed attempt stays failed.
+    """
+    global _WORKER_ATTEMPTED, _WORKER_SOURCES
+    with _WORKER_LOCK:
+        if _WORKER_SOURCES is not None:
+            need(ad is _WORKER_SOURCES.ad and authenticated_inputs is _WORKER_SOURCES.reader,
+                 'private source authority cannot be replaced')
+            _WORKER_SOURCES.check()
