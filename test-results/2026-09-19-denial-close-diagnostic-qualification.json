    "source": "\"\"\"One diagnostic VM observation; never standard-deadline qualification.\"\"\"\nimport hashlib, importlib.util, json, pathlib, subprocess, sys, time\nE=pathlib.Path(__file__).resolve().parent\nW=E.parent/'rog5-review-correctness-20260912-r1'\nP=E.parent/'rog5-unit-query-20260919-r1/close-r1/result.json'\ndef digest(path):\n    with pathlib.Path(path).open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()\ndef write(path,value):\n    with path.open('x') as f:json.dump(value,f,indent=2);f.write('\\n')\ndef main():\n    if sys.argv[1:]:raise SystemExit('no arguments accepted')\n    if subprocess.check_output(['git','status','--porcelain'],cwd=W):raise SystemExit('source not frozen')\n    if subprocess.check_output(['podman','ps','-q']).strip():raise SystemExit('another container active')\n    prior=json.loads(P.read_text())\n    if prior['status']!='FAIL':raise SystemExit('unexpected predecessor')\n    # Prove the production sources and immutable inputs are the same as the\n    # preceding diagnostic attempt. Only this outer observation allowance changes.\n    verified={}\n    for path,row in prior['inputs'].items():\n        got=digest(path)\n        if got!=row['sha256']:raise SystemExit('changed prior input: '+path)\n        verified[path]=got\n    args=prior['command'][2:]\n    args[args.index('--output')+1]=str(E/'vm-r1')\n    if '--close-only' not in args or '--settings-sync-diagnostic' not in args:raise SystemExit('wrong scope')\n    source=W/'scripts/host/test-qemu-logind.py'\n    spec=importlib.util.spec_from_file_location('production_logind',source)\n    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)\n    original=module.container\n    changes=[]\n    def diagnostic_container(command,name,log,deadline,steps,**kw):\n        if log.name=='serial.log':\n            if deadline!=300 or 'qemu-system-aarch64' not in command or changes:\n                raise RuntimeError('unexpected diagnostic dispatch')\n            changes.append({'container':name,'standard_seconds':300,'diagnostic_seconds':420,\n                            'existing_conditional_cleanup_grace_seconds':module.APPS_CLEANUP_GRACE})\n            deadline=420\n            write(E/'vm-dispatch.json',changes[0])\n        return original(command,name,log,deadline,steps,**kw)\n    module.container=diagnostic_container\n    record={'status':'RUNNING','authority':'none','scope':'diagnostic observation only; standard 300-second qualification excluded',\n            'standard_qualification':'NOT RUN; prior FAIL retained','physical_status':'NOT RUN',\n            'source_commit':subprocess.check_output(['git','rev-parse','HEAD'],cwd=W,text=True).strip(),\n            'source_tree':subprocess.check_output(['git','rev-parse','HEAD^{tree}'],cwd=W,text=True).strip(),\n            'wrapper_sha256':digest(__file__),'runner_sha256':digest(source),'verified_prior_inputs':verified,\n            'command':[sys.executable,str(E/'run.py')],'production_arguments':args}\n    write(E/'started.json',record)\n    start=time.monotonic();sys.argv=[str(source),*args]\n    code=module.main()\n    raw=json.loads((E/'vm-r1/result.json').read_text())\n    record.update(status='DIAGNOSTIC_COMPLETED' if code==0 else 'DIAGNOSTIC_FAILED',\n                  internal_check_status=raw['status'],exit_status=code,duration_seconds=time.monotonic()-start,\n                  deadline_changes=changes,raw_result_sha256=digest(E/'vm-r1/result.json'))\n    write(E/'diagnostic-result.json',record)\n    print(json.dumps({k:record[k] for k in ('status','internal_check_status','standard_qualification','duration_seconds')}))\n    return code\nif __name__=='__main__':raise SystemExit(main())\n"
