      "source": "from pathlib import Path\nimport hashlib,json,re\nE=Path(__file__).resolve().parent\n\ndef identity(path):\n with path.open('rb') as stream:digest=hashlib.file_digest(stream,'sha256').hexdigest()\n return dict(path=str(path),sha256=digest,bytes=path.stat().st_size)\n\nterminal=json.loads((E/'terminal.json').read_text());result=json.loads((E/'vm-r1/result.json').read_text())\nserial=(E/'vm-r1/serial.log').read_text(errors='replace')\nclean=re.sub(r'\\x1b\\[[0-9;]*[A-Za-z]','',serial)\nqemu=[step for step in result['steps'] if 'qemu-system-aarch64' in step['command']]\nrecords=[]\nfor match in re.finditer(r'DIAGNOSTIC_((?:DEVICE_(?:WAIT|SNAPSHOT))|SESSION_JOURNAL) status=(\\d+) bytes=(\\d+) truncated=([01]) hex=([0-9a-f]*)',clean):\n kind,status,size,truncated,hex_data=match.groups()\n if len(hex_data)%2:\n  records.append(dict(kind=kind,complete=False,error='incomplete hex'));continue\n data=bytes.fromhex(hex_data)\n row=dict(kind=kind,status=int(status),bytes=int(size),truncated=bool(int(truncated)),complete=len(data)==int(size),text=data.decode(errors='replace'))\n records.append(row);(E/(kind.lower()+f'-{len(records)}.log')).write_bytes(data)\nclocks={phase:float(value) for phase,value in re.findall(r'OBSERVE service-clock phase=([a-z-]+) clock=CLOCK_MONOTONIC seconds=([0-9.]+)',clean)}\ncorrelation={'clock':'same guest boot CLOCK_MONOTONIC; journal timestamps are receipt times', 'start_bracket':clocks,'events':[]}\nif 'before-start' in clocks:correlation['earliest_timeout_cutoff']=clocks['before-start']+25\nfor record in records:\n if record['kind']!='SESSION_JOURNAL' or not record['complete']:continue\n for line in record['text'].splitlines():\n  match=re.match(r'\\[\\s*(\\d+\\.\\d+)\\]\\s+(.*)',line)\n  if not match or not re.search(r'systemd\\[\\d+\\]: (?:Starting|Started) ',match[2]):continue\n  seconds=float(match[1]);event=dict(receipt_monotonic=seconds,line=line)\n  if 'earliest_timeout_cutoff' in correlation:\n   event['receipt_vs_earliest_cutoff']='before' if seconds<=correlation['earliest_timeout_cutoff'] else 'after; actual transition may precede receipt'\n  correlation['events'].append(event)\ncounters=[]\nfor match in re.finditer(r'KMS session complete raster_frames=(\\d+) output_page_flips=(\\d+) delivered_vsyncs=(\\d+)',clean):\n counters.append(dict(zip(['raster_frames','output_page_flips','delivered_vsyncs'],map(int,match.groups()))))\nsummary=dict(status=result['status'],wrapper_status=terminal['status'],source=result['source'],error=result.get('error'),qemu_steps=qemu,\n rcu_stall_reports=serial.count('rcu: INFO: rcu_sched detected stalls'),normal_poweroff='reboot: Power down' in serial,\n device_readiness_lines=[line for line in clean.splitlines() if 'OBSERVE device-readiness' in line],\n service_lines=[line for line in clean.splitlines() if 'OBSERVE service-' in line or 'OBSERVE stage=service-' in line],\n journal_capture_lines=[line for line in clean.splitlines() if 'OBSERVE session-journal' in line],\n diagnostics=records,service_correlation=correlation,denial_counters=counters,\n rendering_qualification=result.get('rendering',{'status':'NOT RUN','reason':'runner did not reach final rendering qualification'}),\n observation=result.get('apps_observation',{}),\n failure_and_cleanup_lines=[line for line in clean.splitlines() if any(x in line for x in ['FAIL ','Failed unmounting','reboot: Power down','KMS teardown happened','KMS hold complete'])],\n result=identity(E/'vm-r1/result.json'),terminal=identity(E/'terminal.json'),serial=identity(E/'vm-r1/serial.log'),authority='none; VM only')\n(E/'analysis.json').write_text(json.dumps(summary,indent=2)+'\\n')\nprint(json.dumps({k:summary[k] for k in ['status','error','device_readiness_lines','service_lines','journal_capture_lines','service_correlation','denial_counters']},indent=2))\n"
