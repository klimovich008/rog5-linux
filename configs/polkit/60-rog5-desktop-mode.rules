// ROG5 desktop mode: the phone user may ask for the GNOME desktop
// (rog5-desktop-request.service: rog5-desktop-mode then checks that the
// phone was unlocked) and return to the phone (rog5-phosh.service, which
// comes up on its lock screen), from the active local session only. Never
// rog5-gnome.service itself: "active" says nothing about the lock, and GNOME
// has no lock screen of its own here. Not from SSH or other sessions; no
// other units or verbs.
polkit.addRule(function(action, subject) {
	if (action.id == "org.freedesktop.systemd1.manage-units" &&
	    subject.user == "phone" && subject.local && subject.active &&
	    action.lookup("verb") == "start" &&
	    (action.lookup("unit") == "rog5-desktop-request.service" ||
	     action.lookup("unit") == "rog5-phosh.service"))
		return polkit.Result.YES;
});
