// ROG5 desktop mode: the phone user may switch between Phosh and the GNOME
// desktop from the active local session only (a tap on the unlocked phone,
// or in GNOME). Not from SSH or other sessions; no other units or verbs.
polkit.addRule(function(action, subject) {
	if (action.id == "org.freedesktop.systemd1.manage-units" &&
	    subject.user == "phone" && subject.local && subject.active &&
	    action.lookup("verb") == "start" &&
	    (action.lookup("unit") == "rog5-gnome.service" ||
	     action.lookup("unit") == "rog5-phosh.service"))
		return polkit.Result.YES;
});
