# Socket-activated by rog5-wayvnc-phone.socket: forwards the client socket
# %t/rog5-vnc-phone.sock to wayvnc's Unix socket %t/rog5-vnc-phone-server.sock
# and exits after two idle minutes, which also stops wayvnc
# (StopWhenUnneeded there).
[Unit]
Description=wayvnc phone mirror: on-demand proxy
Requires=rog5-wayvnc-phone.service
After=rog5-wayvnc-phone.service
PartOf=graphical-session.target

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=120s %t/rog5-vnc-phone-server.sock
