# VNC server for the phone screen (mirror, with input) in the Phosh session,
# started on demand through rog5-wayvnc-phone.socket (clients use
# %t/rog5-vnc-phone.sock through SSH, see that unit and rog5-desktop);
# wayvnc itself listens on the Unix socket %t/rog5-vnc-phone-server.sock
# (no TCP port: a loopback port admits every local account) and stops when
# the proxy no longer needs it. wayvnc uses phoc's screencopy, virtual
# keyboard and pointer.
[Unit]
Description=wayvnc: the phone screen (mirror, with input)
PartOf=graphical-session.target
After=graphical-session.target
StopWhenUnneeded=yes

[Service]
UMask=0077
# graphical-session.target is also up in GNOME (desktop mode), where mutter has
# no wlr virtual pointer and wayvnc failed every 3 s: run only beside phoc (a
# failed ExecCondition skips the unit without a restart).
ExecCondition=/usr/bin/pgrep -u %U -x phoc
# a socket left by a crash would make the bind fail
ExecStartPre=/usr/bin/rm -f %t/rog5-vnc-phone-server.sock
ExecStart=/usr/bin/wayvnc --output=DSI-1 --socket=%t/wayvnc-phone.sock --unix-socket %t/rog5-vnc-phone-server.sock
# The proxy connects as soon as this unit is started: wait until wayvnc listens.
ExecStartPost=/bin/sh -c 'i=0; while [ $i -lt 50 ]; do ss -Hlx | grep -qF " %t/rog5-vnc-phone-server.sock " && exit 0; sleep 0.1; i=$((i + 1)); done; exit 1'
ExecStopPost=/usr/bin/rm -f %t/rog5-vnc-phone-server.sock
# wayvnc exited 0 on a Wayland protocol error (2026-09-28), so on-failure
# left remote input dead.
Restart=always
RestartSec=3
