[Unit]
Description=ROG5: reopen the apps that were open before a Phosh/GNOME switch
Documentation=file:///usr/local/bin/rog5-session-carry
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# exec, not oneshot: after a hand-back it waits (up to 30 min) for the
# PIN unlock before reopening anything, and ends with the session.
Type=exec
ExecStart=/usr/local/bin/rog5-session-carry restore

[Install]
WantedBy=graphical-session.target
