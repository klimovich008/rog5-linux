# /etc/rog5/charge-policy: read by rog5-charge-policy every 30 s.
# `rog5-charge-policy mode ...`, `limit END [START]` and `full` edit or
# override it from the command line. Values shown are the defaults.

# limit: keep the battery between start and end % (always-plugged server);
# at end the charger runs the phone from USB and the cells rest (bypass).
# full: normal charging to 100 %. bypass: never charge on external power.
# off: leave the charger alone.
mode=limit
start=70
end=80

# Bypass (no charging, the adapter carries the load) while on external power
# and GNOME desktop mode runs (bypass_desktop), or rog5-perf-mode is
# "performance" (bypass_perf), or while the battery is at or above
# bypass_temp C (until it cools to bypass_temp_clear; 0 disables).
bypass_desktop=1
bypass_perf=0
bypass_temp=40
bypass_temp_clear=37
# Never bypass below this capacity.
bypass_min=30
# The adapter can't carry the load if the battery discharges faster than
# discharge_ma for discharge_s while bypassing: normal charging for backoff_s.
discharge_ma=200
discharge_s=120
backoff_s=900

# 1: above end+3 % on external power, run from the battery down to end
# (USB input suspended; floor 50 %), e.g. after a full charge. Meanwhile
# qcom-battmgr-usb reads offline: rog5-sleep-policy (10cc4116 and later)
# still counts it as external power, rog5-perf-mode auto does not.
drain=0

# Longest "rog5-charge-policy full" override, in hours.
full_hours=12
