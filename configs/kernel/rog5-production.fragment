# Source-build qualification only. No boot, signing or installation authority.
CONFIG_LOCALVERSION="-rog5-production"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_MODULES=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_ASUS_ROG5_AMS678=m
CONFIG_REGULATOR_QCOM_REFGEN=y
# Built in so the GPU SMMU (a gpucc consumer) probes before the deferred-probe
# timeout; as a module it needed a manual drivers_probe (trial d1).
CONFIG_SM_GPUCC_8350=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
CONFIG_I2C_QCOM_GENI=y
CONFIG_LEDS_QCOM_LPG=m
CONFIG_LEDS_CLASS=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y
# Keep existing trusted-initramfs write policy; NOT a kernel LUN/LBA boundary.
CONFIG_SCSI_UFS_DISCOVERY_READ_ONLY=y
CONFIG_SCSI_UFS_DISCOVERY_DATA_WRITE=y
# CONFIG_CHR_DEV_SG is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_SCSI_UFS_BSG is not set
# CONFIG_RPMB is not set
# No diagnostic-only build, userspace metadata does not claim touch binding.
# CONFIG_COMPILE_TEST is not set
# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_KCOV is not set
# Bounded unsigned build; no DWARF/BTF artifact needed for this compile gate.
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set

# Milestone 1 (self-recovery): systemd-driven software watchdog, PMIC RTC
# (read-only, offset kept in userspace) and ramoops in the stock debug region.
CONFIG_SOFT_WATCHDOG=m
CONFIG_RTC_DRV_PM8XXX=m
# The PMK8350 RTC holds a counter, not wall time: never copy it to the clock
# (hctosys also runs for a modular RTC; it set the clock to 1970 on trial t4).
# CONFIG_RTC_HCTOSYS is not set
CONFIG_PSTORE_RAM=y

# CPU idle stays off for now. The board DT drops the CPU power-domain and
# idle-state references (docs/development-lessons.md 2026-09-12: ASUS firmware
# reset on the PSCI OSI-domain enable after kexec), so cpuidle has no states.
# RAM trial t13 (r14, 2026-09-24) enabled the domain driver: firmware accepted
# OSI mode without a reset over a 3-minute idle soak, but no state was used.
# Qualifying real idle states is a separate experiment.
# CONFIG_ARM_PSCI_CPUIDLE_DOMAIN is not set
# The bench's virtual touchscreen (scripts/device/bench/vtouch.py).
CONFIG_INPUT_UINPUT=m
# Bluetooth profiles (r22 brought up hci0): uhid for BLE HID (keyboards,
# mice, controllers through BlueZ), RFCOMM serial and BNEP PAN.
CONFIG_UHID=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
# Arch ships linux-firmware zstd-compressed on x86; let the loader read .zst.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# Utilization clamping: lets Denial's latency-critical threads (raster, UI,
# compositor) ask for fast cores and clocks once CPU capacities are described.
# With capacities but no clamp, energy-aware placement put them on the A55s
# (r25: quick settings 5 -> 60 dropped frames).
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# Audio (plan step 10): the two Cirrus CS35L45 amplifiers (earpiece and
# speaker) on QUP SE17 I2C, fed over SENARY MI2S from the ADSP.
CONFIG_SND_SOC_CS35L45_I2C=m
# Suspend bring-up: /sys/power/pm_test (freezer/devices/platform/processors/
# core) and pm_print_times/pm_debug_messages. No behaviour change unless used.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
