# Source-build qualification only. No boot, signing or installation authority.
CONFIG_LOCALVERSION="-rog5-production"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_MODULES=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_ASUS_ROG5_AMS678=m
CONFIG_REGULATOR_QCOM_REFGEN=y
# Built in so the GPU SMMU (a gpucc consumer) probes before the deferred-probe
# timeout; as a module it needed a manual drivers_probe (trial d1).
CONFIG_SM_GPUCC_8350=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
CONFIG_I2C_QCOM_GENI=y
CONFIG_LEDS_QCOM_LPG=m
CONFIG_LEDS_CLASS=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y
# UFS runs the mainline driver without the bring-up discovery containment
# (approved by the user 2026-09-28): WriteBooster, auto-hibern8, clock
# scaling, runtime PM, device RTC and auto-BKOPS as on stock. The write policy
# stays in the trusted initramfs; raw SCSI/UFS pass-through (sg, bsg,
# ufs-bsg, RPMB) stays off.
# CONFIG_SCSI_UFS_DISCOVERY_READ_ONLY is not set
# CONFIG_CHR_DEV_SG is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_SCSI_UFS_BSG is not set
# CONFIG_RPMB is not set
# No diagnostic-only build, userspace metadata does not claim touch binding.
# CONFIG_COMPILE_TEST is not set
# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_KCOV is not set
# Bounded unsigned build; no DWARF/BTF artifact needed for this compile gate.
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set

# Milestone 1 (self-recovery): systemd-driven software watchdog, PMIC RTC
# (read-only, offset kept in userspace) and ramoops in the stock debug region.
CONFIG_SOFT_WATCHDOG=m
# Haven hypervisor watchdog (patch 0088): runs from qcom_scm probe on and the
# kernel pets it; it counts busy CPU time only and bites a hard hang. PID 1
# keeps petting softdog (persistent-root-init points systemd at watchdog1).
CONFIG_GUNYAH_WATCHDOG=y
CONFIG_RTC_DRV_PM8XXX=m
# The PMK8350 RTC holds a counter, not wall time: never copy it to the clock
# (hctosys also runs for a modular RTC; it set the clock to 1970 on trial t4).
# CONFIG_RTC_HCTOSYS is not set
CONFIG_PSTORE_RAM=y

# CPU idle stays off for now. The board DT drops the CPU power-domain and
# idle-state references (docs/development-lessons.md 2026-09-12: ASUS firmware
# reset on the PSCI OSI-domain enable after kexec), so cpuidle has no states.
# RAM trial t13 (r14, 2026-09-24) enabled the domain driver: firmware accepted
# OSI mode without a reset over a 3-minute idle soak, but no state was used.
# Qualifying real idle states is a separate experiment.
# CONFIG_ARM_PSCI_CPUIDLE_DOMAIN is not set
# The bench's virtual touchscreen (scripts/device/bench/vtouch.py).
CONFIG_INPUT_UINPUT=m
# Bluetooth profiles (r22 brought up hci0): uhid for BLE HID (keyboards,
# mice, controllers through BlueZ), RFCOMM serial and BNEP PAN.
CONFIG_UHID=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
# Arch ships linux-firmware zstd-compressed on x86; let the loader read .zst.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# Utilization clamping: lets Denial's latency-critical threads (raster, UI,
# compositor) ask for fast cores and clocks once CPU capacities are described.
# With capacities but no clamp, energy-aware placement put them on the A55s
# (r25: quick settings 5 -> 60 dropped frames).
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# Audio (plan step 10): the two Cirrus CS35L45 amplifiers (earpiece and
# speaker) on QUP SE17 I2C, fed over SENARY MI2S from the ADSP.
CONFIG_SND_SOC_CS35L45_I2C=m
# Suspend bring-up: /sys/power/pm_test (freezer/devices/platform/processors/
# core) and pm_print_times/pm_debug_messages. No behaviour change unless used.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# Hierarchical PSCI (OS-initiated) CPU idle domains, the stock regime (the
# 5.4 kernel switches the firmware to OSI; lpm cluster states 0x41000044 /
# 0x4100c344). Only takes effect with a DTB whose CPUs reference the /psci
# power domains (compose feature "osi"); t13 showed the OSI switch itself
# does not reset after kexec.
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y

# Server/hub peripherals (connectivity comparison, 2026-09-27): UASP enclosures,
# hiddev (UPS and HID tools), RNDIS and 2.5GbE (AQC111) dongles, common USB
# serial adapters, game controllers.
CONFIG_USB_UAS=y
CONFIG_USB_HIDDEV=y
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_AQC111=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
# QMP USB3/DP combo PHY of the side port (DisplayPort alt mode, later USB 3).
CONFIG_PHY_QCOM_QMP_COMBO=m
# EPSS L3 provider for the CPU OPP tables (cpu-l3 overlay): built in, since
# cpufreq-hw (built in) defers until the L3 interconnect exists.
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
# FUSE built in: /lib/modules is empty, so a fuse module would never create
# /dev/fuse and xdg-document-portal (Firefox, GTK file choosers, sandboxed
# apps) failed, stalling app start-up on portal timeouts.
CONFIG_FUSE_FS=y

# Bottom USB-C port stage A (DT feature usbbtm): regulator-output node for
# switching its 5 V source by hand (sysfs state).
CONFIG_REGULATOR_USERSPACE_CONSUMER=y

# Server networking (2026-09-28 test campaign): Tailscale's connmark rules
# failed ("operation not supported") and iptables-nft could not list rules;
# containers (podman) need veth, bridge netfilter and iptables NAT. Built in:
# the module tree only carries listed modules.
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_VETH=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_SYN_COOKIES=y

# USB drives (bottom port, hubs): the filesystems sticks, SD cards and
# installer images come with. Built in, as for FUSE above. udisks mounts FAT
# with iocharset=utf8.
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_NLS_UTF8=y
