# Bring up USB before either Qualcomm UFS PHY or host probing begins.
# The exact four-module chain stays outside /lib/modules and loads explicitly.
CONFIG_SCSI_UFS_DISCOVERY_READ_ONLY=y
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=m
CONFIG_SCSI_UFSHCD_PLATFORM=m
CONFIG_SCSI_UFS_QCOM=m
CONFIG_BLK_DEV_SD=y
CONFIG_EFI_PARTITION=y

# Keep the providers needed before the explicit PHY/host module chain built in.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=m
# CONFIG_PHY_QCOM_QMP_COMBO is not set
# CONFIG_PHY_QCOM_QMP_PCIE is not set
# CONFIG_PHY_QCOM_QMP_PCIE_8996 is not set
# CONFIG_PHY_QCOM_QMP_USB is not set
# CONFIG_PHY_QCOM_QMP_USB_LEGACY is not set
CONFIG_PINCTRL_SM8350=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_SM8350=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_RESET_QCOM_AOSS=y

# Preserve the discovery kernel's userspace write-surface exclusions.
# CONFIG_CHR_DEV_SG is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_SCSI_UFS_BSG is not set
# CONFIG_RPMB is not set
# CONFIG_SCSI_UFS_CRYPTO is not set
# CONFIG_SCSI_UFS_HWMON is not set
