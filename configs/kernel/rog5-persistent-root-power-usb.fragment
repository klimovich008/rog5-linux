# Local Arch root plus the V26-proven side-port charging transport. Keep this
# module closure on the composed kernel ABI; V26 modules are not reusable.
# Keep Qualcomm's standard PMK8350 reboot-mode path available before initramfs
# failures: restart2("bootloader") cannot depend on modules loaded later.
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_PMIC_GLINK=m
CONFIG_REMOTEPROC=y
CONFIG_QCOM_PIL_INFO=m
CONFIG_QCOM_RPROC_COMMON=m
CONFIG_QCOM_Q6V5_COMMON=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_PDR_HELPERS=m
CONFIG_QCOM_PDR_MSG=m
CONFIG_QCOM_PMIC_GLINK=m
