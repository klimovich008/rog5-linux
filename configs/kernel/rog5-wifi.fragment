# WCN6855 over SM8350 PCIe0. Layer this after rog5-network-root.fragment,
# which deliberately disables the QMP PCIe PHY in the accepted baseline.
CONFIG_PHY_QCOM_QMP_PCIE=m
CONFIG_PCIE_QCOM=y
CONFIG_PCI_PWRCTRL=y
CONFIG_PCI_PWRCTRL_PWRSEQ=m
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=m
CONFIG_MHI_BUS=m
CONFIG_MHI_BUS_PCI_GENERIC=m
CONFIG_WLAN=y
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
