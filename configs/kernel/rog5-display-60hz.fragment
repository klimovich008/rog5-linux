CONFIG_VT_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_REGULATOR_QCOM_REFGEN=m
CONFIG_DRM_PANEL_ASUS_ROG5_AMS678=y
