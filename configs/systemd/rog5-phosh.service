# Phosh session for the unprivileged "phone" user, started without a display
# manager (like upstream's former phosh.service). systemd runs only the PAM
# account and session stacks, so this auto-logs in; phosh starts on its lock
# screen and the user's PIN unlocks it. SSH is key-only. GNOME desktop mode
# (rog5-gnome.service) conflicts with it: both need DRM master and the input devices.
[Unit]
Description=Phosh mobile session on the ROG5 OLED
Requires=rog5-platform-modules.service
After=rog5-platform-modules.service systemd-user-sessions.service rog5-p2-ready.service
ConditionPathExists=/usr/bin/phosh-session

[Service]
User=phone
PAMName=phosh
WorkingDirectory=~
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user
# No display manager sets the desktop name: without it Phosh inherited
# XDG_CURRENT_DESKTOP from the user manager (sway, from the virtual desktop).
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_CURRENT_DESKTOP=Phosh:GNOME WLR_DRM_DEVICES=/dev/dri/card1
ExecStartPre=+/usr/bin/chvt 7
ExecStart=/usr/bin/phosh-session
# phosh 0.57 segfaults when an external monitor is unplugged; gnome-session
# then ends cleanly, so on-failure never restarted the session.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
