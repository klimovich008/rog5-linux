# Apply the saved charge limit / bypass setting (rog5-charge-limit) at boot.
[Unit]
Description=ROG5 charge limit
ConditionPathExists=/etc/rog5/charge-limit
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rog5-charge-limit apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
