[Unit]
Description=ROG5 desktop mode: GNOME on an external display, Phosh otherwise
After=rog5-phosh.service systemd-logind.service systemd-udevd.service dbus.service
# re-reads /var/lib/rog5/desktop-mode on reload (the .path unit sends it)
Wants=rog5-desktop-mode-reload.path
# rog5-gnome.service is BindsTo= this unit. If the switcher fails for good
# (restart limit), the phone still gets its lock screen.
OnFailure=rog5-phosh.service

[Service]
Type=notify
NotifyAccess=all
# A wedged query/file read must not leave a live, unsupervised desktop.
WatchdogSec=30
TimeoutStartSec=20
TimeoutStopSec=5
ExecStart=/usr/local/libexec/rog5-desktop-mode
# SIGUSR1: re-check now (mode file changed)
ExecReload=/bin/kill -USR1 $MAINPID
# the once-per-plug latch survives a restart of the switcher
RuntimeDirectory=rog5-desktop-mode
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
