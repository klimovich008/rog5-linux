[Unit]
Description=Unattended ROG5 package update with an overlay snapshot
After=network-online.target rog5-package-keyring.service rog5-update-commit.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/run/rog5-update/rog5-update run
# Packages never upgraded automatically (space-separated; see docs/development.md).
Environment=ROG5_UPDATE_HOLD=
# Reboot into a verified update when the display is off (idle), at once (now),
# or leave it for the next ordinary reboot (never).
Environment=ROG5_UPDATE_REBOOT=idle
Environment=ROG5_UPDATE_MIN_BATTERY=50
Environment=ROG5_UPDATE_INTERVAL=86400
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
