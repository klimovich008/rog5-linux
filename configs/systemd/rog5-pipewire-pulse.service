# PulseAudio protocol server on /run/user/0/pulse/native. Denial's volume
# controls and apps such as Firefox use it.
[Unit]
Description=PipeWire PulseAudio server for the Denial root session
BindsTo=rog5-pipewire.service
After=rog5-pipewire.service rog5-wireplumber.service
Before=rog5-denial.service

[Service]
Environment=XDG_RUNTIME_DIR=/run/user/0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus HOME=/root
ExecStart=/usr/bin/pipewire-pulse
Restart=on-failure
RestartSec=2

[Install]
WantedBy=rog5-pipewire.service
