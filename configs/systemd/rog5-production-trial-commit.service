[Unit]
Description=Commit this boot of the default ROG5 production kernel as healthy
After=rog5-persistent-state.service rog5-persistent-ssh-identity.service rog5-early-sshd.service
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/run/rog5-production-trial/commit
TimeoutStartSec=240
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
