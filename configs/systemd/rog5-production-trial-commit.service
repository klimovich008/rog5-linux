[Unit]
Description=Commit this boot of the default ROG5 production kernel as healthy
# Not ordered after the SSH services: the script polls for them, and it must
# already be polling when Phosh shows its startup lock (see local_shell_ready).
After=rog5-persistent-state.service
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/run/rog5-production-trial/commit
TimeoutStartSec=240
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
