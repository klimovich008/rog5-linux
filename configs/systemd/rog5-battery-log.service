# Runs only with Denial: its 2 s sysfs polling is a pmic_glink round trip to
# the ADSP each time, which kept the ADSP and the cluster busy under Phosh
# (2026-09-27).
[Unit]
PartOf=rog5-denial.service
Description=ROG5 battery samples for the Denial battery tile
ConditionPathExists=/sys/class/power_supply/qcom-battmgr-bat

[Service]
ExecStart=/usr/local/bin/rog5-battery-log
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=rog5-denial.service
