# GNOME desktop for the "phone" user on an external display (desktop mode),
# started from the "Desktop mode" launcher on the unlocked phone (polkit rule
# 60-rog5-desktop-mode: active local session only). No
# display manager, so GNOME's own screen lock (it needs GDM) is off: when
# GNOME goes idle or the display is unplugged, rog5-desktop-mode starts Phosh
# again, which comes up on its PIN lock screen. The touchscreen is a touchpad
# while this runs (rog5-touchpad.service).
[Unit]
Description=GNOME desktop on the external display (ROG5 desktop mode)
Requires=rog5-platform-modules.service
# After=rog5-phosh: when one replaces the other, the stop finishes before the
# start (Phosh's tty hangup killed GNOME's start when both ran at once).
After=rog5-platform-modules.service systemd-user-sessions.service rog5-p2-ready.service rog5-phosh.service
Conflicts=rog5-phosh.service
Wants=rog5-touchpad.service
ConditionPathExists=/usr/bin/gnome-session

[Service]
User=phone
PAMName=phosh
WorkingDirectory=~
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_CURRENT_DESKTOP=GNOME XDG_SESSION_DESKTOP=gnome
# Setup marker: ExecStopPost also runs after a skipped start (ExecCondition,
# e.g. in GNOME Mobile mode), and must then not reset the shared settings.
ExecStartPre=+/bin/touch /run/rog5-gnome.setup
ExecStartPre=+/usr/bin/chvt 7
# mutter does not detach planes a previous compositor left on a CRTC it does
# not use (plane-0 on the panel CRTC after Phosh): every frame on DP then
# failed with "switching CRTC directly". Start from an all-off KMS state.
ExecStartPre=+/usr/local/libexec/rog5-kms-reset /dev/dri/card1
# DPU pin: core clock 460 MHz and 15.5 GB/s bus votes while the desktop
# runs. Added 2026-09-29 against a blue DP monitor (INTF_0 underrun on every
# frame). The low votes were fixed by 0099/0100; the blue screen at GNOME's
# first enable (still there at 460 MHz, 2026-09-30) was the GAMMA_LUT commit
# moving the DP pipeline to other mixers without a modeset (kernel 0131/0132).
# Verified on kernel r104 (0130-0132): 5 of 5 GNOME starts without the pin
# had one DP enable, 0 underruns and the DPU on its own votes (~280 MHz core,
# 2026-09-30), so the pin is off by default and only costs DDR power.
# ROG5_DPU_PIN=1 (e.g. in a drop-in) brings it back for A/B tests.
Environment=ROG5_DPU_PIN=0
ExecStartPre=+/bin/sh -c '[ "$${ROG5_DPU_PIN}" = 0 ] && exit 0; P=/sys/kernel/debug/dri/1/debug/core_perf; echo 460000000 > $P/fix_core_clk_rate; echo 15500000 > $P/fix_core_ab_vote; echo 15500000 > $P/fix_core_ib_vote; echo 2 > $P/perf_mode'
# Phosh shows no title-bar buttons ('appmenu:'); a desktop needs them. The
# setting is shared with Phosh, so put it back when GNOME stops.
ExecStartPre=/bin/sh -c 'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus gsettings set org.gnome.desktop.wm.preferences button-layout "appmenu:minimize,maximize,close"'
# Desktop use: blank after 10 min (Phosh: 60 s), and the phone's power key
# must not try to suspend (the rog5-server inhibitor blocks sleep, so GNOME
# asked for a password to override it). Restored for Phosh on stop.
ExecStartPre=/bin/sh -c 'export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus; gsettings set org.gnome.desktop.session idle-delay 600; gsettings set org.gnome.settings-daemon.plugins.power power-button-action nothing'
# Phosh keeps no wallpaper (00-rog5-phosh); the desktop gets GNOME's default.
ExecStartPre=/bin/sh -c 'export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus; gsettings set org.gnome.desktop.background picture-uri file:///usr/share/backgrounds/gnome/adwaita-l.jxl; gsettings set org.gnome.desktop.background picture-uri-dark file:///usr/share/backgrounds/gnome/adwaita-d.jxl; gsettings set org.gnome.desktop.background picture-options zoom'
ExecStart=/usr/bin/gnome-session
ExecStopPost=+/bin/sh -c '[ -e /run/rog5-gnome.setup ] || exit 0; echo 0 > /sys/kernel/debug/dri/1/debug/core_perf/perf_mode'
ExecStopPost=/bin/sh -c '[ -e /run/rog5-gnome.setup ] || exit 0; export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus; gsettings set org.gnome.desktop.wm.preferences button-layout "appmenu:"; gsettings reset org.gnome.desktop.background picture-uri; gsettings reset org.gnome.desktop.background picture-uri-dark; gsettings reset org.gnome.desktop.background picture-options; gsettings reset org.gnome.desktop.session idle-delay; gsettings reset org.gnome.settings-daemon.plugins.power power-button-action'
ExecStopPost=+/bin/rm -f /run/rog5-gnome.setup
