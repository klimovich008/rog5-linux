# Session D-Bus for the Denial session (runs as root, like rog5-denial). Apps
# launched from the shell need it (e.g. GNOME Weather did nothing without it;
# app test 2026-09-26). Installed to /etc/systemd/system on the root overlay.
[Unit]
Description=Session D-Bus for the Denial session
Before=rog5-denial.service

[Service]
Type=exec
ExecStartPre=/usr/bin/install -d -m 0700 /run/user/0
ExecStart=/usr/bin/dbus-daemon --session --nofork --nopidfile --address=unix:path=/run/user/0/bus
Restart=on-failure

[Install]
WantedBy=multi-user.target
