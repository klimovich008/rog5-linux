# Modules the booted production system loads from /run/rog5-modules, in order.
# One module per line, optionally followed by its parameters.
# PMK8350 RTC: read-only time source, see production-rtc-time.
rtc_pm8xxx
# systemd's RuntimeWatchdogSec drives it; on expiry it panics, so ramoops keeps the log.
softdog soft_panic=1
# Empty driver for the A660 GMU so GCC/GPUCC reach sync_state (plan step 6).
# Must load before msm, which leaves devm resources on the GMU device.
rog5_gmu_bind
# Display and GPU (milestone 2): KMS on card0, the A660 as a separate render
# device; gpucc and refgen are built in.
# No kernel fbdev/fbcon client: at msm probe (~24 s) it modesets the panel,
# which shows glitches until Denial's first frame. Without it the bootloader
# splash stays up until Denial takes the display over.
drm_client_lib active=
# DisplayPort alt mode on the side port (dp DTB feature): the QMP USB3/DP combo
# PHY provides the DP link clocks, so it must be there before msm binds the DP
# controller; the SBU switch, the pmic_glink altmode client (HPD, orientation,
# pin assignment from the ADSP) and the aux bridges complete the chain. Without
# the dp nodes they bind nothing.
phy_qcom_qmp_combo
gpio_sbu_mux
aux_bridge
aux_hpd_bridge
pmic_glink_altmode
msm separate_gpu_kms=1
panel_asus_rog5_ams678
# Front touch (milestone 4): GPI DMA for the GENI SE, then the FTS3658U driver.
# Without the touch DT node the driver loads and binds nothing.
gpi
rog5_fts3658u
# Haptics (AW8697, input FF), light/proximity (VCNL36866, IIO) and the back logo
# LED (MS51 Aura, rgb:logo) on wrapper 0 I2C; they bind nothing without the
# peripherals overlay.
rog5_aw8697
rog5_vcnl36866
rog5_aura
# Rear camera flash / torch (PM8350C flash channel 1, peripherals overlay).
leds_qcom_flash
# Power key and volume-down (milestone 8): the PMK8350 PON parent populates
# the pwrkey/resin children the base DTB already enables (V9 buttons-indicator).
qcom_pon
# Board thermistors (PMK8350 ADC7) and the ADC-TM that feeds the skin and
# connector thermal zones (skin DTB feature); they bind nothing without it.
qcom_spmi_adc5
qcom_spmi_adc_tm5
# CPU memory bandwidth monitors (DDR voting, plan step 5): CPU->LLCC (v4) and
# LLCC->DDR (v5) vote from measured traffic. Without the bwmon DT nodes the
# driver loads and binds nothing.
icc_bwmon
# LLCC/DDR at their top level while the user touches or types (the bwmon
# ramp made the first frame of a gesture ~12 ms later, r31 bench).
rog5_input_boost
# RPMh sleep counters (/sys/kernel/debug/qcom_stats): DDR and CX collapse.
qcom_stats
