# Modules the booted production system loads from /run/rog5-modules, in order.
# One module per line, optionally followed by its parameters.
# PMK8350 RTC: read-only time source, see production-rtc-time.
rtc_pm8xxx
# systemd's RuntimeWatchdogSec drives it; on expiry it panics, so ramoops keeps the log.
softdog soft_panic=1
# Display and GPU (milestone 2): KMS on card0, the A660 as a separate render
# device; gpucc and refgen are built in.
msm separate_gpu_kms=1
panel_asus_rog5_ams678
# Front touch (milestone 4): GPI DMA for the GENI SE, then the FTS3658U driver.
# Without the touch DT node the driver loads and binds nothing.
gpi
rog5_fts3658u
