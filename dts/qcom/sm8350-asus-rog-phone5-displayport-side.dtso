// SPDX-License-Identifier: BSD-3-Clause
/*
 * DisplayPort alternate mode on the side (left) Type-C port, for an external
 * monitor or a USB-C hub with HDMI (docked mode). Stage 1: USB stays
 * high-speed (usb_1_dwc3 keeps only the usb2 PHY), so the USB network link
 * the phone is reached over does not change; the QMP USB3/DP combo PHY stays
 * in its default USB3+DP mode, i.e. 2 DP lanes (pin assignment D, what USB-C
 * hubs with HDMI use).
 *
 * The Type-C port must not depend on anything the ramdisk cannot load: with
 * the combo PHY or a gpio-sbu-mux as orientation/mode switches on the
 * connector graph, typec_register_port() deferred until their modules
 * loaded (the PHY pulls in drm through aux-bridge), UCSI never registered
 * port0 and the ramdisk failed "power-usb-telemetry-timeout" (r129/r131,
 * 2026-09-27). So:
 *  - the dp composition deletes "orientation-switch" from the combo PHY (it
 *    then registers no typec switch/mux and keeps USB3+DP);
 *  - the SBU/AUX 2:1 switch is fixed by GPIO hogs instead of gpio-sbu-mux:
 *    enable TLMM 167 low (stock drives it low while DP is configured),
 *    select PM8350C GPIO1 low (normal orientation). A flipped plug gets no
 *    AUX: turn the plug over.
 * From the stock ZS673KS tree (compare-displayport-dex report): HPD comes
 * from the ADSP over pmic_glink altmode (aux-hpd-bridge on the connector),
 * combo PHY supplies vdda-phy = L1B 0.88 V, vdda-pll = L6B 1.2 V (the base
 * dts has them swapped).
 * Needs usbotg (connector@0) and the combo PHY, aux bridge and
 * pmic_glink_altmode modules (boot-modules, before msm).
 */
/dts-v1/;
/plugin/;

#include <dt-bindings/clock/qcom,gcc-sm8350.h>
#include <dt-bindings/gpio/gpio.h>

&tlmm {
	rog5-dp-aux-en-hog {
		gpio-hog;
		gpios = <167 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "dp-aux-enable-n";
	};
};

&pm8350c_gpios {
	rog5-dp-aux-sel-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "dp-aux-select";
	};
};

&{/pmic-glink/connector@0/ports} {
	port@1 {
		reg = <1>;

		rog5_side_ss_in: endpoint {
			remote-endpoint = <&usb_1_qmpphy_out>;
		};
	};
};

/*
 * The combo PHY must hold the USB30_PRIM GDSC itself (as on sc8280xp/sm8550):
 * with the USB controller runtime-suspended after an unplug, the DP hotplug's
 * phy_init found gcc_usb3_prim_phy_aux_clk "stuck at 'off'" (-EBUSY), link
 * training never ran and phoc hung on a DP-1 without modes (r132).
 */
&usb_1_qmpphy {
	power-domains = <&gcc USB30_PRIM_GDSC>;
	vdda-phy-supply = <&vreg_l1b_0p88>;
	vdda-pll-supply = <&vreg_l6b_1p2>;
	status = "okay";
};

&usb_1_qmpphy_out {
	remote-endpoint = <&rog5_side_ss_in>;
};

&mdss_dp {
	status = "okay";
};

&mdss_dp_out {
	data-lanes = <0 1>;
};
