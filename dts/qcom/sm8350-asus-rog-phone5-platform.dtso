/*
 * Production self-recovery: the PMK8350 RTC (read-only; userspace keeps the
 * wall-time offset) and ramoops in the 4 MiB stock ASUS debug region at
 * 0x9b800000, which stock reserves for its own crash logs. The upstream
 * rmtfs node that overlaps it is already disabled (no modem).
 */
/dts-v1/;
/plugin/;

&pmk8350_rtc {
	status = "okay";
};

&{/reserved-memory} {
	#address-cells = <2>;
	#size-cells = <2>;

	ramoops@9b800000 {
		compatible = "ramoops";
		reg = <0x0 0x9b800000 0x0 0x400000>;
		record-size = <0x40000>;
		console-size = <0x100000>;
		pmsg-size = <0x40000>;
		ftrace-size = <0x0>;
		ecc-size = <16>;
	};
};
