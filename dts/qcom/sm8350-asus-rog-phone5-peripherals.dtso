// SPDX-License-Identifier: BSD-3-Clause
/*
 * Haptics, the front light/proximity sensor and the back logo LED, all on QUP
 * wrapper 0 next to the touchscreen (stock ZS673KS DT, MP board = PR1/ER2/ER1
 * overrides):
 *   SE6 I2C (i2c@998000): AW8697 LRA driver at 0x5a (chip ID 0x97), VBAT
 *     powered. tools/aw8697 drives it in CONT mode as an input FF device.
 *   SE0 I2C (i2c@980000): VCNL36866 light/proximity at 0x60 (ID 0x62),
 *     tools/vcnl36866 (IIO); and the MS51 Aura MCU at 0x16, powered by
 *     PM8350C GPIO 2 ("logo_5p0_en", hw_stage 5), tools/aura (multicolor
 *     LED rgb:logo).
 * All three answered on the r33 default boot with the buses enabled at run
 * time (2026-09-24).
 *
 * The sensor's supply is PM8350C LDO7 ("vcc_psensor"), which the boot chain
 * leaves on. Declaring LDO7 to Linux (3.3 V, HPM) reset the phone within the
 * first second of kernel boot (trial r34); SE6 alone (r35) and SE0 alone
 * without LDO7 (r36) booted, so the regulator stays undeclared.
 */
/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

&i2c6 {
	clock-frequency = <400000>;
	status = "okay";

	haptics@5a {
		compatible = "awinic,aw8697";
		reg = <0x5a>;
	};
};

&i2c0 {
	clock-frequency = <400000>;
	status = "okay";

	light-sensor@60 {
		compatible = "vishay,vcnl36866";
		reg = <0x60>;
	};

	led-controller@16 {
		compatible = "asus,rog5-aura";
		reg = <0x16>;
		enable-gpios = <&pm8350c_gpios 2 GPIO_ACTIVE_HIGH>;
		color = <LED_COLOR_ID_RGB>;
		function = "logo";
	};
};
