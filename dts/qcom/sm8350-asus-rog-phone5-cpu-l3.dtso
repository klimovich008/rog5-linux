};

&cpu0 {
	operating-points-v2 = <&cpu0_l3_opp_table>;
	interconnects = <&epss_l3 MASTER_OSM_L3_APPS &epss_l3 SLAVE_OSM_L3>;
};

&cpu1 {
	operating-points-v2 = <&cpu0_l3_opp_table>;
	interconnects = <&epss_l3 MASTER_OSM_L3_APPS &epss_l3 SLAVE_OSM_L3>;
};

&cpu2 {
	operating-points-v2 = <&cpu0_l3_opp_table>;
	interconnects = <&epss_l3 MASTER_OSM_L3_APPS &epss_l3 SLAVE_OSM_L3>;
};

&cpu3 {
	operating-points-v2 = <&cpu0_l3_opp_table>;
	interconnects = <&epss_l3 MASTER_OSM_L3_APPS &epss_l3 SLAVE_OSM_L3>;
