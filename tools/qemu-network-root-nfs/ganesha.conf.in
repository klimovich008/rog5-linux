NFS_CORE_PARAM {
	Protocols = 4;
	Enable_UDP = false;
	Enable_NLM = false;
	Enable_RQUOTA = false;
	Bind_addr = 0.0.0.0;
	NFS_Port = 2049;
}

NFSv4 {
	Graceless = true;
	Minor_Versions = 2;
}

EXPORT {
	Export_Id = 77;
	Path = /;
	Pseudo = /;
	Access_Type = RO;
	Squash = No_Root_Squash;
	Protocols = 4;
	Transports = TCP;
	PrivilegedPort = false;
	SecType = sys;

	FSAL {
		Name = MEM;
	}
}
