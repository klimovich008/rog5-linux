#!/usr/bin/env bash
# Discoverable entry points; existing builders/verifiers remain authoritative.
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)
action=${1:-help}
[[ $# == 0 ]] || shift
case $action in
  capture-rescue) exec python3 "$repo/scripts/host/headless-stage-receiver.py" "$@" ;;
  accept) exec python3 "$repo/scripts/host/release-acceptance.py" "$@" ;;
  check-rescue-root) exec python3 "$repo/scripts/host/check-rescue-root-composition.py" "$@" ;;
  check-deployed-server) exec python3 "$repo/scripts/host/check-deployed-server.py" "$@" ;;
  check-ssh-rollback) exec python3 "$repo/scripts/host/test-systemd-ssh-rollback.py" "$@" ;;
  check-package-keyring) exec python3 "$repo/scripts/host/test-systemd-package-keyring.py" "$@" ;;
  check-wifi-restart) exec python3 "$repo/scripts/host/test-systemd-wifi-restart.py" "$@" ;;
  check-overlay-recovery) exec python3 "$repo/scripts/host/test-qemu-overlay-recovery.py" "$@" ;;
  test) exec "$repo/scripts/host/test-repository-linux.sh" "${@:-active}" ;;
  select) exec python3 "$repo/scripts/host/select-repository-test-tier.py" "$@" ;;
  package) exec python3 "$repo/scripts/host/prepare-recovery-runtime-bundle.py" "$@" ;;
  check-target) exec python3 "$repo/scripts/host/run-sealed-busybox.py" "$@" ;;
  build-initramfs) exec python3 "$repo/scripts/device/build-native-wifi-boot-initramfs.py" "$@" ;;
  help|--help|-h)
    printf '%s\n' 'rog5-dev test [active|probe|ci|nightly]' \
      'rog5-dev capture-rescue --profile CLAIM_PROFILE --manifest EXACT_MANIFEST --output PRIVATE_NEW_DIRECTORY' \
      'rog5-dev accept quick|offline|device-smoke|release --output PRIVATE_NEW_DIRECTORY [--release RECEIPT]' \
      'rog5-dev check-rescue-root --inputs RECEIPT --root PRIVATE_RO_LOOP_MOUNT --output PRIVATE_NEW_DIRECTORY' \
      'rog5-dev check-deployed-server --profile CLAIM_PROFILE --manifest EXACT_MANIFEST --boot-id BOOT_ID --identity-file KEY --known-hosts PINNED_HOSTS --output PRIVATE_NEW_DIRECTORY' \
      'rog5-dev check-ssh-rollback --target-archive EXACT_ARCHIVE --output PRIVATE_NEW_DIRECTORY' \
      'rog5-dev check-package-keyring --output PRIVATE_NEW_DIRECTORY' \
      'rog5-dev check-wifi-restart --output PRIVATE_NEW_DIRECTORY' \
      'rog5-dev check-overlay-recovery --kernel EXACT_IMAGE --target-archive EXACT_ARCHIVE --root-image RETAINED_EXT4 --output PRIVATE_NEW_DIRECTORY' \
      'rog5-dev select [--event push|pull_request] BASE HEAD' \
      'rog5-dev build-initramfs --help' \
      'rog5-dev package --config RECIPE --private-key KEY --bundle-root OUTPUT' \
      'rog5-dev check-target --release RELEASE ARCHIVE -- APPLET [ARGS...]' \
      'Trial/release: see docs/development.md; this tool grants no boot authority.' ;;
  *) printf 'unknown action: %s\n' "$action" >&2; exit 2 ;;
esac
