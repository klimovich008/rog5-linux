#!/bin/sh
# ROG5 standby policy: suspend on battery when the screen has been off for a
# while; stay awake on external power (server mode).
#
# rog5-server-inhibit keeps logind from sleeping at all, which is right on
# USB power. On battery this daemon decides instead:
#   - external power (see ext_power), screen on, /run/rog5-stay-awake
#     present, a USB device attached in host mode with ROG5_SLEEP_USB_DEVICE_BLOCKS=1 (off by
#     default), or a remote client connected (unless
#     ROG5_SLEEP_SSH_BLOCKS=0): stay awake. USB devices used to block sleep
#     because s2idle killed the side-port xHCI (collapsed usb30_prim_gdsc);
#     kernel patch 0105 keeps it in retention, and hubs now survive suspend
#     (r184, 2026-09-29). A remote
#     client is any established inbound TCP connection from a non-loopback
#     address to a local listening port (SSH and everything tunnelled
#     through it, a web server, ...), audio playing (an ALSA playback
#     substream RUNNING or DRAINING: PipeWire opens a sink only while a
#     stream plays and suspends it 5 s after, 50-rog5-speakers.conf; covers
#     the speakers, the headset and USB audio, not Bluetooth), or a logind
#     block or block-weak "sleep" inhibitor from anyone but rog5-server
#     (`systemd-inhibit --what=sleep --mode=block JOB`, an app inhibiting
#     suspend through gnome-session; ROG5_SLEEP_INHIBIT_IGNORE, comma
#     separated, lists the WHO names to ignore): stay awake;
#   - otherwise, after ROG5_SLEEP_IDLE seconds (default 60) with the screen
#     off, suspend. rog5-server-inhibit's block ("sleep:handle-power-key",
#     WHO rog5-server) is always there, so logind's own idle and lid
#     handling never suspend; this daemon overrides it with
#     --check-inhibitors=no and therefore honours every other block
#     inhibitor itself. Delay-mode inhibitors (NetworkManager, UPower,
#     lock-before-sleep) only delay a suspend and do not keep it awake.
# After every wake the phone stays up at least ROG5_SLEEP_AWAKE seconds
# (default 15) so network and timers get a window, then suspends again if
# nothing changed. Plugging USB in keeps it awake. The power key (a PMIC
# wakeup source) wakes the phone, but a shell that re-activates its seat session
# on resume drops key events that arrive meanwhile (seen with Denial, 2026-09), so when the power key
# was the wake reason this daemon replays one KEY_POWER press through uinput
# (only while the display is still off, so it can never switch it back off;
# read again right before the press, since GNOME Shell Mobile lights the
# display on a power-key wake by itself).
# Suspend uses s2idle: a power-key wake from PSCI deep suspend warm-reset the
# phone (2026-09-27).
# ROG5_SLEEP_MODE (or the first word of /etc/rog5/sleep-mode) picks what
# "not in use" means: "suspend" (default) suspends as above; "reachable"
# never suspends on battery, so the phone stays reachable over the network
# at a higher standby current.
# Wi-Fi power save (802.11 PS) is switched off at once when the panel or an
# external display is lit or a remote client connects, and on again only
# after ROG5_SLEEP_WIFI_PS_HOLD seconds (default 60) with none of them: it
# adds ~70 ms average latency (AP buffering), but no longer stalled TCP on
# r127 (2026-09-27). Without the hold every short SSH command toggled it
# twice (84 toggles and log lines per hour, 2026-09-30), and desktop mode
# (panel off, monitor lit) counted as "screen off".
# Wake-on-WLAN (opt-in): with ROG5_SLEEP_WAKE_PORTS set, e.g.
# "tcp:22 udp:41641", WoWLAN is armed before each suspend (magic packet plus
# one IPv4 destination-port pattern per entry). It is OFF by default: on this
# WCN6855 hw1.1 with the ASUS 2021 firmware (WLAN.HSP.1.1.c3-00205) entering
# WoW failed ("htc suspend not complete", "failed to start wow: -110") and the
# firmware crashed (MHI_CB_EE_RDDM), leaving Wi-Fi dead while asleep; the
# first WoW suspends also woke at once through the root port PME, and the
# phone answered no ARP while asleep (2026-09-27).
#
#   rog5-sleep-policy          run the loop (rog5-sleep-policy.service)
#   rog5-sleep-policy --once   evaluate once and print the decision (tests)
set -u
idle_s=${ROG5_SLEEP_IDLE:-60}
awake_s=${ROG5_SLEEP_AWAKE:-15}
poll_s=${ROG5_SLEEP_POLL:-5}
usb=${ROG5_SLEEP_USB:-/sys/class/power_supply/qcom-battmgr-usb/online}
supplies=${ROG5_SLEEP_SUPPLIES:-/sys/class/power_supply}
chg_behaviour=${ROG5_SLEEP_CHG_BEHAVIOUR:-/sys/class/power_supply/qcom-battmgr-bat/charge_behaviour}
typec=${ROG5_SLEEP_TYPEC:-/sys/class/typec}
asound=${ROG5_SLEEP_ASOUND:-/proc/asound}
inhibitors_cmd=${ROG5_SLEEP_INHIBITORS_CMD:-busctl --system call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager ListInhibitors}
inhibit_ignore=${ROG5_SLEEP_INHIBIT_IGNORE-rog5-server}
dpms=${ROG5_SLEEP_DPMS:-/sys/class/drm/card1-DSI-1/dpms}
stay=${ROG5_SLEEP_STAY:-/run/rog5-stay-awake}
usb_devices=${ROG5_SLEEP_USB_DEVICES:-/sys/bus/usb/devices}
usb_device_blocks=${ROG5_SLEEP_USB_DEVICE_BLOCKS:-0}
ssh_blocks=${ROG5_SLEEP_SSH_BLOCKS:-1}
suspend_cmd=${ROG5_SLEEP_SUSPEND_CMD:-systemctl suspend --check-inhibitors=no}
state=${ROG5_SLEEP_STATE:-/run/rog5-sleep-policy}
mem_sleep=${ROG5_SLEEP_MEM_SLEEP:-/sys/power/mem_sleep}
kmsg=${ROG5_SLEEP_KMSG:-/dev/kmsg}
stats=${ROG5_SLEEP_STATS:-/sys/power/suspend_stats}
wake_irq=${ROG5_SLEEP_WAKE_IRQ:-/sys/power/pm_wakeup_irq}
wake_ports=${ROG5_SLEEP_WAKE_PORTS-}
mode_file=${ROG5_SLEEP_MODE_FILE:-/etc/rog5/sleep-mode}
wifi_ps=${ROG5_SLEEP_WIFI_PS:-1}
wifi_ps_hold=${ROG5_SLEEP_WIFI_PS_HOLD:-60}
ext_displays=${ROG5_SLEEP_EXT_DISPLAYS:-/sys/class/drm/card*-DP-*}
shell_effective=${ROG5_SLEEP_SHELL_EFFECTIVE:-/run/rog5-shell/effective}

# The configured mode: suspend or reachable.
sleep_mode() {
	m=${ROG5_SLEEP_MODE:-}
	[ -n "$m" ] || m=$(awk 'NF {print $1; exit}' "$mode_file" 2>/dev/null)
	case $m in reachable) echo reachable ;; *) echo suspend ;; esac
}

# Switches 802.11 power save on (screen off, no remote client) or off.
# Only acts when the wanted state or the set of interfaces (name and
# ifindex, so a recreated interface counts as new) changes, so a manual `iw`
# setting holds until the next screen or client change. The state is cached
# only after every interface took it: with no interface yet (boot before the
# driver) or a failed `iw` (firmware busy) the next poll tries again.
set_wifi_ps() {
	[ "$wifi_ps" = 1 ] && command -v iw >/dev/null || return 0
	want=$1
	devs=$(iw dev 2>/dev/null | awk '
		$1 == "Interface" { if (d != "") print d "/" i; d = $2; i = "" }
		$1 == "ifindex" { i = $2 }
		END { if (d != "") print d "/" i }')
	key="$want $(echo $devs)"
	[ "$key" != "$(cat "$state/wifi-ps" 2>/dev/null)" ] || return 0
	[ -n "$devs" ] || return 0
	ps_ok=1
	for d in $devs; do
		dev=${d%/*}
		if iw dev "$dev" set power_save "$want" 2>/dev/null; then
			log "wifi power save $want on $dev"
		else
			ps_ok=0
			# once per wanted state and interface set, not every poll
			[ "$key" = "$(cat "$state/wifi-ps-failed" 2>/dev/null)" ] ||
				log "WARN could not set wifi power save $want on $dev; retrying"
		fi
	done
	if [ "$ps_ok" = 1 ]; then
		echo "$key" >"$state/wifi-ps"
		rm -f "$state/wifi-ps-failed"
	else
		# Some interfaces may have taken it: the old cache no longer
		# describes them, so the next change (even back) applies again.
		rm -f "$state/wifi-ps"
		echo "$key" >"$state/wifi-ps-failed"
	fi
}

log() { printf 'rog5-sleep-policy: %s\n' "$*" >>"$kmsg" 2>/dev/null || true; }
now() { cut -d. -f1 /proc/uptime; }

# Prints why the phone must stay awake, or nothing. Cheapest checks first;
# the inhibitor list (one D-Bus call) only when nothing else holds.
awake_reason() {
	ext_power && return
	[ "$(cat "$dpms" 2>/dev/null)" = Off ] || { echo screen-on; return; }
	ext_display_lit && { echo external-display; return; }
	[ -e "$stay" ] && { echo stay-awake-file; return; }
	# Root hubs are usbN; anything attached below them is N-port[.port...].
	if [ "$usb_device_blocks" = 1 ] && ls "$usb_devices" 2>/dev/null | grep -q '^[0-9]*-[0-9.]*$'; then
		echo usb-device; return
	fi
	if [ "$ssh_blocks" = 1 ] && [ -n "$(clients)" ]; then
		echo remote-client; return
	fi
	audio_playing && { echo audio-playback; return; }
	who=$(sleep_blocker); case $? in
	0) echo "sleep-inhibitor:$who" ;;
	2) echo inhibitors-unknown ;;
	esac
}

# External power; prints the reason. qcom-battmgr-usb/online is the charger
# as the ADSP sees it and reads 0 while charge_behaviour force-discharge
# suspends USB input with the charger attached (rog5-charge-policy drain, a
# manual test: 2026-09-30 a force-discharge test on the hub suspended the
# phone after 60 s). So also: any other online USB/Mains/Wireless supply
# (the UCSI connector supply is online while the partner sources VBUS,
# whatever the charger does with it), and a charge_behaviour other than
# auto while a Type-C port has a partner and is the power sink (the partner
# supplies VBUS). rog5-charge-policy returns to auto within a poll of an
# unplug; the sink check keeps a stale value with a bottom-port disk (the
# phone is the source there) from holding the phone awake on battery.
ext_power() {
	[ "$(cat "$usb" 2>/dev/null)" = 1 ] && { echo usb-power; return 0; }
	for s in "$supplies"/*; do
		[ "$s/online" != "$usb" ] || continue
		case $(cat "$s/type" 2>/dev/null) in
		USB* | Mains | Wireless)
			[ "$(cat "$s/online" 2>/dev/null)" = 1 ] && { echo "external-power:${s##*/}"; return 0; } ;;
		esac
	done
	case $(cat "$chg_behaviour" 2>/dev/null) in
	'' | *'[auto]'*) ;;
	*)
		for p in "$typec"/port*-partner; do
			[ -e "$p" ] && grep -qs '\[sink\]' "${p%-partner}/power_role" &&
				{ echo usb-power-suspended; return 0; }
		done
		;;
	esac
	return 1
}

# Audio playback: an ALSA playback substream running or draining.
audio_playing() {
	grep -qs -e '^state: RUNNING' -e '^state: DRAINING' "$asound"/card*/pcm*p/sub*/status
}

# Prints the WHO of the first logind inhibitor in mode block or
# block-weak (gnome-session takes block-weak since GNOME 50; this daemon
# suspends with the inhibitors overridden, so it honours both) whose WHAT
# includes "sleep", skipping $inhibit_ignore; exit 1 for none. Exit 2 when
# the list could not be read: a workload's inhibitor may still be held, so
# the caller stays awake (a suspend needs logind anyway). Parses busctl's
# a(ssssuu) reply (what who why mode uid pid, repeated; strings quoted, with
# backslash escapes).
sleep_blocker() {
	out=$($inhibitors_cmd 2>/dev/null) || return 2
	case $out in 'a(ssssuu) '*) ;; *) return 2 ;; esac
	printf '%s\n' "$out" | awk -v ignore=",$inhibit_ignore," '
	{
		s = $0; n = 0
		while (1) {
			sub(/^[ \t]+/, "", s)
			if (s == "") break
			if (substr(s, 1, 1) == "\"") {
				v = ""; i = 2
				while (i <= length(s)) {
					c = substr(s, i, 1)
					if (c == "\\") { v = v substr(s, i + 1, 1); i += 2; continue }
					if (c == "\"") break
					v = v c; i++
				}
				s = substr(s, i + 1)
			} else {
				match(s, /^[^ \t]+/); v = substr(s, 1, RLENGTH); s = substr(s, RLENGTH + 1)
			}
			tok[++n] = v
		}
		for (i = 3; i + 5 <= n; i += 6)
			if ((tok[i + 3] == "block" || tok[i + 3] == "block-weak") && (":" tok[i] ":") ~ /:sleep:/ &&
			    index(ignore, "," tok[i + 1] ",") == 0) {
				who = tok[i + 1]; gsub(/[^A-Za-z0-9._@-]/, "_", who)
				print who; found = 1; exit
			}
	}
	END { exit !found }'
}

# Desktop mode: the panel is off while GNOME drives an external display
# (on battery this suspended a desktop in use 60 s after the monitor's
# power went away). A blanked external display (DPMS Off) does not count.
ext_display_lit() {
	for c in $ext_displays; do
		[ "$(cat "$c/enabled" 2>/dev/null)" = enabled ] &&
			[ "$(cat "$c/dpms" 2>/dev/null)" = On ] && return 0
	done
	return 1
}

# remote_clients, computed at most once per poll by the loop.
clients_known=0 clients_val=
clients() {
	if [ "$clients_known" = 1 ]; then printf '%s' "$clients_val"; else remote_clients; fi
}

# Established inbound TCP connections from outside: the local port is a
# listening port, the peer is not loopback, and the local address is on an
# interface that still has a link. A dead session over a pulled USB cable
# stays "established" (2026-09-27: it kept the phone awake for an hour).
remote_clients() {
	{ for d in /sys/class/net/*; do
		[ "$(cat "$d/carrier" 2>/dev/null)" = 1 ] || continue
		ip -o addr show dev "${d##*/}" 2>/dev/null | awk '{sub("/.*", "", $4); print "addr", $4}'
	  done
	  echo --; ss -Htln 2>/dev/null; echo --; ss -Htn state established 2>/dev/null; } | awk '
		$0 == "--" { part++; next }
		part == 0 { up[$2] = 1; next }
		part == 1 { n = split($4, a, ":"); listen[a[n]] = 1; next }
		{ n = split($3, l, ":"); addr = substr($3, 1, length($3) - length(l[n]) - 1)
		  gsub(/\[|\]/, "", addr); sub(/%.*/, "", addr); sub(/^::ffff:/, "", addr)
		  if ((l[n] in listen) && (addr in up) && $4 !~ /^(127\.|\[::1\]|\[::ffff:127\.)/) print }'
}

# iw pattern bytes for IPv4 <proto> to destination port <port>, from offset 12.
wake_pattern() {
	case $1 in tcp) p=06 ;; udp) p=11 ;; *) return 1 ;; esac
	printf '12+08:00:-:-:-:-:-:-:-:-:-:%s:-:-:-:-:-:-:-:-:-:-:-:-:%02x:%02x' "$p" $(($2 >> 8)) $(($2 & 255))
}

# Arms Wake-on-WLAN for the configured ports if Wi-Fi is associated.
arm_wowlan() {
	[ -n "$wake_ports" ] || return 0
	command -v iw >/dev/null || return 0
	phy=$(iw dev 2>/dev/null | awk '/^phy#/{sub("#", ""); p=$1} /Interface wlan/{print p; exit}')
	[ -n "$phy" ] && iw dev wlan0 link 2>/dev/null | grep -q '^Connected' || return 0
	pats=
	for e in $wake_ports; do pats="$pats $(wake_pattern "${e%%:*}" "${e#*:}")" || true; done
	# shellcheck disable=SC2086
	iw phy "$phy" wowlan enable magic-packet patterns $pats 2>/dev/null ||
		log "WARN could not arm Wake-on-WLAN on $phy"
}

# Number of finished suspend attempts (successful or failed).
attempts() { echo $(( $(cat "$stats/success" 2>/dev/null || echo 0) + $(cat "$stats/fail" 2>/dev/null || echo 0) )); }

# Suspends once and waits until the kernel has finished that attempt.
# systemctl returns as soon as the job is queued, so pm_wakeup_irq read right
# after it still belonged to the previous wake (2026-09-27: a stale power-key
# reading replayed KEY_POWER with the screen on). Returns 0 only when the
# kernel counted a successful suspend.
suspend_once() {
	before=$(attempts)
	ok_before=$(cat "$stats/success" 2>/dev/null || echo 0)
	$suspend_cmd || { log 'WARN suspend command failed'; return 1; }
	waited=0
	# The USB admission (rog5-usb-suspend-admit.service) can hold the suspend
	# job up to 50 s for a reconnect run, or refuse it (no attempt at all).
	while [ "$(attempts)" = "$before" ]; do
		[ "$waited" -lt 90 ] || { log 'WARN no suspend attempt within 90 s (refused or slow)'; return 1; }
		sleep 1
		waited=$((waited + 1))
	done
	[ "$(cat "$stats/success" 2>/dev/null || echo 0)" != "$ok_before" ] ||
		{ log "WARN suspend failed at $(cat "$stats/last_failed_step" 2>/dev/null)"; return 1; }
}

# The IRQ number of the PMIC power key, from /proc/interrupts.
pwrkey_irq() { awk '/pwrkey/{sub(":", "", $1); print $1; exit}' /proc/interrupts; }

# Replays one KEY_POWER press/release through uinput.
press_power_key() {
	ROG5_SLEEP_DPMS_PATH=$dpms python3 - <<'PY'
import fcntl, os, struct, time
UI_SET_EVBIT, UI_SET_KEYBIT, UI_DEV_CREATE, UI_DEV_DESTROY = 0x40045564, 0x40045565, 0x5501, 0x5502
EV_SYN, EV_KEY, KEY_POWER = 0, 1, 116
fd = os.open('/dev/uinput', os.O_WRONLY | os.O_NONBLOCK)
fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
fcntl.ioctl(fd, UI_SET_KEYBIT, KEY_POWER)
os.write(fd, struct.pack('80sHHHHi', b'rog5-sleep-policy wake key', 0x19, 1, 1, 1, 0) + bytes(256 * 4))
fcntl.ioctl(fd, UI_DEV_CREATE)
time.sleep(1.0)  # let the compositor pick the new device up
# The shell may have lit the display itself meanwhile (GNOME Shell Mobile
# does on a power-key wake): a press now would blank it again.
try:
    lit = open(os.environ['ROG5_SLEEP_DPMS_PATH']).read().strip() != 'Off'
except (KeyError, OSError):
    lit = False
for value in (() if lit else (1, 0)):
    os.write(fd, struct.pack('llHHi', 0, 0, EV_KEY, KEY_POWER, value))
    os.write(fd, struct.pack('llHHi', 0, 0, EV_SYN, 0, 0))
time.sleep(0.5)
fcntl.ioctl(fd, UI_DEV_DESTROY)
os.close(fd)
PY
}

# After a power-key wake: turn the display on once the shell listens again.
wake_display() {
	# GNOME Shell Mobile lights the display itself on a power-key wake; a
	# replayed press (a toggle) could only blank it again.
	if grep -qsx gnome-mobile "$shell_effective"; then
		log 'power-key wake: GNOME Mobile lights the display itself'
		return 0
	fi
	[ -e /dev/uinput ] || modprobe -d /run/rog5-modules uinput 2>/dev/null || modprobe uinput 2>/dev/null
	tries=0
	while [ "$tries" -lt 8 ] && [ "$(cat "$dpms" 2>/dev/null)" = Off ]; do
		sleep 1
		# checked again right before the press (the shell may light it itself)
		press_power_key || log 'WARN could not replay the power key'
		sleep 1
		tries=$((tries + 1))
	done
	log "display after power-key wake: $(cat "$dpms" 2>/dev/null) ($tries replays)"
}

if [ "${1:-}" = --once ]; then
	reason=$(awake_reason)
	echo "${reason:-sleep-eligible}"
	exit 0
fi

mkdir -p "$state"
[ ! -w "$mem_sleep" ] || echo s2idle >"$mem_sleep" 2>/dev/null || log 'WARN could not select s2idle'
off_since=0 ps_idle_since=
log "started: idle ${idle_s}s, awake after wake ${awake_s}s"
while :; do
	# One look at the connections per poll, and only when nothing is lit
	# (otherwise neither decision needs it).
	clients_known=0 clients_val=
	if [ "$(cat "$dpms" 2>/dev/null)" = Off ] && ! ext_display_lit; then
		clients_val=$(remote_clients) clients_known=1
	fi
	reason=$(awake_reason)
	if [ "$clients_known" = 1 ] && [ -z "$clients_val" ]; then
		t=$(now)
		[ -n "$ps_idle_since" ] || ps_idle_since=$t
		[ $((t - ps_idle_since)) -lt "$wifi_ps_hold" ] || set_wifi_ps on
	else
		ps_idle_since=
		set_wifi_ps off
	fi
	[ -n "$reason" ] || [ "$(sleep_mode)" != reachable ] || reason=reachable-mode
	if [ -n "$reason" ]; then
		[ "$off_since" = 0 ] || log "stay awake: $reason"
		off_since=0
	else
		t=$(now)
		[ "$off_since" != 0 ] || off_since=$t
		if [ $((t - off_since)) -ge "$idle_s" ]; then
			log "suspend: on battery, screen off for $((t - off_since)) s"
			arm_wowlan
			date -u +%FT%TZ >"$state/last-suspend"
			wake=
			if suspend_once; then
				wake=$(cat "$wake_irq" 2>/dev/null)
				log "resumed, wake irq ${wake:-unknown}"
			fi
			if [ -n "$wake" ] && [ "$wake" = "$(pwrkey_irq)" ]; then
				log 'woken by the power key'
				wake_display
				off_since=0
				sleep "$poll_s"
				continue
			fi
			# Back from suspend (or the command failed): keep a short awake
			# window, then re-evaluate with the timer already expired.
			sleep "$awake_s"
			off_since=$(( $(now) - idle_s ))
			continue
		fi
	fi
	sleep "$poll_s"
done
