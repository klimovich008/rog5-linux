#!/bin/sh
# Re-enumerate the USB gadget after the cable is plugged back in.
#
# The dwc3 controller (a600000.usb, dr_mode=peripheral, no role switch, VBUS
# forced valid) is never told about a detach: after an unplug/replug the link
# stays in Suspend, the UDC in "default", and the host sees nothing attached.
# soft_connect does not help; a driver unbind/bind (core and HS PHY re-init)
# does, and the host enumerates the gadget at once (2026-09-26).
#
# Host mode has the opposite problem. When UCSI switches the running
# controller from device to host, xHCI comes up but every attached device
# fails with "device descriptor read/64, error -71" at full speed. After the
# same unbind/bind and a switch to host, a hub enumerates at high speed with
# its devices behind it (2026-09-26). So in host mode, if nothing enumerates
# within a few seconds, the controller is re-initialised once and put back in
# host mode.
#
# Run by rog5-usb-reconnect.service, which udev starts on every change of the
# qcom-battmgr-usb power supply and of the side port's role switch. On a
# data-capable attach (SDP/CDP) it waits for the host to configure the gadget
# and re-initialises the controller only if that does not happen. A charger
# (DCP) or an already configured link is left alone.
set -u
# One run at a time: the re-init changes the role and udev starts this
# service again; a second run cycling the controller mid-sequence left the
# USB-C KVM dead (2026-09-30).
exec 9>/run/rog5-usb-reconnect.lock
flock -n 9 || exit 0
udc=a600000.usb
gadget=/sys/kernel/config/usb_gadget/rog5-persistent-root
supply=/sys/class/power_supply/qcom-battmgr-usb
wait_s=${ROG5_USB_RECONNECT_WAIT:-6}

role=/sys/class/usb_role/$udc-role-switch/role
stamp=/run/rog5-usb-reconnect.host
host_wait_s=${ROG5_USB_HOST_WAIT:-4}
# After the re-init the controller comes up as a device; switching it to host
# one second later still gave -71 at full speed, 10 s later enumerated a
# USB-C KVM hub at once (2026-09-30).
host_settle_s=${ROG5_USB_HOST_SETTLE:-8}
# Retries after a re-initialisation that enumerated nothing (count reset by
# a success or by leaving host mode); each waits out the 30 s rate limit.
retries=/run/rog5-usb-reconnect.retries
max_retries=${ROG5_USB_HOST_RETRIES:-3}
retry_s=${ROG5_USB_HOST_RETRY_S:-35}

# The USB-link Tailscale (rog5-tailscaled) skips itself while usb0 is down.
start_usb_tailscale() { systemctl --no-block start rog5-tailscaled.service 2>/dev/null || true; }
log() { printf 'rog5-usb-reconnect: %s\n' "$*" >/dev/kmsg 2>/dev/null || true; }
state() { cat "/sys/class/udc/$udc/state" 2>/dev/null; }
host_mode() {
	grep -qs '^\[host\]' /sys/class/typec/port0/data_role ||
		grep -qsx host "$role"
}
# Any device on the controller's root hubs (usb1-1, usb2-1, ...).
enumerated() {
	ls -d /sys/bus/platform/devices/$udc/xhci-hcd.*/usb*/[0-9]*-[1-9]* >/dev/null 2>&1
}

# DisplayPort alt mode shares the side port's QMP combo PHY. The re-init
# used to be skipped while DP was attached (a hub stayed dark on 2026-09-28,
# but DP had other faults then). On 2026-09-30 a dwc3 unbind/bind with a USB-C
# KVM monitor at 1080p kept the DP link up and made the monitor's hub,
# keyboard and mouse enumerate; skipping it left them dead after every replug.
# dp_attached is only logged now.
dp_attached() {
	for dp in /sys/class/drm/card*-DP-*/status; do
		[ "$(cat "$dp" 2>/dev/null)" = connected ] && return 0
	done
	return 1
}

reinit() {
	dp_attached && log "DP sink attached; re-initialising $udc anyway (DP stays up)"
	echo "$udc" >/sys/bus/platform/drivers/dwc3/unbind || { log 'FAIL unbind'; return 1; }
	sleep 1
	echo "$udc" >/sys/bus/platform/drivers/dwc3/bind || { log 'FAIL bind'; return 1; }
	sleep 1
}

if host_mode; then
	# The gadget is not in use. Re-initialise at most once per 30 s: the
	# re-init itself changes the role twice and starts this service again.
	waited=0
	while [ "$waited" -lt "$host_wait_s" ]; do
		enumerated && { rm -f "$retries"; exit 0; }
		host_mode || exit 0
		sleep 1
		waited=$((waited + 1))
	done
	now=$(cut -d. -f1 /proc/uptime)
	last=$(cat "$stamp" 2>/dev/null || echo -100)
	[ $((now - last)) -ge 30 ] || exit 0
	echo "$now" >"$stamp"
	log "host mode, nothing enumerated after ${host_wait_s}s; re-initialising $udc"
	reinit || exit 1
	# UCSI puts the rebound controller straight back into host mode, which
	# still fails; hold device mode for the settle time first (the manual
	# sequence that worked).
	echo device >"$role" 2>/dev/null
	sleep "$host_settle_s"
	echo host >"$role" || { log 'FAIL set host role'; exit 1; }
	waited=0
	while [ "$waited" -lt 10 ]; do
		enumerated && { log 'PASS device enumerated after re-initialisation'; rm -f "$retries"; exit 0; }
		sleep 1
		waited=$((waited + 1))
	done
	# At boot the monitor's USB can come up only after this attempt (then
	# -71 at 54 s with nothing left to start this service, 2026-09-30):
	# try again later, a few times, while the port stays in host mode.
	n=$(cat "$retries" 2>/dev/null || echo 0)
	if [ "$n" -lt "$max_retries" ]; then
		echo $((n + 1)) >"$retries"
		log "host mode: nothing enumerated after re-initialisation; retry $((n + 1))/$max_retries in ${retry_s}s"
		systemd-run --quiet --on-active="$retry_s" --unit="rog5-usb-reconnect-retry-$((n + 1))" \
			/usr/bin/systemctl --no-block start rog5-usb-reconnect.service || true
	else
		log 'host mode: nothing enumerated after re-initialisation'
	fi
	exit 0
fi
rm -f "$retries"

[ "$(cat "$supply/online" 2>/dev/null)" = 1 ] || exit 0
case $(cat "$supply/usb_type" 2>/dev/null) in
*'[SDP]'*|*'[CDP]'*) ;;
*) exit 0 ;;
esac
waited=0
while [ "$waited" -lt "$wait_s" ]; do
	[ "$(state)" = configured ] && { start_usb_tailscale; exit 0; }
	host_mode && exit 0
	sleep 1
	waited=$((waited + 1))
done
log "gadget still $(state) ${wait_s}s after attach; re-initialising $udc"
reinit || exit 1
[ -n "$(cat "$gadget/UDC" 2>/dev/null)" ] || echo "$udc" >"$gadget/UDC" || { log 'FAIL gadget bind'; exit 1; }
ip link set usb0 up 2>/dev/null
waited=0
while [ "$waited" -lt 10 ]; do
	[ "$(state)" = configured ] && { log "PASS gadget configured after re-initialisation"; start_usb_tailscale; exit 0; }
	sleep 1
	waited=$((waited + 1))
done
log "gadget $(state) after re-initialisation"
exit 1
