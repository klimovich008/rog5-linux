#!/bin/sh
# Switch the phone's graphical shell between Denial and Phosh.
#
#   rog5-shell                    print the running and the boot-default shell
#   rog5-shell phosh|denial       switch now (the boot default is unchanged)
#   rog5-shell --default phosh|denial   switch now and make it the boot default
#                                       (with its audio stack)
#
# Denial runs as root with the root PipeWire services (rog5-pipewire*);
# Phosh runs as "phone" with that user's own PipeWire, so the root audio
# services are stopped while Phosh runs.
set -eu
unit() { case "$1" in phosh) echo rog5-phosh.service ;; denial) echo rog5-denial.service ;; *) echo "unknown shell: $1" >&2; exit 2 ;; esac; }
root_audio='rog5-pipewire.service rog5-wireplumber.service rog5-pipewire-pulse.service'
status() {
	for s in denial phosh; do
		printf '%s: %s, boot %s\n' "$s" "$(systemctl is-active "$(unit $s)" || true)" "$(systemctl is-enabled "$(unit $s)" 2>/dev/null || true)"
	done
}
default=0
[ "${1:-}" != --default ] || { default=1; shift; }
[ $# -gt 0 ] || { status; exit 0; }
want=$1
other=denial; [ "$want" = denial ] && other=phosh
if [ "$default" = 1 ]; then
	systemctl disable "$(unit "$other")"
	systemctl enable "$(unit "$want")"
	# rog5-pipewire is wanted by multi-user.target; at boot it would take
	# the sound card from the Phosh user's PipeWire.
	if [ "$want" = phosh ]; then
		systemctl disable rog5-pipewire.service
	else
		systemctl enable rog5-pipewire.service
	fi
fi
systemctl stop "$(unit "$other")"
if [ "$want" = phosh ]; then
	systemctl stop $root_audio 2>/dev/null || true
else
	systemctl start $root_audio 2>/dev/null || true
fi
systemctl start "$(unit "$want")"
status
