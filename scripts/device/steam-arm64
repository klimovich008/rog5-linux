#!/bin/sh
# Start the native aarch64 Steam client installed by steam-arm64-install.
#
# Valve's steam.sh has no aarch64 path, so this does its jobs for
# steamrtarm64: the ~/.steam links, the library path, and restarting the
# client when it exits with 42 (it does that after installing its own update).
#
#   steam-arm64 [steam arguments]
root=${STEAMROOT:-$HOME/.local/share/Steam}
[ -x "$root/steamrtarm64/steam" ] || { echo "steam-arm64: not installed; run steam-arm64-install" >&2; exit 1; }
# Shared lock for Steam's lifetime (inherited by the client and its games):
# steam-fex-rootfs-install takes it exclusively, so the x86 root is never
# swapped under a running game. The installer creates the file.
lock=${ROG5_FEX_LOCK:-/run/lock/rog5-fex-rootfs.lock}
if [ -r "$lock" ]; then
	exec 8<"$lock"
	flock -s -n 8 || { echo 'steam-arm64: steam-fex-rootfs-install is replacing the FEX x86 root; start Steam when it is done' >&2; exit 1; }
fi
# The ~/.steam links steam.sh creates, plus sdkarm64: games start through
# ~/.steam/sdkarm64/steam-launch-wrapper and the overlay is preloaded from
# ~/.steam/bin64/.. .
c=$HOME/.steam
mkdir -p "$c"
ln -sfn "$root/ubuntu12_32" "$c/bin32"
ln -sfn "$root/ubuntu12_64" "$c/bin64"
ln -sfn "$root/linux32" "$c/sdk32"
ln -sfn "$root/linux64" "$c/sdk64"
ln -sfn "$root/linuxarm64" "$c/sdkarm64"
ln -sfn "$root" "$c/root"
ln -sfn "$root" "$c/steam"
ln -sfn "$c/bin32" "$c/bin"
ln -sfn "$c/sdk32/steam" "$HOME/.steampath"
ln -sfn "$c/steam.pid" "$HOME/.steampid"
# Browser composer (HKCU\Software\Valve\Steam\OverrideBrowserComposerMode,
# which the client passes to steamwebhelper as -composer-mode: 0 default,
# 1 System, 2 OpenGL, 3 Gamescope). The default System composer puts CEF's own
# X window over the whole SDL window, so the SDL hit test that implements the
# title-bar drag (-webkit-app-region: drag -> _NET_WM_MOVERESIZE) never sees
# the click and the window cannot be dragged by its title bar under
# GNOME/Xwayland. The OpenGL composer draws CEF off screen into the SDL window,
# which then gets the clicks itself. ROG5_STEAM_COMPOSER=keep leaves the
# value alone. Only written while no client runs: Steam writes registry.vdf
# back on exit, and a second start just hands its arguments to the running one.
composer=${ROG5_STEAM_COMPOSER-2}
pid=$(cat "$c/steam.pid" 2>/dev/null) || pid=
case $composer in
0 | 1 | 2 | 3)
	if [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = steam ]; then
		:
	elif [ ! -e "$c/registry.vdf" ]; then
		printf '"Registry"\n{\n\t"HKCU"\n\t{\n\t\t"Software"\n\t\t{\n\t\t\t"Valve"\n\t\t\t{\n\t\t\t\t"Steam"\n\t\t\t\t{\n\t\t\t\t\t"OverrideBrowserComposerMode"\t\t"%s"\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n' "$composer" >"$c/registry.vdf"
	elif awk -v v="$composer" '
		# Set the value inside Registry/HKCU/Software/Valve/Steam: replace the
		# key if it is there, otherwise add it before that block closes.
		function unq(s) { gsub(/^[ \t]*"|"[ \t]*$/, "", s); return tolower(s) }
		BEGIN { want = "registry/hkcu/software/valve/steam"; d = 0 }
		{
			line = $0
			if (line ~ /^[ \t]*\{[ \t]*$/) { d++; path[d] = pend; print; next }
			if (line ~ /^[ \t]*\}[ \t]*$/) {
				if (!done && cur() == want) {
					match(line, /^[ \t]*/)
					printf "%s\t\"OverrideBrowserComposerMode\"\t\t\"%s\"\n", substr(line, 1, RLENGTH), v; done = 1
				}
				d--; print; next
			}
			if (line ~ /^[ \t]*"[^"]*"[ \t]*$/) { pend = unq(line); print; next }
			if (cur() == want && tolower(line) ~ /^[ \t]*"overridebrowsercomposermode"[ \t]/) {
				match(line, /^[ \t]*/)
				if (!done) printf "%s\"OverrideBrowserComposerMode\"\t\t\"%s\"\n", substr(line, 1, RLENGTH), v
				done = 1; next
			}
			print
		}
		function cur(   i, p) { p = ""; for (i = 1; i <= d; i++) p = p (i > 1 ? "/" : "") path[i]; return p }
		END { exit done ? 0 : 1 }' "$c/registry.vdf" >"$c/registry.vdf.rog5"; then
		if cmp -s "$c/registry.vdf" "$c/registry.vdf.rog5"; then rm -f "$c/registry.vdf.rog5"; else mv -f "$c/registry.vdf.rog5" "$c/registry.vdf"; fi
	else
		rm -f "$c/registry.vdf.rog5"
		echo "steam-arm64: could not find HKCU/Software/Valve/Steam in $c/registry.vdf; browser composer not set" >&2
	fi
	;;
keep) ;;
*) echo "steam-arm64: ignoring ROG5_STEAM_COMPOSER=$composer (0-3 or keep)" >&2 ;;
esac
# The client's library path goes to the client only. Like steam.sh, keep the
# caller's values in SYSTEM_PATH/SYSTEM_LD_LIBRARY_PATH: the client puts them
# back for the games and tools it starts, so steamrtarm64's libraries do not
# leak into them (they did while this wrapper exported LD_LIBRARY_PATH).
export SYSTEM_PATH="$PATH" SYSTEM_LD_LIBRARY_PATH="${LD_LIBRARY_PATH-}"
while :; do
	LD_LIBRARY_PATH="$root/steamrtarm64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
		"$root/steamrtarm64/steam" -noverifyfiles "$@"
	status=$?
	[ "$status" = 42 ] || exit "$status"
	echo "steam-arm64: restarting Steam by request" >&2
done
