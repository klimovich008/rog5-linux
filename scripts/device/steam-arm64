#!/bin/sh
# Start the native aarch64 Steam client installed by steam-arm64-install.
#
# Valve's steam.sh has no aarch64 path, so this does its jobs for
# steamrtarm64: the ~/.steam links, the library path, and restarting the
# client when it exits with 42 (it does that after installing its own update).
#
#   steam-arm64 [steam arguments]
root=${STEAMROOT:-$HOME/.local/share/Steam}
[ -x "$root/steamrtarm64/steam" ] || { echo "steam-arm64: not installed; run steam-arm64-install" >&2; exit 1; }
# Shared lock for Steam's lifetime (inherited by the client and its games):
# steam-fex-rootfs-install takes it exclusively, so the x86 root is never
# swapped under a running game. The installer creates the file.
lock=${ROG5_FEX_LOCK:-/run/lock/rog5-fex-rootfs.lock}
if [ -r "$lock" ]; then
	exec 8<"$lock"
	flock -s -n 8 || { echo 'steam-arm64: steam-fex-rootfs-install is replacing the FEX x86 root; start Steam when it is done' >&2; exit 1; }
fi
# The ~/.steam links steam.sh creates, plus sdkarm64: games start through
# ~/.steam/sdkarm64/steam-launch-wrapper and the overlay is preloaded from
# ~/.steam/bin64/.. .
c=$HOME/.steam
mkdir -p "$c"
ln -sfn "$root/ubuntu12_32" "$c/bin32"
ln -sfn "$root/ubuntu12_64" "$c/bin64"
ln -sfn "$root/linux32" "$c/sdk32"
ln -sfn "$root/linux64" "$c/sdk64"
ln -sfn "$root/linuxarm64" "$c/sdkarm64"
ln -sfn "$root" "$c/root"
ln -sfn "$root" "$c/steam"
ln -sfn "$c/bin32" "$c/bin"
ln -sfn "$c/sdk32/steam" "$HOME/.steampath"
ln -sfn "$c/steam.pid" "$HOME/.steampid"
# Title-bar drag and edge resize: steamwebhelper implements them as an SDL hit
# test on its window, but CEF's own X window covers that window and takes the
# clicks; the code that cuts the drag areas out of CEF's input shape is never
# switched on. steam-arm64-drag.so (source next to this script, built on first
# use) switches it on inside steamwebhelper, for the Steam build it knows only.
# ROG5_STEAM_DRAG=0 leaves it out.
if [ "${ROG5_STEAM_DRAG-1}" != 0 ]; then
	src=${ROG5_STEAM_DRAG_SRC:-$(dirname -- "$0")/steam-arm64-drag.c}
	so=${XDG_CACHE_HOME:-$HOME/.cache}/rog5/steam-arm64-drag.so
	if [ -r "$src" ] && { [ ! -e "$so" ] || [ "$src" -nt "$so" ]; }; then
		mkdir -p "${so%/*}"
		printf 'SDL3_0.0.0 {\n\tglobal: SDL_SetWindowHitTest; SDL_GetWindowSize;\n\tlocal: *;\n};\n' >"$so.map"
		${CC:-cc} -O2 -shared -fPIC -Wl,--version-script="$so.map" -o "$so.new" "$src" && mv -f "$so.new" "$so" ||
			echo "steam-arm64: could not build $so; Steam windows keep no title-bar drag" >&2
		rm -f "$so.map" "$so.new"
	fi
	[ -e "$so" ] && export LD_PRELOAD="$so${LD_PRELOAD:+:$LD_PRELOAD}"
fi
# The client's library path goes to the client only. Like steam.sh, keep the
# caller's values in SYSTEM_PATH/SYSTEM_LD_LIBRARY_PATH: the client puts them
# back for the games and tools it starts, so steamrtarm64's libraries do not
# leak into them (they did while this wrapper exported LD_LIBRARY_PATH).
export SYSTEM_PATH="$PATH" SYSTEM_LD_LIBRARY_PATH="${LD_LIBRARY_PATH-}"
while :; do
	LD_LIBRARY_PATH="$root/steamrtarm64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
		"$root/steamrtarm64/steam" -noverifyfiles "$@"
	status=$?
	[ "$status" = 42 ] || exit "$status"
	echo "steam-arm64: restarting Steam by request" >&2
done
