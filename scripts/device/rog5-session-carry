#!/usr/bin/env python3
"""Carry the open apps across a Phosh <-> GNOME desktop-mode switch.

A switch stops one compositor and starts the other, so every app closes.
This makes it cheaper:

  save [--close]   (ExecStop of rog5-phosh / rog5-gnome, as the phone user,
                   while the old compositor still runs) acts only on a
                   switch, i.e. while systemd has a start job queued for the
                   other session unit and no shutdown/reboot job: it records
                   the apps and, with --close, asks them to quit cleanly
                   (browsers then restore their tabs instead of reporting a
                   crash). --timeout bounds the whole run (collection, quit
                   requests and waiting). On a shutdown, a crash restart or a
                   plain stop it records nothing and drops any old record.
  restore          (rog5-session-restore.service, user unit started with
                   graphical-session.target) claims the record atomically
                   (once only), uses it only in the same boot and if it is
                   at most --max-age seconds old, waits until the session is
                   unlocked (Phosh comes up locked after a hand-back; up to
                   --unlock-wait seconds) and then relaunches the apps, each
                   only while that same session is still active and
                   unlocked (a relock or a session change stops it).
  status           prints the record.

Which apps: the ones Phosh and GNOME launched that still run (systemd
scopes app-gnome-<desktop id>-<pid>.scope; this includes an app that only
sits in the tray, e.g. Steam with its window closed) plus D-Bus activated GtkApplications
that have a window (<object path>/window/<n> on the session bus; names are
checked with NameHasOwner and called with NO_AUTO_START, so nothing is ever
activated by the check). Only ids with an installed, visible .desktop file
are kept. Never carried: the shells' own pieces and the mode launchers;
more with "exclude GLOB" lines in /etc/rog5/session-carry.conf or
~/.config/rog5/session-carry.conf ("off" in either disables the tool).

Games started by Steam run inside Steam's scope: Steam is reopened, the game
is not.
"""
from __future__ import annotations

import argparse
import fnmatch
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_EXCLUDE = (
    'rog5-desktop-mode', 'rog5-phone-mode', 'mobi.phosh.*', 'sm.puri.*',
    'org.gnome.Shell*', 'org.gnome.Extensions', 'gnome-session*',
    'org.freedesktop.*', 'xdg-desktop-portal*', 'org.gnome.ScreenSaver',
    # background services that keep a hidden GtkApplication window
    'org.gnome.Software', 'org.gnome.Evolution-alarm-notify',
)
SCOPE_RE = re.compile(r'^app-gnome-(?P<id>.+)-(?P<pid>[0-9]+)\.scope$')
APP_ID_RE = re.compile(r'^[A-Za-z0-9._-]{1,128}$')
SESSION_UNITS = ('rog5-gnome.service', 'rog5-phosh.service')
SHUTDOWN_UNITS = ('shutdown.target', 'reboot.target', 'poweroff.target', 'halt.target',
                  'kexec.target', 'final.target', 'soft-reboot.target')
MAX_RECORD = 64 * 1024
MAX_APPS = 64
_deadline = None


def remaining(cap):
    """Seconds an operation may take: CAP, or less near the run's deadline."""
    if _deadline is None:
        return cap
    return max(0.05, min(cap, _deadline - time.monotonic()))


def expired():
    return _deadline is not None and time.monotonic() >= _deadline


def log(msg):
    print(f'rog5-session-carry: {msg}', file=sys.stderr, flush=True)


def env(name, default):
    return os.environ.get('ROG5_SESSION_CARRY_' + name, default)


def state_file():
    base = os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'), '.local/state')
    return Path(env('STATE', os.path.join(base, 'rog5/session-carry.json')))


def config_files():
    return [Path(env('SYS_CONF', '/etc/rog5/session-carry.conf')),
            Path(os.path.expanduser(env('USER_CONF', '~/.config/rog5/session-carry.conf')))]


def read_small_file(path, limit=MAX_RECORD):
    """Text of a regular file of at most LIMIT bytes; None otherwise. Never
    blocks on a FIFO or a device at that path (O_NONBLOCK, then fstat)."""
    import stat
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > limit:
            return None
        with os.fdopen(fd, 'rb', closefd=False) as f:
            data = f.read(limit + 1)
    except OSError:
        return None
    finally:
        os.close(fd)
    if len(data) > limit:
        return None
    return data.decode('utf-8', 'replace')


def read_config():
    """(enabled, exclude globs)."""
    enabled, exclude = True, list(DEFAULT_EXCLUDE)
    for path in config_files():
        text = read_small_file(path)
        if text is None:
            if path.exists() or path.is_symlink():
                log(f'{path}: not a small regular file, ignored')
            continue
        lines = text.splitlines()
        for line in lines:
            words = line.split('#', 1)[0].split()
            if not words:
                continue
            if words[0] == 'off':
                enabled = False
            elif words[0] == 'exclude' and len(words) > 1:
                exclude.extend(words[1:])
    return enabled, exclude


def boot_id():
    try:
        return Path(env('BOOT_ID_FILE', '/proc/sys/kernel/random/boot_id')).read_text().strip()
    except OSError:
        return ''


def unescape_unit(text):
    return re.sub(r'\\x([0-9a-fA-F]{2})', lambda m: chr(int(m.group(1), 16)), text)


class System:
    """Everything that touches the session; the tests replace it."""

    def __init__(self):
        self._bus = None

    def run(self, argv, timeout=10):
        try:
            p = subprocess.run(argv, capture_output=True, text=True, timeout=remaining(timeout))
            return p.returncode, p.stdout
        except (OSError, subprocess.TimeoutExpired):
            return 1, ''

    def scopes(self):
        rc, out = self.run(['systemctl', '--user', 'list-units', '--type=scope', '--state=running',
                            '--plain', '--no-legend', '--full', 'app-gnome-*'])
        return [line.split()[0] for line in out.splitlines() if line.split()] if rc == 0 else []

    def bus(self):
        if self._bus is None:
            from gi.repository import Gio
            self._bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        return self._bus

    def _call(self, name, path, iface, method, args, reply):
        from gi.repository import Gio, GLib
        return self.bus().call_sync(name, path, iface, method, args, GLib.VariantType(reply),
                                    Gio.DBusCallFlags.NO_AUTO_START, int(remaining(3) * 1000), None).unpack()

    def bus_names(self):
        try:
            names = self._call('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus',
                               'ListNames', None, '(as)')[0]
        except Exception:
            return []
        return [n for n in names if not n.startswith(':')]

    def window_count(self, name):
        """Open GtkApplication windows of NAME (0 if none or not running)."""
        from gi.repository import GLib
        try:
            if not self._call('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus',
                              'NameHasOwner', GLib.Variant('(s)', (name,)), '(b)')[0]:
                return 0
            path = '/' + name.replace('.', '/').replace('-', '_') + '/window'
            xml = self._call(name, path, 'org.freedesktop.DBus.Introspectable', 'Introspect', None, '(s)')[0]
        except Exception:
            return 0
        return len(re.findall(r'<node name="[0-9]+"', xml))

    def name_pid(self, name):
        from gi.repository import GLib
        try:
            return int(self._call('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus',
                                  'GetConnectionUnixProcessID', GLib.Variant('(s)', (name,)), '(u)')[0])
        except Exception:
            return 0

    def quit_app(self, name):
        """GtkApplication's app.quit action; False if it has none."""
        from gi.repository import GLib
        path = '/' + name.replace('.', '/').replace('-', '_')
        try:
            actions = self._call(name, path, 'org.gtk.Actions', 'List', None, '(as)')[0]
            if 'quit' not in actions:
                return False
            self._call(name, path, 'org.gtk.Actions', 'Activate',
                       GLib.Variant('(sava{sv})', ('quit', [], {})), '()')
            return True
        except Exception:
            return False

    def visible_app(self, app_id):
        """True for an installed .desktop file that is not hidden."""
        try:
            import gi
            try:        # GLib >= 2.86 moved it to GioUnix (Gio's copy warns)
                gi.require_version('GioUnix', '2.0')
                from gi.repository import GioUnix as DesktopGio
            except (ImportError, ValueError):
                gi.require_version('Gio', '2.0')
                from gi.repository import Gio as DesktopGio
            info = DesktopGio.DesktopAppInfo.new(app_id + '.desktop')
        except Exception:
            return False
        return info is not None and not info.get_nodisplay() and not info.get_is_hidden()

    def kill_scope(self, unit):
        self.run(['systemctl', '--user', 'kill', '--signal=SIGTERM', unit])

    def kill_pid(self, pid):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass

    def supervisor_active(self):
        rc, state = self.run(['systemctl', 'is-active', 'rog5-desktop-mode.service'], timeout=0.5)
        return rc == 0 and state.strip() == 'active'

    def switch_pending(self):
        """True while a start job for the other session unit is queued and
        no shutdown-type job is: a Phosh <-> GNOME switch, not a shutdown,
        crash restart or plain stop."""
        rc, out = self.run(['systemctl', 'list-jobs', '--no-legend', '--plain'])
        if rc != 0:
            return False
        jobs = [line.split() for line in out.splitlines() if len(line.split()) >= 3]
        if any(j[1] in SHUTDOWN_UNITS for j in jobs):
            return False
        return any(j[1] in SESSION_UNITS and j[2] == 'start' for j in jobs)

    def session_state(self):
        """(session id, 'no' | 'yes' | None) for this user's graphical
        session: 'no' only while it is unlocked and active on its seat
        (an inactive session counts as locked), None if unknown."""
        import pwd
        user = pwd.getpwuid(os.getuid()).pw_name
        rc, sid = self.run(['loginctl', 'show-user', user, '-p', 'Display', '--value'])
        sid = sid.strip()
        if rc != 0 or not sid:
            return None, None
        rc, out = self.run(['loginctl', 'show-session', sid, '-p', 'LockedHint', '-p', 'Active', '-p', 'Seat', '-p', 'Leader'])
        if rc != 0:
            return sid, None
        props = dict(line.split('=', 1) for line in out.splitlines() if '=' in line)
        locked, active = props.get('LockedHint'), props.get('Active')
        if locked not in ('yes', 'no') or active not in ('yes', 'no'):
            return sid, None
        if active != 'yes' or locked != 'no':
            return sid, 'yes'
        if props.get('Seat') != 'seat0' or not props.get('Leader', '').isdigit():
            return sid, None
        # Display is only logind's preferred primary session. Require it to
        # be the running destination compositor's PAM session, not SSH or
        # another same-user graphical session.
        for unit in SESSION_UNITS:
            rc, out = self.run(['systemctl', 'show', unit, '-p', 'MainPID', '-p', 'ActiveState'])
            unit_props = dict(line.split('=', 1) for line in out.splitlines() if '=' in line)
            if rc == 0 and unit_props.get('ActiveState') == 'active' and \
                    unit_props.get('MainPID') == props['Leader'] and props['Leader'] != '0':
                return sid, 'no'
        return sid, None

    def launch(self, app_id):
        unit = 'app-gnome-%s-%d.scope' % (self.escape(app_id), os.getpid() * 100 + int(time.time()) % 100)
        rc, _ = self.run(['systemd-run', '--user', '--scope', '--collect', '--quiet', '--unit=' + unit,
                          'gtk-launch', app_id], timeout=30)
        return rc == 0

    def escape(self, text):
        rc, out = self.run(['systemd-escape', text])
        return out.strip() if rc == 0 and out.strip() else re.sub(r'[^A-Za-z0-9_.]', '_', text)

    def sleep(self, s):
        time.sleep(s)


def excluded(app_id, globs):
    return any(fnmatch.fnmatch(app_id, g) for g in globs)


def collect(sysm, globs):
    """{app id: {'scopes': [...], 'bus': name or None}} for the apps to carry."""
    apps = {}
    for unit in sysm.scopes():
        if expired():
            break
        m = SCOPE_RE.match(unit)
        if not m:
            continue
        app_id = unescape_unit(m.group('id'))
        if excluded(app_id, globs) or not sysm.visible_app(app_id):
            continue
        apps.setdefault(app_id, {'scopes': [], 'bus': None})['scopes'].append(unit)
    for name in sysm.bus_names():
        if expired():
            break
        if excluded(name, globs) or not sysm.visible_app(name):
            continue
        if name not in apps and sysm.window_count(name) == 0:
            continue
        apps.setdefault(name, {'scopes': [], 'bus': None})['bus'] = name
    return apps


def close_apps(sysm, apps):
    """Ask APPS to quit; wait until they are gone or the deadline passes."""
    left = sorted(apps)
    for app_id, a in apps.items():
        if expired():
            return left
        if a['bus'] and sysm.quit_app(a['bus']):
            continue
        for unit in a['scopes']:
            sysm.kill_scope(unit)
        if a['bus'] and not a['scopes']:
            pid = sysm.name_pid(a['bus'])
            if pid > 1:
                sysm.kill_pid(pid)
    while not expired():
        running = set(sysm.scopes())
        names = set(sysm.bus_names())
        left = [i for i, a in apps.items()
                if any(u in running for u in a['scopes']) or (a['bus'] and a['bus'] in names)]
        if not left:
            return []
        sysm.sleep(min(0.5, remaining(0.5)))
    return left


def drop_record(path):
    try:
        path.unlink()
    except OSError:
        pass


def write_private(path, text):
    import tempfile
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(text)
        os.replace(tmp, path)
    except BaseException:
        drop_record(Path(tmp))
        raise


def cmd_save(sysm, args):
    global _deadline
    _deadline = time.monotonic() + args.timeout
    # BindsTo stops GNOME on supervisor failure. Do not delay that stop by
    # collecting/closing apps for an OnFailure=Phosh recovery transaction.
    if os.environ.get('XDG_CURRENT_DESKTOP') == 'GNOME' and not sysm.supervisor_active():
        drop_record(state_file())
        log('desktop supervisor unavailable: stop GNOME without carrying apps')
        return 0
    enabled, globs = read_config()
    path = state_file()
    if not enabled:
        log('off (session-carry.conf)')
        return 0
    if not sysm.switch_pending():
        drop_record(path)
        log('not a Phosh/GNOME switch (shutdown, restart or plain stop): nothing recorded')
        return 0
    apps = collect(sysm, globs)
    names = sorted(apps)[:MAX_APPS]
    desktop = os.environ.get('XDG_CURRENT_DESKTOP', '')
    rec = {'format': 'rog5-session-carry-v1', 'boot_id': boot_id(), 'saved': time.time(),
           'from': desktop[:64], 'apps': names}
    write_private(path, json.dumps(rec) + '\n')
    log(f'saved {len(names)} app(s) from {desktop or "?"}: {" ".join(names) or "-"}')
    if args.close and apps:
        left = close_apps(sysm, apps)
        log('closed cleanly' if not left else f'still running at the {args.timeout:g} s limit: {" ".join(left)}')
    return 0


def claim_record(path):
    """Take the record for this run only (rename, then read); None if there
    is none or it is not a plain private file of ours."""
    claimed = path.with_name(f'.{path.name}.claimed.{os.getpid()}')
    try:
        os.rename(path, claimed)
    except OSError:
        return None
    try:
        st = os.lstat(claimed)
        import stat
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_size > MAX_RECORD:
            return None
        return claimed.read_text()
    except OSError:
        return None
    finally:
        drop_record(claimed)


def valid_record(text):
    """The record as a dict, or None unless it has exactly the expected shape."""
    import math
    try:
        rec = json.loads(text)
    except ValueError:
        return None
    if not isinstance(rec, dict) or rec.get('format') != 'rog5-session-carry-v1':
        return None
    saved, apps = rec.get('saved'), rec.get('apps')
    if not isinstance(rec.get('boot_id'), str) or not isinstance(saved, (int, float)) or \
            isinstance(saved, bool) or not math.isfinite(saved):
        return None
    if not isinstance(apps, list) or len(apps) > MAX_APPS or \
            not all(isinstance(a, str) and APP_ID_RE.match(a) for a in apps):
        return None
    if not isinstance(rec.get('from', ''), str):
        return None
    return rec


def wait_unlocked(sysm, limit):
    """The session id once the session reports unlocked; None on timeout or
    if the lock state stays unreadable (no session) for 30 s."""
    end = time.monotonic() + limit
    unknown_since = None
    while time.monotonic() < end:
        sid, state = sysm.session_state()
        if state == 'no' and sid:
            return sid
        if state is None:
            unknown_since = unknown_since or time.monotonic()
            if time.monotonic() - unknown_since > 30:
                return None
        else:
            unknown_since = None
        sysm.sleep(2)
    return None


def cmd_restore(sysm, args):
    enabled, globs = read_config()
    text = claim_record(state_file())
    if text is None or not enabled:
        return 0
    rec = valid_record(text)
    if rec is None:
        log('record malformed: ignored')
        return 0
    age = time.time() - float(rec['saved'])
    if rec['boot_id'] != boot_id() or not 0 <= age <= args.max_age:
        log(f'record not used (other boot or {age:.0f} s old)')
        return 0
    apps = [a for a in rec['apps'] if not excluded(a, globs) and sysm.visible_app(a)]
    if not apps:
        return 0
    sid = wait_unlocked(sysm, args.unlock_wait)
    if not sid:
        log(f'session not unlocked within {args.unlock_wait:g} s: {len(apps)} app(s) not reopened')
        return 0
    sysm.sleep(args.delay)
    ok = []
    for i, app in enumerate(apps):
        # the same session, still active and unlocked, before each launch
        if sysm.session_state() != (sid, 'no'):
            log(f'session {sid} locked, inactive or replaced: {len(apps) - i} app(s) not reopened')
            break
        if sysm.launch(app):
            ok.append(app)
    log(f'reopened {len(ok)}/{len(apps)} app(s) from {rec.get("from") or "?"}: {" ".join(ok) or "-"}')
    return 0


def cmd_status(_sysm, _args):
    try:
        print(state_file().read_text().strip())
    except OSError:
        print('no record')
    return 0


def main(argv=None, sysm=None):
    p = argparse.ArgumentParser(prog='rog5-session-carry')
    sub = p.add_subparsers(dest='cmd', required=True)
    s = sub.add_parser('save')
    s.add_argument('--close', action='store_true')
    s.add_argument('--timeout', type=float, default=6.0)
    r = sub.add_parser('restore')
    r.add_argument('--max-age', type=float, default=300.0)
    r.add_argument('--delay', type=float, default=2.0)
    r.add_argument('--unlock-wait', type=float, default=1800.0)
    sub.add_parser('status')
    args = p.parse_args(argv)
    for name in ('timeout', 'max_age', 'delay', 'unlock_wait'):
        v = getattr(args, name, None)
        if v is not None and not (0 <= v < 1e6):
            p.error(f'--{name.replace("_", "-")} must be between 0 and 1e6')
    os.environ.setdefault('DBUS_SESSION_BUS_ADDRESS', f'unix:path=/run/user/{os.getuid()}/bus')
    os.environ.setdefault('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
    global _deadline
    _deadline = None
    sysm = sysm or System()
    return {'save': cmd_save, 'restore': cmd_restore, 'status': cmd_status}[args.cmd](sysm, args)


if __name__ == '__main__':
    sys.exit(main())
