#!/bin/sh
# ROG5 bottom USB-C port (DT feature usbbtm, patches 0089/0090): USB 2.0 host
# with the port's 5 V switched by hand.
#
#   rog5-usb-bottom on       switch 5 V on (devices enumerate in ~2 s)
#   rog5-usb-bottom off      switch 5 V off
#   rog5-usb-bottom status   5 V state and attached devices
#
# Only USB devices (sticks, hubs, adapters) go in the bottom port: never a
# charger or a computer while the 5 V is on (stage A has no Type-C policy).
#
# The controller stays runtime-active (power/control=on, the default): its
# runtime resume lost state ("xHC error in resume", SMMU fault, dead HC) and
# retries were unreliable; awake it costs about 5 mA, and system suspend
# still powers it down. A runtime-suspended root hub saw a connect
# (CCS+CSC) but never woke to enumerate it, so the root hubs are held awake
# while the 5 V is on.
set -eu
V=/sys/devices/platform/rog5-btm-vbus-output/state
X=$(ls -d /sys/devices/platform/soc@0/a8f8800.usb/a800000.usb/xhci-hcd.* 2>/dev/null | head -1)
[ -w "$V" ] && [ -n "$X" ] || { echo 'rog5-usb-bottom: no bottom port (needs the usbbtm DT and 0089)' >&2; exit 1; }
case ${1:-status} in
on)
	for h in "$X"/usb*; do echo on > "$h/power/control"; done
	echo 1 > "$V"
	[ "$(cat "$V")" = enabled ] || { echo 'rog5-usb-bottom: 5 V did not switch on (see dmesg)' >&2; exit 1; }
	;;
off)
	echo 0 > "$V"
	for h in "$X"/usb*; do echo auto > "$h/power/control"; done
	;;
status)
	echo "5V=$(cat "$V")"
	for d in "$X"/usb*/[0-9]*-[0-9]*; do
		[ -e "$d/product" ] && echo "$(basename "$d"): $(cat "$d/product") $(cat "$d/speed") Mb/s"
	done
	;;
*) echo 'usage: rog5-usb-bottom on|off|status' >&2; exit 2 ;;
esac
