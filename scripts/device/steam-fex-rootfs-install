#!/bin/sh
# Install the x86 guest root that Steam's FEX compatibility tool needs to run
# x86 games (Proton or native x86 Linux) on the aarch64 Steam client.
#
# FEX-Emu's fex-compat-tool uses /usr/share/guestos/fex-mesa as the x86 root
# (SteamOS on ARM ships it; Arch Linux ARM does not). FEX-Emu's official
# Arch Linux root image carries exactly that: an x86_64/i686 userland with a
# Mesa that has freedreno (GL) and turnip (Vulkan, for DXVK/VKD3D) and a
# graphics_provider.json. This downloads the image named in FEX's
# RootFS_links.json, checks its XXH3 hash from the same list, and unpacks it.
#
# The new root is unpacked beside the old one and swapped in with one
# rename(RENAME_EXCHANGE) (mv --exchange), so a working root is in place at
# every moment; the old one is removed afterwards. Without exchange support
# two renames are used, and an interrupted run is repaired by the next one.
# One run at a time (flock), and not while Steam runs (games keep files of
# the old root open; steam-arm64 holds a shared lock).
#
#   steam-fex-rootfs-install          (as root; needs squashfs-tools, xxhash)
set -eu
[ "$(id -u)" = 0 ] || { echo 'steam-fex-rootfs-install: run as root' >&2; exit 1; }
dest=${ROG5_FEX_ROOT:-/usr/share/guestos/fex-mesa}
cache=${ROG5_FEX_CACHE:-/var/cache/rog5-fex}
entry='ArchLinux (SquashFS)'
mkdir -p "$cache"
exec 9>"$cache/install.lock"
flock -n 9 || { echo 'steam-fex-rootfs-install: another install is running' >&2; exit 1; }
# steam-arm64 holds this lock shared while Steam runs; new Steam starts are
# refused while it is held here. pgrep covers a Steam started before the
# lock file existed (/run is empty after a boot).
lock=${ROG5_FEX_LOCK:-/run/lock/rog5-fex-rootfs.lock}
[ -e "$lock" ] || { : >"$lock"; chmod 644 "$lock"; }
exec 8<"$lock"
flock -x -n 8 || { echo 'steam-fex-rootfs-install: quit Steam first' >&2; exit 1; }
pgrep -f 'steamrtarm64/steam( |$)' >/dev/null && { echo 'steam-fex-rootfs-install: quit Steam first' >&2; exit 1; }
# a run interrupted between the two fallback renames left only $dest.old
if [ ! -e "$dest" ] && [ -d "$dest.old" ]; then mv -T "$dest.old" "$dest"; fi
curl -fsSL --max-time 60 https://rootfs.fex-emu.gg/RootFS_links.json -o "$cache/links.json"
set -- $(python3 - "$cache/links.json" "$entry" <<'PY'
import json, sys
e = json.load(open(sys.argv[1]))["v1"][sys.argv[2]]
print(e["URL"], e["Hash"])
PY
)
url=$1 hash=$2
echo "downloading $url"
curl -fsSL --retry 3 "$url" -o "$cache/rootfs.sqsh.part"
mv "$cache/rootfs.sqsh.part" "$cache/rootfs.sqsh"
got=$(xxhsum -H3 "$cache/rootfs.sqsh" | awk '{print $1}')
[ "${got#XXH3_}" = "$hash" ] || { echo "steam-fex-rootfs-install: XXH3 $got, expected $hash" >&2; exit 1; }
rm -rf "$dest.new"; mkdir -p "$(dirname "$dest")"
unsquashfs -q -n -d "$dest.new" "$cache/rootfs.sqsh"
[ -f "$dest.new/graphics_provider.json" ] || { echo "steam-fex-rootfs-install: no graphics_provider.json in the image" >&2; exit 1; }
if [ ! -e "$dest" ]; then
	mv -T "$dest.new" "$dest"
elif ! mv -T --exchange "$dest.new" "$dest" 2>/dev/null; then
	# no RENAME_EXCHANGE (old coreutils or filesystem): two renames
	rm -rf "$dest.old"
	mv -T "$dest" "$dest.old"
	mv -T "$dest.new" "$dest" || { mv -T "$dest.old" "$dest"; exit 1; }
fi
rm -rf "$dest.new" "$dest.old"          # the previous root
rm -f "$cache/rootfs.sqsh"
echo "installed: $dest ($url)"
