#!/bin/sh
# ROG5 charge limit / bypass charging (kernel patch 0082 on qcom-battmgr-bat).
#
#   rog5-charge-limit status            current behaviour, thresholds, battery
#   rog5-charge-limit set END [START]   keep the battery between START and END %
#                                       (START defaults to END-5); charging
#                                       pauses at END and resumes at START
#   rog5-charge-limit bypass            never charge: run from the charger,
#                                       the cells rest (inhibit-charge)
#   rog5-charge-limit off               normal charging to 100 %
#   rog5-charge-limit apply             apply /etc/rog5/charge-limit (boot)
#
# set/bypass/off also write /etc/rog5/charge-limit, which
# rog5-charge-limit.service applies at boot. Lines: behaviour=auto|
# inhibit-charge|force-discharge, end=N, start=N. Without the file nothing
# changes (normal charging).
set -eu
B=/sys/class/power_supply/qcom-battmgr-bat
conf=/etc/rog5/charge-limit
[ -w "$B/charge_behaviour" ] || { echo 'rog5-charge-limit: kernel without charge control (0082)' >&2; exit 1; }
write_conf() { mkdir -p /etc/rog5; printf '%s\n' "$@" > "$conf.tmp"; mv "$conf.tmp" "$conf"; }
apply() {
	behaviour=auto end=100 start=0
	if [ -r "$conf" ]; then
		while IFS='=' read -r k v; do
			case $k in behaviour) behaviour=$v ;; end) end=$v ;; start) start=$v ;; esac
		done < "$conf"
	fi
	# end first: a start >= the current end would move end.
	echo "$end" > "$B/charge_control_end_threshold"
	[ "$start" = 0 ] || echo "$start" > "$B/charge_control_start_threshold"
	echo "$behaviour" > "$B/charge_behaviour"
}
case ${1:-status} in
status)
	printf 'behaviour: %s\nlimit: %s-%s %%\nbattery: %s %% %s, %s uA\n' \
		"$(sed 's/.*\[\(.*\)\].*/\1/' "$B/charge_behaviour")" \
		"$(cat "$B/charge_control_start_threshold")" "$(cat "$B/charge_control_end_threshold")" \
		"$(cat "$B/capacity")" "$(cat "$B/status")" "$(cat "$B/current_now")" ;;
set)
	end=${2:?usage: rog5-charge-limit set END [START]}; start=${3:-$((end - 5))}
	write_conf behaviour=auto "end=$end" "start=$start"; apply ;;
bypass) write_conf behaviour=inhibit-charge; apply ;;
off) rm -f "$conf"; apply ;;
apply) apply ;;
*) sed -n '2,19p' "$0" >&2; exit 2 ;;
esac
