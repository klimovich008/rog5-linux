#!/bin/sh
# Battery samples for Denial's home battery tile. Denial reads the file its
# companion power daemon (denia-powerd, not packaged here) writes:
#   /run/denia-powerd/battery_discharge.tsv
#   ts_ms  source  state  capacity  current_ma  voltage_mv  power_mw
# This takes them from the PMIC GLINK battery (qcom-battmgr-bat) every
# ROG5_BATTERY_PERIOD seconds and keeps the newest ~3600 lines; a rotation
# replaces the file atomically, which the tile's reader follows.
# ROG5_BATTERY_ONESHOT=1 writes one sample and exits (tests).
set -u
bat=${ROG5_BATTERY:-/sys/class/power_supply/qcom-battmgr-bat}
dir=${ROG5_BATTERY_LOG_DIR:-/run/denia-powerd}
period=${ROG5_BATTERY_PERIOD:-2}
keep=3600
out=$dir/battery_discharge.tsv
header='ts_ms\tsource\tstate\tcapacity\tcurrent_ma\tvoltage_mv\tpower_mw\n'

value() {
	# one sysfs attribute, or "unknown"
	v=
	read -r v <"$bat/$1" 2>/dev/null || v=
	case $v in ''|*[!0-9-]*) [ "$1" = status ] && [ -n "$v" ] || v=unknown ;; esac
	printf '%s' "$v"
}

mkdir -p "$dir" || exit 1
printf "$header" >"$out.tmp" && mv -f "$out.tmp" "$out" || exit 1
lines=0
while :; do
	state=$(value status | tr 'A-Z ' 'a-z-')
	capacity=$(value capacity)
	ua=$(value current_now)
	uv=$(value voltage_now)
	ma=unknown mv=unknown mw=unknown
	[ "$ua" = unknown ] || ma=$((ua / 1000))
	[ "$uv" = unknown ] || mv=$((uv / 1000))
	if [ "$ma" != unknown ] && [ "$mv" != unknown ]; then
		mw=$((ma * mv / 1000))
		[ "$mw" -ge 0 ] || mw=$((-mw))
	fi
	printf '%s\tqcom-battmgr\t%s\t%s\t%s\t%s\t%s\n' "$(date +%s%3N)" "$state" "$capacity" "$ma" "$mv" "$mw" >>"$out"
	[ "${ROG5_BATTERY_ONESHOT:-0}" = 1 ] && exit 0
	lines=$((lines + 1))
	if [ "$lines" -ge $((2 * keep)) ]; then
		{ printf "$header"; tail -n "$keep" "$out" | grep -v '^ts_ms'; } >"$out.tmp" && mv -f "$out.tmp" "$out"
		lines=$keep
	fi
	sleep "$period"
done
