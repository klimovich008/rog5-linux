#!/bin/sh
# systemd-sleep hook (install as /usr/lib/systemd/system-sleep/rog5-usb-sleep):
# after resume, rebind every xHCI controller that had USB devices attached
# before the suspend and has none afterwards.
#
# s2idle with a hub on the side port (a600000.usb, xhci-hcd.1.auto) collapsed
# the controller's power domain: on resume it fetched from stale IOVAs (~31k
# SMMU context faults from SID 0x0), "xhci-hcd: WARNING: Host System Error",
# and the hub never
# re-enumerated ("couldn't allocate usb_device") until the xHCI was rebound
# (2026-09-29, r182). Kernel patch 0105 (usb30_prim_gdsc in retention) fixed
# the cause on r184; this hook stays as a safety net. Unbinding the xHCI
# before suspend instead reset the phone during suspend entry (r182; kernel
# 0117 guards that dereference now), so the hook never unbinds before suspend.
# A device unplugged while asleep costs a harmless rebind.
#
# It also keeps rog5-usb-reconnect (which unbinds and binds dwc3) away from
# suspend. systemd ignores a sleep hook's exit status, so a hook cannot veto
# a suspend; the veto is "admit", run by rog5-usb-suspend-admit.service,
# which the drop-in systemd-suspend.service.d/50-rog5-usb.conf Requires= and
# orders After=. "admit" marks the suspend ($suspending) and waits up to
# $lock_wait s for a reconnect run in progress to finish (it holds the
# reconnect lock for its whole transaction). If the lock stays busy it
# clears the marker and fails: systemd-suspend.service then fails with a
# dependency error and the system does not suspend (rog5-sleep-policy sees
# no suspend attempt and tries again later). Runs that start while the
# marker is set and a suspend job is queued exit without touching the
# controller and leave $skipped for "post".
# "pre" (inside systemd-sleep) takes the lock again and records the attached
# devices. It only repeats the old fallback (stop the run, bind the side
# controller again if the run left it unbound, only once it holds the lock)
# when the admission was bypassed, e.g. systemd-sleep run by hand.
# "post" does its recovery under the same lock, then clears the marker and,
# if a reconnect run was skipped meanwhile, starts one.
# systemd-sleep gives each hook 90 s.
set -u
sys=${ROG5_USB_SYS:-/sys}
run=${ROG5_USB_RUN:-/run}
kmsg=${ROG5_USB_KMSG:-/dev/kmsg}
drv=${ROG5_USB_SLEEP_DRIVER:-$sys/bus/platform/drivers/xhci-hcd}
list=${ROG5_USB_SLEEP_STATE:-$run/rog5-usb-sleep}
settle=${ROG5_USB_SLEEP_SETTLE:-3}
lock_wait=${ROG5_USB_SLEEP_LOCK_WAIT:-50}
lock=$run/rog5-usb-reconnect.lock
suspending=$run/rog5-usb-suspending
skipped=$run/rog5-usb-reconnect.skipped
udc=a600000.usb
log() { printf 'rog5-usb-sleep: %s\n' "$*" >>"$kmsg" 2>/dev/null || true; }

# Prints the attached (non-root-hub) devices of controller $1.
devices() {
	for bus in "$1"/usb[0-9]*; do
		[ -d "$bus" ] || continue
		n=${bus##*/usb}
		ls "$bus" | grep "^$n-[0-9.]*\$"
	done
}

# Binds the side controller to dwc3 if a stopped reconnect run left it
# unbound (only possible between its unbind and bind).
bind_side() {
	[ -e "$sys/bus/platform/devices/$udc" ] || return 0
	[ -e "$sys/bus/platform/devices/$udc/driver" ] && return 0
	log "$udc left unbound by rog5-usb-reconnect; binding it"
	echo "$udc" >"$sys/bus/platform/drivers/dwc3/bind" 2>/dev/null ||
		log "WARN could not bind $udc"
}

# A reconnect run that was skipped meanwhile gets its look now.
replay_skipped() {
	[ -e "$skipped" ] || return 0
	rm -f "$skipped"
	systemctl --no-block start rog5-usb-reconnect.service 2>/dev/null || true
}

case ${1-} in
admit)
	rm -f "$skipped"
	# The marker comes first: a run that starts from now on sees it (and the
	# queued suspend job) and stays away from the controller.
	: >"$suspending" || { log 'FAIL could not create the suspend marker; refusing suspend'; exit 1; }
	exec 9>"$lock"
	if ! flock -w "$lock_wait" 9; then
		log "FAIL rog5-usb-reconnect still running after ${lock_wait}s; refusing suspend"
		rm -f "$suspending"
		replay_skipped
		exit 1
	fi
	# Again under the lock: a run that read the job list before this
	# suspend was queued may have removed the marker as stale meanwhile.
	# From here on every run sees the marker and the queued job.
	: >"$suspending" && [ -e "$suspending" ] ||
		{ log 'FAIL could not keep the suspend marker; refusing suspend'; rm -f "$suspending"; exit 1; }
	exit 0
	;;
pre)
	: >"$suspending"
	exec 9>"$lock"
	if ! flock -w "$lock_wait" 9; then
		log "rog5-usb-reconnect still running after ${lock_wait}s; stopping it"
		# "post" replays the interrupted run.
		: >"$skipped"
		systemctl kill --signal=TERM rog5-usb-reconnect.service 2>/dev/null
		# Never touch the controller without the lock. Only reachable when
		# the admission unit was bypassed: a hook cannot veto the suspend
		# (systemd ignores its exit status); log loudly.
		flock -w 10 9 || { log 'FAIL reconnect lock still held at suspend entry'; exit 1; }
		bind_side
	fi
	: >"$list"
	for c in "$drv"/xhci-hcd.*; do
		[ -n "$(devices "$c")" ] && echo "${c##*/}" >>"$list"
	done
	;;
post)
	exec 9>"$lock"
	# Without the lock: no recovery; the marker goes stale (the helper drops
	# it once no suspend job and no systemd-sleep are left).
	flock -w "$lock_wait" 9 || { log 'FAIL reconnect lock busy after resume'; exit 1; }
	if [ -s "$list" ]; then
		sleep "$settle"
		while read -r name; do
			[ -n "$(devices "$drv/$name")" ] && continue
			log "$name lost its USB devices over suspend; rebinding"
			echo "$name" >"$drv/unbind" 2>/dev/null
			echo "$name" >"$drv/bind" || log "WARN could not rebind $name"
		done <"$list"
	fi
	rm -f "$list" "$suspending"
	exec 9>&-
	# A plug or role change while the marker was set was ignored: look now.
	replay_skipped
	;;
esac
exit 0
