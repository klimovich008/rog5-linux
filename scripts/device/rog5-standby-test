#!/bin/sh
# ROG5 unattended standby measurement (battery, screen off, rog5-sleep-policy).
#
# Waits up to ROG5_STANDBY_WAIT seconds (default 900) for USB power to go
# away, then records until USB power returns or ROG5_STANDBY_MAX seconds
# (default 1800) pass. It doesn't suspend anything itself: rog5-sleep-policy
# does, so this measures the real policy. Run it detached so an SSH session
# doesn't keep the phone awake:
#   systemd-run --unit rog5-standby-test /usr/local/sbin/rog5-standby-test
# Output: /var/lib/rog5-standby-test/<start time>/ (summary.txt plus raw data).
#   charge_counter start/end over wall-clock time (CLOCK_REALTIME includes
#     suspended time; battmgr reports it for the 2S pack, see summary);
#   current_now samples every 5 s while awake;
#   every suspend/resume from the kernel log with the policy's wake IRQ;
#   qcom_stats (cxsd, aosd, ddr, subsystems) and wakeup_sources before/after.
set -u
bat=/sys/class/power_supply/qcom-battmgr-bat
usb=${ROG5_SLEEP_USB:-/sys/class/power_supply/qcom-battmgr-usb/online}
stats=/sys/kernel/debug/qcom_stats
wait_s=${ROG5_STANDBY_WAIT:-900}
max_s=${ROG5_STANDBY_MAX:-1800}
dir=/var/lib/rog5-standby-test/$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p "$dir"
cd "$dir" || exit 1

qstats() { for f in "$stats"/*; do [ -f "$f" ] && printf '%s %s\n' "${f##*/}" "$(tr '\n' ' ' <"$f")"; done; }
wsrc() { awk 'NR>1 {print $1, $2, $3, $4}' /sys/kernel/debug/wakeup_sources; }
online() { [ "$(cat "$usb" 2>/dev/null)" = 1 ]; }
# CLOCK_MONOTONIC stops during suspend (/proc/uptime does not).
mono() { python3 -c 'import time; print(int(time.monotonic()))'; }

t=0
while online; do
	[ "$t" -lt "$wait_s" ] || { echo 'USB power never went away' >summary.txt; exit 1; }
	sleep 5; t=$((t + 5))
done
sleep 10 # let the charger state settle

echo 1 >/sys/power/pm_debug_messages 2>/dev/null
start_rt=$(date +%s); start_mono=$(mono)
start_q=$(cat "$bat/charge_counter"); start_cap=$(cat "$bat/capacity")
start_ok=$(cat /sys/power/suspend_stats/success)
qstats >qstats-start; wsrc >wsrc-start; cat /proc/interrupts >irq-start
cursor=$(journalctl -n0 --show-cursor -o cat | sed -n 's/^-- cursor: //p')

while ! online; do
	now=$(date +%s)
	[ $((now - start_rt)) -lt "$max_s" ] || break
	printf '%s %s %s\n' "$now" "$(cat "$bat/current_now")" "$(cat /sys/class/drm/card1-DSI-1/dpms 2>/dev/null)" >>current.txt
	sleep 5
done

end_rt=$(date +%s); end_mono=$(mono)
end_q=$(cat "$bat/charge_counter"); end_cap=$(cat "$bat/capacity")
end_ok=$(cat /sys/power/suspend_stats/success)
qstats >qstats-end; wsrc >wsrc-end; cat /proc/interrupts >irq-end
echo 0 >/sys/power/pm_debug_messages 2>/dev/null
journalctl --after-cursor="$cursor" -o short-monotonic --no-pager >journal.txt 2>/dev/null
grep -E 'rog5-sleep-policy|PM: suspend (entry|exit)|Triggering wakeup|wakeup from|Wakeup pending|Abort' journal.txt >events.txt

wall=$((end_rt - start_rt)); awake=$((end_mono - start_mono))
dq=$((start_q - end_q))
{
	echo "window: ${wall} s wall clock, ${awake} s awake (monotonic), $((wall - awake)) s suspended"
	echo "suspends: $((end_ok - start_ok)) successful"
	echo "charge_counter: $start_q -> $end_q uAh (delta $dq uAh); capacity $start_cap -> $end_cap %"
	[ "$wall" -gt 0 ] && echo "average from charge_counter: $((dq * 3600 / wall / 1000)) mA as reported (battmgr counts the 2S pack: halve for per-cell current)"
	[ -s current.txt ] && awk '{s+=$2; n++} END {if (n) printf "awake current_now: mean %d mA over %d samples\n", s/n/1000, n}' current.txt
	echo "wake IRQs (policy log):"; grep -o 'wake irq [0-9a-z]*' events.txt | sort | uniq -c
	echo "qcom_stats (sleep entries and seconds asleep during the window; 19.2 MHz ticks):"
	join qstats-start qstats-end 2>/dev/null | awk '{
		n = 0; for (i = 2; i <= NF; i++) {
			if ($i == "Count:") c[n] = $(i + 1)
			if ($i == "Duration:") { d[n] = $(i + 1); n++ } }
		if (n == 2) printf "  %-12s +%d entries, %.0f s asleep\n", $1, c[1] - c[0], (d[1] - d[0]) / 19200000 }'
	echo "wakeup_sources with new events:"
	awk 'NR == FNR {a[$1] = $3; next} ($3 - a[$1]) > 0 {printf "  %s +%d\n", $1, $3 - a[$1]}' wsrc-start wsrc-end
} >summary.txt
cat summary.txt
