#!/bin/sh
# ROG5 desktop mode switcher (runs as root).
#
# Switches to the GNOME desktop (rog5-gnome) when an external display is
# connected and the phone is unlocked, and returns to Phosh when the display
# is unplugged, GNOME idles for IDLE_SECS, GNOME locks, or the mode file says
# off; and makes sure a session runs.
#
# GNOME has no lock screen here, so it is started automatically only after
# this loop has seen the running Phosh session locked (logind LockedHint=yes)
# and then unlocked (LockedHint=no). Phosh's org.gnome.ScreenSaver.GetActive
# is NOT a lock state: it is true only while the panel is blanked, so a lit
# lock screen answered "b false" and GNOME started without the PIN on every
# boot with the monitor attached (2026-09-29/30). Phosh 0.57 also sends its
# startup lock to logind only with phosh 0002 (screen-saver-manager: sync
# LockedHint); without it the first auto-switch waits for one lock/unlock.
# A locked phone waits for its PIN. The automatic switch happens once per plug-in: after "Phone mode" the
# phone stays in Phosh until the display is replugged; after an idle or lock
# hand-back the next unlock returns to the desktop.
# /var/lib/rog5/desktop-mode holds auto (default: switch automatically),
# manual (only the "Desktop mode" launcher) or off.
set -u
STATUS=/sys/class/drm/card1-DP-1/status
MODE_FILE=/var/lib/rog5/desktop-mode
OFF_AFTER=21      # seconds of stable disconnection before switching back
                  # (4 s turned an HPD bounce into a session kill, 00:26-00:27)
ON_AFTER=6        # seconds of stable connection before switching automatically
IDLE_SECS=600     # GNOME idle time before handing back to the lock screen
POLL=3            # seconds between checks; counters below are in seconds
up=0 down=0 idle=0 tick=0 nosess=0 auto_done=0
sess_cache= seen_locked=

# Records the Phosh session's lock state; call on every poll while Phosh runs.
# Fails closed: "unlocked" needs a locked -> unlocked transition of the same
# logind session, so a fresh session (LockedHint defaults to no) never counts.
track_phosh_lock() {
	[ -n "$sess_cache" ] &&
		[ "$(loginctl show-session "$sess_cache" -p State --value 2>/dev/null)" != closing ] &&
		loginctl show-session "$sess_cache" -p Id >/dev/null 2>&1 || sess_cache=$(phone_session)
	[ -n "$sess_cache" ] || { lock_state=unknown; return; }
	lock_state=$(loginctl show-session "$sess_cache" -p LockedHint --value 2>/dev/null)
	[ "$lock_state" = yes ] && seen_locked=$sess_cache
}

phosh_unlocked() {
	[ "$lock_state" = no ] && [ -n "$seen_locked" ] && [ "$seen_locked" = "$sess_cache" ]
}

phone_session() {       # id of the phone user's graphical (phosh PAM) session
	for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '$3 == "phone" {print $1}'); do
		[ "$(loginctl show-session "$s" -p Service --value 2>/dev/null)" = phosh ] || continue
		[ "$(loginctl show-session "$s" -p State --value 2>/dev/null)" = closing ] && continue
		echo "$s"
		return
	done
}

to_phosh() {
	echo "rog5-desktop-mode: $1 -> Phosh"
	systemctl stop rog5-gnome.service
	systemctl start rog5-phosh.service
}

while :; do
	sleep "$POLL"
	mode=$(cat "$MODE_FILE" 2>/dev/null || echo auto)
	if [ "$(cat "$STATUS" 2>/dev/null)" = connected ]; then
		up=$((up + POLL)) down=0
	else
		down=$((down + POLL)) up=0
	fi
	tick=$((tick + 1))
	if systemctl -q is-active rog5-gnome.service; then
		# idle is checked every other poll (loginctl is not free on a phone)
		if [ $((tick % 2)) -eq 0 ]; then
			sess=$(phone_session)
			if [ -n "$sess" ] && [ "$(loginctl show-session "$sess" -p LockedHint --value)" = yes ]; then
				# GNOME's own lock needs GDM: hand over to the Phosh lock screen
				to_phosh "GNOME locked"
				auto_done=0
				continue
			fi
			if [ -n "$sess" ] && [ "$(loginctl show-session "$sess" -p IdleHint --value)" = yes ]; then
				idle=$((idle + 2 * POLL))
			else
				idle=0
			fi
		fi
		if [ "$mode" = off ]; then
			to_phosh "desktop mode off"
		elif [ "$down" -ge "$OFF_AFTER" ]; then
			to_phosh "display unplugged"
		elif [ "$idle" -ge "$IDLE_SECS" ]; then
			to_phosh "GNOME idle ${IDLE_SECS}s"
			auto_done=0
		fi
		continue
	fi
	idle=0
	[ "$down" -ge "$OFF_AFTER" ] && auto_done=0
	lock_state=unknown
	systemctl -q is-active rog5-phosh.service && track_phosh_lock
	if [ "$mode" = auto ] && [ "$auto_done" = 0 ] && [ "$up" -ge "$ON_AFTER" ] &&
		systemctl -q is-active rog5-phosh.service && phosh_unlocked; then
		echo "rog5-desktop-mode: display connected, phone unlocked -> GNOME"
		auto_done=1
		systemctl start --no-block rog5-gnome.service
		continue
	fi
	# A switch in progress (Phosh stopping before GNOME starts, queued jobs)
	# is not "no session": only act when nothing runs or is queued for a
	# while, e.g. after a failed GNOME start. Acting early cancelled the
	# "Desktop mode" launcher's GNOME start (14:16).
	states=,$(systemctl is-active rog5-phosh.service rog5-gnome.service 2>/dev/null | paste -sd,),
	case $states in
	*,active,*|*,activating,*|*,deactivating,*|*,reloading,*) nosess=0 ;;
	*)
		if systemctl list-jobs --no-legend 2>/dev/null | grep -qE "rog5-(phosh|gnome)"; then
			nosess=0
		else
			nosess=$((nosess + POLL))
		fi ;;
	esac
	if [ "$nosess" -ge 10 ]; then
		# never leave the phone without its lock screen
		to_phosh "no session"
		nosess=0
	fi
	continue
done
