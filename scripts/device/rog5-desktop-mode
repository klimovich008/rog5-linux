#!/bin/sh
# ROG5 desktop mode switcher (runs as root).
#
# External display connected and stable, and the phone unlocked in Phosh ->
# GNOME desktop (rog5-gnome, touchscreen as touchpad). Display unplugged, or
# GNOME idle for IDLE_SECS -> Phosh, which starts on its PIN lock screen.
#
# GNOME never starts from a locked phone: a new Phosh session briefly
# reports LockedHint=no before its lock screen is up, so an unlocked session
# counts only once it has been seen locked or is at least SETTLE seconds old.
# /var/lib/rog5/desktop-mode holds auto (default) or off.
set -u
STATUS=/sys/class/drm/card1-DP-1/status
MODE_FILE=/var/lib/rog5/desktop-mode
ON_AFTER=6        # seconds of stable connection before switching to GNOME
OFF_AFTER=4       # seconds of stable disconnection before switching back
IDLE_SECS=600     # GNOME idle time before handing back to the lock screen
SETTLE=15         # age before a never-locked Phosh session's "unlocked" counts
up=0 down=0 idle=0 tick=0
seen_locked_session=

phone_session() {       # id of the phone user's graphical (phosh PAM) session
	for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '$3 == "phone" {print $1}'); do
		[ "$(loginctl show-session "$s" -p Service --value 2>/dev/null)" = phosh ] || continue
		[ "$(loginctl show-session "$s" -p State --value 2>/dev/null)" = closing ] && continue
		echo "$s"
		return
	done
}

to_phosh() {
	echo "rog5-desktop-mode: $1 -> Phosh"
	seen_locked_session=
	systemctl stop rog5-gnome.service
	systemctl start rog5-phosh.service
}

while :; do
	sleep 1
	mode=$(cat "$MODE_FILE" 2>/dev/null || echo auto)
	if [ "$(cat "$STATUS" 2>/dev/null)" = connected ]; then
		up=$((up + 1)) down=0
	else
		down=$((down + 1)) up=0
	fi
	tick=$((tick + 1))
	if systemctl -q is-active rog5-gnome.service; then
		# idle is checked every 5 s (loginctl is not free on a phone)
		if [ $((tick % 5)) -eq 0 ]; then
			sess=$(phone_session)
			if [ -n "$sess" ] && [ "$(loginctl show-session "$sess" -p IdleHint --value)" = yes ]; then
				idle=$((idle + 5))
			else
				idle=0
			fi
		fi
		if [ "$mode" = off ]; then
			to_phosh "desktop mode off"
		elif [ "$down" -ge "$OFF_AFTER" ]; then
			to_phosh "display unplugged"
		elif [ "$idle" -ge "$IDLE_SECS" ]; then
			to_phosh "GNOME idle ${IDLE_SECS}s"
		fi
		continue
	fi
	idle=0
	case ,$(systemctl is-active rog5-phosh.service rog5-denial.service 2>/dev/null | paste -sd,), in
	*,active,*|*,activating,*|*,reloading,*) ;;
	*)
		# no session runs (a failed GNOME start): never leave the phone
		# without its lock screen
		to_phosh "no session"
		continue ;;
	esac
	systemctl -q is-active rog5-phosh.service || continue
	# without a display there is nothing to decide: skip the session queries
	[ "$up" -gt 0 ] || continue
	sess=$(phone_session)
	[ -n "$sess" ] || continue
	now=$(cut -d. -f1 /proc/uptime)
	born=$(loginctl show-session "$sess" -p TimestampMonotonic --value 2>/dev/null)
	born=$(( ${born:-0} / 1000000 ))
	locked=$(loginctl show-session "$sess" -p LockedHint --value 2>/dev/null)
	[ "$locked" = yes ] && seen_locked_session=$sess
	settled=no
	{ [ "$seen_locked_session" = "$sess" ] ||
	  [ $((now - born)) -ge "$SETTLE" ]; } && settled=yes
	if [ "$mode" = auto ] && [ "$up" -ge "$ON_AFTER" ] && [ "$locked" = no ] &&
	   [ "$settled" = yes ]; then
		echo "rog5-desktop-mode: display connected, phone unlocked -> GNOME"
		systemctl stop rog5-phosh.service
		if ! systemctl start rog5-gnome.service; then
			to_phosh "GNOME failed to start"
		fi
		up=0
	fi
done
