#!/bin/bash
# ROG5 desktop mode switcher (runs as root).
#
# Switches to the GNOME desktop (rog5-gnome) when an external display is
# connected and the phone is unlocked, and returns to Phosh when the display
# is unplugged, GNOME goes idle, GNOME locks, or the mode file says off; and
# makes sure a session runs.
#
# Event driven: it sleeps in one blocking read on a private pipe fed by
#   - udevadm monitor (drm uevents: DP hotplug),
#   - gdbus monitor of logind (LockedHint/IdleHint changes, sessions
#     added/removed: Phosh and GNOME each open a logind session),
#   - SIGUSR1 (systemctl reload, from rog5-desktop-mode-reload.path when the
#     mode file changes),
# and re-checks the state only then, at debounce deadlines, every 2 s while a
# switch is in progress, and every SAFETY seconds as a safety net. The former
# 3 s poll cost 1.6 % of a core with nothing attached (2026-09-30).
#
# GNOME has no lock screen here, so it is started automatically only after
# this switcher has seen the running Phosh session locked (logind
# LockedHint=yes) and then unlocked (LockedHint=no). Phosh's
# org.gnome.ScreenSaver.GetActive is NOT a lock state: it is true only while
# the panel is blanked, so a lit lock screen answered "b false" and GNOME
# started without the PIN on every boot with the monitor attached
# (2026-09-29/30). Phosh 0.57 sends its startup lock to logind only with
# phosh 0002 (screen-saver-manager: sync LockedHint); without it the first
# auto-switch waits for one lock/unlock. Fail closed on top of that:
#   - the lock must be confirmed: LockedHint read "yes" again at least
#     LOCKED_MIN seconds after the lock was first seen (a PIN entry takes
#     longer), so a quick yes -> no flip (a shell publishing a wrong state,
#     queued signals) never counts and needs a fresh lock;
#   - one unlock per lock period, and the session must be the one whose
#     leader is rog5-phosh.service's main process (GNOME's session has
#     Service=phosh too); a removed session forgets its history;
#   - an unreadable lock state drops everything seen so far;
#   - LockedHint is read again directly before GNOME is started, after every
#     queued event has been handled.
# Every lock and unlock the switcher acts on is logged with its session.
#
# The automatic switch happens once per plug-in (also after a "Desktop mode"
# start by hand): after "Phone mode" the phone stays in Phosh until the
# display has been unplugged for OFF_AFTER seconds; after an idle or lock
# hand-back the next unlock returns to the desktop. GNOME's idle time is its
# own idle-delay (ROG5_DESKTOP_IDLE_DELAY in rog5-gnome.service, 600 s; 0 =
# never): logind's IdleHint turns yes after it, GNOME blanks and locks, and
# the switcher hands back at once. GNOME has no lock screen of its own here,
# so this hand-back is the desktop's auto-lock (Phosh comes up on its PIN).
#
# Work in progress keeps GNOME from going idle (2026-10-01 13:32: Steam's
# shader pre-compilation ran without input for 10 min and the hand-back
# killed it with the whole session). While GNOME runs, every BUSY_POLL
# seconds, PRE_IDLE seconds before GNOME's idle-delay runs out (mutter's idle
# time) and at once when IdleHint turns yes, the switcher looks for
#   - processes of the desktop user matching ROG5_DM_BUSY_PROCS (pgrep -f,
#     default: Steam's fossilize_replay and a game under Steam's reaper
#     "SteamLaunch"),
#   - audio playing (an ALSA playback substream RUNNING/DRAINING, or a
#     RUNNING PipeWire sink: also Bluetooth),
#   - a logind "idle" inhibitor (block or block-weak; systemd-inhibit
#     --what=idle),
#   - a fullscreen X11 (Xwayland) window with the focus (games, Proton),
#   - with IdleHint yes also GNOME's own idle inhibitors (apps inhibit
#     through org.gnome.SessionManager, org.freedesktop.ScreenSaver or the
#     inhibit portal; GNOME itself never goes idle while one is held),
# and while any is there it holds a GNOME idle inhibitor of its own
# (gnome-session-inhibit, app id rog5-desktop-mode), so GNOME neither blanks
# nor locks and IdleHint stays no. A GNOME already idle is not handed back
# while work runs; but work that starts in the last PRE_IDLE seconds before
# the idle-delay can still meet GNOME's lock, and a lock always hands back. With the work gone the inhibitor is dropped, and the
# hand-back follows GNOME's idle-delay as before.
# /var/lib/rog5/desktop-mode holds auto (switch automatically),
# manual (default: only the "Desktop mode" launcher) or off.
#
# Every start of GNOME goes through this switcher (it has no lock screen of
# its own, so it must never start on a locked phone):
#   - the "Desktop mode" launcher starts rog5-desktop-request.service (the
#     only desktop unit polkit lets the phone user start), which runs
#     "rog5-desktop-mode --request": a request file in RUN_DIR and a reload.
#     The switcher honours it only for rog5-phosh's own session after a
#     confirmed lock and an unlock of it, with the same re-read of
#     LockedHint right before the start as the automatic switch; otherwise
#     it drops it (and tells the phone user). A request expires after
#     REQUEST_TTL seconds;
#   - before it queues the start the switcher writes a one-use grant;
#     rog5-gnome.service's first ExecStartPre ("rog5-desktop-mode --gate")
#     consumes it and refuses to start GNOME without a fresh one, so no
#     other path (a root "systemctl start", a dependency) gets an unlocked
#     desktop; Phosh then comes back through the "no session" rule;
#   - rog5-gnome.service is BindsTo= this switcher: GNOME never runs
#     without it, and while GNOME runs, a missing GNOME session or an
#     unreadable LockedHint/IdleHint for SUP_GRACE seconds hands back to
#     the Phosh lock screen.
#   - a lock of the granted session between the grant and the gate (Phosh
#     still stopping) voids the grant and puts Phosh back; a grant names
#     this switcher's PID, so one from an earlier switcher is void.
# Authorization also reads Phosh's real Locked property (package patch
# 0003) from its unique bus owner, verified as the packaged executable in
# its system or user service cgroup. A forged logind hint or an unrelated
# replacement bus owner cannot authorize a desktop. Missing/older Phosh fails closed. This does not isolate
# Phosh from arbitrary code that can ptrace it as the same UID.
# Hand-backs start rog5-phosh.service, whose Conflicts= stops GNOME in the
# same transaction (so rog5-session-carry sees the switch and carries the
# apps); a GNOME lock or an unreadable lock state stops GNOME first instead.
set -u
STATUS=${ROG5_DM_STATUS:-/sys/class/drm/card1-DP-1/status}
MODE_FILE=${ROG5_DM_MODE_FILE:-/var/lib/rog5/desktop-mode}
RUN_DIR=${ROG5_DM_RUN_DIR:-/run/rog5-desktop-mode}
LATCH=$RUN_DIR/auto-done   # once-per-plug latch, kept across switcher restarts
OFF_AFTER=21      # seconds of stable disconnection before switching back
                  # (4 s turned an HPD bounce into a session kill, 00:26-00:27)
ON_AFTER=6        # seconds of stable connection before switching automatically
NOSESS_AFTER=10   # seconds with neither session running or queued
TRANSIT=2         # re-check interval while a switch is in progress
SAFETY=60         # re-check interval without events
LOCKED_MIN=2      # a lock counts once it still reads "yes" this long after
BUSY_POLL=60      # seconds between work checks while GNOME runs
PRE_IDLE=10       # and one this long before GNOME's idle-delay runs out
REQUEST_TTL=10    # a "Desktop mode" request is dropped after this long
GRANT_TTL=60      # a start grant is valid this long (Phosh's stop comes first)
START_GRACE=60    # maximum GNOME activation time, including Phosh stop
SUP_GRACE=10      # GNOME without a readable lock state this long -> Phosh
REQUEST=$RUN_DIR/request
GRANT=$RUN_DIR/gnome-grant
DM_USER=${ROG5_DM_USER:-phone}
BUSY_PROCS=${ROG5_DM_BUSY_PROCS-fossilize_replay|SteamLaunch}
ASOUND=${ROG5_DM_ASOUND:-/proc/asound}
INHIBITORS_CMD=${ROG5_DM_INHIBITORS_CMD:-timeout 5 busctl --system call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager ListInhibitors}
INHIBIT_ID=rog5-desktop-mode   # app id / reason tag of the own inhibitor
inhibit_pid= busy= eval_at=
auto_done=0 nosess_since= dp_state= dp_since=0 now=0 wait_s=$SAFETY EV=
lock_sess= locked_at=0 lock_ready= unlock_ok=
sess_cache= seen_locked= req= sup_bad= grant_sess= grant_at=

# Every logind and systemd query is bounded, so a wedged bus cannot stall the
# supervisor while GNOME runs (SUP_GRACE is only a deadline if checks run).
# The systemctl bound leaves room for a hand-back's synchronous start
# (GNOME's stop with rog5-session-carry, Phosh's start); its job continues
# in systemd if the client is killed.
loginctl() { timeout -k 1 5 loginctl "$@"; }
systemctl() {
	case ${1:-} in
	show|is-active|list-jobs) timeout -k 1 3 systemctl "$@" ;;
	*) timeout -k 1 30 systemctl "$@" ;;
	esac
}

# Root connects directly: do not run a probe with phone's mutable environment.
# Resolve the name once, authenticate that unique owner's process, then query
# that same unique name (never auto-activate a replacement).
phosh_locked() {
	local uid owner pid cg state exe membership
	uid=$(id -u "$DM_USER") || return 1
	owner=$(timeout -k 1 3 busctl --address="unix:path=/run/user/$uid/bus" call \
		org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus GetNameOwner s org.gnome.Shell 2>/dev/null) || return 1
	[[ $owner =~ ^s\ \"(:[0-9]+\.[0-9]+)\"$ ]] || return 1
	owner=${BASH_REMATCH[1]}
	pid=$(timeout -k 1 3 busctl --address="unix:path=/run/user/$uid/bus" call \
		org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus GetConnectionUnixProcessID s "$owner" 2>/dev/null) || return 1
	[[ $pid =~ ^u\ ([1-9][0-9]*)$ ]] || return 1
	pid=${BASH_REMATCH[1]}
	cg=$(systemctl show -p ControlGroup --value rog5-phosh.service 2>/dev/null) || return 1
	[ -n "$cg" ] && [ "$cg" != / ] || return 1
	exe=$(readlink "/proc/$pid/exe") || return 1
	case $exe in /usr/bin/phosh|/usr/lib/phosh/phosh) ;; *) return 1 ;; esac
	membership=$(cat "/proc/$pid/cgroup") || return 1
	# gnome-session may launch Phosh through its packaged systemd user
	# unit instead of directly below the system service's PAM leader.
	local user_cg=/user.slice/user-$uid.slice/user@$uid.service/session.slice/mobi.phosh.Shell.service
	awk -F: -v cg="$cg" -v user_cg="$user_cg" \
		'$1 == "0" && ($3 == cg || index($3, cg "/") == 1 || $3 == user_cg) {ok=1} END {exit !ok}' \
		<<<"$membership" || return 1
	state=$(timeout -k 1 3 busctl --address="unix:path=/run/user/$uid/bus" get-property \
		"$owner" /org/gnome/Shell org.gnome.Shell Locked 2>/dev/null) || return 1
	case $state in 'b true') echo yes ;; 'b false') echo no ;; *) return 1 ;; esac
}

# Records the Phosh session's lock state; call on every check while Phosh runs.
# Fails closed: "unlocked" needs a locked -> unlocked transition of the same
# logind session, so a fresh session (LockedHint defaults to no) never counts.
track_phosh_lock() {
	[ -n "$sess_cache" ] &&
		[ "$(loginctl show-session "$sess_cache" -p State --value 2>/dev/null)" != closing ] &&
		loginctl show-session "$sess_cache" -p Id >/dev/null 2>&1 || sess_cache=$(phone_session)
	[ -n "$sess_cache" ] || { lock_state=unknown; return; }
	lock_state=$(loginctl show-session "$sess_cache" -p LockedHint --value 2>/dev/null) || lock_state=unknown
	[ "$lock_state" = yes ] && seen_locked=$sess_cache
}

phosh_unlocked() {
	[ "$lock_state" = no ] && [ -n "$seen_locked" ] && [ "$seen_locked" = "$sess_cache" ]
}

phone_session() {       # id of the phone user's graphical (phosh PAM) session
	for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '$3 == "phone" {print $1}'); do
		[ "$(loginctl show-session "$s" -p Service --value 2>/dev/null)" = phosh ] || continue
		[ "$(loginctl show-session "$s" -p State --value 2>/dev/null)" = closing ] && continue
		echo "$s"
		return
	done
}

# $2 = now: a security hand-back (GNOME locked, its lock state unreadable):
# GNOME goes first, so the desktop does not stay on the monitor while
# rog5-session-carry closes its apps (they are not carried). Otherwise one
# transaction: Conflicts= stops GNOME (or cancels a start that is still
# activating) before Phosh starts, and rog5-session-carry in GNOME's
# ExecStop sees Phosh's start job (a switch, not a plain stop).
to_phosh() {
	inhibit_stop
	echo "rog5-desktop-mode: $1 -> Phosh"
	[ "${2:-}" != now ] || systemctl stop rog5-gnome.service
	systemctl start rog5-phosh.service
}

now_cs() {              # boot time in centiseconds (counts suspend; no fork)
	local up
	read -r up _ </proc/uptime
	now=$(( ${up%.*} * 100 + 10#${up#*.} ))
}

forget_locks() {        # fail closed: nothing seen so far counts
	[ -n "$lock_sess$unlock_ok$seen_locked" ] &&
		echo "rog5-desktop-mode: lock history dropped ($1)" >&2
	lock_sess= lock_ready= unlock_ok= seen_locked=
	return 0
}

# Session $1 read or signalled "locked". A lock period starts at the first
# "yes" (or the first after an accepted unlock); it is confirmed by a "yes"
# read LOCKED_MIN seconds later ($2 = confirm: a state read, not a signal).
note_lock() {
	if [ "$lock_sess" != "$1" ] || [ "$unlock_ok" = "$1" ]; then
		lock_sess=$1 locked_at=$now lock_ready= unlock_ok=
		echo "rog5-desktop-mode: session $1 locked"
	fi
	if [ "${2:-}" = confirm ] && [ "$lock_ready" != "$1" ]; then
		if [ $((now - locked_at)) -ge $((LOCKED_MIN * 100)) ]; then
			lock_ready=$1
		else
			set_wait "$LOCKED_MIN"
		fi
	fi
	return 0
}

# Session $1 reads unlocked: accepted once per confirmed lock period;
# an unlock of an unconfirmed lock is ignored and needs a new lock.
note_unlock() {
	[ "$lock_sess" = "$1" ] && [ "$unlock_ok" != "$1" ] || return 0
	if [ "$lock_ready" = "$1" ]; then
		unlock_ok=$1
		echo "rog5-desktop-mode: session $1 unlocked"
	else
		echo "rog5-desktop-mode: session $1 unlocked before its lock was confirmed: ignored, needs a new lock" >&2
		lock_sess= lock_ready= unlock_ok=
	fi
	return 0
}

unit_leader() {         # true if session $2 is led by unit $1's main process
	local pid leader
	[ -n "${2:-}" ] || return 1
	pid=$(systemctl show -p MainPID --value "$1" 2>/dev/null) || return 1
	leader=$(loginctl show-session "$2" -p Leader --value 2>/dev/null) || return 1
	[ -n "$pid" ] && [ "$pid" != 0 ] && [ "$pid" = "$leader" ]
}

phosh_leader() {        # true if session $1 is rog5-phosh.service's session
	unit_leader rog5-phosh.service "${1:-}"
}

unit_session() {        # the phone session led by unit $1
	local s
	for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '$3 == "phone" {print $1}'); do
		unit_leader "$1" "$s" && { echo "$s"; return; }
	done
}

phosh_session() { unit_session rog5-phosh.service; }
gnome_session() { unit_session rog5-gnome.service; }

# --- "Desktop mode" requests and start grants ---------------------------------

# Sets req=1 while a fresh request is pending; drops an old or malformed one.
request_check() {
	local t=
	req=
	[ -e "$REQUEST" ] || return 0
	[ -f "$REQUEST" ] && [ ! -L "$REQUEST" ] && { read -r t <"$REQUEST"; } 2>/dev/null
	case $t in ''|*[!0-9]*) t=-1 ;; esac
	if [ "$t" -lt 0 ] || [ "$t" -gt "$now" ] || [ $((now - t)) -gt $((REQUEST_TTL * 100)) ]; then
		rm -f "$REQUEST"
		echo "rog5-desktop-mode: desktop request dropped (expired or malformed)" >&2
		return 0
	fi
	req=1
}

# Ends the pending request; with $1 it was refused for that reason.
request_done() {
	[ -n "$req" ] || return 0
	req=
	rm -f "$REQUEST"
	[ -n "${1:-}" ] || return 0
	echo "rog5-desktop-mode: desktop request refused: $1" >&2
	notify_user "Desktop mode: $1" &
	return 0
}

notify_user() {         # best effort, never blocks the switcher (background)
	user_cmd gdbus call --session --dest org.freedesktop.Notifications \
		--object-path /org/freedesktop/Notifications \
		--method org.freedesktop.Notifications.Notify \
		rog5-desktop-mode 0 video-display "Desktop mode" "$1" '[]' '{}' 5000 >/dev/null 2>&1
}

# The one-use grant rog5-gnome.service's gate consumes ($1 = session). It
# names this switcher process: a grant from an earlier switcher (restarted
# since) is void.
grant_write() {
	printf '%s %s %s\n' "$now" "$1" "$$" >"$GRANT.tmp" && mv -f "$GRANT.tmp" "$GRANT" &&
		grant_sess=$1 grant_at=$now
}

# The phone locked again (or its lock state became unreadable) while a
# switch to GNOME was queued: void the grant, so the gate refuses GNOME, and
# put Phosh back (its start job replaces GNOME's through Conflicts=).
grant_revoke() {
	[ -n "$grant_sess" ] || return 0
	grant_sess=
	rm -f "$GRANT"
	echo "rog5-desktop-mode: $1 during the switch: GNOME start cancelled -> Phosh" >&2
	to_phosh "cancelled desktop transition" now
}

# "Desktop mode" launcher (rog5-desktop-request.service, as root): leaves a
# request for the switcher and wakes it; the switcher decides.
request_main() {
	now_cs
	[ -d "$RUN_DIR" ] || { echo "rog5-desktop-mode: the switcher is not running" >&2; exit 1; }
	printf '%s\n' "$now" >"$REQUEST.tmp" && mv -f "$REQUEST.tmp" "$REQUEST" || exit 1
	systemctl reload rog5-desktop-mode.service
}

# rog5-gnome.service's first ExecStartPre (as root): GNOME starts only with
# a fresh grant from the switcher, and each grant serves one start.
gate_main() {
	local t= s= pid= main sessions locked
	now_cs
	[ -f "$GRANT" ] && [ ! -L "$GRANT" ] && { read -r t s pid <"$GRANT"; } 2>/dev/null
	rm -f "$GRANT"
	case $t in ''|*[!0-9]*)
		echo "rog5-gnome: refused: not started by rog5-desktop-mode for an unlocked phone (no grant)" >&2
		exit 1 ;;
	esac
	if [ "$t" -gt "$now" ] || [ $((now - t)) -gt $((GRANT_TTL * 100)) ]; then
		echo "rog5-gnome: refused: the start grant is stale" >&2
		exit 1
	fi
	main=$(systemctl show -p MainPID --value rog5-desktop-mode.service 2>/dev/null) || main=
	if [ -z "$pid" ] || [ "$pid" != "$main" ]; then
		echo "rog5-gnome: refused: the grant is not from the running rog5-desktop-mode" >&2
		exit 1
	fi
	sessions=$(loginctl list-sessions --no-legend 2>/dev/null) || exit 1
	if awk -v sid="$s" '$1 == sid {found=1} END {exit !found}' <<<"$sessions"; then
		locked=$(loginctl show-session "$s" -p LockedHint --value 2>/dev/null) || exit 1
		[ "$locked" = no ] && [ "$(phosh_locked)" = no ] || exit 1
	fi
	echo "rog5-gnome: started by rog5-desktop-mode (phone unlocked in session ${s:-?})"
}

latch() {
	[ "$auto_done" = "$1" ] && return
	auto_done=$1
	if [ "$1" = 1 ]; then : >"$LATCH"; else rm -f "$LATCH"; fi 2>/dev/null
}

set_wait() {            # wake up after at most $1 seconds
	local s=$1
	[ "$s" -ge 1 ] || s=1
	[ "$s" -lt "$wait_s" ] && wait_s=$s
	return 0
}

remaining() {           # whole seconds (rounded up) until $1 s after dp_since
	echo $(( ($1 * 100 - (now - dp_since) + 99) / 100 ))
}

# DP status; any drm uevent ($1 = event) restarts the debounce, so a bounce
# that ends in the same state as before still counts as a change.
read_dp() {
	local s=
	# read fails at EOF without a newline but still sets s
	{ read -r s <"$STATUS"; } 2>/dev/null
	[ "$s" = connected ] || s=disconnected
	if [ "$s" != "$dp_state" ] || [ "${1:-}" = event ]; then
		dp_state=$s dp_since=$now
	fi
}

pending_events() {      # true if the event pipe holds unread input
	[ -n "$EV" ] && read -r -t 0 -u "$EV" 2>/dev/null
}

# --- work in progress (keeps GNOME from idling) ------------------------------

# The environment for a command as the desktop user on its session bus (no
# PAM, no session): sets user_argv.
user_argv() {
	local uid gid home
	uid=$(id -u "$DM_USER" 2>/dev/null) && gid=$(id -g "$DM_USER" 2>/dev/null) || return 1
	home=$(getent passwd "$DM_USER" | cut -d: -f6)
	user_argv=(setpriv --reuid="$uid" --regid="$gid" --init-groups
		env -i PATH=/usr/local/bin:/usr/bin:/bin HOME="${home:-/}" XDG_RUNTIME_DIR="/run/user/$uid"
		DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus")
}

# Runs "$@" as the desktop user, limited to 5 s (a wedged session bus must
# not stall the switcher).
user_cmd() {
	local user_argv
	user_argv "$@" || return 1
	timeout -k 2 5 "${user_argv[@]}" "$@"
}

# Prints "<who>: <why>" of the first logind idle inhibitor in mode block or
# block-weak that is not this switcher's own (gnome-session may mirror app
# inhibitors to logind). Parses busctl's a(ssssuu) reply (what who why mode
# uid pid, strings quoted with backslash escapes), as rog5-sleep-policy does.
logind_idle_inhibitor() {
	local out
	out=$($INHIBITORS_CMD 2>/dev/null) || return 1
	case $out in 'a(ssssuu) '*) ;; *) return 1 ;; esac
	printf '%s\n' "$out" | awk -v own="$INHIBIT_ID" '
	{
		s = $0; n = 0
		while (1) {
			sub(/^[ \t]+/, "", s)
			if (s == "") break
			if (substr(s, 1, 1) == "\"") {
				v = ""; i = 2
				while (i <= length(s)) {
					c = substr(s, i, 1)
					if (c == "\\") { v = v substr(s, i + 1, 1); i += 2; continue }
					if (c == "\"") break
					v = v c; i++
				}
				s = substr(s, i + 1)
			} else {
				match(s, /^[^ \t]+/); v = substr(s, 1, RLENGTH); s = substr(s, RLENGTH + 1)
			}
			tok[++n] = v
		}
		for (i = 3; i + 5 <= n; i += 6)
			if ((tok[i + 3] == "block" || tok[i + 3] == "block-weak") && (":" tok[i] ":") ~ /:idle:/ &&
			    index(tok[i + 1], own) == 0 && index(tok[i + 2], own) == 0) {
				print tok[i + 1] ": " tok[i + 2]; found = 1; exit
			}
	}
	END { exit !found }'
}

# Prints the app id of the first GNOME session idle inhibitor (flag 8) that
# is not this switcher's own.
gnome_idle_inhibitor() {
	user_cmd sh -c '
	sm() { gdbus call --session --dest org.gnome.SessionManager --object-path "$1" --method "$2"; }
	for p in $(sm /org/gnome/SessionManager org.gnome.SessionManager.GetInhibitors |
	           grep -o "/org/gnome/SessionManager/Inhibitor[0-9]*"); do
		f=$(sm "$p" org.gnome.SessionManager.Inhibitor.GetFlags | tr -dc 0-9) || continue
		[ -n "$f" ] && [ $((f & 8)) -ne 0 ] || continue
		a=$(sm "$p" org.gnome.SessionManager.Inhibitor.GetAppId | sed "s/^(.\(.*\).,)$/\1/") || continue
		[ "$a" = "$1" ] && continue
		echo "${a:-unknown app}"; exit 0
	done
	exit 1' sh "$INHIBIT_ID"
}

# Prints the name of a fullscreen X11 window that has the focus (Xwayland:
# games, Proton, Steam Big Picture). Native Wayland fullscreen apps are
# covered by their idle inhibitors (SDL, browsers and players take one).
x11_fullscreen() {
	local uid x auth r
	uid=$(id -u "$DM_USER" 2>/dev/null) || return 1
	for auth in /run/user/"$uid"/.mutter-Xwaylandauth.*; do
		[ -e "$auth" ] || return 1
		for x in /tmp/.X11-unix/X*; do
			[ -S "$x" ] && [ "$(stat -c %u "$x" 2>/dev/null)" = "$uid" ] || continue
			r=$(user_cmd sh -c '
			export DISPLAY=$1 XAUTHORITY=$2
			w=$(xprop -root _NET_ACTIVE_WINDOW | sed -n "s/.*# \(0x[0-9a-fA-F]*\).*/\1/p")
			[ -n "$w" ] && [ "$w" != 0x0 ] || exit 1
			xprop -id "$w" _NET_WM_STATE | grep -q _NET_WM_STATE_FULLSCREEN || exit 1
			c=$(xprop -id "$w" WM_CLASS | sed -n "s/.*= \"\([^\"]*\)\".*/\1/p")
			echo "${c:-X11} $w"' sh ":${x##*/X}" "$auth" 2>/dev/null) && [ -n "$r" ] &&
				{ echo "$r"; return 0; }
		done
	done
	return 1
}

# Prints the seconds left until GNOME's idle-delay runs out (mutter's idle
# time against org.gnome.desktop.session idle-delay); fails if unknown or
# idle-delay is 0 (never).
gnome_idle_left() {
	user_cmd sh -c '
	i=$(gdbus call --session --dest org.gnome.Mutter.IdleMonitor \
		--object-path /org/gnome/Mutter/IdleMonitor/Core \
		--method org.gnome.Mutter.IdleMonitor.GetIdletime) || exit 1
	d=$(gsettings get org.gnome.desktop.session idle-delay) || exit 1
	i=${i#*uint64 }; i=${i%%,*}; d=${d#uint32 }
	case $i$d in *[!0-9]*|"") exit 1 ;; esac
	[ "$d" -gt 0 ] || exit 1
	echo $((d - i / 1000))'
}

# Prints why the desktop user's work is running, or nothing. $1 = idle: also
# ask GNOME for its own idle inhibitors (they only matter once GNOME is idle,
# which they normally prevent).
work_reason() {
	local r
	if [ -n "$BUSY_PROCS" ] && r=$(pgrep -u "$DM_USER" -l -f -- "$BUSY_PROCS" 2>/dev/null | head -n 1) && [ -n "$r" ]; then
		echo "running: ${r#* }"; return
	fi
	if grep -qs -e '^state: RUNNING' -e '^state: DRAINING' "$ASOUND"/card*/pcm*p/sub*/status; then
		echo "audio playing"; return
	fi
	if r=$(user_cmd pactl list short sinks 2>/dev/null | awk '$NF == "RUNNING" { print $2; exit }') && [ -n "$r" ]; then
		echo "audio playing on $r"; return
	fi
	if r=$(logind_idle_inhibitor); then
		echo "idle inhibitor: $r"; return
	fi
	if r=$(x11_fullscreen); then
		echo "fullscreen window: $r"; return
	fi
	if [ "${1:-}" = idle ] && r=$(gnome_idle_inhibitor); then
		echo "GNOME idle inhibitor: $r"; return
	fi
}

# Holds a GNOME idle inhibitor while work runs (gnome-session-inhibit as the
# desktop user, ended by inhibit_stop or with the switcher's cgroup).
spawn_inhibitor() {
	local user_argv
	user_argv || return 0
	# exec in the background subshell: $! is gnome-session-inhibit itself,
	# so inhibit_stop's kill reaches it (no shell in between to orphan it)
	(exec "${user_argv[@]}" gnome-session-inhibit --app-id "$INHIBIT_ID" \
		--reason "$INHIBIT_ID: $1" --inhibit idle --inhibit-only) </dev/null >/dev/null 2>&1 &
	inhibit_pid=$!
}

inhibit_start() {
	[ -n "$inhibit_pid" ] && kill -0 "$inhibit_pid" 2>/dev/null && return 0
	spawn_inhibitor "$1"
}

inhibit_stop() {
	[ -n "$inhibit_pid" ] || return 0
	kill "$inhibit_pid" 2>/dev/null
	wait "$inhibit_pid" 2>/dev/null
	inhibit_pid=
	return 0
}

# Re-evaluates the work every BUSY_POLL seconds, PRE_IDLE seconds before
# GNOME's idle-delay runs out (so work that started since the last look gets
# its inhibitor before GNOME blanks and locks), and at once with $1 = idle;
# keeps the inhibitor in step and logs every change.
work_check() {
	local r left next
	if [ "${1:-}" != idle ] && [ -n "$eval_at" ] && [ "$now" -lt "$eval_at" ]; then
		[ -z "$busy" ] || inhibit_start "$busy"
		set_wait $(( (eval_at - now + 99) / 100 ))
		return 0
	fi
	r=$(work_reason "${1:-}")
	next=$BUSY_POLL
	if [ -n "$r" ]; then
		[ -n "$busy" ] || echo "rog5-desktop-mode: work in progress ($r): GNOME kept from idling"
		busy=$r
		inhibit_start "$r"
	else
		[ -z "$busy" ] || echo "rog5-desktop-mode: work done: GNOME may idle again"
		busy=
		inhibit_stop
		if [ "${1:-}" != idle ] && left=$(gnome_idle_left) && [ $((left - PRE_IDLE)) -lt "$next" ]; then
			next=$((left - PRE_IDLE))
			[ "$next" -ge 1 ] || next=1
		fi
	fi
	eval_at=$((now + next * 100))
	set_wait "$next"
	return 0
}

work_forget() {         # GNOME is not running (any more)
	inhibit_stop
	busy= eval_at=
}

check() {
	local mode gnome phosh sess kv locked idle why
	now_cs
	wait_s=$SAFETY
	mode=
	{ read -r mode <"$MODE_FILE"; } 2>/dev/null   # "printf manual >" has no newline
	[ -n "$mode" ] || mode=manual
	read_dp
	request_check
	set -- $(systemctl is-active rog5-gnome.service rog5-phosh.service 2>/dev/null)
	gnome=${1:-unknown} phosh=${2:-unknown}
	case $gnome in inactive|failed) sup_bad= ;; esac
	case $gnome in
	active|activating|reloading)
		request_done
		# covers "Desktop mode" by hand: no automatic restart after "Phone mode"
		latch 1
		nosess_since=
		if [ "$mode" = off ]; then
			to_phosh "desktop mode off"; set_wait "$TRANSIT"; return
		fi
		if [ "$dp_state" != connected ]; then
			if [ "$(remaining "$OFF_AFTER")" -le 0 ]; then
				to_phosh "display unplugged"; set_wait "$TRANSIT"; return
			fi
			set_wait "$(remaining "$OFF_AFTER")"
		fi
		if [ "$gnome" != active ]; then
			# Phosh may still run (its stop comes first): a relock now
			# voids the grant before the gate reads it.
			if [ -n "$grant_sess" ]; then
				# Session removal must be confirmed by a successful list;
				# a failed query is never evidence that Phosh has gone.
				local sessions
				if ! sessions=$(loginctl list-sessions --no-legend 2>/dev/null); then
					grant_revoke "session list unavailable"
				elif awk -v sid="$grant_sess" '$1 == sid {found=1} END {exit !found}' <<<"$sessions"; then
					locked=$(loginctl show-session "$grant_sess" -p LockedHint --value 2>/dev/null) || locked=unknown
					[ "$locked" = no ] && [ "$(phosh_locked)" = no ] ||
						grant_revoke "session $grant_sess locked or unreadable"
				fi
				[ -z "$grant_sess" ] || [ $((now - grant_at)) -lt $((START_GRACE * 100)) ] ||
					grant_revoke "GNOME activation timed out"
			fi
			set_wait "$TRANSIT"; return
		fi
		# Supervision fails closed: GNOME's own session (led by its main
		# process) with a readable lock and idle state, or Phosh after
		# SUP_GRACE seconds.
		sess=$(gnome_session)
		locked= idle=
		[ -z "$sess" ] || while IFS= read -r kv; do
			case $kv in
			LockedHint=*) locked=${kv#*=} ;;
			IdleHint=*) idle=${kv#*=} ;;
			esac
		done < <(loginctl show-session "$sess" -p LockedHint -p IdleHint 2>/dev/null)
		case $locked:$idle in
		yes:yes|yes:no|no:yes|no:no) sup_bad= ;;
		*)
			[ -n "$sup_bad" ] || sup_bad=$now
			if [ $((now - sup_bad)) -ge $((SUP_GRACE * 100)) ]; then
				sup_bad=
				to_phosh "GNOME's lock state unavailable (session ${sess:--})" now
				latch 0; set_wait "$TRANSIT"; return
			fi
			set_wait "$TRANSIT"; return ;;
		esac
		if [ "$locked" = yes ]; then
			# GNOME's own lock needs GDM: hand over to the Phosh lock screen
			to_phosh "GNOME locked" now; latch 0; set_wait "$TRANSIT"; return
		fi
		if [ "$idle" = yes ]; then
			work_check idle
			if [ -z "$busy" ]; then
				to_phosh "GNOME idle"; latch 0; set_wait "$TRANSIT"; return
			fi
		else
			work_check
		fi
		return ;;
	unknown|"")
		[ -n "$sup_bad" ] || sup_bad=$now
		if [ $((now - sup_bad)) -ge $((SUP_GRACE * 100)) ]; then
			to_phosh "session unit status unavailable" now
			latch 0
		fi
		set_wait "$TRANSIT"; return ;;
	deactivating)
		request_done "the desktop is stopping"
		work_forget; set_wait "$TRANSIT"; return ;;
	esac
	work_forget
	if [ "$dp_state" != connected ] && [ "$auto_done" = 1 ]; then
		if [ "$(remaining "$OFF_AFTER")" -le 0 ]; then latch 0; else set_wait "$(remaining "$OFF_AFTER")"; fi
	fi
	lock_state=unknown
	if [ "$phosh" = active ]; then
		nosess_since=
		[ -n "$sess_cache" ] && phosh_leader "$sess_cache" || sess_cache=$(phosh_session)
		track_phosh_lock
		phosh_leader "$sess_cache" || lock_state=unknown
		# The logind hint can be set by any phone process. Authorization
		# needs the real lockscreen state as well.
		[ "$(phosh_locked)" = "$lock_state" ] || lock_state=unknown
		case $lock_state in
		yes) note_lock "$sess_cache" confirm ;;
		no) note_unlock "$sess_cache" ;;
		*) forget_locks "lock state of session ${sess_cache:--} unreadable" ;;
		esac
		if [ -n "$req" ]; then
			# "Desktop mode" tap: no debounce, display or latch rules, the
			# same unlock rules
			[ "$mode" != off ] || { request_done "desktop mode is off"; return; }
			[ "$dp_state" = connected ] || { request_done "no external display is connected"; return; }
			phosh_unlocked && [ "$unlock_ok" = "$sess_cache" ] ||
				{ request_done "the phone is not unlocked"; return; }
			why="desktop requested"
		else
			[ "$mode" = auto ] && [ "$auto_done" = 0 ] && [ "$dp_state" = connected ] &&
				phosh_unlocked && [ "$unlock_ok" = "$sess_cache" ] || return
			if [ "$(remaining "$ON_AFTER")" -gt 0 ]; then
				set_wait "$(remaining "$ON_AFTER")"; return
			fi
			why="display connected"
		fi
		[ "$(loginctl show-session "$sess_cache" -p Active --value 2>/dev/null)" = yes ] &&
			[ "$(loginctl show-session "$sess_cache" -p Seat --value 2>/dev/null)" = seat0 ] || {
			request_done "the phone session is not active on seat0"; return; }
		# A lock that is already queued must be seen first; then ask logind
		# again right before the switch.
		pending_events && { set_wait 1; return; }
		phosh_leader "$sess_cache" || {
			forget_locks "session $sess_cache is not rog5-phosh's"
			request_done "the phone is not unlocked"; return; }
		locked=$(loginctl show-session "$sess_cache" -p LockedHint --value 2>/dev/null) || locked=
		case $locked in
		no) [ "$(phosh_locked)" = no ] || {
			forget_locks "Phosh locked or unreadable"
			request_done "the phone is not unlocked"; return; } ;;
		yes) note_lock "$sess_cache"; request_done "the phone is locked"; return ;;
		*) forget_locks "lock state of session $sess_cache unreadable"
			request_done "the lock state is unreadable"; return ;;
		esac
		echo "rog5-desktop-mode: $why, phone unlocked (session $sess_cache) -> GNOME"
		request_done
		latch 1
		grant_write "$sess_cache" ||
			{ echo "rog5-desktop-mode: cannot write the start grant" >&2; return; }
		systemctl start --no-block rog5-gnome.service
		set_wait "$TRANSIT"
		return
	fi
	request_done "no phone session"
	# A switch in progress (Phosh stopping before GNOME starts, queued jobs)
	# is not "no session": only act when nothing runs or is queued for a
	# while, e.g. after a failed GNOME start. Acting early cancelled the
	# "Desktop mode" launcher's GNOME start (14:16).
	set_wait "$TRANSIT"
	case $phosh in
	activating|deactivating|reloading) nosess_since=; return ;;
	esac
	if systemctl list-jobs --no-legend 2>/dev/null | grep -qE "rog5-(phosh|gnome)"; then
		nosess_since=; return
	fi
	[ -n "$nosess_since" ] || nosess_since=$now
	if [ $(( (now - nosess_since) / 100 )) -ge "$NOSESS_AFTER" ]; then
		# never leave the phone without its lock screen
		to_phosh "no session"
		nosess_since=
	fi
}

# One event line: D (drm uevent), L <session> yes|no (LockedHint), Q <session>
# (session removed), E/S (other logind session changes), M (mode file /
# reload), R <source> (monitor ready), X <source> (a monitor died).
handle_event() {
	case $1 in
	D*) now_cs; read_dp event ;;
	"L "*" yes")
		set -- $1
		[ "$2" != "$grant_sess" ] || grant_revoke "session $2 locked"
		# the lock itself, even if it is already over when the state is read
		[ "$(loginctl show-session "$2" -p Service --value 2>/dev/null)" = phosh ] || return 0
		seen_locked=$2
		now_cs; note_lock "$2" ;;
	"L "*" no")
		set -- $1
		now_cs; note_unlock "$2" ;;
	"Q "*)  # session removed: its id must not carry history
		set -- $1
		[ "$2" != "$grant_sess" ] || grant_sess=
		[ "$2" = "$lock_sess" ] || [ "$2" = "$seen_locked" ] || [ "$2" = "$unlock_ok" ] &&
			forget_locks "session $2 removed"
		[ "$2" != "$sess_cache" ] || sess_cache= ;;
	X*) echo "rog5-desktop-mode: event source ${1#X } ended" >&2; return 1 ;;
	esac
	return 0
}

LOGIND_AWK='
function unesc(s,  out, i, c, hex, n) {    # sd_bus object path label -> id
	hex = "0123456789abcdef"; out = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (c == "_" && i + 2 <= length(s)) {
			n = (index(hex, tolower(substr(s, i + 1, 1))) - 1) * 16
			n += index(hex, tolower(substr(s, i + 2, 1))) - 1
			out = out sprintf("%c", n)
			i += 2
		} else
			out = out c
	}
	return out
}
/ does not have an owner/ { print "X logind lost its bus name"; fflush(); next }
/ is owned by / { print "R logind"; fflush(); next }
/\.PropertiesChanged / && /login1\.Session/ {
	p = $1; sub(/:$/, "", p); sub(/.*\//, "", p)
	if (match($0, /.LockedHint.: <(true|false)>/))
		print "L", unesc(p), (substr($0, RSTART, RLENGTH) ~ /true/ ? "yes" : "no")
	else
		print "E"
	fflush(); next
}
/\.SessionRemoved \(\047/ {
	id = $0; sub(/.*SessionRemoved \(\047/, "", id); sub(/\047.*/, "", id)
	print "Q", id; fflush(); next
}
/\.(SessionNew|SessionRemoved|PrepareForSleep) / { print "S"; fflush() }
'

start_sources() {
	# awk in the foreground: if either end dies, "X" follows at once (a
	# pipeline would wait for the monitor's next write)
	{ awk '/^UDEV - / { print "R udev"; fflush(); next }
	       /^UDEV / { print "D"; fflush() }' \
		< <(stdbuf -oL udevadm monitor --udev --subsystem-match=drm 2>/dev/null)
	  echo "X udevadm monitor"; } >&"$EV" &
	{ awk "$LOGIND_AWK" \
		< <(stdbuf -oL gdbus monitor --system --dest org.freedesktop.login1 2>/dev/null)
	  echo "X gdbus monitor"; } >&"$EV" &
}

main() {
	local ev ready=0 fifo batch left slice
	# Non-blocking: the main shell is the only reader, so a blocking write
	# into a full pipe would hang it for good. A full pipe already wakes it.
	trap '[ -n "$EV" ] && printf "M\n" | dd of=/proc/self/fd/"$EV" oflag=nonblock status=none 2>/dev/null' USR1
	mkdir -p "$RUN_DIR"
	fifo=$RUN_DIR/events.$$
	rm -f "$fifo"
	mkfifo -m 600 "$fifo" || exit 1
	# read-write: never EOF; the sources block only while the pipe is full
	exec {EV}<>"$fifo"
	rm -f "$fifo"
	[ -e "$LATCH" ] && auto_done=1
	start_sources
	# listen before the first look, so no change falls between the two
	while [ "$ready" -lt 2 ] && IFS= read -r -t 5 -u "$EV" ev; do
		case $ev in R*) ready=$((ready + 1)) ;; *) handle_event "$ev" || exit 1 ;; esac
	done
	[ "$ready" -ge 2 ] || { echo "rog5-desktop-mode: event sources not confirmed ready" >&2; exit 1; }
	systemd-notify --ready || exit 1
	while :; do
		check
		systemd-notify WATCHDOG=1 || exit 1
		# Feed the watchdog during an event wait without repeating expensive
		# session/work probes. A blocked check itself gets no heartbeat.
		left=$wait_s
		while [ "$left" -gt 0 ]; do
			slice=$left; [ "$slice" -le 5 ] || slice=5
			IFS= read -r -t "$slice" -u "$EV" ev && break
			systemd-notify WATCHDOG=1 || exit 1
			left=$((left - slice))
		done
		[ "$left" -gt 0 ] || continue
		handle_event "$ev" || exit 1
		# handle what is already queued (bounded, so a busy source cannot
		# starve check()), then check once; check() starts no GNOME while
		# input is still queued
		batch=0
		while [ "$batch" -lt 64 ] && pending_events && IFS= read -r -u "$EV" ev; do
			batch=$((batch + 1))
			handle_event "$ev" || exit 1
		done
	done
}

if [ -z "${ROG5_DM_LIB:-}" ]; then
	case ${1:-} in
	--request) request_main ;;
	--gate) gate_main ;;
	"") main ;;
	*) echo "usage: rog5-desktop-mode [--request|--gate]" >&2; exit 2 ;;
	esac
fi
