#!/bin/sh
# Install Valve's native aarch64 Linux Steam client for the current user.
#
# Valve publishes the ARM64 client on its own update CDN
# (client-update.steamstatic.com/steam_client_linuxarm64, and _publicbeta_
# for the beta). This downloads the client bootstrap package from that
# manifest, checks its SHA-256 against the manifest, unpacks it into
# ~/.local/share/Steam and adds a "Steam" launcher (steam-arm64, which
# restarts the client after its self-update). The phone kernel uses 4 KiB
# pages, so no muvm VM is needed (Asahi needs it for 16 KiB pages). x86
# games run through Steam's own FEX tool, which needs the x86 guest root
# from steam-fex-rootfs-install (as root); native aarch64 games do not.
#
#   steam-arm64-install [--beta]     (run as the desktop user, not root)
set -eu
[ "$(id -u)" != 0 ] || { echo 'steam-arm64-install: run as the desktop user, not root' >&2; exit 1; }
manifest=steam_client_linuxarm64
[ "${1-}" = --beta ] && manifest=steam_client_publicbeta_linuxarm64
cdn=https://client-update.steamstatic.com
root=${STEAMROOT:-$HOME/.local/share/Steam}
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

# Valve's zips name entries with Windows separators (steamrt64\locales\af.pak)
# and hold symlinks; unzip would create files with backslashes in their names.
unzip_steam() {
	python3 - "$1" "$2" <<'PY'
import os, shutil, stat, sys, zipfile
root = os.path.realpath(sys.argv[2])
with zipfile.ZipFile(sys.argv[1]) as z:
    for info in z.infolist():
        name = info.filename.replace("\\", "/")
        path = os.path.normpath(os.path.join(root, name))
        if os.path.commonpath([root, path]) != root:
            sys.exit(f"steam-arm64-install: {name} escapes {root}")
        if name.endswith("/"):
            os.makedirs(path, exist_ok=True)
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.lexists(path) and not os.path.isdir(path):
            os.unlink(path)
        if stat.S_ISLNK(info.external_attr >> 16):
            os.symlink(z.read(info).decode(), path)
            continue
        with z.open(info) as src, open(path, "wb") as dst:
            shutil.copyfileobj(src, dst)
PY
}

# steamui.so links GTK 2 (not in Arch Linux ARM: packages/gtk2) and the
# client runs lsof for its IPC checks.
missing=
ldconfig -p | grep -q 'libgtk-x11-2\.0\.so\.0 ' || missing="$missing gtk2 (packages/gtk2)"
command -v lsof >/dev/null || missing="$missing lsof"
[ -z "$missing" ] || echo "steam-arm64-install: warning: Steam will not start without:$missing" >&2

curl -fsS --max-time 60 "$cdn/$manifest" -o "$tmp/manifest"
mkdir -p "$root"
# Every package of the manifest (what Steam's bootstrapper fetches): its "file"
# and "sha2"; each is checked before it is unpacked.
awk -F'"' 'NF>=4 && $2=="file"{f=$4} NF>=4 && $2=="sha2" && f{print f, $4; f=""}' "$tmp/manifest" |
while read -r file sha; do
	echo "downloading $file"
	curl -fsSL --max-time 900 "$cdn/$file" -o "$tmp/pkg.zip"
	echo "$sha  $tmp/pkg.zip" | sha256sum -c --quiet || { echo "steam-arm64-install: SHA-256 mismatch for $file" >&2; exit 1; }
	unzip -o -qq "$tmp/pkg.zip" -d "$root"
	rm -f "$tmp/pkg.zip"
done
# Valve's zips carry no usable permissions: mark ELF programs and #! scripts
# executable, nothing world-writable.
find "$root" -type f -size +3c | while IFS= read -r f; do
	case $(head -c 4 "$f" | od -An -c | tr -d ' \n') in
	177ELF* | '#!'*) chmod +x "$f" ;;
	esac
done
chmod -R go-w "$root"
[ -x "$root/steamrtarm64/steam" ] || { echo "steam-arm64-install: no $root/steamrtarm64/steam" >&2; exit 1; }

# The data links steam.sh would create; the client refuses to start without.
mkdir -p "$HOME/.steam"
for link in steam root; do ln -sfn "$root" "$HOME/.steam/$link"; done

apps=$HOME/.local/share/applications
mkdir -p "$apps"
cat >"$apps/steam-arm64.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Steam
Comment=Valve's native aarch64 Steam client
Exec=steam-arm64 %U
Icon=steam
Terminal=false
Categories=Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
X-Purism-FormFactor=Workstation;Mobile;
EOF
echo "installed: $root/steamrtarm64/steam (manifest $manifest); launcher: Steam"
