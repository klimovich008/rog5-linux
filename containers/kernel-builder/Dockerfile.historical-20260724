FROM --platform=linux/amd64 docker.io/library/fedora:44@sha256:89f61a124414261868224666aa7fb8df1b78397a53623774bdfb105d1612b48b AS ca-bootstrap

RUN printf '%s  %s\n' \
      00411c197b16f659945fba3c2f970a26030f56eef5d445c913cb59a089c813b9 \
      /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
      | sha256sum -c -

FROM --platform=linux/amd64 docker.io/library/ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

# This profile reconstructs the package state used by the original
# network-root-v1 builds on 2026-07-24. It is intentionally separate from the
# maintained kernel builder and must not replace its tag.
ENV DEBIAN_FRONTEND=noninteractive

COPY --from=ca-bootstrap \
    /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
    /etc/ssl/certs/ca-certificates.crt

RUN printf '%s\n' \
      'Types: deb' \
      'URIs: https://snapshot.ubuntu.com/ubuntu/20260724T020000Z' \
      'Suites: noble noble-updates noble-backports noble-security' \
      'Components: main universe restricted multiverse' \
      'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
      'Check-Valid-Until: no' \
      > /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get -o APT::Update::Error-Mode=any update \
 && apt-get install -y --no-install-recommends \
      bc bison build-essential ca-certificates clang cpio device-tree-compiler \
      dwarves flex git gnupg iproute2 kmod libarchive-tools libelf-dev \
      libssl-dev lld llvm make nftables python3 qemu-user-static rsync \
      wireguard-tools zlib1g-dev \
 && test "$(dpkg-query -W -f='${Version}' libc6)" = 2.39-0ubuntu8.7 \
 && test "$(dpkg-query -W -f='${Version}' libc6-dev)" = 2.39-0ubuntu8.7 \
 && test "$(clang --version | head -n 1)" = \
      'Ubuntu clang version 18.1.3 (1ubuntu1)' \
 && test "$(ld.lld --version)" = \
      'Ubuntu LLD 18.1.3 (compatible with GNU linkers)' \
 && test "$(pahole --version)" = v1.25 \
 && rm -rf /var/lib/apt/lists/*

LABEL org.rog5.kernel-builder.profile="historical-network-root-v1" \
      org.rog5.kernel-builder.snapshot="20260724T020000Z" \
      org.rog5.kernel-builder.original-image-id="34ecc17078b364df195ad61253520b1cac487dca05773dc4b2fc2bacb0941941" \
      org.rog5.kernel-builder.original-image-digest="sha256:7b2e3415dc638ca4864912c9aa4905425561e21b9d08f1e60e4cfb0a3aa6ff8c"

WORKDIR /workspace
